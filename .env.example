# ---------------------------------------------------------------------------
# EduLink environment
# Copy to .env and fill in. Never commit .env.
# ---------------------------------------------------------------------------

# Database.
#   dev  : SQLite file, zero setup
#   prod : swap provider to "postgresql" in prisma/schema.prisma and use a
#          postgres:// URL. The schema is written to be portable between them
#          (no native enums, no Json columns).
DATABASE_URL="file:./dev.db"

# Public origin. Used for magic links, invite links, push notification click
# targets and manifest start_url resolution.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# 32+ byte secret used to derive the session-cookie HMAC and to hash tokens
# at rest. Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=""

# Web Push (VAPID). Generate a pair with:  npm run vapid
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@edulink.local"

# Email transport.
#   "devbox" -> messages are written to the database and readable at /dev/mailbox
#   "smtp"   -> not implemented in v1 (see Later list)
EMAIL_TRANSPORT="devbox"
EMAIL_FROM="EduLink <no-reply@edulink.local>"

# Local file storage root for uploads (logos, avatars, attachments).
# Deliberately outside ./public so nothing is web-root readable; files are
# served through an authorized route handler instead. (§6)
STORAGE_DIR="./storage"
