{
  "name": "edulink-monorepo",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "pnpm --filter @edulink/web dev",
    "dev:network": "pnpm --filter @edulink/web dev:network",
    "build": "pnpm --filter @edulink/web build",
    "start": "pnpm --filter @edulink/web start",
    "web": "pnpm --filter @edulink/web",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "pnpm -r --if-present lint",
    "test": "pnpm -r --if-present test",
    "test:packages": "pnpm --filter './packages/*' test",
    "battery": "pnpm --filter @edulink/web battery && pnpm --filter './packages/*' test",
    "battery:mobile": "pnpm --filter @edulink/mobile battery",
    "mobile": "pnpm --filter @edulink/mobile"
  },
  "pnpm": {
    "overrides": {
      "postcss@<8.5.23": ">=8.5.23",
      "brace-expansion@<1.1.21": "^1.1.21",
      "brace-expansion@>=4.0.0 <5.0.12": "^5.0.12",
      "browserslist@<4.28.7": "^4.28.7",
      "shell-quote@<1.11.0": "^1.11.0",
      "compression@<1.8.2": "^1.8.2",
      "node-forge@<1.4.1": "^1.4.1",
      "source-map-js@<1.2.2": "^1.2.2",
      "decode-uri-component@<0.5.1": "^0.5.1"
    },
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-ggr8-5vv4-36mx",
        "GHSA-mrhx-c7xc-m3w5"
      ]
    },
    "patchedDependencies": {
      "@prisma/client@6.19.3": "patches/@prisma__client@6.19.3.patch",
      "zod@3.25.76": "patches/zod@3.25.76.patch",
      "query-string@7.1.3": "patches/query-string@7.1.3.patch"
    }
  }
}
