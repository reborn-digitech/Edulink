{
  "name": "edulink-monorepo",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "pnpm --filter @edulink/web dev",
    "build": "pnpm --filter @edulink/web build",
    "start": "pnpm --filter @edulink/web start",
    "web": "pnpm --filter @edulink/web",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "pnpm -r --if-present lint",
    "test": "pnpm -r --if-present test",
    "test:packages": "pnpm --filter './packages/*' test",
    "battery": "pnpm --filter @edulink/web battery && pnpm --filter './packages/*' test"
  }
}
