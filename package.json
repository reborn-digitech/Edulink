{
  "name": "edulink",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma db push --force-reset && npm run db:seed",
    "db:studio": "prisma studio",
    "setup": "npm run db:push && npm run db:seed",
    "test": "vitest run",
    "test:watch": "vitest",
    "vapid": "tsx scripts/gen-vapid.ts",
    "files:check": "tsx --tsconfig scripts/tsconfig.json scripts/reclaim-files.ts",
    "files:reclaim": "tsx --tsconfig scripts/tsconfig.json scripts/reclaim-files.ts --delete",
    "backfill:school-id": "tsx --tsconfig scripts/tsconfig.json scripts/backfill-school-id.ts"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.0.2",
    "@phosphor-icons/react": "^2.1.10",
    "@prisma/client": "^6.19.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "next": "^15.5.22",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^2.6.0",
    "web-push": "^3.6.7",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@serwist/next": "^9.5.12",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^20.19.9",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.1",
    "@types/web-push": "^3.6.4",
    "dotenv": "^16.4.7",
    "postcss": "^8.5.6",
    "prisma": "^6.19.3",
    "serwist": "^9.5.12",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
