{
  "name": "edulink-monorepo",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "pnpm --filter @edulink/web dev",
    "build": "pnpm --filter @edulink/web build",
    "start": "pnpm --filter @edulink/web start",
    "web": "pnpm --filter @edulink/web",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "pnpm -r --if-present lint",
    "test": "pnpm -r --if-present test",
    "test:packages": "pnpm --filter './packages/*' test",
    "battery": "pnpm --filter @edulink/web battery && pnpm --filter './packages/*' test",
    "battery:mobile": "pnpm --filter @edulink/mobile battery",
    "mobile": "pnpm --filter @edulink/mobile"
  },
  "pnpm": {
    "overrides": {
      "postcss@<8.5.23": ">=8.5.23",
      "brace-expansion@<1.1.21": "^1.1.21",
      "brace-expansion@>=4.0.0 <5.0.12": "^5.0.12"
    },
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-ggr8-5vv4-36mx"
      ]
    }
  }
}
