{
  "name": "edulink",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:push": "node scripts/with-admin-db.mjs npx prisma db push",
    "db:seed": "node scripts/with-admin-db.mjs npx tsx prisma/seed.ts",
    "db:reset": "node scripts/with-admin-db.mjs npx prisma db push --force-reset && npm run db:grants && npm run db:seed",
    "db:studio": "prisma studio",
    "setup": "npm run db:push && npm run db:grants && npm run db:seed",
    "test": "vitest run",
    "test:watch": "vitest",
    "vapid": "tsx scripts/gen-vapid.ts",
    "files:check": "tsx --tsconfig scripts/tsconfig.json scripts/reclaim-files.ts",
    "files:reclaim": "tsx --tsconfig scripts/tsconfig.json scripts/reclaim-files.ts --delete",
    "rls:generate": "tsx --tsconfig scripts/tsconfig.json scripts/gen-rls.ts",
    "rls:verify": "tsx --tsconfig scripts/tsconfig.json scripts/verify-rls-app.ts",
    "sweep": "tsx --tsconfig scripts/tsconfig.json scripts/sweep.ts",
    "quiz:verify": "tsx --tsconfig scripts/tsconfig.json scripts/verify-quiz.ts",
    "quiz:import": "tsx --tsconfig scripts/tsconfig.json scripts/import-quiz.ts",
    "quiz:generate": "tsx --tsconfig scripts/tsconfig.json scripts/quiz2/gen-quiz2.ts",
    "expert:invite": "tsx --tsconfig scripts/tsconfig.json scripts/invite-expert.ts",
    "digest:weekly": "tsx --tsconfig scripts/tsconfig.json scripts/send-weekly-digest.ts",
    "demo:seed": "tsx --tsconfig scripts/tsconfig.json scripts/demo-seed.ts",
    "zz:fixtures": "node scripts/with-admin-db.mjs npx tsx --tsconfig scripts/tsconfig.json scripts/zz-fixtures.ts",
    "db:grants": "node scripts/db-grants.mjs",
    "superuser": "node scripts/with-admin-db.mjs npx tsx --tsconfig scripts/tsconfig.json scripts/make-superuser.ts",
    "appadmin": "node scripts/with-admin-db.mjs npx tsx --tsconfig scripts/tsconfig.json scripts/make-app-admin.ts",
    "guardians:backfill": "node scripts/with-admin-db.mjs npx tsx --tsconfig scripts/tsconfig.json scripts/backfill-standin-guardians.ts",
    "i18n": "tsx scripts/i18n-audit.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.116.0",
    "@node-rs/argon2": "^2.0.2",
    "@phosphor-icons/react": "^2.1.10",
    "@prisma/client": "^6.19.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "next": "^15.5.22",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^2.6.0",
    "web-push": "^3.6.7",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@serwist/next": "^9.5.12",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^20.19.9",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.1",
    "@types/web-push": "^3.6.4",
    "dotenv": "^16.4.7",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.0",
    "postcss": "^8.5.6",
    "prisma": "^6.19.3",
    "serwist": "^9.5.12",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
