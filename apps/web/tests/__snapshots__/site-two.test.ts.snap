;list-style:none}.people li{border-left:4px solid var(--c);padding:.25rem .75rem}.people span{display:block;color:var(--muted);font-size:.95rem}.news{display:grid;gap:1.5rem;margin:0;padding:0;list-style:none}.news article{display:grid;gap:.75rem}@media(min-width:48rem){.news article.pic{grid-template-columns:16rem 1fr}}.news time,.when{color:var(--muted);font-size:.9rem}.news img{border-radius:8px}.gallery{display:grid;grid-template-columns:repeat(auto-fill,minmax(12rem,1fr));gap:.75rem;margin:0;padding:0;list-style:none}.gallery img{border-radius:8px;aspect-ratio:4/3;object-fit:cover;width:100%}.album{margin:0 0 2rem}.cards{display:grid;grid-template-columns:repeat(auto-fill,minmax(15rem,1fr));gap:1rem;margin:0;padding:0;list-style:none}.cards li{border:1px solid var(--line);border-radius:10px;background:var(--card);overflow:hidden}.cards .body{padding:1rem}.cards img{aspect-ratio:4/3;object-fit:cover;width:100%}.cards p{margin:.25rem 0 0}.events{margin:0;padding:0;list-style:none;display:grid;gap:.75rem}.events li{display:grid;gap:.1rem;border-left:4px solid var(--a);padding:.25rem .75rem}.events .kind{color:var(--muted);font-size:.9rem}.files{margin:0;padding:0;list-style:none;display:grid;gap:.5rem}.files a{display:inline-flex;min-height:44px;align-items:center;font-weight:600}.files span{color:var(--muted);font-size:.9rem;margin-left:.5rem}.facts{display:grid;grid-template-columns:max-content 1fr;gap:.5rem 1.5rem;margin:0 0 1.5rem}.facts dt{color:var(--muted)}.facts dd{margin:0}.classes{display:grid;grid-template-columns:repeat(auto-fill,minmax(14rem,1fr));gap:1rem;margin:0;padding:0;list-style:none}.classes li{border:1px solid var(--line);border-radius:10px;padding:.75rem 1rem;background:var(--card)}.classes span{display:block;color:var(--muted);font-size:.95rem}dl.contact{display:grid;grid-template-columns:max-content 1fr;gap:.5rem 1.5rem;margin:0}dl.contact dt{color:var(--muted)}dl.contact dd{margin:0}form.enquiry{display:grid;gap:.75rem;max-width:36rem;margin-top:1.5rem}form.enquiry label{display:grid;gap:.25rem;font-weight:600}form.enquiry label.tick{display:flex;gap:.5rem;align-items:center;font-weight:400}form.enquiry input,form.enquiry textarea{font:inherit;padding:.6rem .75rem;border:1px solid #8c959f;border-radius:6px;min-height:44px;width:100%;background:var(--card);color:var(--ink)}form.enquiry input[type=checkbox]{width:1.25rem;min-height:1.25rem}form.enquiry button{font:inherit;font-weight:700;background:var(--c);color:#fff;border:0;border-radius:6px;padding:.7rem 1.25rem;min-height:44px;justify-self:start;cursor:pointer}.hp{position:absolute;left:-9999px;width:1px;height:1px;overflow:hidden}.note{color:var(--muted);font-size:.9rem;margin:0}.rich h2{font-size:1.3rem;margin:1.5rem 0 .5rem}.rich h3{margin:1.25rem 0 .25rem}.principal blockquote{margin:0;padding:0 0 0 1rem;border-left:4px solid var(--c)}.principal cite{display:block;margin-top:.5rem;font-style:normal;font-weight:600}footer{padding:2rem 0;border-top:1px solid var(--line);color:var(--muted);font-size:.9rem}footer p{margin:.25rem 0}footer ul{display:flex;flex-wrap:wrap;gap:.25rem 1rem;margin:.5rem 0;padding:0;list-style:none}footer a{display:inline-block;min-height:44px;padding:.5rem 0}header.hd{background:var(--c);color:#fff;text-align:center;padding:2rem 0 1rem}header.hd a{color:#fff}header.hd .logo{margin:0 auto 1rem}header.hd .nav,header.hd .langs{justify-content:center}main section:nth-of-type(even){background:var(--c-soft)}</style></head><body class="t-classic"><a class="skip" href="#main">Skip to the content</a><div class="ann" role="note"><div class="wrap"><p>Admissions open for 2027</p></div></div><header class="hd"><div class="wrap"><img class="logo" src="/api/files/f-logo?w=320" alt="ZZ Hill School logo" width="72" height="72"><h1>ZZ Hill School</h1><nav aria-label="The site&#39;s pages"><ul class="nav"><li><a href="__SITE_BASE__/" aria-current="page">Home</a></li><li><a href="__SITE_BASE__/about">About us</a></li><li><a href="__SITE_BASE__/academics">Academics</a></li><li><a href="__SITE_BASE__/admissions">Admissions</a></li><li><a href="__SITE_BASE__/facilities">Facilities</a></li><li><a href="__SITE_BASE__/gallery">Gallery</a></li><li><a href="__SITE_BASE__/news">News</a></li><li><a href="__SITE_BASE__/events">Events</a></li><li><a href="__SITE_BASE__/achievements">Achievements</a></li><li><a href="__SITE_BASE__/downloads">Downloads</a></li><li><a href="__SITE_BASE__/contact">Contact</a></li><li><a href="__SITE_BASE__/transport-routes">Bus routes</a></li></ul></nav><nav aria-label="Language"><ul class="langs"><li><a href="__SITE_BASE__/?lang=en" lang="en" aria-current="page">English</a></li><li><a href="__SITE_BASE__/?lang=hi" lang="hi" hreflang="hi">हिन्दी</a></li><li><a href="__SITE_BASE__/?lang=mr" lang="mr" hreflang="mr">मराठी</a></li></ul></nav></div></header><main id="main"><div class="hero pic"><img src="/api/files/f-hero?w=1280" alt="The school building"><div class="cap"><div class="wrap"><p class="big">Learning on the hill</p></div></div></div><section id="about" aria-labelledby="h-about"><div class="wrap"><h2 id="h-about">About us</h2><p>A school by the hill.</p><p>We teach everyone.</p><p class="more"><a href="__SITE_BASE__/about">More about us</a></p></div></section><section id="numbers" aria-labelledby="h-numbers"><div class="wrap"><h2 id="h-numbers">At a glance</h2><ul class="numbers"><li><span class="v">640</span><span class="l">Students enrolled</span></li></ul><p class="asof">Figures as of 16 October 2026.</p></div></section><section id="disclosure" aria-labelledby="h-disclosure"><div class="wrap"><h2 id="h-disclosure">Mandatory disclosure</h2><p>The disclosure the regulator asks us to publish, with our programmes, faculty and results.</p><p><a href="https://app.example.test/public/disclosure/zz-hill">Read the mandatory disclosure</a></p></div></section><section id="admissions" aria-labelledby="h-admissions"><div class="wrap"><h2 id="h-admissions">Admissions</h2><p>Forms in January.</p><p class="more"><a href="__SITE_BASE__/admissions">How to apply</a></p></div></section><section id="news" aria-labelledby="h-news"><div class="wrap"><h2 id="h-news">News</h2><ul class="news"><li><article><div><h3>Annual day</h3><time datetime="2026-10-10">10 October 2026</time><p>Songs and a play.</p></div></article></li></ul><p class="more"><a href="__SITE_BASE__/news">All the news</a></p></div></section><section id="gallery" aria-labelledby="h-gallery"><div class="wrap"><h2 id="h-gallery">Gallery</h2><ul class="gallery"><li><img src="/api/files/f-album?w=640" alt="A race" loading="lazy"></li></ul><p class="more"><a href="__SITE_BASE__/gallery">All the pictures</a></p></div></section><section id="contact" aria-labelledby="h-contact"><div class="wrap"><h2 id="h-contact">Contact</h2><dl class="contact"><dt>Address</dt><dd>2 Hill Road, Nashik, Maharashtra, 422001</dd><dt>Phone</dt><dd><a href="tel:+912531234567">+91 253 123 4567</a></dd><dt>Email</dt><dd><a href="mailto:office@zz-hill.test">office@zz-hill.test</a></dd></dl><p class="more"><a href="__SITE_BASE__/contact">Contact us</a></p></div></section><section id="events" aria-labelledby="h-events"><div class="wrap"><h2 id="h-events">Events</h2><ul class="events"><li><strong>Diwali break</strong><span class="when"><time datetime="2026-10-20">20 October 2026 – 27 October 2026</time></span><span class="kind">Holiday</span></li></ul><p class="more"><a href="__SITE_BASE__/events">All the events</a></p></div></section><section id="achievements" aria-labelledby="h-achievements"><div class="wrap"><h2 id="h-achievements">Achievements</h2><ul class="cards"><li><div class="body"><h3>District science fair, first place</h3><span class="when"><time datetime="2026-09-12">12 September 2026</time></span><p>The Grade 8 team&#39;s water filter.</p></div></li></ul><p class="more"><a href="__SITE_BASE__/achievements">See all</a></p></div></section><section id="facilities" aria-labelledby="h-facilities"><div class="wrap"><h2 id="h-facilities">Facilities</h2><ul class="cards"><li><img src="/api/files/f-library?w=640" alt="Shelves of books" loading="lazy"><div class="body"><h3>Library</h3><p>Six thousand books.</p></div></li><li><div class="body"><h3>Music room</h3></div></li></ul><p class="more"><a href="__SITE_BASE__/facilities">See all</a></p></div></section></main><footer><div class="wrap"><p>ZZ Hill School · 2 Hill Road, Nashik, Maharashtra, 422001</p><ul><li><a href="https://www.facebook.com/zz-hill" rel="noopener">Facebook</a></li><li><a href="https://youtu.be/zz" rel="noopener">YouTube</a></li><li><a href="https://wa.me/919800000000" rel="noopener">WhatsApp</a></li><li><a href="https://app.example.test/public/disclosure/zz-hill">Mandatory disclosure</a></li></ul><p><a href="https://app.example.test">Built with Shalaghar</a></p></div></footer></body></html>"`;

