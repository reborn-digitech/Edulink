0;list-style:none}.people li{border-left:4px solid var(--c);padding:.25rem .75rem}.people span{display:block;color:var(--muted);font-size:.95rem}.people img{width:4.5rem;height:4.5rem;border-radius:50%;object-fit:cover;margin-bottom:.5rem}.news{display:grid;gap:1.5rem;margin:0;padding:0;list-style:none}.news article{display:grid;gap:.75rem}@media(min-width:48rem){.news article.pic{grid-template-columns:16rem 1fr}}.news time,.when{color:var(--muted);font-size:.9rem}.news img{border-radius:8px}.gallery{display:grid;grid-template-columns:repeat(auto-fill,minmax(12rem,1fr));gap:.75rem;margin:0;padding:0;list-style:none}.gallery img{border-radius:8px;aspect-ratio:4/3;object-fit:cover;width:100%}.album{margin:0 0 2rem}.cards{display:grid;grid-template-columns:repeat(auto-fill,minmax(15rem,1fr));gap:1rem;margin:0;padding:0;list-style:none}.cards li{border:1px solid var(--line);border-radius:10px;background:var(--card);overflow:hidden}.cards .body{padding:1rem}.cards img{aspect-ratio:4/3;object-fit:cover;width:100%}.cards p{margin:.25rem 0 0}.events{margin:0;padding:0;list-style:none;display:grid;gap:.75rem}.events li{display:grid;gap:.1rem;border-left:4px solid var(--a);padding:.25rem .75rem}.events .kind{color:var(--muted);font-size:.9rem}.files{margin:0;padding:0;list-style:none;display:grid;gap:.5rem}.files a{display:inline-flex;min-height:44px;align-items:center;font-weight:600}.files span{color:var(--muted);font-size:.9rem;margin-left:.5rem}.facts{display:grid;grid-template-columns:max-content 1fr;gap:.5rem 1.5rem;margin:0 0 1.5rem}.facts dt{color:var(--muted)}.facts dd{margin:0}.classes{display:grid;grid-template-columns:repeat(auto-fill,minmax(14rem,1fr));gap:1rem;margin:0;padding:0;list-style:none}.classes li{border:1px solid var(--line);border-radius:10px;padding:.75rem 1rem;background:var(--card)}.classes span{display:block;color:var(--muted);font-size:.95rem}dl.contact{display:grid;grid-template-columns:max-content 1fr;gap:.5rem 1.5rem;margin:0}dl.contact dt{color:var(--muted)}dl.contact dd{margin:0}form.enquiry{display:grid;gap:.75rem;max-width:36rem;margin-top:1.5rem}form.enquiry label{display:grid;gap:.25rem;font-weight:600}form.enquiry label.tick{display:flex;gap:.5rem;align-items:center;font-weight:400}form.enquiry input,form.enquiry textarea{font:inherit;padding:.6rem .75rem;border:1px solid #8c959f;border-radius:6px;min-height:44px;width:100%;background:var(--card);color:var(--ink)}form.enquiry input[type=checkbox]{width:1.25rem;min-height:1.25rem}form.enquiry button{font:inherit;font-weight:700;background:var(--c);color:#fff;border:0;border-radius:6px;padding:.7rem 1.25rem;min-height:44px;justify-self:start;cursor:pointer}.hp{position:absolute;left:-9999px;width:1px;height:1px;overflow:hidden}.note{color:var(--muted);font-size:.9rem;margin:0}.rich h2{font-size:1.3rem;margin:1.5rem 0 .5rem}.rich h3{margin:1.25rem 0 .25rem}.principal blockquote{margin:0;padding:0 0 0 1rem;border-left:4px solid var(--c)}.principal cite{display:block;margin-top:.5rem;font-style:normal;font-weight:600}footer{padding:2rem 0;border-top:1px solid var(--line);color:var(--muted);font-size:.9rem}footer p{margin:.25rem 0}footer ul{display:flex;flex-wrap:wrap;gap:.25rem 1rem;margin:.5rem 0;padding:0;list-style:none}footer a{display:inline-block;min-height:44px;padding:.5rem 0}:root{--bg:#fdf8f3}header.hd{padding:1.5rem 0 0}header.hd .card{background:var(--c-mid);border-radius:20px;padding:1.5rem;display:grid;gap:.75rem;justify-items:start}h2{color:var(--link);border-bottom:2px dotted var(--c-mid);padding-bottom:.25rem}main section{padding:2rem 0}.numbers li{border-radius:16px;border-color:var(--c-mid)}</style></head><body class="t-warm"><a class="skip" href="#main">Skip to the content</a><header class="hd"><div class="wrap"><div class="card"><img class="logo" src="/api/files/f-logo?w=320" alt="ZZ River School logo" width="72" height="72"><h1>ZZ River School</h1><nav aria-label="The site&#39;s pages"><ul class="nav"><li><a href="__SITE_BASE__/" aria-current="page">Home</a></li><li><a href="__SITE_BASE__/about">About us</a></li><li><a href="__SITE_BASE__/academics">Academics</a></li><li><a href="__SITE_BASE__/admissions">Admissions</a></li><li><a href="__SITE_BASE__/gallery">Gallery</a></li><li><a href="__SITE_BASE__/news">News</a></li><li><a href="__SITE_BASE__/contact">Contact</a></li></ul></nav><nav aria-label="Language"><ul class="langs"><li><a href="__SITE_BASE__/?lang=en" lang="en" aria-current="page">English</a></li><li><a href="__SITE_BASE__/?lang=hi" lang="hi" hreflang="hi">हिन्दी</a></li><li><a href="__SITE_BASE__/?lang=mr" lang="mr" hreflang="mr">मराठी</a></li></ul></nav></div></div></header><main id="main"><div class="hero band"><div class="wrap"><p class="big">Learning by the river</p></div></div><section id="about" aria-labelledby="h-about"><div class="wrap"><h2 id="h-about">About us</h2><p>A school by the river.</p><p>We teach &lt;b&gt;everyone&lt;/b&gt; &amp; we mean it.</p><div class="principal"><h3>From the principal</h3><blockquote><p>Welcome to our school.</p><cite>ZZ Head</cite></blockquote></div><p class="more"><a href="__SITE_BASE__/about">More about us</a></p></div></section><section id="numbers" aria-labelledby="h-numbers"><div class="wrap"><h2 id="h-numbers">At a glance</h2><ul class="numbers"><li><span class="v">1,234</span><span class="l">Students enrolled</span></li><li><span class="v">56</span><span class="l">Teaching staff</span></li><li><span class="v">93%</span><span class="l">Attendance this month</span></li><li><span class="v">CBSE · 1130456</span><span class="l">Board and affiliation</span></li><li><span class="v">36</span><span class="l">Years since founding</span></li></ul><p class="asof">Figures as of 15 October 2026.</p></div></section><section id="news" aria-labelledby="h-news"><div class="wrap"><h2 id="h-news">News</h2><ul class="news"><li><article class="pic"><img src="/api/files/f-news?w=640" alt="Children racing" loading="lazy"><div><h3>Sports day</h3><time datetime="2026-10-01">1 October 2026</time><p>Races and a &lt;script&gt;alert(1)&lt;/script&gt; tug of war.</p></div></article></li></ul><p class="more"><a href="__SITE_BASE__/news">All the news</a></p></div></section><section id="gallery" aria-labelledby="h-gallery"><div class="wrap"><h2 id="h-gallery">Gallery</h2><ul class="gallery"><li><img src="/api/files/f-gallery?w=640" alt="The prize table" loading="lazy"></li></ul><p class="more"><a href="__SITE_BASE__/gallery">All the pictures</a></p></div></section><section id="admissions" aria-labelledby="h-admissions"><div class="wrap"><h2 id="h-admissions">Admissions</h2><p>Forms open in January.</p><p class="more"><a href="__SITE_BASE__/admissions">How to apply</a></p></div></section><section id="contact" aria-labelledby="h-contact"><div class="wrap"><h2 id="h-contact">Contact</h2><dl class="contact"><dt>Address</dt><dd>1 River Road, Pune, Maharashtra, 411001</dd><dt>Phone</dt><dd><a href="tel:+912012345678">+91 20 1234 5678</a></dd><dt>Email</dt><dd><a href="mailto:office@zz-river.test">office@zz-river.test</a></dd><dt>Office hours</dt><dd>Monday to Saturday, 9 to 4</dd></dl><p><a href="https://maps.example.test/river" rel="noopener">Open the map</a></p><p class="more"><a href="__SITE_BASE__/contact">Contact us</a></p></div></section></main><footer><div class="wrap"><p>ZZ River School · 1 River Road, Pune, Maharashtra, 411001</p><p><a href="https://app.example.test">Built with Shalaghar</a></p></div></footer></body></html>"`;
