exports[`the renderer (pure) > draws the CLASSIC template the same way every time 1`] = `"<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>ZZ River School · Learning by the river</title><meta name="description" content="Learning by the river"><meta name="generator" content="Shalaghar"><style>:root{--c:#1d4ed8;--c-soft:#e8edfb;--c-mid:#c7d3f5;--ink:#1f2328;--muted:#57606a;--line:#d8dee4;--bg:#ffffff}*{box-sizing:border-box}html{font-family:system-ui, -apple-system, "Segoe UI", Roboto, "Noto Sans", "Noto Sans Devanagari", sans-serif;color:var(--ink);background:var(--bg);line-height:1.6;-webkit-text-size-adjust:100%}body{margin:0}img{max-width:100%;height:auto;display:block}a{color:var(--c)}a:focus-visible,button:focus-visible,input:focus-visible,textarea:focus-visible{outline:3px solid var(--c);outline-offset:2px}.skip{position:absolute;left:-999px;top:0;background:#fff;color:var(--ink);padding:.5rem 1rem;z-index:10}.skip:focus{left:1rem}.wrap{max-width:68rem;margin:0 auto;padding:0 1rem}h1{font-size:clamp(1.6rem,4vw,2.4rem);line-height:1.2;margin:0}h2{font-size:1.5rem;line-height:1.25;margin:0 0 1rem}h3{font-size:1.1rem;margin:0 0 .25rem}.motto{margin:.25rem 0 0;font-size:1.05rem}.logo{width:72px;height:72px;object-fit:contain;background:#fff;border-radius:8px}.nav{display:flex;flex-wrap:wrap;gap:.25rem 1rem;margin:0;padding:0;list-style:none}.nav a{display:inline-block;padding:.5rem 0;min-height:44px;text-decoration:none}.langs{display:flex;gap:.75rem;margin:.5rem 0 0;padding:0;list-style:none;font-size:.95rem}.langs a{display:inline-block;padding:.5rem 0;min-height:44px}.langs [aria-current]{font-weight:700;text-decoration:none}section{padding:2.5rem 0}.numbers{display:grid;grid-template-columns:repeat(auto-fit,minmax(10rem,1fr));gap:1rem;margin:0;padding:0;list-style:none}.numbers li{border:1px solid var(--line);border-radius:10px;padding:1rem;background:#fff}.numbers .v{display:block;font-size:1.8rem;font-weight:700;color:var(--c);line-height:1.2}.numbers .l{display:block;color:var(--muted);font-size:.95rem}.asof{color:var(--muted);font-size:.9rem;margin:1rem 0 0}.people{display:grid;grid-template-columns:repeat(auto-fit,minmax(14rem,1fr));gap:1rem;margin:0;padding:0;list-style:none}.people li{border-left:4px solid var(--c);padding:.25rem .75rem}.people span{display:block;color:var(--muted);font-size:.95rem}.news{display:grid;gap:1.5rem;margin:0;padding:0;list-style:none}.news article{display:grid;gap:.75rem}@media(min-width:48rem){.news article.pic{grid-template-columns:16rem 1fr}}.news time{color:var(--muted);font-size:.9rem}.news img{border-radius:8px}.gallery{display:grid;grid-template-columns:repeat(auto-fill,minmax(12rem,1fr));gap:.75rem;margin:0;padding:0;list-style:none}.gallery img{border-radius:8px;aspect-ratio:4/3;object-fit:cover;width:100%}dl.contact{display:grid;grid-template-columns:max-content 1fr;gap:.5rem 1.5rem;margin:0}dl.contact dt{color:var(--muted)}dl.contact dd{margin:0}form.enquiry{display:grid;gap:.75rem;max-width:36rem;margin-top:1.5rem}form.enquiry label{display:grid;gap:.25rem;font-weight:600}form.enquiry input,form.enquiry textarea{font:inherit;padding:.6rem .75rem;border:1px solid #8c959f;border-radius:6px;min-height:44px;width:100%}form.enquiry button{font:inherit;font-weight:700;background:var(--c);color:#fff;border:0;border-radius:6px;padding:.7rem 1.25rem;min-height:44px;justify-self:start;cursor:pointer}.hp{position:absolute;left:-9999px;width:1px;height:1px;overflow:hidden}.note{color:var(--muted);font-size:.9rem;margin:0}.principal blockquote{margin:0;padding:0 0 0 1rem;border-left:4px solid var(--c)}.principal cite{display:block;margin-top:.5rem;font-style:normal;font-weight:600}footer{padding:2rem 0;border-top:1px solid var(--line);color:var(--muted);font-size:.9rem}footer p{margin:.25rem 0}header.hd{background:var(--c);color:#fff;text-align:center;padding:2rem 0 1rem}header.hd a{color:#fff}header.hd .logo{margin:0 auto 1rem}header.hd .nav,header.hd .langs{justify-content:center}main section:nth-of-type(even){background:var(--c-soft)}</style></head><body class="t-classic"><a class="skip" href="#main">Skip to the content</a><header class="hd"><div class="wrap"><img class="logo" src="/api/files/f-logo?w=320" alt="ZZ River School logo" width="72" height="72"><h1>ZZ River School</h1><p class="motto">Learning by the river</p><nav aria-label="Sections of this page"><ul class="nav"><li><a href="#about">About us</a></li><li><a href="#numbers">At a glance</a></li><li><a href="#news">News</a></li><li><a href="#gallery">Gallery</a></li><li><a href="#admissions">Admissions</a></li><li><a href="#contact">Contact</a></li></ul></nav><nav aria-label="Language"><ul class="langs"><li><a href="?lang=en" lang="en" aria-current="page">English</a></li><li><a href="?lang=hi" lang="hi" hreflang="hi">हिन्दी</a></li><li><a href="?lang=mr" lang="mr" hreflang="mr">मराठी</a></li></ul></nav></div></header><main id="main"><section id="about" aria-labelledby="h-about"><div class="wrap"><h2 id="h-about">About us</h2><p>A school by the river.</p><p>We teach &lt;b&gt;everyone&lt;/b&gt; &amp; we mean it.</p><div class="principal"><h3>From the principal</h3><blockquote><p>Welcome to our school.</p><cite>ZZ Head</cite></blockquote></div></div></section><section id="numbers" aria-labelledby="h-numbers"><div class="wrap"><h2 id="h-numbers">At a glance</h2><ul class="numbers"><li><span class="v">1,234</span><span class="l">Students enrolled</span></li><li><span class="v">56</span><span class="l">Teaching staff</span></li><li><span class="v">93%</span><span class="l">Attendance this month</span></li><li><span class="v">CBSE · 1130456</span><span class="l">Board and affiliation</span></li><li><span class="v">36</span><span class="l">Years since founding</span></li></ul><p class="asof">Figures as of 15 October 2026.</p></div></section><section id="news" aria-labelledby="h-news"><div class="wrap"><h2 id="h-news">News</h2><ul class="news"><li><article class="pic"><img src="/api/files/f-news?w=640" alt="Children racing" loading="lazy"><div><h3>Sports day</h3><time datetime="2026-10-01">1 October 2026</time><p>Races and a &lt;script&gt;alert(1)&lt;/script&gt; tug of war.</p></div></article></li></ul></div></section><section id="gallery" aria-labelledby="h-gallery"><div class="wrap"><h2 id="h-gallery">Gallery</h2><ul class="gallery"><li><img src="/api/files/f-gallery?w=640" alt="The prize table" loading="lazy"></li></ul></div></section><section id="admissions" aria-labelledby="h-admissions"><div class="wrap"><h2 id="h-admissions">Admissions</h2><p>Forms open in January.</p><form class="enquiry" method="post" action="/enquiry"><h3>Ask about admission</h3><input type="hidden" name="lang" value="en"><label>Your name<input name="name" required maxlength="120" autocomplete="name"></label><label>Your phone or email<input name="contact" required maxlength="200" autocomplete="tel"></label><label>Class you are asking about (optional)<input name="grade" maxlength="60"></label><label>Your question<textarea name="message" required maxlength="2000" rows="4"></textarea></label><div class="hp" aria-hidden="true"><label>Leave this empty<input name="website" tabindex="-1" autocomplete="off"></label></div><p class="note">We use these details only to answer you.</p><button type="submit">Send</button></form></div></section><section id="contact" aria-labelledby="h-contact"><div class="wrap"><h2 id="h-contact">Contact</h2><dl class="contact"><dt>Address</dt><dd>1 River Road, Pune, Maharashtra, 411001</dd><dt>Phone</dt><dd><a href="tel:+912012345678">+91 20 1234 5678</a></dd><dt>Email</dt><dd><a href="mailto:office@zz-river.test">office@zz-river.test</a></dd><dt>Office hours</dt><dd>Monday to Saturday, 9 to 4</dd></dl><p><a href="https://maps.example.test/river" rel="noopener">Open the map</a></p></div></section></main><footer><div class="wrap"><p>ZZ River School · 1 River Road, Pune, Maharashtra, 411001</p><p><a href="https://app.example.test">Built with Shalaghar</a></p></div></footer></body></html>"`;

