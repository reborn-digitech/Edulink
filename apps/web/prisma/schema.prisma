// affiliation lives on Membership, never on User.
// ---------------------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  email         String?   @unique
  phone         String?   @unique
  /// UDISE+ Permanent Education Number: eleven digits the portal assigns
  /// once to a pupil for life. On the account, not the membership, because
  /// it identifies the person across every school they attend; unique
  /// across the platform so the office can find a pupil by it and a
  /// transfer can recognise them. The pupil record mirrors it for the
  /// certificate and the filing that print it. Never Aadhaar.
  penNumber     String?   @unique
  passwordHash  String? // null while the account is magic-link / parent-managed only
  name          String
  preferredName String?
  avatarKey     String? // "preset:fox-orange" or "upload:<fileId>"
  bio           String?
  birthdate     DateTime? // date-only semantics; stored UTC midnight

  emailVerifiedAt DateTime?
  phoneVerifiedAt DateTime?

  // Account is known to belong to a child -> stricter defaults, parent consent
  // gates, no global-feed posting without approval. (§6 COPPA/GDPR-K)
  isMinor Boolean @default(false)

  lastRole     String?
  lastSchoolId String?

  // JSON: theme, contrast, dyslexicFont, reducedMotion, locale,
  // notification channels, quietHours.
  prefs String @default("{}")

  /// THE PROVIDER'S MEETING ACCOUNT IS PREMIUM (decision 0008, 7 November 2026): an expert's or a teacher's own
  /// word, said once, that their Google Meet, Zoom, Teams or Jitsi account is a paid one. Without it a session they
  /// offer is held to the service's free-account length (GigSettings.freeLimit*Minutes, read by
  /// src/lib/gig-sessions.ts offerSlot and the series). On the person, not a profile: a teacher has no profile row
  /// of their own, and the room is the person's whichever school or kind they offer under. Nothing verifies it.
  premiumMeeting Boolean @default(false)

  /// Whoever runs the server, not whoever runs a school.
  ///
  /// A FLAG, NOT A ROLE, and deliberately. A role is something a session is
  /// currently acting AS, and it belongs to one school; this belongs to the
  /// person and to no school. Making it a role would mean adding it to the
  /// switcher, to every `requireRole`, and to the membership machinery — for an
  /// actor that has no membership by definition.
  ///
  /// It grants exactly two things, enforced in the database rather than here:
  /// School and Invite rows may be read and written outside any tenant. It does
  /// NOT grant sight of a single child's marks, register or message. See the
  /// SUPERUSER_TABLES note in scripts/gen-rls.ts.
  isSuperuser Boolean @default(false)

  /// The application's content team, not a school post and not the operator.
  ///
  /// A FLAG, NOT A ROLE, for the same reasons as `isSuperuser` above. An app
  /// admin curates what is shared across every school — the practice question
  /// bank and platform-wide competitions — and holds no membership anywhere.
  /// The tables they write (QuizTopic, QuizQuestion, their translations,
  /// Competition) are the shared catalogue and carry no school policy; the
  /// authorisation is this flag, checked at the application boundary.
  isAppAdmin    Boolean @default(false)
  /// A person the tests make (the ZZ people, the sweeps' experts): left out of
  /// every cross-school directory unless the reader is a fixture too.
  isTestFixture Boolean @default(false)

  disabledAt DateTime?

  /// Set when this account was joined into another one. See account-merge.ts.
  ///
  /// THE ACCOUNT IS CLOSED, NOT DELETED, and this column is why. A merged-away
  /// account has usually posted, commented and reacted, and every one of those
  /// rows carries `authorUserId`. Deleting the User would cascade them out of
  /// existence — a class bulletin losing three months of a child's posts
  /// because they changed school. Keeping the row keeps the name attached to
  /// what it wrote, and this pointer says where the person went.
  ///
  /// `disabledAt` is set alongside it, which is what actually stops the login.
  /// Two columns because they answer different questions: `disabledAt` is "may
  /// this account sign in", which a suspended account also answers no to, and
  /// this is "is there still a person behind it".
  mergedIntoUserId String?
  mergedAt         DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  mergedInto User?  @relation("AccountMerge", fields: [mergedIntoUserId], references: [id], onDelete: SetNull)
  mergedFrom User[] @relation("AccountMerge")

  memberships          Membership[]
  reviewResponses      ReviewResponse[]          @relation("ReviewRespondent")
  sessions             Session[]
  ssoIdentities        SsoIdentity[]
  guardianships        Guardianship[]            @relation("ParentGuardianships")
  authTokens           AuthToken[]
  notifications        Notification[]
  pushSubscriptions    PushSubscription[]
  deviceTokens         DeviceToken[]
  uploadTickets        UploadTicket[]
  posts                Post[]
  comments             Comment[]
  reactions            Reaction[]
  remarkMessages       RemarkMessage[]
  conversationMembers  ConversationParticipant[]
  conversationMessages ConversationMessage[]
  reportsFiled         Report[]                  @relation("ReportsFiled")
  expertProfile        ExpertProfile?
  /// A recruiter's own account (4 Oct 2026): belongs to no college, reaches one only through a placement drive.
  recruiterProfile     RecruiterProfile?
  expertMessages       ExpertMessage[]
  mentorMessages       MentorMessage[]
  schoolRecords        SchoolRecord[]
  operatorAccess       OperatorAccess[]
  enquiries            Enquiry[]                 @relation("EnquiryOpener")
  enquiryMessages      EnquiryMessage[]          @relation("EnquiryMessageAuthor")
  postAcks             PostAck[]
  postReads            PostRead[]
  meetingBookings      MeetingBooking[]
  feePaymentsMade      FeePayment[]              @relation("FeePayer")
  feePaymentsTaken     FeePayment[]              @relation("FeeCollector")
  feePaymentsConfirmed FeePayment[]              @relation("FeeConfirmer")
  feePaymentsReversed  FeePayment[]              @relation("FeeReverser")
  feeConcessionsGiven  FeeConcession[]           @relation("FeeConcessionGranter")
  feeRefundsRequested  FeeRefund[]               @relation("FeeRefundRequester")
  outboundMessages     OutboundMessage[]         @relation("MessageRecipient")
  broadcastsSent       Broadcast[]               @relation("BroadcastAuthor")
  applications         Application[]             @relation("ApplicationApplicant")
  joinRequests         JoinRequest[]             @relation("JoinRequester")
  guardianClaims       GuardianClaim[]           @relation("GuardianClaimant")
  contributions        QuestionContribution[]    @relation("ContributionAuthor")
  gigEarnings          GigEarning[]              @relation("GigEarner")
  gigPaymentsReceived  GigPayment[]              @relation("GigPaymentPayee")
  gigPayee             GigPayee?
  gigSlots             GigSlot[]                 @relation("GigSlotProvider")
  gigSeries GigSeries[] @relation("GigSeriesProvider")
  payoutAccount        ExpertPayoutAccount?      @relation("ExpertPayoutAccountOwner")
  seatPaymentsMade     SessionPayment[]          @relation("SessionPaymentPayer")
  seatPaymentsEarned   SessionPayment[]          @relation("SessionPaymentExpert")
  expertPayouts        ExpertPayout[]            @relation("ExpertPayoutOwner")
  gigInvoices          GigInvoice[]              @relation("GigInvoiceBuyer")

  /// Two-step sign-in (TOTP, RFC 6238), for the office, the head and the
  /// operator. The secret is sealed under FEES_SECRET_KEY and bound to
  /// `${userId}:totp` (src/lib/secret-box.ts); a secret being set up waits in
  /// totpPendingEnc until one code confirms it and is never used to sign in.
  /// Recovery codes are kept as sha256 hashes and each is spent once.
  /// totpLastStep is the thirty-second step of the last code accepted, so the
  /// same code cannot be replayed inside its window.
  totpSecretEnc       String?
  totpPendingEnc      String?
  totpEnabledAt       DateTime?
  totpRecoveryHashes  String[]             @default([])
  totpLastStep        Int?
  twoFactorChallenges TwoFactorChallenge[]

  /// The companies a recruiter is bound to (placement, 4 Oct 2026).
  companyRecruiters CompanyRecruiter[] @relation("CompanyRecruiterOf")

  @@index([email])
  // A foreign key to User needs its own index, or deleting a person scans this table once per row (found by the fleet load test).
  @@index([mergedIntoUserId])
}

