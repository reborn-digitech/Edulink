model School {
  id           String  @id @default(cuid())
  name         String
  slug         String  @unique
  code         String  @unique // human-shareable join code, e.g. RIVER-7X9K
  logoPath     String?
  addressLine  String?
  city         String?
  region       String?
  postalCode   String?
  country      String?
  contactEmail String
  contactPhone String?
  website      String?
  gradeLow     String? // "K", "1", ... free-form: grade naming is not universal
  gradeHigh    String?
  brandPrimary String? // hex, overrides role accent when set
  timezone     String  @default("UTC") // IANA zone; all date-keys resolve against this
  locale       String  @default("en")
  /// THE ACCREDITATION BENCHMARKS SIGNED (G4-15, risks batch 5 Oct 2026): the platform's NAAC benchmarks and NIRF
  /// bands are its own reading, so every figure built on them reads "provisional" until the college's IQAC coordinator
  /// signs the list. The version is iqac-rules.ts `benchmarkListVersion()` at the signing: a changed list is unsigned
  /// again. One writer: iqac-benchmarks.ts `signBenchmarks` (audited iqac.benchmarks.sign).
  benchmarksSignedVersion  String?
  benchmarksSignedAt       DateTime?
  benchmarksSignedByUserId String?

  /// The school's face in the cross-school directory. NULL means invisible
  /// there — publishing is an explicit admin act, never a side effect of
  /// registering, because appearing in a list every parent on the platform
  /// can browse is a decision the school makes, not one made for it.
  /// Publishing REQUIRES an admissions contact (enforced in school-profile.ts):
  /// a profile with nobody behind it invites enquiries into a void.
  profilePublishedAt            DateTime?
  /// The school's own words on its profile page. Plain text.
  profileAbout                  String    @default("")
  /// Where a parent's admissions enquiry lands: an ACTIVE ADMIN, PRINCIPAL or
  /// TEACHER membership of this school. Named by the school, usually from the
  /// setup checklist. SetNull so ending that person's membership can never
  /// block ending it — the enquiry machinery falls back to the admins.
  admissionsContactMembershipId String?

  // Setup checklist progress. JSON: { "inviteTeachers": true, ... }
  onboardingState String @default("{}")

  /// Notification housekeeping, per school. Null means the platform default
  /// (90 / 365 — see notification-housekeeping.ts). A school that wants a
  /// shorter memory or a longer one sets its own; the tidy applies each
  /// school's numbers to that school's notices and the defaults to the rest.
  notifAutoReadDays Int?
  notifExpireDays   Int?
  // Privacy defaults applied to new members. JSON.
  privacyDefaults   String @default("{}")

  /// Fees. The school's own UPI id and the payee name a parent's UPI app
  /// shows — the gateway-free way to pay, confirmed by the office against the
  /// bank statement. Null means the school does not take UPI directly.
  feeUpiId    String?
  feeUpiPayee String?

  /// Gigs (decision 0004): the school lets its teachers offer free one-to-one guidance to its own pupils.
  teacherGuidanceOn Boolean @default(false)
  /// The receipt serial's prefix: "RCPT/2026-27/000123". Per school, so a
  /// school moving from paper keeps the series its auditor knows.
  feeReceiptPrefix  String  @default("RCPT")
  /// Printed at the foot of every receipt and shown to a parent paying by
  /// bank transfer — the account name, number and IFSC, in the school's words.
  feeBankNote       String?

  /// Texts to families. Off until the office switches each channel on; the
  /// server also needs a transport (SMS_TRANSPORT / WHATSAPP_TRANSPORT), and a
  /// message goes only to a guardian who has a number and has not opted out.
  msgSmsEnabled         Boolean @default(false)
  msgWhatsappEnabled    Boolean @default(false)
  /// Messages per calendar month, both channels together; the school's
  /// spending brake. A text past the cap is recorded SKIPPED, not lost silently.
  msgMonthlyCap         Int     @default(2000)
  /// Staff attendance: the minute of the day (in School.timezone) the staff
  /// day starts, and the grace after it before a self check-in counts as
  /// late. 540 is 09:00.
  staffCheckInMinute    Int     @default(540)
  staffLateGraceMinutes Int     @default(15)
  /// The school's teaching week as weekday numbers (0 = Sunday … 6 = Saturday),
  /// comma-separated in order. Monday to Saturday by default, the Indian norm;
  /// a five-day school drops the 6. Read through school-week.ts.
  teachingDays          String  @default("1,2,3,4,5,6")
  /// The report card's rules, one JSON document read through report-card-config.ts:
  /// the grading scale (board bands), the co-scholastic areas and their scale,
  /// the weight of each exam kind inside a term, and the printed layout. Null
  /// means the defaults; a card snapshots the document it was built with.
  reportCardConfig      String?

  /// FILINGS: what the UDISE+ portal and the board know the school as. The
  /// eleven-digit UDISE code, the board (CBSE, CISCE, a state board), its
  /// affiliation or index number, the district and block the portal files
  /// the school under, the medium of instruction, and the management type
  /// in the portal's own words. All optional; the exports name what is blank.
  udiseCode         String?
  board             String?
  affiliationNumber String?
  district          String?
  block             String?
  medium            String?
  managementType    String?
  /// Which automatic events may text: JSON { absence, feeReminders, feeReceipts, circulars }. Missing = on.
  msgEventsJson     String  @default("{}")
  /// Fees for the pupil's own eyes: from this age (by the date of birth on
  /// the account) a pupil may read their dues, what is paid and the next due
  /// date — never a way to pay. Null means pupils see no fees at all.
  pupilFeeViewAge   Int?

  /// From this age (by the date of birth on the account) a pupil may read
  /// their own health card and incident log, read-only; the office sets it.
  /// Null means never: a nine-year-old's screen is a classroom screen.
  selfReadAge Int?

  /// THE ASSISTANT'S HELPLINE SENTENCE (Phase B, 9 Oct 2026): named to a pupil whose question is
  /// about hurting themselves, beside the counsellor route (src/lib/assistant/refusals.ts). Null or
  /// blank names the national helpline (the dictionary's assistantService.helplineDefault). The
  /// office sets it on its assistant card; the assistant itself is the ASSISTANT module, not a column.
  helplineText String?

  /// TEXTS TO THE NUMBER THE OFFICE TYPED. Off, only a number its owner
  /// proved with a code (User.phone) is ever texted. On, an absence notice,
  /// a fee reminder or a circular may also go to the guardian phone on the
  /// pupil's record (PupilRecord.guardianPhone, unverified) when the guardian
  /// has no proved number — and a wrong number on the record texts a
  /// stranger, which is why it is the office's choice and every such send
  /// is audited "office-entered". Read in messaging.ts.
  textOfficePhones Boolean @default(false)

  verifiedAt DateTime?

  /// REMOVED, NOT DELETED. Set when the operator takes the school off the
  /// installation. A hard delete would cascade through SchoolRecord and erase
  /// every leaving certificate the school ever issued — the one document a
  /// pupil carries away. Removal instead ends every membership through the same
  /// departure machinery an ordinary leaver goes through, so the children keep
  /// their accounts, their certificates and their portable records, exactly as
  /// alumni do.
  removedAt     DateTime?
  /// A school the tests and the sweeps make and destroy (the ZZ schools). It
  /// is a flag and not a name prefix so that the directories and the
  /// operator's default list can leave it out without reading names: a real
  /// school's Experts page once listed seven fixture experts (2026-10-01).
  isTestFixture Boolean   @default(false)

  /// WHAT KIND OF INSTITUTION (4 Oct 2026): SCHOOL (every row before that day),
  /// JUNIOR_COLLEGE (classes 11 and 12, run as the school version),
  /// COLLEGE or AUTONOMOUS_COLLEGE — INSTITUTION_KINDS in packages/contracts.
  /// A college is offered the college modules and roles; AUTONOMOUS_COLLEGE is
  /// the one switch the exams module reads (`isAutonomous` in lib/modules.ts).
  /// Set when the tenant is made (the operator's onboarding, self-registration).
  kind                  String    @default("SCHOOL")
  /// A college's profile, written by its office (lib/college-profile.ts) and
  /// read by the IQAC and filings builders; null for a school. Few on purpose:
  /// each college module keeps its own tables. naacGrade is NAAC_GRADES and
  /// nirfCategory NIRF_CATEGORIES (packages/contracts), never free text.
  affiliatingUniversity String?
  aisheCode             String?
  aicteApprovalRef      String?
  ugcApprovalRef        String?
  naacGrade             String?
  naacValidUntil        DateTime?
  nirfCategory          String?
  /// THE GLOBAL FEED'S KIND FILTER: a JSON array of the INSTITUTION_KINDS whose
  /// global posts this tenant's people read (the admin's "schools / colleges /
  /// both" on the feed settings page). Every kind by default.
  globalFeedKinds       String    @default("[\"SCHOOL\",\"JUNIOR_COLLEGE\",\"COLLEGE\",\"AUTONOMOUS_COLLEGE\"]")
  /// A COLLEGE'S STREAMS (5 Oct 2026): a JSON array of STREAMS codes
  /// (packages/contracts v1/streams.ts), chosen with the kind at onboarding and
  /// changed by the registrar on the college profile (audited
  /// college.streams.set); empty for a school and a junior college. What the
  /// college starts with and is offered — modules, regulators, filings,
  /// duties, its homes' tiles — is the union of the streams' presets
  /// (lib/streams.ts).
  streamsJson           String    @default("[]")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

