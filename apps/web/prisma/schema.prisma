/// A commission partner: somebody who brings schools to the platform and is
/// owed a share of what those schools pay. Operator-only and school-less,
/// like Plan. `percentTenths` is the share as TENTHS OF A PERCENT — 125 is
/// 12.5 % — so it is an integer and 0–1000 covers 0–100 %; what is owed is
/// computed on read (percent × the plan's recorded price × the partner's
/// ACTIVE schools) and never stored: nothing here moves money (decision 0003).
model CommissionPartner {
  id            String   @id @default(cuid())
  name          String
  phone         String?
  email         String?
  percentTenths Int
  notes         String   @default("")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  schools School[]
}

