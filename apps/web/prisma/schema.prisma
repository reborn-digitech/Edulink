/// SOMEBODY ASKING TO JOIN, BEFORE ANYBODY HAS SAID YES.
///
/// A school's code and a class's code are printed on posters and photographed
/// off whiteboards, and a join used to put whoever typed one on the roll at
/// once, as an active pupil, with nobody's say-so. A code now makes THIS row
/// and nothing else: no membership, no enrolment, no stand-in guardian, no
/// sight of the school. The office decides a join by the school's code; the
/// class's teacher, or the office, one by a class's code. Approval is what
/// creates the membership, by the same steps the join used to take at once.
///
/// A separate table and not a PENDING membership, on purpose: hundreds of
/// queries read Membership and Enrollment for "who is on the roll", and a row
/// that is not there cannot be counted, listed, marked absent or billed by
/// one of them that forgot to ask about its status.
model JoinRequest {
  id       String  @id @default(cuid())
  schoolId String
  userId   String
  /// Set when the code was a class's: the class approval enrols them in.
  classId  String?
  /// SCHOOL | CLASS — which kind of code was typed, kept after a class is deleted.
  via      String
  status   String  @default("PENDING") // PENDING | APPROVED | DECLINED | EXPIRED

  createdAt             DateTime  @default(now())
  decidedAt             DateTime?
  decidedByMembershipId String?
  /// What the decider chose to tell the asker with a decline. The asker reads
  /// it; the audit log never holds it.
  declineReason         String?

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user   User   @relation("JoinRequester", fields: [userId], references: [id], onDelete: Cascade)
  class  Class? @relation(fields: [classId], references: [id], onDelete: SetNull)

  @@index([schoolId, status])
  @@index([userId])
  @@index([classId])
}

/// SOMEBODY ASKING TO BE A CHILD'S GUARDIAN, BEFORE ANYBODY HAS SAID YES.
///
/// The student code and the date of birth are both on paper that changes
/// hands, and a guardianship is the child's whole record. A right pair used
/// to make the guardianship at once and tell the family afterwards; it now
/// makes this row, and the guardianship is made when the office, or a
/// guardian the child already has, approves it.
///
/// A separate table for the reason JoinRequest is one: Guardianship is what
/// the row-level policies read to decide who may see a child's record, and a
/// claim must not be a row any of them could mistake for a guardian.
model GuardianClaim {
  id                  String @id @default(cuid())
  /// The child's school, for the office's queue and the tenant policy.
  schoolId            String
  studentMembershipId String
  claimantUserId      String
  relation            String @default("PARENT") // PARENT | GUARDIAN | OTHER
  status              String @default("PENDING") // PENDING | APPROVED | DECLINED | EXPIRED

  createdAt       DateTime  @default(now())
  decidedAt       DateTime?
  decidedByUserId String?
  /// What the decider chose to tell the claimant with a decline.
  declineReason   String?

  school   School     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student  Membership @relation("GuardianClaimStudent", fields: [studentMembershipId], references: [id], onDelete: Cascade)
  claimant User       @relation("GuardianClaimant", fields: [claimantUserId], references: [id], onDelete: Cascade)

  @@index([schoolId, status])
  @@index([studentMembershipId, status])
  @@index([claimantUserId])
}

model Guardianship {
  id                  String @id @default(cuid())
  parentUserId        String
  studentMembershipId String

  // The child's school, copied here on purpose. NOT a tenancy column — this
  // table is deliberately cross-school and carries no RLS policy — but the one
  // fact the session bootstrap needs before it can know which schools a parent
  // may see. Reading it through the `student` relation instead is a chicken and
  // egg: Membership IS policied, so with no tenant set yet the join returns null
  // and Prisma refuses a required relation that came back empty.
  studentSchoolId String
  relation        String @default("PARENT") // PARENT | GUARDIAN | OTHER
  status          String @default("ACTIVE") // PENDING | ACTIVE | REVOKED

  // Explicit, separately-recorded consents. (§6)
  consentSharingAt       DateTime?
  consentNotificationsAt DateTime?

  createdAt DateTime @default(now())

  parent  User       @relation("ParentGuardianships", fields: [parentUserId], references: [id], onDelete: Cascade)
  student Membership @relation("StudentGuardianships", fields: [studentMembershipId], references: [id], onDelete: Cascade)

  @@unique([parentUserId, studentMembershipId])
  @@index([studentMembershipId])
}

// ---------------------------------------------------------------------------
// Classes
// ---------------------------------------------------------------------------

model Class {
  id         String  @id @default(cuid())
  schoolId   String
  name       String
  subject    String?
  gradeLevel String?
  /// "A", "B", "Sunflower" — the section within a grade, when a school has them.
  ///
  /// NULLABLE, because plenty of schools do not. A village school with one Class
  /// 5 should not be made to invent a "5A", and a school with six sections
  /// should not have to encode them in the name and then parse them back out.
  section    String?
  room       String?
  color      String? // accent for the class card
  joinCode   String  @unique // student self-join code, also encoded in the room QR

  /// Stamped when a promotion moved this class's cohort on (promotion.ts).
  /// Not cleared until the class is archived or reused for a new year: while
  /// it stands, this is LAST year's class, and admitting a pupil into it
  /// deserves the warning the intake results now carry. The three-school
  /// simulation put a transferred child into exactly such a ghost class with
  /// nothing flagging it.
  promotedAt DateTime?

  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  school              School               @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  teachers            ClassTeacher[]
  attendanceCovers    AttendanceCover[]
  reportCards         ReportCard[]
  enrollments         Enrollment[]
  practiceAssignments PracticeAssignment[]
  attendance          AttendanceSession[]
  timetableSlots      TimetableSlot[]
  assignments         Assignment[]
  posts               Post[]
  gradeCategories     GradeCategory[]
  syllabusProgress    SyllabusProgress[]
  lessonPlans         LessonPlan[]
  joinRequests        JoinRequest[]

  /// A college division (4 Oct 2026): the programme and year this class is.
  division Division? @relation("DivisionOf")

  @@index([schoolId, archivedAt])
}

model ClassTeacher {
  id                  String @id @default(cuid())
  classId             String
  // Denormalised, like every other school-owned table. Derivable
  // through classId and deliberately not derived: it makes this table's
  // RLS policy the same one-line predicate as everywhere else.
  schoolId            String
  teacherMembershipId String
  role                String @default("LEAD") // LEAD | CO

  /// Whether this teacher may take THIS class's register.
  ///
  /// DEFAULTS TRUE, which is not the direction it first looks like it should
  /// go. Defaulting to false would be the tighter-sounding choice and would
  /// silently make every register in every existing school untakeable on the
  /// morning this shipped — a permission model that arrives by breaking the
  /// register is one that gets turned off. So the default is what was already
  /// true, and the admin's control is to withdraw it from the people who should
  /// not have it: a visiting music teacher attached to six classes does not mark
  /// six registers.
  canTakeAttendance Boolean @default(true)
  school            School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  class   Class      @relation(fields: [classId], references: [id], onDelete: Cascade)
  teacher Membership @relation(fields: [teacherMembershipId], references: [id], onDelete: Cascade)

  @@unique([classId, teacherMembershipId])
  @@index([teacherMembershipId])
  @@index([schoolId])
}

model Enrollment {
  id                  String    @id @default(cuid())
  classId             String
  // Denormalised, like every other school-owned table. Derivable
  // through classId and deliberately not derived: it makes this table's
  // RLS policy the same one-line predicate as everywhere else.
  schoolId            String
  studentMembershipId String
  status              String    @default("ACTIVE") // ACTIVE | REMOVED
  enrolledAt          DateTime  @default(now())
  removedAt           DateTime?
  /// The roll number the school assigned in this class, printed on the filing sheets in place of a counter.
  rollNumber          Int?
  /// REPEATING THE CLASS: held back at promotion, or said so by the office.
  /// The filing's "class studied in the previous year" was always this
  /// grade less one, so a repeater filed as promoted. A new enrolment
  /// starts false.
  repeating           Boolean   @default(false)
  school              School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  class   Class      @relation(fields: [classId], references: [id], onDelete: Cascade)
  student Membership @relation(fields: [studentMembershipId], references: [id], onDelete: Cascade)

  @@unique([classId, studentMembershipId])
  @@index([studentMembershipId])
  @@index([schoolId])
}

// ---------------------------------------------------------------------------
// Attendance
//
// `dateKey` is the school-local calendar date as YYYY-MM-DD and is the real
// identity of a session. Storing only a UTC instant would put a 19:00 class in
// Auckland on the wrong day, and DST transitions would silently merge or split
// sessions. The instant is kept alongside for ordering. (§10)
// ---------------------------------------------------------------------------

model AttendanceSession {
  id                  String    @id @default(cuid())
  schoolId            String
  classId             String
  dateKey             String // YYYY-MM-DD in School.timezone
  takenAt             DateTime  @default(now())
  takenByMembershipId String?
  finalizedAt         DateTime?
  note                String?

  school  School             @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  class   Class              @relation(fields: [classId], references: [id], onDelete: Cascade)
  takenBy Membership?        @relation("AttendanceTaker", fields: [takenByMembershipId], references: [id], onDelete: SetNull)
  records AttendanceRecord[]

  @@unique([classId, dateKey])
  @@index([schoolId, dateKey])
  @@index([takenByMembershipId])
}

/// A child's report card for a term, as the class teacher issued it.
///
/// A DOCUMENT, NOT A QUERY, and that is the whole design. The obvious build is a
/// page that recomputes the marks every time somebody opens it — which means the
/// card a parent read in December quietly says something different in March,
/// because a teacher corrected a typo in one assignment. A report card is a
/// statement made on a date by a named person. So everything on it is SNAPSHOT
/// at the moment it is generated, and publishing freezes it.
///
/// Regenerating a DRAFT replaces its contents; regenerating a PUBLISHED one does
/// nothing at all. To change a published card a teacher has to withdraw it
/// first, which is a deliberate, audited act rather than a side effect of
/// pressing "generate" again.
model ReportCard {
  id                  String  @id @default(cuid())
  schoolId            String
  classId             String
  studentMembershipId String
  academicYearId      String?
  /// The term the card reports, when built from one; its name is the title.
  termId              String?

  /// "Term 1", "Half-yearly 2026" — whatever the school calls it. Unique per
  /// child per class, so pressing generate twice updates rather than duplicates.
  title  String
  status String @default("DRAFT") // DRAFT | PUBLISHED

  /// The class teacher's words. The one part of the card that is not arithmetic.
  remark String?

  /// The window the attendance figures cover, snapshot with everything else so
  /// the card can say what it counted rather than leaving a reader to guess.
  fromDateKey String
  toDateKey   String

  attendancePresent Int @default(0)
  attendanceTotal   Int @default(0)

  /// Thousandths of a percent, like every other score here — floats drift on
  /// weighted averages exactly the way money does.
  overallPercentMilli Int?
  /// "points" or "weighted", carried through from `overallForStudent` so a
  /// reader is told which rule produced the number.
  gradingMethod       String  @default("points")
  /// The overall grade on the scale the card was built with, and the mean
  /// grade points across subjects (thousandths), when the scale carries points.
  overallLetter       String?
  gradePointsMilli    Int?
  /// The subject rows, JSON, SNAPSHOT: each subject's weighted percent, band
  /// and the parts (papers or terms) that made it, with the weights applied.
  subjects            String?
  /// The grading scale and the printed layout the card was built with, JSON,
  /// SNAPSHOT, so a later change to the school's rules never rewrites an
  /// issued document.
  scale               String?
  layout              String?

  /// The practice annexure: what the child's self-practice ladder looked like
  /// on the day the card was generated. JSON, SNAPSHOT like everything else on
  /// this document — the ladder keeps moving after the card is issued, and the
  /// card must not. Null on cards generated before the annexure existed, and
  /// the renderer treats null as "no annexure", not as "no practice".
  practice String?

  createdByMembershipId String?
  publishedAt           DateTime?
  /// The pupil's legal name as the published card printed it: set when the
  /// card is published, cleared when it is withdrawn to a draft. A draft
  /// reads the name of today.
  studentName           String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school    School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  class     Class            @relation(fields: [classId], references: [id], onDelete: Cascade)
  student   Membership       @relation("ReportCardStudent", fields: [studentMembershipId], references: [id], onDelete: Cascade)
  createdBy Membership?      @relation("ReportCardAuthor", fields: [createdByMembershipId], references: [id], onDelete: SetNull)
  term      Term?            @relation(fields: [termId], references: [id], onDelete: SetNull)
  items     ReportCardItem[]

  @@unique([classId, studentMembershipId, title])
  @@index([schoolId, classId, status])
  @@index([studentMembershipId, status])
  @@index([createdByMembershipId])
}

/// One assessment on a report card, as it stood when the card was made.
///
/// The title and the marks are COPIED rather than joined. An assignment renamed
/// or deleted after the card was issued must not change or empty a document a
/// parent already read — so `assignmentId` is kept for provenance only, and is
/// nulled rather than cascading if the assignment goes.
model ReportCardItem {
  id           String  @id @default(cuid())
  schoolId     String
  reportCardId String
  assignmentId String?

  title       String
  category    String?
  scoreMilli  Int?
  pointsMilli Int?
  /// Order the class teacher chose, so the card reads the way they built it.
  position    Int     @default(0)
  /// The paper's subject, so the card can group papers under it.
  subject     String?
  /// SCHOLASTIC (an exam paper) or CO_SCHOLASTIC (an area graded by the class
  /// teacher on the card itself, kept when the papers are regenerated).
  kind        String  @default("SCHOLASTIC")
  /// The grade awarded: a paper's band on the scale, or the co-scholastic grade.
  letter      String?
  /// A co-scholastic area's note from the class teacher.
  comment     String?

  school     School      @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  reportCard ReportCard  @relation(fields: [reportCardId], references: [id], onDelete: Cascade)
  assignment Assignment? @relation(fields: [assignmentId], references: [id], onDelete: SetNull)

  @@index([reportCardId])
  @@index([schoolId])
}

/// A member of staff asking to be away, and the principal's answer.
///
/// STAFF-ONLY BY CONSTRUCTION, not by a filter. The obvious implementation is a
/// Holiday row with kind = "LEAVE", which reuses the calendar for free — and
/// puts "Priya is on sick leave" on a calendar students and parents read. A
/// filter would fix that until somebody forgets it once. So leave lives in its
/// own table with its own policy, the staff calendar reads it directly, and
/// there is no filter to forget.
///
/// Date keys, inclusive both ends, like Holiday and AttendanceCover — "Monday to
/// Friday" is what a school says.
model LeaveRequest {
  id                  String @id @default(cuid())
  schoolId            String
  teacherMembershipId String

  fromDateKey String
  toDateKey   String
  kind        String @default("CASUAL") // CASUAL | SICK | UNPAID | OTHER
  reason      String

  status String @default("PENDING") // PENDING | APPROVED | DECLINED | CANCELLED

  /// Who the applicant suggests should cover their classes. A suggestion, not a
  /// decision: the principal may approve the leave and name somebody else, and
  /// the cover rows are written from what the PRINCIPAL chose.
  nominatedCoverMembershipId String?

  decidedByMembershipId String?
  decidedAt             DateTime?
  decisionNote          String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school    School      @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  teacher   Membership  @relation("LeaveApplicant", fields: [teacherMembershipId], references: [id], onDelete: Cascade)
  nominated Membership? @relation("LeaveNominee", fields: [nominatedCoverMembershipId], references: [id], onDelete: SetNull)
  decidedBy Membership? @relation("LeaveDecider", fields: [decidedByMembershipId], references: [id], onDelete: SetNull)

  @@index([schoolId, status, fromDateKey])
  @@index([teacherMembershipId])
  @@index([nominatedCoverMembershipId])
  @@index([decidedByMembershipId])
}

/// Somebody else may take this class's register, for these days.
///
/// THE FAILSAFE, and the shape of it is the design. A cover ADDS a person; it
/// never removes one. Making it a true reassignment reads better in a sentence
/// and is worse in a school: a teacher whose leave is cancelled, or who comes in
/// anyway, would find themselves locked out of their own register, and the
/// register is the thing that must happen. Nobody is ever harmed by two people
/// being able to mark it; a class is harmed by nobody being able to.
///
/// Date keys, not instants, and inclusive at both ends — the same rule as
/// Holiday, and for the same reason: "Monday to Friday" is what a school says,
/// and a timestamp would put a cover in the wrong day across a DST boundary.
model AttendanceCover {
  id                   String @id @default(cuid())
  schoolId             String
  classId              String
  coveringMembershipId String

  /// YYYY-MM-DD in the SCHOOL's timezone. Inclusive both ends.
  fromDateKey String
  toDateKey   String
  reason      String?

  createdByMembershipId String?
  /// Set when the cover was created by approving a leave request, so cancelling
  /// the leave can withdraw exactly the covers it caused and no others.
  leaveRequestId        String?

  createdAt DateTime @default(now())

  school    School      @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  class     Class       @relation(fields: [classId], references: [id], onDelete: Cascade)
  covering  Membership  @relation("AttendanceCovering", fields: [coveringMembershipId], references: [id], onDelete: Cascade)
  createdBy Membership? @relation("AttendanceCoverCreator", fields: [createdByMembershipId], references: [id], onDelete: SetNull)

  @@index([schoolId, classId, fromDateKey])
  @@index([coveringMembershipId])
  @@index([leaveRequestId])
  @@index([createdByMembershipId])
  @@index([classId])
}

model AttendanceRecord {
  id                  String  @id @default(cuid())
  sessionId           String
  schoolId            String
  studentMembershipId String
  status              String // PRESENT | LATE | ABSENT | EXCUSED
  note                String?

  // Idempotency key minted on the client before the row leaves the device.
  // A replayed background-sync batch must not double-write. (§6 offline)
  clientId String?

  markedAt  DateTime @default(now())
  updatedAt DateTime @updatedAt

  session AttendanceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  student Membership        @relation(fields: [studentMembershipId], references: [id], onDelete: Cascade)

  @@unique([sessionId, studentMembershipId])
  @@index([schoolId, studentMembershipId])
  @@index([clientId])
  @@index([studentMembershipId])
}

// ---------------------------------------------------------------------------
// The timetable
//
// TWO TABLES, AND THE SPLIT IS THE WHOLE DESIGN. `TimetablePeriod` is the
// school's day — the bells, shared by every class, set once. `TimetableSlot` is
// one lesson: this class, this weekday, this period, this subject, this teacher.
//
// Periods are school-wide rather than per-class because that is what a bell is.
// Per-class periods would let 5A's third lesson start at a different time from
// 5B's, which no school with one corridor can do — and would make "who is free
// at 11:15" a question with no answer, which is exactly the question the builder
// has to answer to stop a teacher being timetabled into two rooms at once.
// ---------------------------------------------------------------------------

/// One bell-to-bell stretch of the school day. School-wide.
///
/// TIMES ARE MINUTES FROM LOCAL MIDNIGHT, as integers. 08:30 is 510. Not a
/// DateTime, which would carry a meaningless date component that somebody would
/// eventually compare, and would shift by an hour twice a year in any zone with
/// DST — a bell does not move because the clocks did. Not a "08:30" string
/// either: comparing and ordering those works right up until a school types
/// "8:30". Integers sort, subtract and validate, and the only formatting rule
/// lives in one function. Same reasoning as `scoreMilli`. (§10)
///
/// BREAKS ARE PERIODS. Lunch and the morning break sit in this table with
/// kind = BREAK, rather than being gaps between periods. A gap cannot be
/// labelled, so a timetable rendered from gaps has an unexplained hole in the
/// middle of it; and a school that wants "Assembly" on the grid has nowhere to
/// put it. A BREAK period simply takes no slots.
model TimetablePeriod {
  id       String @id @default(cuid())
  schoolId String

  /// "Period 1", "Lunch", "Assembly" — whatever the school calls it.
  name String

  /// Minutes from local midnight, in School.timezone. 0–1439.
  startMinute Int
  /// Exclusive end, so 09:15–10:00 and 10:00–10:45 do not read as overlapping.
  endMinute   Int

  kind String @default("LESSON") // LESSON | BREAK

  /// Display order. Held explicitly rather than derived from startMinute so an
  /// admin can insert a period mid-list without every later one being renamed.
  position Int

  /// Retiring a period keeps the slots that pointed at it, the same way
  /// archiving a class keeps its register. Deleting one mid-year would silently
  /// take every lesson in that column with it.
  archivedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school School          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  slots  TimetableSlot[]

  @@index([schoolId, position])
}

/// One lesson on the weekly grid.
///
/// WEEKDAY IS 0=SUNDAY … 6=SATURDAY, which is `Date.getUTCDay()` and therefore
/// `weekdayOfKey()` in dates.ts. ISO's 1=Monday reads better in a timetable and
/// would mean a conversion at every boundary between this table and a date key;
/// one convention with an ugly Sunday beats two conventions with an off-by-one.
///
/// THE TEACHER IS NULLABLE, ON PURPOSE. An admin lays the grid out first —
/// "maths at period 1 on Monday" — and staffs it afterwards, which is the order
/// they described and the order a paper timetable is built in. Forcing a name
/// into every cell before any of them are decided makes the tool unusable on the
/// afternoon it is most needed. An unstaffed slot is shown loudly rather than
/// hidden.
///
/// TWO UNIQUE CONSTRAINTS, and the second is a safety property rather than
/// tidiness. `(classId, weekday, periodId)` says a class has one lesson at a
/// time. `(schoolId, weekday, periodId, teacherMembershipId)` says a TEACHER
/// does — nobody is in two rooms at 11:15. Postgres treats NULLs as distinct in
/// a unique index, so the second constraint does not collide across the many
/// slots that have no teacher yet, which is precisely the behaviour needed.
/// The application checks first and gives a message naming the clash; the
/// constraint is what holds when two admins press save at the same moment.
model TimetableSlot {
  id       String @id @default(cuid())
  schoolId String
  classId  String
  periodId String

  /// 0 = Sunday … 6 = Saturday. See the note above.
  weekday Int

  /// What is taught. Free text, like Class.subject — subject naming is not
  /// universal and a fixed list would be wrong in the second school to use it.
  subject String

  /// Null until the lesson is staffed.
  teacherMembershipId String?

  /// Overrides Class.room for this lesson — a lab, a field, the hall.
  room String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school        School          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  class         Class           @relation(fields: [classId], references: [id], onDelete: Cascade)
  period        TimetablePeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)
  teacher       Membership?     @relation("TimetableTeacher", fields: [teacherMembershipId], references: [id], onDelete: SetNull)
  substitutions Substitution[]

  @@unique([classId, weekday, periodId])
  @@unique([schoolId, weekday, periodId, teacherMembershipId])
  @@index([schoolId, teacherMembershipId, weekday])
  @@index([schoolId, classId])
  @@index([teacherMembershipId])
}

// ---------------------------------------------------------------------------
// Term exams — the date sheet, and the bridge into marks.
//
// AN EXAM IS NOT A NEW KIND OF MARK. The whole grading pipeline — Grade rows,
// category weights, report-card snapshots — already exists for assignments, so
// an exam paper IS an Assignment (category "Exam"), auto-created per class when
// a teacher first opens the marks grid for a slot. What these two tables add is
// the part schools actually lack digitally: the DATE SHEET — a named series
// ("Term 1"), per grade, with one dated slot per subject — published to pupils
// and families, and a marks-entry grid that fills the existing pipeline.
// ---------------------------------------------------------------------------

/// One named exam round for one grade: "Term 1", "Half-yearly 2026".
///
/// PER GRADE, NOT PER CLASS, because that is what a date sheet is — 5A and 5B
/// sit the same paper on the same morning. Classes come back into the picture
/// at marks entry, where each class gets its own auto-created Assignment per
/// slot, because marks are entered register-by-register.
///
/// Unpublished series are the admin's scratchpad; publishing puts the date
/// sheet in front of pupils and families. Marks entry works either way — a
/// school that never publishes still gets its grid.
model ExamSeries {
  id       String @id @default(cuid())
  schoolId String

  name       String
  /// Free text matching Class.gradeLevel, like every grade in this schema.
  gradeLevel String
  /// UNIT_TEST | MID_TERM | FINAL — what kind of round this is. The report
  /// card is built from these, and a reader should be told which weight of
  /// paper a mark came from without decoding the name.
  kind       String  @default("UNIT_TEST")
  /// The term this round reports into, when the school has terms.
  termId     String?

  publishedAt DateTime?
  archivedAt  DateTime?

  createdByMembershipId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school    School      @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  createdBy Membership? @relation("ExamSeriesAuthor", fields: [createdByMembershipId], references: [id], onDelete: SetNull)
  term      Term?       @relation(fields: [termId], references: [id], onDelete: SetNull)
  slots     ExamSlot[]

  @@unique([schoolId, gradeLevel, name])
  @@index([schoolId, gradeLevel])
  @@index([createdByMembershipId])
}

/// One subject's paper on the date sheet: what, when, out of how much.
///
/// Times are minutes from local midnight like TimetablePeriod, and nullable —
/// plenty of schools publish only the day. Max marks are thousandths
/// (`pointsMilli`) like every score in this codebase.
model ExamSlot {
  id       String @id @default(cuid())
  schoolId String
  seriesId String

  subject     String
  dateKey     String // YYYY-MM-DD in School.timezone
  startMinute Int?
  endMinute   Int?
  pointsMilli Int // max marks, thousandths: out of 80 -> 80000
  position    Int    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school      School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  series      ExamSeries   @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  assignments Assignment[]

  @@unique([seriesId, subject])
  @@index([schoolId, seriesId, dateKey])
}

// ---------------------------------------------------------------------------
// Assignments & grades
//
// Scores are integer thousandths of a point (`scoreMilli`). 87.5 -> 87500.
// Floats would drift on weighted-category averages exactly the way money does. (§10)
// ---------------------------------------------------------------------------

model Assignment {
  id                 String  @id @default(cuid())
  schoolId           String
  /// The class a school's work is set to; null on a college offering's work (an elective has no class).
  classId            String?
  authorMembershipId String
  /// HOMEWORK AT A COLLEGE (R-48, 5 Oct 2026): set to one CourseOffering, read by its REGISTERED
  /// students; exactly one of classId and offeringId is set (a CHECK in the migration). college-homework.ts.
  offeringId         String?

  title       String
  body        String  @default("")
  category    String? // "Homework", "Quiz" ... weighting lives on the class later
  /// THE SUBJECT THE WORK IS FOR (owner's item 1, 27 Oct 2026): free text matched to the class's
  /// timetable as exam marks are, stored as the timetable spells it; a subject teacher who reaches the
  /// class only through the timetable may tag only a subject they take there. Null on older work.
  subject     String?
  pointsMilli Int? // max score, thousandths
  attachments String  @default("[]") // JSON of {fileId,name,size,mime}[]
  rubric      String? // JSON
  /// THE TEACHER'S SWITCH FOR THE ASSISTANT (Phase B, 9 Oct 2026): a pupil's question matching this
  /// assignment gets a hint first; asked again in the same conversation it gets the worked answer
  /// while this is true (the default), and stays a hint when the teacher turns it off.
  assistantAnswers Boolean @default(true)

  dueAt       DateTime?
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  /// Set when this assignment IS one class's sitting of an exam-slot paper —
  /// the marks grid finds-or-creates it by (examSlotId, classId), and the
  /// unique constraint is what makes that idempotent under two teachers
  /// pressing save at once. Nulled, not cascaded, if the slot goes: entered
  /// marks outlive a date-sheet edit.
  examSlotId String?

  school          School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  class           Class?           @relation(fields: [classId], references: [id], onDelete: Cascade)
  offering        CourseOffering?  @relation(fields: [offeringId], references: [id], onDelete: Cascade)
  author          Membership       @relation(fields: [authorMembershipId], references: [id], onDelete: Cascade)
  examSlot        ExamSlot?        @relation(fields: [examSlotId], references: [id], onDelete: SetNull)
  submissions     Submission[]
  grades          Grade[]
  reportCardItems ReportCardItem[]

  // ⚠ PROVENANCE: on the original dev database this unique index was created
  // BY HAND — `CREATE UNIQUE INDEX "Assignment_examSlotId_classId_key" …` via
  // `prisma db execute` on the admin connection — because adding a unique to a
  // populated table made `db push` demand --accept-data-loss it did not need.
  // The name matches what Prisma generates, so `db push` has reported in-sync
  // ever since. A from-scratch database gets it from this line the normal way;
  // nothing to do. If `db push` ever claims this index is missing on a database
  // that visibly has it, check the name before believing either of them.
  @@unique([examSlotId, classId])
  @@index([schoolId, dueAt])
  @@index([classId, publishedAt])
  @@index([offeringId, publishedAt])
  @@index([authorMembershipId])
}

model Submission {
  id                  String @id @default(cuid())
  schoolId            String
  assignmentId        String
  studentMembershipId String

  body        String    @default("")
  attachments String    @default("[]")
  status      String    @default("DRAFT") // DRAFT | SUBMITTED | RETURNED
  submittedAt DateTime?
  updatedAt   DateTime  @updatedAt

  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student    Membership @relation(fields: [studentMembershipId], references: [id], onDelete: Cascade)
  grade      Grade?

  @@unique([assignmentId, studentMembershipId])
  @@index([schoolId, status])
  @@index([studentMembershipId])
}

/// How a class weights its categories of work: Homework 20%, Exam 50%, and so on.
///
/// `name` MATCHES `Assignment.category`, which is a free-text string a teacher
/// types. That is a join on text and it is deliberate: categories existed as
/// strings on assignments long before weights did, and a foreign key here would
/// mean either migrating every existing assignment or refusing to weight the
/// ones already written. The cost is that renaming a category orphans the work
/// filed under the old name — so `weightedPercent` counts orphaned work and
/// hands the number back rather than letting it vanish from the total.
///
/// WEIGHTS ARE BASIS POINTS, 10000 = 100%, integers like every other number in
/// this codebase. Percent-as-integer would make three equal categories
/// impossible to express without one of them silently carrying the rounding.
///
/// A set that does not total exactly 10000 is treated as ABSENT, not applied as
/// written — see `weightsAreUsable`. A half-entered set must not quietly put a
/// whole class on a scale nobody chose.
model GradeCategory {
  id       String @id @default(cuid())
  schoolId String
  classId  String

  /// Matches Assignment.category, exactly and case-sensitively.
  name      String
  /// 10000 = 100%. Zero means "track it, do not count it".
  weightBps Int    @default(0)
  position  Int    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  class  Class  @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@unique([classId, name])
  @@index([schoolId, classId, position])
}

/// One school's decision to hide one global post from its own people.
///
/// PER SCHOOL, and that is the entire point. There is no role in this app above
/// a school — ROLES is ADMIN, TEACHER, STUDENT, PARENT and all four are scoped
/// to one — so there is nobody who could moderate the global feed on everyone's
/// behalf. Rather than invent that actor, each school gets a veto over what its
/// OWN people see, and no school can affect what another school sees.
///
/// It is tenant-scoped like everything else, so Riverside hiding a post is
/// invisible to Oakfield in the strict sense: the row is behind Riverside's RLS
/// predicate and Oakfield cannot read it, let alone act on it.
///
/// Deleting the hide un-hides. There is no "hidden forever" state to get stuck
/// in, and no separate audit of un-hiding beyond the ordinary audit log.
model GlobalPostHide {
  id       String @id @default(cuid())
  schoolId String
  postId   String

  hiddenByMembershipId String?
  reason               String?
  createdAt            DateTime @default(now())

  school School      @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  post   Post        @relation(fields: [postId], references: [id], onDelete: Cascade)
  hider  Membership? @relation("GlobalPostHider", fields: [hiddenByMembershipId], references: [id], onDelete: SetNull)

  @@unique([schoolId, postId])
  @@index([schoolId])
  @@index([hiddenByMembershipId])
}

model Grade {
  id                  String  @id @default(cuid())
  schoolId            String
  assignmentId        String
  studentMembershipId String
  submissionId        String? @unique

  scoreMilli           Int?
  letter               String?
  comment              String?
  gradedByMembershipId String?
  gradedAt             DateTime @default(now())
  updatedAt            DateTime @updatedAt

  assignment Assignment  @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student    Membership  @relation("GradeStudent", fields: [studentMembershipId], references: [id], onDelete: Cascade)
  grader     Membership? @relation("GradeGrader", fields: [gradedByMembershipId], references: [id], onDelete: SetNull)
  submission Submission? @relation(fields: [submissionId], references: [id], onDelete: SetNull)

  @@unique([assignmentId, studentMembershipId])
  @@index([schoolId, studentMembershipId])
  @@index([studentMembershipId])
  @@index([gradedByMembershipId])
}

// ---------------------------------------------------------------------------
// Remarks — private teacher <-> guardian threads about one student.
// ---------------------------------------------------------------------------

model RemarkThread {
  id                  String @id @default(cuid())
  schoolId            String
  studentMembershipId String
  teacherMembershipId String

  subject       String
  createdAt     DateTime  @default(now())
  lastMessageAt DateTime  @default(now())
  closedAt      DateTime?

  school   School          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student  Membership      @relation("RemarkStudent", fields: [studentMembershipId], references: [id], onDelete: Cascade)
  teacher  Membership      @relation("RemarkTeacher", fields: [teacherMembershipId], references: [id], onDelete: Cascade)
  messages RemarkMessage[]

  @@index([schoolId, lastMessageAt])
  @@index([studentMembershipId])
  @@index([teacherMembershipId])
}

model RemarkMessage {
  id           String   @id @default(cuid())
  threadId     String
  // Denormalised, like every other school-owned table. Derivable
  // through threadId and deliberately not derived: it makes this table's
  // RLS policy the same one-line predicate as everywhere else.
  schoolId     String
  authorUserId String
  body         String
  createdAt    DateTime @default(now())
  readBy       String   @default("[]") // JSON userId[]
  school       School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  thread RemarkThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  author User         @relation(fields: [authorUserId], references: [id], onDelete: Cascade)

  @@index([threadId, createdAt])
  @@index([schoolId])
  // A foreign key to User needs its own index, or deleting a person scans this table once per row (found by the fleet load test).
  @@index([authorUserId])
}

// ---------------------------------------------------------------------------
// Parent–teacher meetings — slots a teacher publishes, bookings a family makes.
//
// The shape is ExpertSlot/ExpertBooking's, reused deliberately: an open window
// owned by one person, and a booking row that claims it with a database-level
// @unique rather than an application check, so two parents tapping the same
// slot at the same moment cannot both get it.
// ---------------------------------------------------------------------------

/// One window in which a teacher will sit down with one family.
model MeetingSlot {
  id                  String @id @default(cuid())
  schoolId            String
  teacherMembershipId String

  startsAt DateTime
  endsAt   DateTime
  /// "Room 4", "the office", "phone call" — where to turn up.
  location String?
  note     String?

  /// Cancelling keeps the row so a family who saw the slot can be shown WHY it
  /// went, rather than watching it vanish.
  cancelledAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school  School          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  teacher Membership      @relation("MeetingTeacher", fields: [teacherMembershipId], references: [id], onDelete: Cascade)
  booking MeetingBooking?

  @@index([schoolId, teacherMembershipId, startsAt])
  @@index([schoolId, startsAt])
  @@index([teacherMembershipId])
}

/// One family's claim on one slot, about one child.
///
/// The parent is a USER (guardians have no membership); the child is named so
/// a teacher with thirty families knows which conversation this is, and so a
/// parent with two children at the school can book twice without ambiguity.
model MeetingBooking {
  id                  String @id @default(cuid())
  schoolId            String
  /// One booking per slot, enforced by the database rather than by a check.
  slotId              String @unique
  studentMembershipId String
  parentUserId        String

  /// What the parent wants to talk about. Optional — "just checking in" is a
  /// fine reason to meet.
  note String?

  cancelledAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school  School      @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  slot    MeetingSlot @relation(fields: [slotId], references: [id], onDelete: Cascade)
  student Membership  @relation("MeetingStudent", fields: [studentMembershipId], references: [id], onDelete: Cascade)
  parent  User        @relation(fields: [parentUserId], references: [id], onDelete: Cascade)

  @@index([schoolId, parentUserId])
  @@index([studentMembershipId])
  // A foreign key to User needs its own index, or deleting a person scans this table once per row (found by the fleet load test).
  @@index([parentUserId])
}

// ---------------------------------------------------------------------------
// Bulletin + global feed
// ---------------------------------------------------------------------------

model Post {
  id                 String  @id @default(cuid())
  schoolId           String? // null only for GLOBAL posts by external organizers
  classId            String?
  authorUserId       String
  authorMembershipId String?

  scope String // CLASS | SCHOOL | GLOBAL
  title String
  body  String @default("")
  media String @default("[]") // JSON of {fileId,alt,kind}[] — alt is required at write time
  tags  String @default("[]")

  /// One of POST_CATEGORIES: PEOPLE | CAMPUS | EVENTS | LEARNING | UPDATES.
  /// Defaulted to UPDATES because every post written before categories existed
  /// was an announcement — which is what UPDATES means.
  category String @default("UPDATES")
  /// The typeface the post is set in, by the web's key (src/lib/fonts.ts); "default" is the reader's own.
  font     String @default("default")

  /// Who a SCHOOL post is FOR: everyone, only families, only staff, or only
  /// pupils. A courtesy filter applied at QUERY time, never a secrecy boundary —
  /// RLS still shows the row to the whole school, and the feed simply leaves it
  /// out for people it does not concern. Making it secrecy would mean a policy
  /// per audience, and "Grade 5 parents must not know sports day moved" is not
  /// a secret any school keeps.
  audience         String    @default("ALL") // ALL | PARENTS | TEACHERS | STUDENTS
  /// Narrows a SCHOOL post to one grade's pupils and their families. Free text
  /// matching Class.gradeLevel, like every grade in this schema.
  audienceGrade    String?
  /// A COLLEGE NOTICE'S TARGET (4 Oct 2026): JSON { kind: PROGRAMME | DEPARTMENT |
  /// DIVISION | BATCH, id } narrowing a SCHOOL post to one programme's, department's,
  /// division's or intake year's students and their consented families. A courtesy
  /// filter like `audience`, never a secrecy boundary.
  audienceTarget   String?
  /// The author wants a "seen and understood" tap from each reader. What makes
  /// a notice a circular: the school can finally answer "did this reach anyone".
  requiresAck      Boolean   @default(false)
  /// A PERMISSION SLIP (5 Oct 2026): a circular that asks each child's family a yes-or-no question (a trip, an
  /// event), answered per child (PostConsent) until `consentBy`, a day key. Null on everything else.
  consentQuestion  String?
  consentBy        String?
  /// A circular's delivery: queued at publish, done when every reader in its
  /// audience has been told (push, and a text where the school allows), and
  /// the last time the outstanding families were chased. Null on a plain post.
  deliveryQueuedAt DateTime?
  deliveredAt      DateTime?
  remindedAt       DateTime?
  remindCount      Int       @default(0)

  /// The publishing school's NAME, copied here when a post goes global.
  ///
  /// Denormalised because the relation is unreadable across the boundary: the
  /// global clause lets another school read the POST, and School's own policy
  /// still — correctly — hides the school row. Joining gave every reader outside
  /// the publishing school "Unknown school", which is worse than useless on a
  /// feed whose entire safety story is "you can always see who published this".
  ///
  /// Widening School's policy was the alternative and is worse: it would expose
  /// school rows to every tenant to solve a display problem. A snapshot also
  /// behaves correctly on rename — the post keeps the name it was published
  /// under, which is what provenance means.
  globalSchoolName String?
  /// The publishing institution's KIND, stamped beside its name at publish for
  /// the same reason (4 Oct 2026): the feed's kind filter reads it from a post
  /// whose School row the reader cannot. Null on posts published before it,
  /// which were all schools'.
  globalSchoolKind String?

  /// A STUDENT COUNCIL NOTICE (risks batch 5A, 5 Oct 2026; council-notices.ts): the council it is published as.
  /// Set only with category COUNCIL, by a council member or the office; the feed names the council, not the
  /// writer, to readers (the review desk still sees who wrote it). Nulled if the council is removed.
  authorCommitteeId String?

  status                 String    @default("PENDING") // DRAFT | PENDING | APPROVED | REJECTED | TAKEN_DOWN (the platform's; see PlatformTakedown)
  rejectionReason        String?
  reviewedByMembershipId String?
  reviewedAt             DateTime?
  pinnedAt               DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school     School?     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  class      Class?      @relation(fields: [classId], references: [id], onDelete: Cascade)
  author     User        @relation(fields: [authorUserId], references: [id], onDelete: Cascade)
  authorship Membership? @relation("PostAuthorMembership", fields: [authorMembershipId], references: [id], onDelete: SetNull)
  authorCommittee Committee? @relation("CouncilNotices", fields: [authorCommitteeId], references: [id], onDelete: SetNull)
  reviewer   Membership? @relation("PostReviewer", fields: [reviewedByMembershipId], references: [id], onDelete: SetNull)

  comments    Comment[]
  globalHides GlobalPostHide[]
  /// The platform's take-down of a GLOBAL post, when status is TAKEN_DOWN.
  takedown    PlatformTakedown?
  reactions   Reaction[]
  acks        PostAck[]
  reads       PostRead[]
  consents    PostConsent[]

  @@index([schoolId, status, createdAt])
  @@index([scope, status, createdAt])
  @@index([classId, status])
  // A foreign key to User needs its own index, or deleting a person scans this table once per row (found by the fleet load test).
  @@index([authorUserId])
  @@index([reviewedByMembershipId])
  @@index([authorMembershipId])
}

model Comment {
  id           String   @id @default(cuid())
  postId       String
  // Denormalised, like every other school-owned table. Derivable
  // through postId and deliberately not derived: it makes this table's
  // RLS policy the same one-line predicate as everywhere else.
  schoolId     String
  authorUserId String
  body         String
  status       String   @default("APPROVED") // PENDING | APPROVED | REMOVED
  createdAt    DateTime @default(now())
  school       School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  /// Set on a reply, null on a top-level comment. ONE LEVEL DEEP by rule:
  /// `addComment` re-points a reply-to-a-reply at the thread's top comment,
  /// so this never chains — a school post's discussion is a list of comments
  /// each with its answers, not a forum tree nobody can moderate at a glance.
  parentCommentId String?
  parent          Comment?  @relation("CommentThread", fields: [parentCommentId], references: [id], onDelete: Cascade)
  replies         Comment[] @relation("CommentThread")

  post   Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorUserId], references: [id], onDelete: Cascade)

  @@index([postId, createdAt])
  @@index([parentCommentId])
  @@index([schoolId])
  // A foreign key to User needs its own index, or deleting a person scans this table once per row (found by the fleet load test).
  @@index([authorUserId])
}

model Reaction {
  id        String   @id @default(cuid())
  postId    String
  // Denormalised, like every other school-owned table. Derivable
  // through postId and deliberately not derived: it makes this table's
  // RLS policy the same one-line predicate as everywhere else.
  schoolId  String
  userId    String
  kind      String // fixed kid-safe set: CLAP | STAR | IDEA | HEART
  createdAt DateTime @default(now())
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId, kind])
  @@index([schoolId])
  // A foreign key to User needs its own index, or deleting a person scans this table once per row (found by the fleet load test).
  @@index([userId])
}

/// One person's "seen and understood" on one circular.
///
/// KEYED BY USER, NOT MEMBERSHIP, because the reader a circular most needs to
/// reach — a parent — has no membership at all; they reach the school through
/// Guardianship. A userId covers every reader with one shape.
///
/// An ack is append-only in spirit: there is no "un-acknowledge", because the
/// question the school is asking is "did this ever reach you", and the answer
/// to that cannot become no again. Deleting the post takes its acks with it.
model PostAck {
  id       String @id @default(cuid())
  postId   String
  // Denormalised, like Comment and Reaction on the same post: it makes this
  // table's RLS policy the same one-line predicate as everywhere else.
  schoolId String
  userId   String

  createdAt DateTime @default(now())

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([schoolId])
  // A foreign key to User needs its own index, or deleting a person scans this table once per row (found by the fleet load test).
  @@index([userId])
}

/// A reader opened the circular: "seen", between "told" and "acknowledged".
/// One row per reader per post, written when the post is read on the web or
/// the phone; keyed by user for the same reason PostAck is. What it answers
/// is the office's question — did the notice reach the family at all — not
/// how long anyone spent on it.
model PostRead {
  id        String   @id @default(cuid())
  postId    String
  schoolId  String
  userId    String
  createdAt DateTime @default(now())

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([schoolId])
  @@index([userId])
}

/// A family's yes or no to a permission slip (5 Oct 2026), one per child per
/// circular: any of the child's guardians may answer, and change it until the
/// circular's `consentBy` day; the last answer stands and says who gave it. A
/// pupil's own answer is never asked. Keyed by the child so a family with two
/// children in the audience answers for each.
model PostConsent {
  id                  String   @id @default(cuid())
  postId              String
  schoolId            String
  studentMembershipId String
  answeredByUserId    String
  /// YES | NO
  answer              String
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([postId, studentMembershipId])
  @@index([schoolId])
  @@index([studentMembershipId])
}

model Report {
  id             String    @id @default(cuid())
  schoolId       String?
  targetType     String // POST | COMMENT | USER
  targetId       String
  reporterUserId String
  reason         String
  detail         String?
  status         String    @default("OPEN") // OPEN | ACTIONED | DISMISSED
  resolvedAt     DateTime?
  resolutionNote String?
  createdAt      DateTime  @default(now())

  school   School? @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  reporter User    @relation("ReportsFiled", fields: [reporterUserId], references: [id], onDelete: Cascade)

  @@index([schoolId, status])
  @@index([targetType, targetId])
  // A foreign key to User needs its own index, or deleting a person scans this table once per row (found by the fleet load test).
  @@index([reporterUserId])
}

// ---------------------------------------------------------------------------
// Competitions
// ---------------------------------------------------------------------------

model Competition {
  id                String  @id @default(cuid())
  organizerSchoolId String?
  organizerName     String
  title             String
  summary           String
  body              String  @default("")
  subject           String?
  gradeLow          String?
  gradeHigh         String?

  eligibility String?
  rules       String?
  prizes      String?
  externalUrl String?

  registrationOpensAt  DateTime?
  registrationClosesAt DateTime?
  startsAt             DateTime?
  endsAt               DateTime?

  status                String  @default("DRAFT") // DRAFT | PUBLISHED | ARCHIVED
  verified              Boolean @default(false)
  leaderboardEnabled    Boolean @default(false)
  requiresParentConsent Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// CASCADE, not SetNull: a school's own competition is the school's, and
  /// when the school goes the competition goes with it. SetNull turned a
  /// deleted test school's competitions into platform-wide ones that every
  /// school on the server could see and enter.
  organizerSchool School?               @relation(fields: [organizerSchoolId], references: [id], onDelete: Cascade)
  entries         CompetitionEntry[]
  standings       CompetitionStanding[]
  /// competitions-crawler (12 Oct 2026): where a competition suggested from the web came from, or the
  /// crawler's note on a hand-posted one it found again. Null for a competition the crawler never saw.
  crawl           CompetitionCrawl?

  // ---- college-content (competitions by audience, 12 October 2026) ----
  /// Who the competition is for: "SCHOOL" (with its class range, gradeLow/gradeHigh) | "COLLEGE" (with `streams`)
  /// (COMPETITION_AUDIENCES in packages/contracts v1/college-practice.ts). Null: not set yet, shown to both as
  /// before, until the content team or the operator edits it. A tenant's list shows only what fits it
  /// (competitionFitsTenant): a school its SCHOOL ones, a college its COLLEGE ones of its streams (or of none).
  audience String?
  /// A COLLEGE competition's stream codes (STREAMS); empty: every college.
  streams  String[] @default([])
  // ---- end college-content ----

  // ---- competitions on the calendar (decision 0007, 6 November 2026) ----
  /// THE INTERNAL BOARD, chosen by the organising school's office when the calendar event is made
  /// (COMPETITION_INTERNAL_BOARDS in packages/contracts v1/contest.ts): "OFF" (no internal board),
  /// "STAFF" (the organising school's ADMIN, PRINCIPAL and TEACHER read the full board of the school's own
  /// entries: name, class, score, place), "SCHOOL" (staff read the full board; a pupil and a guardian of that
  /// school additionally read the pupil's own place and the top places by FIRST NAME and class). Every read is
  /// under the tenant fence and the person binding: the board is built from `CompetitionEntry`, which is the
  /// entrant's school's and policied, so it never shows one school another school's children, and a guardian
  /// reads only their own child's place, a pupil their own. The cross-school `CompetitionStanding` board and
  /// its rule (schools ranked, children never named across schools) are unchanged by this field. Meaningless on
  /// a platform competition (organizerSchoolId null), where it stays OFF.
  internalBoard String  @default("OFF") // OFF | STAFF | SCHOOL
  /// Whether pupils may enrol at all (the office's "enrolment on/off" on the calendar event). Off: the event is
  /// on the agenda and the detail page for information, and no entry can be made, whatever the dates say. The
  /// dates (registrationOpensAt/ClosesAt) still decide WHEN an open enrolment takes entries. True for every row
  /// that existed before 6 November 2026, which changes nothing for them.
  enrolmentOpen Boolean @default(true)
  /// The school calendar row this competition is the event of (Holiday.kind COMPETITION): the office makes the
  /// two together in one tenant transaction, edits them in step, and removing the event with entries archives
  /// the competition rather than deleting them (src/lib/competition-events.ts). Null for a platform
  /// competition and for one posted before 6 November 2026.
  calendarEntry Holiday?
  // ---- end competitions on the calendar ----

  @@index([status, registrationClosesAt])
  @@index([organizerSchoolId])
}

/// How one SCHOOL is doing in a competition. The cross-school surface.
///
/// THE CHILDREN ARE NOT IN THIS TABLE, AND THAT IS THE ENTIRE DESIGN. A ranking
/// across schools would otherwise be the first thing in this app to show one
/// school another school's children — which the README named as a decision
/// rather than a feature, and this is the decision: SCHOOLS ARE RANKED,
/// CHILDREN ARE NOT. Riverside can see that Oakfield entered nine pupils and
/// that their best place was third. It cannot learn one of their names, one of
/// their scores, or which nine.
///
/// DENORMALISED RATHER THAN COMPUTED ACROSS THE BOUNDARY, for the same reason
/// `Post.globalSchoolName` is: the rows an aggregate would have to read —
/// `CompetitionEntry` — are school-scoped by policy, and widening THAT to make a
/// leaderboard work would open every entrant's name and score to every school on
/// the server to solve a display problem. Instead each school maintains its own
/// one-row summary, recomputed from its own entries whenever a result is
/// recorded, and only the summary crosses.
///
/// WRITTEN EVEN WHEN THE LEADERBOARD IS OFF. The row is not the disclosure; the
/// POLICY is (see GLOBALLY_READABLE in scripts/gen-rls.ts, which opens it only
/// for competitions whose organiser has switched the leaderboard on). Keeping it
/// current regardless is what lets an organiser turn a leaderboard on in week
/// three and see true standings, rather than an empty board until every school
/// happens to re-enter a result.
///
/// `schoolName` is a SNAPSHOT, exactly like `Post.globalSchoolName` and for the
/// same two reasons: School's own policy correctly hides the school row from
/// other tenants, so a join renders "Unknown school" on the one page whose point
/// is naming who did what; and a school that renames itself keeps the name it
/// competed under.
model CompetitionStanding {
  id            String @id @default(cuid())
  competitionId String
  schoolId      String

  /// The name this school competed under. Snapshot — see above.
  schoolName String

  /// How many of this school's entries have a recorded result.
  ///
  /// Context for the place, and it is needed: a school placing fourth with one
  /// entrant and a school placing fourth with thirty have not done the same
  /// thing. A count of children is not a child.
  entrants Int @default(0)

  /// The best individual place this school achieved. Null when nobody was
  /// ranked — plenty of competitions score without placing.
  bestRank Int?

  /// The highest score any of this school's entries recorded, in thousandths.
  /// Integers, like every other score in this schema.
  bestScoreMilli Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  competition Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  school      School      @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([competitionId, schoolId])
  @@index([competitionId, bestRank])
  @@index([schoolId])
}

model CompetitionEntry {
  id                  String @id @default(cuid())
  competitionId       String
  studentMembershipId String
  schoolId            String

  status          String    @default("REGISTERED") // REGISTERED | SUBMITTED | RESULTS
  parentConsentAt DateTime?
  parentConsentBy String?
  submissionUrl   String?
  scoreMilli      Int?
  rank            Int?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  competition Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  student     Membership  @relation(fields: [studentMembershipId], references: [id], onDelete: Cascade)

  @@unique([competitionId, studentMembershipId])
  @@index([schoolId])
  @@index([studentMembershipId])
}

// ---------------------------------------------------------------------------
// Sessions, invites, tokens, notifications, audit
// ---------------------------------------------------------------------------

/// One external login bound to one EduLink account: "Google says this is
/// sub 118…" belongs to this User.
///
/// SSO SIGNS PEOPLE IN; IT NEVER SIGNS THEM UP. Accounts in a school system
/// come from invites, join codes and registration — an SSO-minted account
/// would be an orphan with no school and no roles, so an identity that
/// matches no existing account is refused with directions, not created.
///
/// THE SUBJECT IS THE KEY, THE EMAIL IS ONLY THE INTRODUCTION. First sign-in
/// links by verified email; every later sign-in matches (provider, subject),
/// so a family changing their Google address does not lose their account, and
/// a recycled email address cannot inherit somebody else's children. The email
/// column here is a snapshot of what the provider said at link time, kept for
/// the account page to display — never re-used for matching.
///
/// Not tenant-scoped: like AuthToken, it belongs to a user before any school
/// is chosen — resolving the school is what signing in is FOR.
model SsoIdentity {
  id       String @id @default(cuid())
  userId   String
  provider String // "google" | "microsoft" | "apple"
  /// The provider's stable `sub` claim.
  subject  String

  /// What the provider reported at link time. Display only — see above.
  email String?

  createdAt  DateTime @default(now())
  lastUsedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, subject])
  @@index([userId])
}

model Session {
  id        String @id @default(cuid())
  userId    String
  // sha256 of the opaque token. The raw token exists only in the cookie, so a
  // database leak does not hand over live sessions.
  tokenHash String @unique

  activeSchoolId String?
  activeRole     String?

  userAgent  String?
  ip         String?
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?

  user    User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// The phones that registered for push under this session (campaign PH-4).
  devices DeviceToken[]

  @@index([userId, revokedAt])
  /// The retention sweep finds expired rows by this alone.
  @@index([expiresAt])
}

model Invite {
  id                  String  @id @default(cuid())
  schoolId            String
  role                String // TEACHER | STUDENT | ADMIN | PRINCIPAL | PARENT
  email               String?
  name                String?
  classId             String?
  subjects            String? // JSON string[]
  /// For a PARENT invitation: the child it links to, and how. The office
  /// sends it from the pupil's directory row; accepting creates the
  /// guardianship, with consent, instead of a membership.
  studentMembershipId String?
  relation            String? // PARENT | GUARDIAN | OTHER

  tokenHash String @unique
  status    String @default("PENDING") // PENDING | ACCEPTED | REVOKED | EXPIRED

  createdByMembershipId String?
  acceptedByUserId      String?
  acceptedAt            DateTime?
  expiresAt             DateTime
  createdAt             DateTime  @default(now())

  school    School      @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  createdBy Membership? @relation("InviteCreator", fields: [createdByMembershipId], references: [id], onDelete: SetNull)

  @@index([schoolId, status])
  @@index([email])
  @@index([createdByMembershipId])
}

model AuthToken {
  id        String  @id @default(cuid())
  userId    String?
  email     String?
  purpose   String // MAGIC_LINK | EMAIL_VERIFY | PASSWORD_RESET | PARENT_CLAIM
  tokenHash String  @unique
  meta      String  @default("{}")
  // Wrong six-digit codes charged so far. A column and not a field in `meta`,
  // because the charge is one conditional UPDATE (attempts < cap) that a burst
  // of concurrent guesses cannot all pass — a read-then-written JSON count let
  // every guess in the burst see 0.
  attempts  Int     @default(0)

  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([email, purpose])
  @@index([expiresAt])
  // A foreign key to User needs its own index, or deleting a person scans this table once per row (found by the fleet load test).
  @@index([userId])
}

model Notification {
  id        String  @id @default(cuid())
  userId    String
  schoolId  String?
  kind      String // ATTENDANCE | GRADE | ASSIGNMENT | REMARK | POST | INVITE | SYSTEM
  title     String
  body      String  @default("")
  url       String?
  meta      String  @default("{}")
  /// The sentence's key and variables, kept beside the rendered text so a
  /// reader who changes language reads old notices in the new one. Null on
  /// rows written before the columns existed and on literal titles.
  titleKey  String?
  titleVars String  @default("{}")
  bodyKey   String?
  bodyVars  String  @default("{}")

  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
}

/// A phone registered for push through Expo's service: one row per device
/// token, beside the browser's PushSubscription. Dropped when the service
/// says the token is dead, or when the app asks on sign-out.
/// A file the API stored for a person and nobody has attached yet. The web
/// composes a post and its files in one multipart request, so a stored file
/// is always somebody's; the phone uploads first and composes later, and
/// without this row anyone who had SEEN a file id could put it in their own
/// post and hand their audience access to it (files.ts authorises a file by
/// the post that mentions it). The post endpoint spends the ticket.
model UploadTicket {
  id         String    @id @default(cuid())
  userId     String
  fileId     String    @unique
  mime       String
  size       Int
  createdAt  DateTime  @default(now())
  consumedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, consumedAt])
  @@index([consumedAt])
}

model DeviceToken {
  id            String   @id @default(cuid())
  userId        String
  expoPushToken String   @unique
  platform      String // ios | android
  device        String?
  failureCount  Int      @default(0)
  createdAt     DateTime @default(now())
  lastUsedAt    DateTime @default(now())
  /// The session the phone registered under (campaign PH-4): revoking that one
  /// session from the web removes the token, and a token whose session has
  /// ended or expired is not sent to. Null for a token registered before
  /// this column, which keeps the old behaviour until it next registers.
  sessionId     String?

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  session Session? @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([sessionId])
}

model PushSubscription {
  id       String @id @default(cuid())
  userId   String
  endpoint String @unique
  p256dh   String
  auth     String

  userAgent    String?
  failureCount Int      @default(0)
  createdAt    DateTime @default(now())
  lastUsedAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// A round of teacher reviews the ADMIN opens — ratings on a fixed
/// questionnaire, deliberately not free text: a child asked to "write about
/// your teacher" is being asked to do something no school should collect at
/// scale, while "how clearly do they explain, one to five" is answerable,
/// comparable, and translatable. The questions are code-side keys (see
/// REVIEW_QUESTIONS) so every reader rates the same thing in their own
/// language.
model ReviewRound {
  id       String @id @default(cuid())
  schoolId String

  /// Who is asked: STUDENTS | PARENTS | BOTH.
  audience String

  /// YYYY-MM-DD in the school's timezone, inclusive — the last day answers
  /// are accepted. Same date-key convention as Holiday and AttendanceCover.
  closesDateKey String

  status String @default("OPEN") // OPEN | CLOSED

  createdByMembershipId String?
  createdAt             DateTime @default(now())

  school    School      @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  createdBy Membership? @relation("ReviewRoundCreator", fields: [createdByMembershipId], references: [id], onDelete: SetNull)

  teachers  ReviewRoundTeacher[]
  responses ReviewResponse[]

  @@index([schoolId, status])
  @@index([createdByMembershipId])
}

/// Which teachers a round asks about. Explicit rows, not "everyone at open
/// time" — a teacher who joins mid-round was not part of the question.
/// Carries `schoolId` like every join table here: the RLS generator keys its
/// tenant policy on that column, and a row without one would sit outside the
/// fence entirely.
model ReviewRoundTeacher {
  id                  String @id @default(cuid())
  schoolId            String
  roundId             String
  teacherMembershipId String

  school  School      @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  round   ReviewRound @relation(fields: [roundId], references: [id], onDelete: Cascade)
  teacher Membership  @relation("ReviewedTeacher", fields: [teacherMembershipId], references: [id], onDelete: Cascade)

  @@unique([roundId, teacherMembershipId])
  @@index([teacherMembershipId])
  @@index([schoolId])
}

/// One person's ratings of one teacher in one round.
///
/// THE RESPONDENT IS STORED AND NEVER SHOWN. Stored, because "one answer per
/// person" is unenforceable without it; never shown, because a ten-year-old's
/// honest 2/5 must not be traceable to them by the person it rates — every
/// read path aggregates, and the UI promises exactly that before they answer.
model ReviewResponse {
  id                  String @id @default(cuid())
  schoolId            String
  roundId             String
  teacherMembershipId String
  respondentUserId    String

  /// JSON { questionKey: 1..5 } over the fixed REVIEW_QUESTIONS.
  scores String

  createdAt DateTime @default(now())

  school     School      @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  round      ReviewRound @relation(fields: [roundId], references: [id], onDelete: Cascade)
  teacher    Membership  @relation("ReviewResponseTeacher", fields: [teacherMembershipId], references: [id], onDelete: Cascade)
  respondent User        @relation("ReviewRespondent", fields: [respondentUserId], references: [id], onDelete: Cascade)

  @@unique([roundId, teacherMembershipId, respondentUserId])
  @@index([schoolId, teacherMembershipId])
  // A foreign key to User needs its own index, or deleting a person scans this table once per row (found by the fleet load test).
  @@index([respondentUserId])
  @@index([teacherMembershipId])
}

model AuditLog {
  id          String   @id @default(cuid())
  schoolId    String?
  actorUserId String?
  action      String // "attendance.mark", "invite.create", ...
  targetType  String?
  targetId    String?
  meta        String   @default("{}")
  ip          String?
  createdAt   DateTime @default(now())

  school School? @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId, createdAt])
  @@index([actorUserId, createdAt])
  /// The retention sweep prunes by age across every school at once.
  @@index([createdAt])
}

/// A time-boxed, reasoned grant letting whoever runs the server look inside one
/// school.
///
/// THE WHOLE POINT IS THAT IT IS NOT A STANDING POWER. The operator flag opens
/// exactly two tables — School and Invite — and that has not changed. What this
/// row does is let one named person open ONE named school for a bounded time,
/// having written down why, with the school able to see that it happened.
///
/// WHY A ROW AND NOT A BOOLEAN ON USER. Because the three things that make this
/// defensible are all properties of an occasion rather than of a person: the
/// REASON, the SCHOOL, and the fact that it EXPIRES. A flag saying "may look
/// inside schools" is a master key; this is a signed-out key with a time on it.
///
/// The school reads it in their own Safety Centre, because opening and closing
/// are audited against that school's id like any other event. That is the trade
/// this feature is: the operator gains sight, and gives up doing it unobserved.
model OperatorAccess {
  id       String @id @default(cuid())
  schoolId String
  /// The operator. Not a Membership — they hold none, by definition.
  userId   String

  /// Written before the door opens, and shown to the school afterwards.
  reason String

  startedAt DateTime  @default(now())
  expiresAt DateTime
  /// Set when they close it by hand, before it would have run out.
  endedAt   DateTime?

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([schoolId, startedAt])
  @@index([userId, expiresAt])
}

/// Dev-only outbox. EMAIL_TRANSPORT="devbox" writes here instead of sending,
/// and /dev/mailbox renders it. Keeps magic-link and invite flows fully
/// exercisable with no SMTP credentials.
/// A departure the office has dated ahead: the pupil keeps full access until
/// the last day, and the morning after it the daily job executes the real
/// departure — certificate, roll, notifications — exactly as if the office
/// had pressed the button that day. One per membership; re-scheduling
/// corrects it, cancelling deletes it, and nothing else changes until it runs.
model ScheduledDeparture {
  id           String @id @default(cuid())
  schoolId     String
  membershipId String @unique

  /// The pupil's LAST DAY (YYYY-MM-DD, school-timezone date). Access ends after it.
  leaveOnKey  String
  reason      String
  destination String?
  note        String?
  conduct     String?

  scheduledByMembershipId String?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  school     School     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@index([schoolId, leaveOnKey])
}

/// A member of staff's record, as the office keeps it: the official joining
/// date (the membership's `joinedAt` is when they joined the PLATFORM, which a
/// school migrating in September does not want on a letter), what they are
/// called on the board, what they hold, and how many days' leave a year they
/// are entitled to — which is what the leave desk needs before it approves.
model StaffRecord {
  id                        String    @id @default(cuid())
  schoolId                  String
  membershipId              String    @unique
  staffNumber               String?
  designation               String?
  qualification             String?
  joinedOn                  DateTime?
  /// The DCF's own two dates: the teacher's date of birth, and the day they first joined service
  /// anywhere, as distinct from joinedOn, the day they joined this school.
  birthdate                 DateTime?
  serviceJoinedOn           DateTime?
  /// Entitlement per academic year. Null means the school has not said.
  leaveDaysPerYear          Int?
  /// FILINGS: the UDISE+ teacher profile beyond the payroll basics — gender
  /// as the portal codes it, the social category, the highest academic and
  /// professional qualification, the nature of appointment (regular,
  /// contract, part-time), and the date of birth when the account has none.
  gender                    String?
  socialCategory            String?
  academicQualification     String?
  professionalQualification String?
  appointmentType           String?
  /// DCF 3.2.18, the subject this teacher was APPOINTED for, as one of the
  /// contracts' STAFF_APPOINTED_SUBJECTS. It was guessed from the designation
  /// with its rank word stripped ("TGT Mathematics"), which a designation
  /// like "Senior teacher" does not survive.
  appointedSubject          String?
  // owner-batch-item2a (27 Oct 2026): the number the office rings a member of staff on, as E.164 — the record's,
  // not the account's sign-in phone (User.phone is unique and proved by its owner). Written when the office adds a
  // support worker with no login (src/lib/support-staff.ts); a support worker's account has no phone of its own.
  contactPhone              String?
  updatedAt                 DateTime  @updatedAt
  createdAt                 DateTime  @default(now())

  school     School     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@index([schoolId])
}

/// One run of a scheduled job — the tidy, the digest, the file sweep. The
/// row is written when the run starts and finished when it ends, so an
/// unfinished row is the lock that stops a second copy starting, and the
/// operator can read on /root/jobs whether Friday's digest went out. No
/// tenant: a job runs for the whole server.
model JobRun {
  id         String    @id @default(cuid())
  job        String
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  ok         Boolean?
  /// JSON: whatever the job returned (counts), or nothing.
  summary    String    @default("{}")
  error      String?
  host       String?

  @@index([job, startedAt])
}

model OutboundEmail {
  id        String   @id @default(cuid())
  to        String
  subject   String
  text      String
  html      String
  purpose   String?
  createdAt DateTime @default(now())
  // website-three (17 Oct 2026)
  /// The Reply-To a message carried (the school's own address on a website enquiry's reply), and its threading
  /// headers as JSON { messageId, inReplyTo, references }, so the dev mailbox shows what a real mail would carry.
  replyTo     String?
  headersJson String   @default("{}")
  // end website-three

  @@index([to, createdAt])
  @@index([createdAt])
}

/// How many times something has been tried lately.
///
/// THE FIRST RATE LIMIT IN THIS CODEBASE, and it arrived with the feature that
/// made its absence dangerous. Before password reset, the worst an unlimited
/// login form could do was let somebody guess a password — bounded by argon2
/// and by `fakePasswordWork`, slow and noisy. Reset by mobile number changed
/// the shape of that: the app will send a text to a number the CALLER types, so
/// with no limit an attacker picks a stranger's number and the app becomes the
/// thing harassing them, at the deployment's expense.
///
/// IN THE DATABASE, NOT IN MEMORY. An in-process map is one restart away from
/// forgetting everything, and one instance away from being bypassed — and the
/// two moments a limiter matters most are a deploy and a busy afternoon. It
/// costs one indexed upsert per attempt, on a table nobody reads for anything
/// else.
///
/// A FIXED WINDOW rather than a sliding one. The honest limit: an attacker who
/// times a burst either side of a boundary gets 2× the allowance for one
/// moment. That is a rounding error against the threat — somebody sending a
/// stranger six texts instead of three — and a sliding window costs a row per
/// hit and a range scan to answer.
///
/// NO SCHOOL, AND NO POLICY. Every write happens before there is a session, let
/// alone a tenant, which is exactly why the limit is needed. Listed in
/// NO_SCHOOL_POLICY for the same reason OutboundEmail is.
model RateLimit {
  id String @id @default(cuid())

  /// What is being counted, and for whom: `reset:+919876543210`,
  /// `login:amara@school.test`. Built by the caller so one table serves every
  /// limit, and unique so the upsert is a single statement.
  bucket String @unique

  hits Int @default(0)

  /// When the current window ends. A hit arriving after it resets the count
  /// rather than adding to it — see `consume`.
  windowEndsAt DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Swept by whatever cleans up; nothing depends on old rows existing.
  @@index([windowEndsAt])
}

/// ---------------------------------------------------------------------------
/// Academic year, holidays, and badges that outlive them
/// ---------------------------------------------------------------------------

/// The year a school is currently running.
///
/// Everything that "resets in September" hangs off this: attendance streaks, the
/// badges earned from them, and eventually reports. Exactly one row per school
/// may be current, which `closeAcademicYear` maintains rather than trusting a
/// caller to.
model AcademicYear {
  id        String    @id @default(cuid())
  schoolId  String
  name      String // "2026–27", as the school writes it
  startDate DateTime
  endDate   DateTime
  /// Exactly one per school. Closing a year is an admin action, never automatic:
  /// a school decides when its year ended, and a date-based guess would archive
  /// a child's badges in the middle of an exam week.
  isCurrent Boolean   @default(false)
  closedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// The next receipt number for this year. Read and bumped under a row lock
  /// in the same transaction that posts the payment (fees-payments.ts), so
  /// two counters never issue the same serial — the number is allocated by
  /// the database, never guessed from a count.
  feeReceiptNext Int @default(1)

  school             School              @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  holidays           Holiday[]
  earnedBadges       EarnedBadge[]
  terms              Term[]
  feeStructures      FeeStructure[]
  studentFeePlans    StudentFeePlan[]
  feeConcessions     FeeConcession[]
  feeDemands         FeeDemand[]
  feeReceipts        FeeReceipt[]
  issuedCertificates IssuedCertificate[]
  admissionCycles    AdmissionCycle[]

  @@unique([schoolId, name])
  @@index([schoolId, isCurrent])
}

/// A term inside an academic year — "Term 1", "Half-yearly" — the unit a
/// school reports in. Exam series and report cards hang off it; a date falls
/// in at most one term of a year, which the library enforces (no overlaps,
/// inside the year). A school that reports once a year simply has none.
model Term {
  id             String    @id @default(cuid())
  schoolId       String
  academicYearId String
  name           String
  startDate      DateTime
  endDate        DateTime
  /// Display order within the year; the library keeps it equal to the start order.
  position       Int       @default(0)
  /// The office said this term is done — a milestone, set from the calendar
  /// page by the admin or the principal. Reversible there, because a term
  /// marked done by accident should not need a database admin to unmark.
  finishedAt     DateTime?
  /// This term's share of the annual report card, in percent. Null on every
  /// term means equal shares; the office sets them on the calendar.
  weightPercent  Int?
  createdAt      DateTime  @default(now())

  school       School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  examSeries   ExamSeries[]
  reportCards  ReportCard[]

  @@unique([academicYearId, name])
  @@index([schoolId, startDate])
}

/// A day the school is shut, or otherwise not teaching.
///
/// Attendance percentages divide by the days a register COULD have been taken,
/// so a holiday that is not recorded here quietly makes every child look worse.
/// A range is one row with an end date rather than one row per day: a school
/// enters "Diwali break, 8th to 15th" and should not have to enter eight things.
model Holiday {
  id             String  @id @default(cuid())
  schoolId       String
  academicYearId String?
  name           String
  /// YYYY-MM-DD in the SCHOOL's timezone, like every other date key here.
  startDateKey   String
  /// Inclusive. Equal to startDateKey for a single day.
  endDateKey     String
  /// COMPETITION (decision 0007, 6 Nov 2026) is an EVENT the school runs as a competition: the school is open,
  /// and the row carries `competitionId`, the Competition that holds the entries, results and boards.
  kind           String  @default("HOLIDAY") // HOLIDAY | EXAM | EVENT | COMPETITION
  note           String?
  /// The school's own Competition this calendar row is the event of; set only on a COMPETITION row, one row per
  /// competition. Made, edited and removed together with it (src/lib/competition-events.ts); SetNull so a
  /// competition row that goes first never takes a calendar day with it.
  competitionId  String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school       School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academicYear AcademicYear? @relation(fields: [academicYearId], references: [id], onDelete: SetNull)
  competition  Competition?  @relation(fields: [competitionId], references: [id], onDelete: SetNull)

  @@index([schoolId, startDateKey])
}

/// A badge a child has earned and KEEPS.
///
/// Attendance badges are derived live from the register, so that breaking a
/// streak takes the badge away the same day — that is the point of a streak. But
/// a year's achievements must not vanish because the next year started, so
/// closing an academic year writes the badges standing at that moment into rows
/// here, where nothing recalculates them again.
///
/// Badges earned by finishing a topic without looking at the solutions are
/// written here IMMEDIATELY and marked permanent: they record something a child
/// did once, which no later absence can undo.
model EarnedBadge {
  id                  String  @id @default(cuid())
  schoolId            String
  studentMembershipId String
  academicYearId      String?

  badgeId     String // derived ids from badges.ts, a quiz topic (abhyaas:<slug>), or a ladder tier (abhyaas:<slug>:tier-<n>)
  label       String
  description String  @default("")
  /// Permanent badges ignore the academic year entirely and are never archived
  /// or recalculated — currently the quiz ones.
  permanent   Boolean @default(false)

  earnedAt  DateTime @default(now())
  createdAt DateTime @default(now())

  school       School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student      Membership    @relation(fields: [studentMembershipId], references: [id], onDelete: Cascade)
  academicYear AcademicYear? @relation(fields: [academicYearId], references: [id], onDelete: SetNull)

  /// Plus a partial unique index over the year-less (permanent) rows —
  /// migration 20260927010000 — because two NULL years are distinct to this
  /// unique and a permanent badge could be awarded twice under a race.
  @@unique([studentMembershipId, badgeId, academicYearId])
  @@index([schoolId, studentMembershipId])
}

/**
 * --------------------------------------------------------------------------
 */
/**
 * Practice — adaptive practice
 */
/**
 * --------------------------------------------------------------------------
 */

/// A chapter's worth of practice questions.
///
/// GLOBAL, LIKE THE COMPETITIONS CATALOGUE, and for the same reason: a question
/// about the quadratic formula is not one school's property, and making every
/// school author its own bank would mean no school has one. So topics and
/// questions carry no `schoolId` and sit in `NO_SCHOOL_POLICY`.
///
/// What is emphatically NOT global is how a child did. Attempts, responses and
/// mastery are school-scoped rows, because a list of a nine-year-old's wrong
/// answers is exactly the kind of thing that must not cross a school boundary.
model QuizTopic {
  id         String @id @default(cuid())
  /// MATHS | SCIENCE | HISTORY | GEOGRAPHY | CIVICS | ECONOMICS
  subject    String
  /// The class this chapter belongs to, as a number: 5, 6, 7…
  classLevel Int
  /// "Chapter 4 — Linear Equations", as the syllabus writes it.
  chapter    String
  name       String
  /// Stable, human-readable, and what a badge id is built from:
  /// `abhyaas:maths-8-linear-equations`. Renaming a topic must not orphan a
  /// badge a child already earned, so this never changes once published.
  slug       String @unique
  summary    String @default("")
  /// Display order within (subject, classLevel).
  position   Int    @default(0)

  /// RETIRED, NOT DELETED. Set when a chapter-true topic supersedes this one
  /// (the 2026 bank refurbishment). A retired topic stops listing on every
  /// practice surface but its mastery, attempts and badges keep their rows —
  /// deleting a topic would orphan a child's earned history, and this bank
  /// never pays for tidiness with somebody's streak.
  retiredAt DateTime?

  // ---- quiz-board (the practice bank's board, 11 October 2026) ----
  /// The board whose books the chapter is written against: "NCERT" | "BALBHARATI" (QUIZ_BOARDS in
  /// packages/contracts v1/quiz-board.ts). The authored bank is NCERT's (scripts/import-quiz.ts writes it
  /// on every run; the migration quiz_topic_board backfilled the rows already there); a generated batch's
  /// topic takes its file's `board` (scripts/quiz-queue.ts). Null for a bank that follows no school book
  /// (the placement banks): such a topic lists under either board. The practice list shows the school's
  /// board first (School.board through quizBoardForSchool) with a switch to the other.
  board String?
  // ---- end quiz-board ----

  // ---- college-content (college practice by stream, 12 October 2026) ----
  /// Who the chapter is for: "SCHOOL" (the school bank: authored, NCERT and Balbharati) | "COLLEGE" (a
  /// stream's bank, generated from a syllabus unit, and the placement banks). QUIZ_AUDIENCES in packages/
  /// contracts v1/college-practice.ts. A school lists SCHOOL chapters only; a college lists its streams'
  /// COLLEGE chapters and, in "Competitive Exams Prep", the NCERT SCHOOL chapters (src/lib/practice-audience.ts).
  audience       String   @default("SCHOOL")
  /// A COLLEGE chapter's stream codes (STREAMS); empty for a school chapter, and for a college-wide bank
  /// (the placement banks), which lists at every college.
  streams        String[] @default([])
  /// A COLLEGE chapter's programme as the syllabus names it ("LL.M.", "B.Pharm"); null for a school chapter.
  programme      String?
  /// A COLLEGE chapter's year or semester, coded Y1–Y5 | S1–S10 (COLLEGE_TERMS); null when the syllabus does not say.
  yearOrSemester String?
  // ---- end college-content ----

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  questions           QuizQuestion[]
  attempts            QuizAttempt[]
  mastery             QuizMastery[]
  translations        QuizTopicTranslation[]
  practiceAssignments PracticeAssignment[]
  practiceOnce        PracticeOnce[]
  contributions       QuestionContribution[]

  @@index([subject, classLevel, position])
  // college-content (12 Oct 2026): the practice list's audience filter.
  @@index([audience])
}

/// A topic's name and summary in one other language.
///
/// A SEPARATE TABLE, not `nameHi` / `nameMr` columns, because the set of
/// languages this app will be asked for is not knowable now — Hindi and Marathi
/// are the ask today and the argument for the next one will be identical. A
/// column per language means a migration per language.
///
/// PARTIAL BY DESIGN. A row here may exist for Hindi and not for Marathi, and a
/// question inside a translated topic may itself be untranslated. Reading falls
/// back FIELD BY FIELD to the English original rather than requiring a complete
/// translation before any of it is usable, because the alternative is that no
/// language ships until every string is done.
model QuizTopicTranslation {
  id       String @id @default(cuid())
  topicId  String
  /// BCP-47-ish and short: "hi", "mr". Matches UserPrefs.locale.
  language String
  name     String
  summary  String @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  topic QuizTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@unique([topicId, language])
  @@index([language])
}

/// One question's stem, options and solution in one other language.
///
/// `answerIndex` is deliberately NOT repeated here. The correct option is a
/// property of the question, not of the language it is read in, and storing it
/// twice would allow a translation to disagree with the original about which
/// answer is right — a bug that would mark a child wrong for being correct in
/// Marathi. The translated `choices` array must therefore keep the SAME ORDER
/// as the original, which the verifier enforces by comparing lengths.
model QuizQuestionTranslation {
  id         String @id @default(cuid())
  questionId String
  language   String
  stem       String
  /// JSON array, same order and length as the original's `choices`.
  choices    String
  solution   String

  // ---- figures (the quiz bank's figure builder, 10 October 2026) ----
  /// This language's drawing of the item's figure (the same spec, the labels in this language): a
  /// fileId in the uploads store, written by the importer's image step. Null: the question's imageKey.
  imageKey String?
  /// The figure in words in this language. Null: the question's imageAlt.
  imageAlt String?

  @@index([imageKey])
  // ---- end figures ----

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  question QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([questionId, language])
  @@index([language])
}

// ---------------------------------------------------------------------------
// The assistant's content (docs/plans/assistant.md §2 and §5, Phase A, 8 October 2026)
//
// The curriculum corpus and the platform-help corpus the assistant retrieves from. NO schoolId on
// any of them, and all three sit in NO_SCHOOL_POLICY in scripts/gen-rls.ts beside QuizTopic: a
// chapter of the NCERT class 8 science book, or the sentence saying where the office records a
// departure, belongs to no school. Readable by the app role, written by the owner only (the ingest
// and the help index run on the owner connection; scripts/db-grants.mjs takes INSERT, UPDATE and
// DELETE back from the app role). What a PERSON asks the assistant is a different matter and will
// carry schoolId and RLS like everything else (Phase B).
//
// Two indexes per table are written in the migration in SQL Prisma cannot say, and Prisma ignores
// them (a partial index and an expression index), so no later `migrate dev` diff touches them:
//   - an HNSW index on `embedding` (cosine distance, vector_cosine_ops) WHERE embedding IS NOT NULL;
//   - a GIN index on the text's tsvector (English stemming for "en" rows, the simple configuration
//     for Hindi and Marathi), the keyword half of the search. The expression is not a stored
//     generated column because Prisma reads one as a default and every later diff would try to drop
//     it; queries repeat the index's expression exactly (src/lib/assistant-retrieval.ts).
// ---------------------------------------------------------------------------

/// One file of the curriculum corpus, as the corpus fetcher saved it (storage/corpus/…), with the
/// fields of its manifest.json. Re-ingesting a file whose checksum changed replaces its chunks.
model ContentDocument {
  id               String    @id @default(cuid())
  /// Corpus-relative path, the document's identity: "ncert/8/science/hesc111.pdf".
  path             String    @unique
  /// ncert | balbharati | nios | syllabi | glossaries | papers (scripts/corpus-lib.ts SourceKey); "fixture" for the test corpus.
  source           String
  /// textbook | exemplar | course | glossary | syllabus | entrance-paper | olympiad-paper | board-sample-paper
  kind             String
  /// As the site names itself: "NCERT", "Balbharati (…)", "NIOS", "SPPU (…)".
  board            String
  /// "8" for a class; a programme or faculty for a syllabus.
  gradeOrProgramme String
  subject          String
  /// The book's title as the site lists it.
  title            String
  /// "en"; "en+hi" for a bilingual glossary.
  language         String
  /// As the site or the book's own prelims state it; null when neither does.
  edition          String?
  year             String?
  sourceUrl        String
  licenceUrl       String
  /// The site's own words, trimmed; never paraphrased.
  licenceText      String?
  retrievedAt      DateTime
  sha256           String
  bytes            Int
  pageCount        Int
  /// The chapter number, the site's book code, its Last-Modified: whatever the manifest carried.
  extra            Json?
  // ---- papers (the entrance and olympiad papers as a style corpus, 10 October 2026) ----
  /// A STYLE document (source "papers": past entrance, olympiad and board sample papers): the quiz
  /// generator reads it through papersStyleFor (src/lib/quiz-style.ts) for difficulty levels 5 and 6;
  /// the tutor's searchCurriculum never returns it, so it is never cited to a pupil.
  styleOnly        Boolean  @default(false)
  // ---- end papers ----
  // ---- vidura pass 4 (18 Oct 2026): college knowledge ----
  /// Who the document is searched for: null for everyone (the books, as before), "COLLEGE" for a source only a college's
  /// tutor reads (the Wikipedia subset for the professional streams). searchCurriculum leaves COLLEGE documents out
  /// unless the search asks for them, so a school's search is exactly what it was.
  audience         String?
  /// The college streams (packages/contracts STREAMS) a COLLEGE document was chosen for; searched first for a college
  /// of those streams. Empty for the books.
  streams          String[] @default([])
  /// The licence by its short name ("CC BY-SA 4.0"), when the source publishes one by name; licenceUrl and licenceText
  /// carry the rest.
  licenceName      String?
  /// What every passage of this document carries in its citation (a share-alike licence asks for it): for Wikipedia
  /// { kind: "WIKIPEDIA", title, revision, revisedAt, url, licence }. Null for a document whose licence asks for none.
  attribution      Json?
  // ---- end vidura pass 4 ----
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  chunks ContentChunk[]

  @@index([board, gradeOrProgramme, subject])
  @@index([source])
}

/// About 500 tokens of one document, cut at chapter and section boundaries, with where it came from.
/// The citation the assistant gives is built from this row and its document.
model ContentChunk {
  id          String   @id @default(cuid())
  documentId  String
  /// Position within the document, from 0.
  ordinal     Int
  chapter     String?
  section     String?
  /// Chapter, section, subsection… as the headings read: ["Force and Pressure", "4.2 A Force — A Push or a Pull"].
  headingPath String[]
  pageStart   Int
  pageEnd     Int
  text        String
  language    String
  /// Estimated (characters / 4), enough to size a prompt.
  tokens      Int
  /// Figures cut from the pages this chunk covers: "figures/<file>-p<page>-<n>.png", corpus-relative.
  figureKeys  String[]
  /// The document's edition, repeated on the chunk so a citation never loses it.
  edition     String?
  // ---- papers (10 October 2026) ----
  /// What a paper's chunk is (scripts/corpus-papers-chunk.ts): "question" (one numbered question with
  /// its options), "questions" (a block whose numbering could not be read), "answer-key" (the body's
  /// key, model solution or marking scheme), "instructions" (the paper's front matter). Null for a book.
  kind        String?
  // ---- end papers ----
  /// Qwen3-Embedding-0.6B, 1024 dimensions; HNSW (cosine) index in the migration. Null until embedded.
  embedding   Unsupported("vector(1024)")?
  embeddedAt  DateTime?
  createdAt   DateTime @default(now())

  document ContentDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, ordinal])
  @@index([documentId])
}

/// One unit of platform help: a door's summary, a docs paragraph that tells somebody how to do
/// something, or a dictionary sentence naming a page or an action, in one language, tagged with
/// the commit it was read from. Rebuilt by `npm run help:index` at every deploy.
model HelpEntry {
  id         String   @id @default(cuid())
  /// door | doc | nav | action | dictionary
  kind       String
  /// The roles the entry applies to (RoleCode values); empty means every role.
  roles      String[]
  /// The page it names, when it names one: "/admin/people/departures".
  pagePath   String?
  /// For a door: its method and path ("GET /api/v1/…") and module.
  door       String?
  module     String?
  /// A short label: the door's summary, the docs heading path, the nav label.
  title      String
  text       String
  /// Repository-relative: "docs/college.md", "src/lib/api-catalog/office.ts".
  sourceFile String
  /// `git rev-parse --short HEAD` at the build, "-dirty" when the tree had changes.
  commit     String
  /// en | hi | mr
  language   String
  embedding  Unsupported("vector(1024)")?
  /// Vidura pass 2 (17 Oct 2026): a Hindi or Marathi guide paragraph made from a HelpRendering carries its id, so a
  /// rendering the reviewer rejects leaves retrieval at once and an edited one is read in its new words before the
  /// next rebuild (src/lib/assistant-retrieval.ts). Null for every other entry.
  renderingId String?
  createdAt  DateTime @default(now())

  @@index([commit])
  @@index([language])
  @@index([renderingId])
}

/// VIDURA PASS 2 (docs/plans/vidura.md, 17 Oct 2026): the Hindi or Marathi rendering of one unit of the user guide
/// (docs/guide/*.md) — a section heading or a paragraph — made once by the local model (`npm run help:index --
/// --render=hi,mr`), stored UNREVIEWED and used at once for retrieval and the suggested questions in that language,
/// then read by a speaker on the operator's panel (/root/vidura-review: Approve, Edit, Reject, audited; the content
/// team reads the queue at /appadmin/vidura-review). help:index writes a HelpEntry per rendered paragraph, never one
/// for a REJECTED rendering. Outside the school fence like HelpEntry: the guide is the platform's, the same for every
/// school, and its reviewer is the operator, who belongs to no school (scripts/gen-rls.ts names it).
// ---- vidura pass 3 (18 Oct 2026) ----
/// A STANDARD ANSWER for a common how-to question (docs/plans/vidura.md, pass 3; src/lib/assistant/standard.ts). The
/// operator asks Vidura a question as a role on /root/vidura-answers; the answer that came through both gates is kept
/// here as a DRAFT (checkedAt null), and "Mark as the standard answer" checks it. A person of that role whose question
/// normalises to the same key in the same language is then served the checked answer, still through the gate's tables,
/// thresholds and classifier, without the answering model; revoked, it is never served again. Only a "Using Shalaghar"
/// answer, which reads no person's records, can be kept. Outside the school fence like HelpEntry: the platform's own
/// help, the same for every school, checked by the operator, who belongs to no school (scripts/gen-rls.ts names it).
model CachedAnswer {
  id               String    @id @default(cuid())
  /// The role it was asked as, and the only role it is served to.
  role             String
  /// en | hi | mr
  language         String
  /// The question in its normal form (standard.ts `questionKey`): what a person's question must normalise to.
  questionKey      String
  /// The question as the operator typed it.
  question         String
  /// The checked answer as it was shown, and its citations (JSON AssistantCitation[]).
  text             String
  citationsJson    String    @default("[]")
  /// The trial's verdict (ANSWERED for a draft that may be checked).
  verdict          String
  /// The chip the trial wore: USING only may be checked.
  chip             String?
  hitCount         Int       @default(0)
  lastHitAt        DateTime?
  createdByUserId  String
  createdAt        DateTime  @default(now())
  checkedByUserId  String?
  checkedAt        DateTime?
  revokedByUserId  String?
  revokedAt        DateTime?

  @@index([questionKey, language, role])
  @@index([createdAt])
}

/// THE UNANSWERED REPORT'S COUNTS (pass 3), one school's: questions per school day, role, mode, verdict and reason,
/// counts only, recomputed for the last thirty days by the nightly vidura:gaps job (its one writer) from the
/// conversations' rows. The school's row like UsageSample, and like it readable by the operator across schools
/// (SUPERUSER_READABLE in scripts/gen-rls.ts); the counsellor routes are never counted here.
model AssistantGapCount {
  id         String   @id @default(cuid())
  schoolId   String
  /// YYYY-MM-DD in the school's own calendar.
  dayKey     String
  role       String
  /// USING | RECORDS | LEARNING, or NONE before the gate reached a mode.
  scope      String
  verdict    String
  /// The first reason code, or "" when none (NOTHING_FOUND, CLASSIFIER, CITATION, …).
  reason     String   @default("")
  count      Int
  computedAt DateTime @default(now())

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([schoolId, dayKey, role, scope, verdict, reason])
  @@index([dayKey])
}

/// A QUESTION STEM THAT FOUND NOTHING (pass 3): the first words of the stripped question (names, ids and codes already
/// out, strip.ts) of the questions that found no page or passage in the last thirty days, per language and role, kept
/// only when at least two people asked it; never a whole question. Rewritten whole by vidura:gaps. Outside the school
/// fence: counted across every school and naming none, read by the operator alone.
model AssistantGapStem {
  id         String   @id @default(cuid())
  language   String
  role       String
  stem       String
  questions  Int
  people     Int
  fromDay    String
  toDay      String
  computedAt DateTime @default(now())

  @@index([questions])
}

/// ONE EVALUATION RUN started from the operator's panel (/root/vidura-evals; src/lib/eval-jobs.ts, its one writer):
/// the sets asked for, the live line, the scores when it ends, and the pid of the detached runner
/// (scripts/assistant-eval.ts --job=<id>). One at a time (`active` unique, as QuizGenJob). The model servers it brought
/// up go down with it unless a generation run or a crawl still holds them (src/lib/model-holders.ts). Nothing in it is a
/// school's: outside the fence (scripts/gen-rls.ts).
model AssistantEvalJob {
  id              String    @id @default(cuid())
  /// QUEUED | RUNNING | STOPPING | STOPPED | FINISHED | FAILED
  state           String    @default("QUEUED")
  active          Boolean?  @unique
  /// { sets, limit? } (viduraEvalRequestSchema)
  request         Json
  /// The live line (viduraEvalProgressSchema), rewritten after every case.
  progress        Json?
  /// The sets' scores when the run ends (viduraEvalScoreSchema[]), kept with the run.
  scores          Json?
  /// The refusal set held at 100 percent (null when it was not run).
  gate            Boolean?
  /// Where the harness wrote its files (storage/assistant-eval/<dir>).
  outDir          String?
  pid             Int?
  startedServers  String[]  @default([])
  startedByUserId String
  stopRequestedBy String?
  error           String?
  createdAt       DateTime  @default(now())
  startedAt       DateTime?
  finishedAt      DateTime?
  heartbeatAt     DateTime?

  @@index([createdAt])
}
// ---- end vidura pass 3 ----
// ---- vidura pass 4 (18 Oct 2026) ----
/// A PUBLIC EDUCATION SOURCE Vidura may link to beside a Learning answer (docs/plans/vidura.md, the owner's decision 8;
/// src/lib/assistant/references.ts). The operator manages the allow-list on /root/vidura-references: a source's name,
/// its host, its kind, its licence as the source publishes it, the roles shown its links and whether it is on. A link
/// is built by code from `linkTemplate` (https, on `host`) and the cited passage's own heading, never from the person's
/// words and never written by the model. Shown only to staff and adult college students; never to a pupil while
/// decision 0002 stands. Outside the school fence: the list is the platform's, the same for every school, and the
/// operator who keeps it belongs to no school (scripts/gen-rls.ts names it).
model ReferenceSource {
  id              String    @id @default(cuid())
  /// As the source names itself ("NPTEL", "NCERT OFFICIAL"); one row a name.
  name            String    @unique
  /// The source's host, lower case, no scheme: "nptel.ac.in"; every link is built on it (two channels may share one).
  host            String
  /// VIDEO | COURSE | LAW | PRACTICE | REFERENCE (VIDURA_REFERENCE_KINDS in packages/contracts v1/vidura-ops.ts)
  kind            String
  /// The licence or terms as the source publishes them, in its own words or by name; with the address they are at.
  licence         String
  licenceUrl      String?
  /// An https address on `host` with "{topic}" where the cited passage's heading goes (URL-encoded).
  linkTemplate    String
  /// The roles shown this source's links (VIDURA_REFERENCE_ROLES); a STUDENT only when an adult at a college.
  shownTo         String[]  @default([])
  enabled         Boolean   @default(true)
  createdByUserId String?
  createdAt       DateTime  @default(now())
  updatedByUserId String?
  updatedAt       DateTime  @updatedAt
}
// ---- end vidura pass 4 ----

model HelpRendering {
  id               String    @id @default(cuid())
  /// HEADING | PARAGRAPH
  kind             String
  /// hi | mr
  language         String
  /// sha256 of the kind and the English text: the unit's identity across rebuilds and commits.
  sourceKey        String
  /// The English as the guide has it, and the file it came from.
  sourceText       String
  sourceFile       String
  /// The rendering in use: the model's, or the reviewer's edit.
  text             String
  /// The model's own words, kept beside an edit.
  modelText        String
  /// UNREVIEWED | APPROVED | REJECTED
  status           String    @default("UNREVIEWED")
  edited           Boolean   @default(false)
  reviewedByUserId String?
  reviewedAt       DateTime?
  /// The model that wrote it (ASSISTANT_MODEL).
  model            String
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@unique([sourceKey, language])
  @@index([language, status])
}

/// One question, its answer, and the worked solution behind the reveal.
///
/// `difficulty` is 1–6 and the ladder is deliberate — see QUIZ_LEVELS in
/// `src/lib/quiz.ts`. Level 1 is "name the theorem"; level 6 is Olympiad. The
/// adaptive engine walks it, so a gap in the middle of a topic's ladder makes
/// that topic unplayable above the gap.
///
/// PROVENANCE IS REQUIRED, not decorative. `source` and `licence` are non-null
/// so that a bank can always answer "where did this come from and may we serve
/// it" — the question a question bank gets asked once, years later, by somebody
/// who is not you.
model QuizQuestion {
  id      String @id @default(cuid())
  topicId String

  /// 1 RECALL · 2 UNDERSTAND · 3 APPLY · 4 ANALYSE · 5 COMPETITIVE · 6 OLYMPIAD
  difficulty  Int
  stem        String
  /// JSON array of option strings. String, not Json — see the SQLite note.
  choices     String
  /// Index into `choices`. Validated against its length on import.
  answerIndex Int
  /// Shown only when a child asks for it, and asking costs the badge.
  solution    String

  /// Optional machine-checkable assertion, e.g. "42" or "3/4". When present the
  /// verifier evaluates it and compares with the chosen option, which is the
  /// only correctness check that is worth anything without a human.
  checkExpr String?

  source       String
  licence      String
  /// Set when a person has actually read this question and its solution.
  /// Null means unreviewed, and the verifier counts those out loud.
  reviewedAt   DateTime?
  reviewedBy   String?
  /// A NATIVE SPEAKER READ THE HINDI (or the Marathi). The translation rows are
  /// machine drafts the moment they are written (app-admin.ts translates on
  /// save, and clears these); a person on the content team stamps a language
  /// here once they have read it, from /appadmin/translations. A content-quality
  /// flag only: an unreviewed draft is still served, because a draft a child can
  /// read beats an English question a child cannot. Decision 0002, gap 8.
  hiReviewedAt DateTime?
  mrReviewedAt DateTime?
  hiReviewedBy String?
  mrReviewedBy String?

  // ---- quiz-gen (the quiz bank generator, Phase 1 step 1, 10 October 2026) ----
  /// The figure drawn above the stem: a fileId in the uploads store (the way a document's bytes are
  /// kept, src/lib/storage.ts), never a URL, written by scripts/import-quiz.ts from the corpus figure
  /// a generated file names. One image per item, shared by its Hindi and Marathi rows. Null for an
  /// item without a figure. Plan §8 gap 1: counsel's reading of the boards' figure terms is pending.
  imageKey String?
  /// The figure described in words, in the question's language; required whenever imageKey is set
  /// (scripts/verify-quiz.ts refuses an image without one).
  imageAlt String?
  // ---- end quiz-gen ----

  // ---- figures (the quiz bank's figure builder, 10 October 2026) ----
  /// The figure spec and the renderer's version the stored images were drawn from, as JSON
  /// ({"v":1,"figure":{kind,spec,labels}}), written only by the importer's image step
  /// (scripts/quiz-gen/figures/attach.ts) together with imageKey and the translations' imageKey. Null
  /// for an item whose image is not drawn from a spec. Compared on re-import, so an unchanged figure
  /// keeps its stored files and a changed spec or renderer draws new ones.
  imageSpec String?

  /// The file route finds the question a figure belongs to by its fileId (src/lib/files.ts).
  @@index([imageKey])
  // ---- end figures ----

  // ---- review-queue (the generated bank's review queue, 10 October 2026), as the owner changed it on
  // 11 October 2026 (quiz-publish-jobs): PUBLISHED WITHOUT REVIEW, taken down afterwards ----
  /// Written by scripts/quiz-queue-load.ts (quiz:queue and the generation job) from
  /// content/quiz/generated/*.json, never by the authored bank's importer. A generated item that passed
  /// the generator's own checks is SERVED the moment it is loaded, with its Hindi and Marathi rows; the
  /// operator or the content team may take it down afterwards (takenDownAt) or edit it. The one serving
  /// filter is src/lib/quiz-served.ts.
  generated            Boolean   @default(false)
  /// "NCERT", "BALBHARATI": the board of the book the item was generated against, for the desk's filter.
  generatedBoard       String?
  /// JSON (String, as the bank stores JSON): the material the generator kept — the distractor reasons,
  /// the solver's five answers, the level flag, the critique, the figure spec and needsFigure, the
  /// edition, the model, the time, the translations' critiques. Never shown to a pupil.
  generation           String?
  /// TAKEN DOWN by the operator or the content team with a coded reason (QUIZ_TAKEDOWN_REASONS): not
  /// served from that moment, the answers pupils gave kept; put back by clearing it. Written only by
  /// src/lib/quiz-review.ts (the bank desk), with a QuizReviewStamp row in the same transaction.
  /// (Renamed from discardedAt / discardReason, the review queue's discard, on 11 October 2026.)
  takenDownAt          DateTime?
  takenDownReason      String?
  takenDownBy          String?
  /// The item's figure must be drawn before a pupil sees it (the generator asked for one): an item
  /// whose figure failed to draw is loaded but held until imageKey is set. A stored copy of the
  /// `generation` JSON's needsFigure, written only by the loader (scripts/quiz-queue-load.ts).
  needsFigure          Boolean   @default(false)
  /// Edited on the desk after the generator's blind solver answered it: the solver's answers were
  /// given to the old words.
  editedAfterSolvingAt DateTime?
  reviewStamps         QuizReviewStamp[]

  @@index([generated, takenDownAt])
  // ---- end review-queue ----

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  topic        QuizTopic                 @relation(fields: [topicId], references: [id], onDelete: Cascade)
  responses    QuizResponse[]
  translations QuizQuestionTranslation[]
  stats        QuestionStat[]

  @@index([topicId, difficulty])
}

/// One sitting at one topic.
model QuizAttempt {
  id                  String @id @default(cuid())
  schoolId            String
  studentMembershipId String
  topicId             String

  startedAt   DateTime  @default(now())
  finishedAt  DateTime?
  /// THE BADGE GATE. Set the moment a solution is revealed and never unset.
  /// Not derived from the responses on finish, because a response row can be
  /// deleted and a flag that was already true cannot be argued with.
  revealedAny Boolean   @default(false)

  school    School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student   Membership     @relation(fields: [studentMembershipId], references: [id], onDelete: Cascade)
  topic     QuizTopic      @relation(fields: [topicId], references: [id], onDelete: Cascade)
  responses QuizResponse[]

  @@index([schoolId, studentMembershipId, topicId])
  @@index([studentMembershipId])
}

/// One answer to one question inside an attempt.
model QuizResponse {
  id         String @id @default(cuid())
  schoolId   String
  attemptId  String
  questionId String

  /// Null when the child revealed the solution without committing to an answer.
  chosenIndex      Int?
  correct          Boolean @default(false)
  revealedSolution Boolean @default(false)
  /// The level the engine served this at, kept so a run can be replayed.
  servedDifficulty Int
  /// The pupil's grade when they answered (1–12 from their form group's
  /// gradeLevel), null when no enrolment names one or the row predates the
  /// column. A fact of the moment, kept because a promotion in April would
  /// otherwise move last year's answers up a grade.
  gradeLevel       Int?
  /// Seconds between this answer and the previous answer in the sitting (or
  /// the sitting's start), capped at 600: a child who walked away for an hour
  /// did not spend an hour on the question. Null on a reveal-only row and on
  /// rows that predate the column.
  seconds          Int?

  answeredAt DateTime @default(now())

  school   School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  attempt  QuizAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([attemptId, questionId])
  @@index([schoolId])
}

/// Where a child currently sits on one topic's ladder.
///
/// Survives between sittings on purpose: a child who reached level 4 last week
/// should not be handed "name the formula" again on Monday. This is the whole of
/// "adaptive" — the rest is presentation.
model QuizMastery {
  id                  String @id @default(cuid())
  schoolId            String
  studentMembershipId String
  topicId             String

  /// 1–6, the level the next question is served at.
  level        Int @default(1)
  seenCount    Int @default(0)
  correctCount Int @default(0)
  /// Consecutive right / wrong at the current level. Two of either moves it.
  streakRight  Int @default(0)
  streakWrong  Int @default(0)

  /// Set once the topic has been finished with no solution ever revealed. The
  /// badge is written at the same moment and is permanent; this exists so the
  /// UI can say so without re-deriving it from every attempt.
  cleanCompletionAt DateTime?

  updatedAt DateTime @updatedAt

  school  School     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student Membership @relation(fields: [studentMembershipId], references: [id], onDelete: Cascade)
  topic   QuizTopic  @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@unique([studentMembershipId, topicId])
  @@index([schoolId, studentMembershipId])
}

/// A chapter a teacher asked a class to climb: "reach this rung of this
/// chapter's ladder". There is nothing to hand in and nothing to mark — the
/// practice engine already proves every answer, so attainment is DERIVED from
/// QuizMastery at read time and can never disagree with what the child did.
model PracticeAssignment {
  id       String @id @default(cuid())
  schoolId String
  classId  String
  topicId  String

  /// 1-6, the rung the class is asked to reach.
  targetLevel Int
  note        String?
  dueAt       DateTime?

  createdById String
  createdAt   DateTime  @default(now())
  archivedAt  DateTime?

  school    School     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  class     Class      @relation(fields: [classId], references: [id], onDelete: Cascade)
  topic     QuizTopic  @relation(fields: [topicId], references: [id], onDelete: Cascade)
  createdBy Membership @relation("PracticeAssigner", fields: [createdById], references: [id], onDelete: Cascade)

  once PracticeOnce[]

  @@index([schoolId, classId, archivedAt])
  @@index([createdById])
  @@index([classId])
}

/// ONE-TIME PRACTICE (decision 0008, 7 November 2026): a pupil WITHOUT the Student plan opens a set a teacher
/// assigned once — a fixed draw of the chapter's questions nearest the target rung, each answered once, scored —
/// and a second open shows the result rather than the questions. It counts toward nothing else: no QuizAttempt,
/// no QuizResponse, no QuizMastery, no badge, no journey; the bank, the journey and revision stay behind the plan
/// card. One row per pupil and assignment (src/lib/practice-once.ts is the one writer).
model PracticeOnce {
  id                  String    @id @default(cuid())
  schoolId            String
  studentMembershipId String
  assignmentId        String
  topicId             String
  /// The drawn question ids in serving order (a JSON string[]), fixed at the first open.
  questionIds         Json
  /// What was answered, in order: { questionId, chosenIndex, correct }[] (a JSON array); one entry per question at most.
  answers             Json      @default("[]")
  total               Int
  correct             Int       @default(0)
  openedAt            DateTime  @default(now())
  finishedAt          DateTime?
  updatedAt           DateTime  @updatedAt

  school     School             @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student    Membership         @relation(fields: [studentMembershipId], references: [id], onDelete: Cascade)
  assignment PracticeAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  topic      QuizTopic          @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@unique([studentMembershipId, assignmentId])
  @@index([schoolId, assignmentId])
}

// ---------------------------------------------------------------------------
// Experts — consultation bookings, and mentoring
//
// AN EXPERT IS NOT A SCHOOL ROLE. They consult for many schools and belong to
// none, so there is no Membership row and `SCHOOL_ROLES` is untouched. What
// gives an expert access to a school's data is a BOOKING, and nothing else:
// `resolveRequestTenant` turns an expert's confirmed bookings into their
// `app.school_ids`, exactly the way a parent's guardianships become theirs. No
// booking, no tenant, no rows — enforced by the same policies as everyone else
// rather than by a new one.
// ---------------------------------------------------------------------------

/// A curated expert. Global, like the practice catalogue: an expert belongs to
/// no school, and scoping them to one would mean every school starts with an
/// empty marketplace.
///
/// `publishedAt` is the curation gate. A profile is invisible to schools until
/// somebody publishes it, so accepting an invitation does not by itself put an
/// adult in front of schools.
model ExpertProfile {
  id     String @id @default(cuid())
  userId String @unique

  headline     String
  bio          String  @default("")
  /// JSON string[] — "Careers", "Dyslexia support", "Olympiad maths".
  specialisms  String  @default("[]")
  timezone     String  @default("UTC")
  /// Where they work, for a school choosing between them. Free text.
  organisation String?

  /// SESSIONS | MENTORING | BOTH — what this person is actually offering.
  ///
  /// A ONE-OFF WORKSHOP AND A YEAR OF MENTORING ARE DIFFERENT COMMITMENTS, and
  /// until this column existed the marketplace could not tell them apart: every
  /// published expert appeared bookable for a session AND pairable with a
  /// child, whatever they had agreed to. A retired engineer happy to talk to a
  /// hall for an hour was one click away from being made responsible for one
  /// eleven-year-old for a term.
  offering String @default("BOTH")

  /// How many children they will mentor at once. NULL means they have not said.
  ///
  /// Enforced when a mentorship is created, not merely displayed — a cap that
  /// is only a label is a cap the tenth school to call ignores.
  mentorCapacity Int?

  /// How many they are mentoring right now, DENORMALISED for exactly the reason
  /// `ExpertSlot.bookedAt` is.
  ///
  /// The cap is global — somebody who said "three children" meant three, not
  /// three per school — but `MentorThread` is school-scoped by policy, so an
  /// admin at one school counting them sees only their own and would wave the
  /// expert past their limit at every school after the first. Counting across
  /// schools would mean widening the tenant boundary to a table full of
  /// children's names, to answer a question that is only ever a number.
  ///
  /// So the number lives here, on the row that belongs to no school. Claimed
  /// with a conditional UPDATE like a slot, so two schools booking the last
  /// place at the same moment cannot both win.
  activeMentorships Int @default(0)

  /// Curation. Null means invisible to every school.
  publishedAt DateTime?
  /// Set by the operator to shut the expert out of every school at once (G4-28, risks batch 5 Oct 2026): no way in at
  /// sign-in, told by a sentence there and by email, sessions ended; the recruiter's `disabledAt` is the same rule.
  disabledAt  DateTime?
  /// Set when a human has actually checked who this person is.
  verifiedAt  DateTime?
  verifiedBy  String?

  /// KYC — who this person is, on paper. NONE | SUBMITTED | VERIFIED | REJECTED
  /// (EXPERT_KYC_STATUSES in @edulink/contracts). ONE TRUTH WITH `verifiedAt`:
  /// VERIFIED here sets it, anything else clears it, whichever door was used
  /// (the operator's KYC decision or the older "mark identity checked"), so
  /// the marketplace's badge has exactly one meaning. See src/lib/expert-kyc.ts.
  kycStatus      String    @default("NONE")
  /// The expert's note while the papers wait; the operator's reason once decided.
  kycNote        String?
  kycSubmittedAt DateTime?
  kycDecidedAt   DateTime?
  /// Stored file ids (never URLs) from the upload-ticket pipeline; files.ts
  /// opens them to the expert themself and the operator alone.
  kycDocumentIds String[]  @default([])
  /// The secret in this expert's iCalendar feed URL; null until minted, and
  /// a rotation refuses the old one at once. Slots and school names only —
  /// no pupil is ever named in the feed (decision 0002).
  calendarToken  String?   @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  slots       ExpertSlot[]
  bookings    ExpertBooking[]
  mentorships MentorThread[]

  @@index([publishedAt])
}

/// One bookable window an expert has offered.
///
/// GLOBAL, so every school sees the same marketplace. `bookedAt` is denormalised
/// onto the slot precisely so that a school can tell a taken slot from a free one
/// WITHOUT being able to read the booking — which belongs to whichever school
/// made it and stays behind that school's policy. Availability is public;
/// who booked it is not.
model ExpertSlot {
  id              String @id @default(cuid())
  expertProfileId String

  startsAt DateTime
  endsAt   DateTime
  /// What the expert is offering in this window, if it is specific.
  note     String?

  /// Set the moment a school books it. No school identity here on purpose.
  bookedAt    DateTime?
  cancelledAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  expert  ExpertProfile  @relation(fields: [expertProfileId], references: [id], onDelete: Cascade)
  booking ExpertBooking?

  @@index([expertProfileId, startsAt])
  @@index([startsAt])
}

/// A school's booking of one slot. Tenant-scoped: this is the row that gives an
/// expert access to a school, so it is the row that must be school-owned.
model ExpertBooking {
  id              String @id @default(cuid())
  schoolId        String
  expertProfileId String
  /// The expert's User id, copied from the profile at booking time.
  ///
  /// DENORMALISED TO BREAK A BOOTSTRAP CIRCLE, the same one Membership.userId
  /// breaks for logging in. An expert's tenant set IS their confirmed bookings,
  /// so resolving it means reading this table before any school is known — and
  /// a school-scoped policy refuses exactly that query. With the column here,
  /// `app.user_id` opens an expert's own booking rows and nothing else, read
  /// only, and the tenant set can be computed at all.
  expertUserId    String
  /// One booking per slot, enforced by the database rather than by a check.
  slotId          String @unique

  bookedByMembershipId String?
  /// What the school wants to discuss. Shown to the expert.
  topic                String
  status               String  @default("CONFIRMED") // CONFIRMED | CANCELLED | COMPLETED

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school   School          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  expert   ExpertProfile   @relation(fields: [expertProfileId], references: [id], onDelete: Cascade)
  slot     ExpertSlot      @relation(fields: [slotId], references: [id], onDelete: Cascade)
  bookedBy Membership?     @relation("ExpertBookingBooker", fields: [bookedByMembershipId], references: [id], onDelete: SetNull)
  messages ExpertMessage[]

  @@index([schoolId, status])
  @@index([expertProfileId])
  @@index([bookedByMembershipId])
}

/// A message on a booking, between school staff and the expert.
///
/// Both parties are adults and the thread is about a professional engagement, so
/// there is no consent gate here — that belongs to mentoring, where one end of
/// the conversation is a child.
model ExpertMessage {
  id           String @id @default(cuid())
  schoolId     String
  bookingId    String
  authorUserId String

  body   String
  /// JSON string[] of userIds, same shape as RemarkMessage.readBy.
  readBy String @default("[]")

  createdAt DateTime @default(now())

  school  School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  booking ExpertBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  author  User          @relation(fields: [authorUserId], references: [id], onDelete: Cascade)

  @@index([schoolId, bookingId, createdAt])
  // A foreign key to User needs its own index, or deleting a person scans this table once per row (found by the fleet load test).
  @@index([authorUserId])
}

/// An invitation to become an expert, by link.
///
/// `schoolId` IS NULLABLE, and that is the app owner's route in. A school admin
/// or teacher inviting an expert creates a row naming their school; the person
/// who runs the server creates one naming none, from `npm run expert:invite`.
/// There is no super-admin web role to make that button appear in — running the
/// script requires the database, which is the authorisation.
///
/// The token is stored as its SHA-256, exactly like Invite: what is emailed is
/// the only copy of the secret.
model ExpertInvite {
  id        String  @id @default(cuid())
  schoolId  String?
  tokenHash String  @unique

  email                 String?
  name                  String?
  invitedByMembershipId String?

  expiresAt      DateTime
  acceptedAt     DateTime?
  acceptedUserId String?
  revokedAt      DateTime?

  createdAt DateTime @default(now())

  school    School?     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  invitedBy Membership? @relation("ExpertInviteCreator", fields: [invitedByMembershipId], references: [id], onDelete: SetNull)

  @@index([schoolId])
  @@index([invitedByMembershipId])
}

/// Mentoring — one expert mentoring one child.
///
/// THE THREAD IS NEVER PRIVATE, and that is the feature rather than a setting.
/// An outside adult does not get an unobserved channel with a child, so the
/// child's guardians and the school's admin can always read every message. That
/// is enforced in `mentoring.ts` by who the reader may be, not by a flag anybody
/// could turn off, and there is deliberately no "confidential" mode to add later.
///
/// ONLY SCHOOL STAFF MAY PAIR. Not the expert, who would be choosing their own
/// mentee, and not the child, who cannot consent to an adult stranger. The row
/// records which member of staff did it.
///
/// PARENT CONSENT GATES THE FIRST MESSAGE. `status` stays PENDING_CONSENT until a
/// guardian says yes, and posting is refused until then — the same gate
/// competitions.ts uses, for the same reason and reusing the same notification.
model MentorThread {
  id       String @id @default(cuid())
  schoolId String

  expertProfileId String
  /// Denormalised for the same bootstrap reason as ExpertBooking.expertUserId:
  /// an expert's schools are derived from this table before any school is known.
  expertUserId    String

  studentMembershipId   String
  createdByMembershipId String?

  /// Why this pairing exists. Shown to the guardian being asked to consent.
  purpose String
  /// REQUESTED | PENDING_CONSENT | ACTIVE | CLOSED
  ///
  /// REQUESTED is a PUPIL asking, and it is deliberately a state before the one
  /// staff-created pairings start in. It grants nothing: the expert cannot see
  /// it, nobody can message in it, and it does not occupy one of the expert's
  /// mentee places. A school has to approve it first, and only then does a
  /// guardian get asked.
  status  String @default("PENDING_CONSENT")

  /// Who dealt with the request, and when. Null on staff-created pairings,
  /// which never pass through REQUESTED.
  decidedByMembershipId String?
  decidedAt             DateTime?
  /// Why it was turned down. Read by the pupil who asked.
  declineReason         String?

  parentConsentAt     DateTime?
  parentConsentUserId String?
  closedAt            DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school    School          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  expert    ExpertProfile   @relation(fields: [expertProfileId], references: [id], onDelete: Cascade)
  student   Membership      @relation("MentorStudent", fields: [studentMembershipId], references: [id], onDelete: Cascade)
  createdBy Membership?     @relation("MentorCreator", fields: [createdByMembershipId], references: [id], onDelete: SetNull)
  messages  MentorMessage[]

  @@unique([expertProfileId, studentMembershipId])
  @@index([schoolId, status])
  @@index([studentMembershipId])
  @@index([createdByMembershipId])
}

/// One message in a mentorship. Same shape as RemarkMessage, deliberately.
model MentorMessage {
  id           String @id @default(cuid())
  schoolId     String
  threadId     String
  authorUserId String

  body   String
  /// JSON string[] of userIds.
  readBy String @default("[]")

  createdAt DateTime @default(now())

  school School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  thread MentorThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  author User         @relation(fields: [authorUserId], references: [id], onDelete: Cascade)

  @@index([schoolId, threadId, createdAt])
  // A foreign key to User needs its own index, or deleting a person scans this table once per row (found by the fleet load test).
  @@index([authorUserId])
}

/// A single-use way back in when the phone with the authenticator is gone.
///
/// WITHOUT THESE, TURNING ON 2FA IS A WAY TO LOSE AN ACCOUNT. Changing phone
/// mid-term is ordinary, and the alternative to a recovery code is an
/// administrator who can switch somebody else's second factor off — a much
/// larger hole than the one 2FA closes.
///
/// Only the HASH is stored, like every other credential here: the plaintext is
/// shown once at enrolment and is unrecoverable afterwards. `usedAt` rather than
/// deletion, so somebody can see how many they have spent.
/// What a school certifies about a pupil who has left it.
///
/// A LEAVING CERTIFICATE, AND THAT IS THE WHOLE DESIGN. When a child transfers
/// from Riverside to Oakfield, Oakfield must never be able to read Riverside's
/// rows — that boundary is the point of this schema and Postgres enforces it. So
/// "their previous school" cannot be a query across schools. It is a DOCUMENT
/// the leaving school writes, exactly as a report card is a document rather than
/// a live view of a gradebook, and for the same reason: the school that issued
/// it is accountable for what it says, and nothing about it changes afterwards.
///
/// A SUMMARY, NEVER AN EXPORT. Grade reached, the dates, how many days were
/// marked and how many present, how many report cards were issued. Not the marks
/// themselves, not the attendance day by day, not a message. That is what a real
/// transfer certificate carries, and it is the difference between handing a new
/// school what it needs and handing it a child's file.
///
/// `studentUserId` IS DENORMALISED ON PURPOSE, the same trick and the same
/// reason as `ExpertBooking.expertUserId`: the pupil loses their membership of
/// the issuing school the moment they leave, so a policy keyed only on
/// `schoolId` would hide their own certificate from them. Keyed on their user
/// id, `app.user_id` opens it and nothing else.
model SchoolRecord {
  id String @id @default(cuid())

  /// The school that ISSUED it. Provenance, and what the ordinary tenant policy
  /// scopes by — so the issuer can still read and correct what it wrote.
  schoolId            String
  /// The pupil. See the note above: this is what lets the record travel.
  studentUserId       String
  /// One LIVE record per membership, so re-recording a departure corrects
  /// rather than duplicates, and so undoing one can find it. Null once the
  /// record is closed (see supersededAt).
  studentMembershipId String?   @unique
  /// LIFECYCLE-7 (4 Oct 2026): a departure undone, recorded again, or followed
  /// by readmission CLOSES its record instead of deleting it, so the TC
  /// register keeps every serial it printed and never hands one out twice. A
  /// closed record lets go of the membership (studentMembershipId null: the
  /// one-per-membership index then holds live records only, no certificate
  /// prints the old leaving day and a guardian no longer reads it) and keeps
  /// which membership it was in formerMembershipId.
  formerMembershipId  String?
  supersededAt        DateTime?
  /// READMITTED | UNDONE | RERECORDED
  supersededReason    String?

  /// FROZEN AT ISSUE. A school may rename itself; a certificate it signed in
  /// 2026 does not silently start saying something else.
  schoolName String
  gradeLevel String?
  joinedAt   DateTime
  leftAt     DateTime

  /// THE DOCUMENT'S OWN FIELDS, frozen at issue like the school's name: what a
  /// receiving school's office asks to see on paper. The serial is the
  /// school's own numbering — TC/2026/0042 — one per school per certificate.
  serial          String?
  studentName     String?
  /// The school's own admission register (GR) number, from the pupil record.
  /// NOT the platform's student code, which this line used to carry: a code
  /// that opens an account does not belong on a paper that changes hands.
  admissionNumber String?
  birthdate       DateTime?
  className       String?
  /// EXCELLENT | GOOD | SATISFACTORY — the one word a TC carries about conduct.
  conduct         String?

  /// TRANSFERRED | GRADUATED | LEFT
  reason      String
  /// Where they went, if the school knows. Free text: the receiving school is
  /// very often not on this server, and a dropdown of schools would be a lie.
  destination String?
  note        String?

  /// Snapshot figures. Counts, not rows.
  attendanceMarked  Int @default(0)
  attendancePresent Int @default(0)
  reportCardCount   Int @default(0)

  issuedByMembershipId String?
  createdAt            DateTime @default(now())

  school     School      @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student    User        @relation(fields: [studentUserId], references: [id], onDelete: Cascade)
  membership Membership? @relation(fields: [studentMembershipId], references: [id], onDelete: Cascade)

  @@unique([schoolId, serial])
  @@index([studentUserId])
  @@index([schoolId, leftAt])
  @@index([formerMembershipId])
}

// ---------------------------------------------------------------------------
// Cross-school outreach — the directory, the job board, and the enquiries
// both of them invite. The one corner of the schema where a person who is
// nobody at a school writes a row into that school's tenant, and the writes
// are pinned in scripts/gen-rls.ts exactly the way the global feed's are.
// ---------------------------------------------------------------------------

/// One vacancy a school has put on the platform-wide board.
///
/// GLOBALLY READABLE WHILE OPEN, like an expert's slot: the marketplace only
/// works if every school sees the same board. The clause is `status = 'OPEN'`
/// and DELIBERATELY does not join School — School's own global clause joins
/// this table (a school with an open vacancy is discoverable), and a policy
/// pair that each reference the other is infinite recursion in Postgres. So a
/// removed school's postings are CLOSED by the removal machinery
/// (superuser.ts) instead of being filtered by policy, and restore does not
/// reopen them — a vacancy is timely, and the school that comes back can post
/// it again if it is still real.
model JobPosting {
  id       String @id @default(cuid())
  schoolId String

  title          String
  /// The school's own words: duties, requirements, how to apply. Plain text.
  body           String
  /// JSON string[] — the same subject vocabulary Membership.subjects uses, so
  /// a teacher's profile and a vacancy can one day be matched mechanically.
  subjects       String @default("[]")
  /// FULL_TIME | PART_TIME | TEMPORARY — EMPLOYMENT_TYPES in constants.ts.
  employmentType String @default("FULL_TIME")

  /// Where a teacher's enquiry lands: an ACTIVE ADMIN, PRINCIPAL or TEACHER
  /// membership of this school, named when the vacancy is posted. Required —
  /// a vacancy with nobody behind it invites enquiries into a void.
  hiringContactMembershipId String
  postedByMembershipId      String?

  status   String    @default("OPEN") // OPEN | CLOSED
  closedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school        School      @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  hiringContact Membership  @relation("JobPostingContact", fields: [hiringContactMembershipId], references: [id], onDelete: Cascade)
  postedBy      Membership? @relation("JobPostingPoster", fields: [postedByMembershipId], references: [id], onDelete: SetNull)
  enquiries     Enquiry[]

  @@index([schoolId, status])
  @@index([status, createdAt])
  @@index([hiringContactMembershipId])
  @@index([postedByMembershipId])
}

/// One person's conversation with a school they do not belong to.
///
/// A parent asking about admission, or a teacher asking about a vacancy. The
/// row lives in the TARGET school's tenant — the school answers it from its
/// own desk — and the opener keeps reading it through a self clause on
/// `fromUserId`, exactly the way a leaver keeps reading their own
/// SchoolRecord. Deliberately a thread and not a one-shot ping: an enquiry
/// whose answer cannot be replied to just moves the conversation to a phone
/// number, which is the thing this feature exists to replace.
///
/// WHAT THIS IS NOT: free-mail between schools. The insert policy admits an
/// enquiry only against a school that published its profile (ADMISSION) or a
/// vacancy that is open (JOB) — the school's own opt-in is the door, and
/// closing the profile or the vacancy closes it for new enquiries while the
/// existing threads live on.
model Enquiry {
  id       String @id @default(cuid())
  schoolId String

  /// ADMISSION | JOB — ENQUIRY_KINDS in constants.ts.
  kind         String
  jobPostingId String?
  fromUserId   String

  status   String    @default("OPEN") // OPEN | CLOSED
  closedAt DateTime?

  /// Copies that SURVIVE THE BOUNDARY, the `globalSchoolName` precedent: the
  /// school's name, and the vacancy's title (or "" for an admission
  /// enquiry), taken at the moment of writing. The live School and
  /// JobPosting rows stop being readable to the opener the moment the school
  /// unpublishes or the vacancy closes — correctly — and without the copies
  /// their own enquiries page would list conversations with nobody about
  /// nothing.
  schoolName String
  subject    String @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school     School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  jobPosting JobPosting?      @relation(fields: [jobPostingId], references: [id], onDelete: SetNull)
  fromUser   User             @relation("EnquiryOpener", fields: [fromUserId], references: [id], onDelete: Cascade)
  messages   EnquiryMessage[]

  @@index([schoolId, status, createdAt])
  @@index([fromUserId, createdAt])
}

/// One message on an enquiry, from either side.
///
/// Same shape as RemarkMessage. `readBy` is the school side's read marker;
/// the opener is told about replies by notification instead, because marking
/// a row read would be a cross-tenant UPDATE and the notification already
/// carries the news.
model EnquiryMessage {
  id           String @id @default(cuid())
  schoolId     String
  enquiryId    String
  authorUserId String

  body   String
  /// JSON string[] of userIds, same shape as RemarkMessage.readBy.
  readBy String @default("[]")

  createdAt DateTime @default(now())

  school  School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  enquiry Enquiry @relation(fields: [enquiryId], references: [id], onDelete: Cascade)
  author  User    @relation("EnquiryMessageAuthor", fields: [authorUserId], references: [id], onDelete: Cascade)

  @@index([schoolId, enquiryId, createdAt])
  // A foreign key to User needs its own index, or deleting a person scans this table once per row (found by the fleet load test).
  @@index([authorUserId])
}

// ---------------------------------------------------------------------------
// Conversations — a person writing to a person, inside one school.
//
// RemarkThread is the room ABOUT A PUPIL: teacher, child and guardians, keyed
// on the pupil so the family is in it by construction. It was the only
// message shape the platform had, which meant a principal could not write to
// a teacher, an admin could not answer a parent's question, and two teachers
// planning a trip had to use WhatsApp. This is the other shape: two (or more)
// people in one school, keyed on nothing but who is in it.
//
// The room belongs to the SCHOOL, not to the people — `schoolId` on all three
// tables, so the one-line tenant policy applies as everywhere else, a parent
// reaches it through the child's school binding, and a person who leaves the
// school stops reading it the day they leave. Who may open one with whom is
// the application's rule (lib/conversations.ts): a pupil only ever writes to
// staff, never to another pupil or to somebody else's parent — the same
// safeguarding line RemarkThread draws, drawn again here.
// ---------------------------------------------------------------------------

model Conversation {
  id             String    @id @default(cuid())
  schoolId       String
  createdById    String
  createdAt      DateTime  @default(now())
  lastMessageAt  DateTime  @default(now())
  /// "<schoolId>:<userId>:<userId>" with the two ids sorted — the database's
  /// own guarantee that two people share ONE room, which find-then-create
  /// could not give under a double tap. Null on rooms made before the key
  /// existed; they are keyed the first time they are found again.
  pairKey        String?   @unique
  /// CLOSED BY STAFF (the alumni module, 3 Oct 2026): a teacher, the head or
  /// the office may close a room a former pupil opened; the alumnus cannot
  /// write in it again until staff write (which reopens it) or reopen it.
  /// Null for an open room, which is every room before the alumni module.
  closedAt       DateTime?
  closedByUserId String?

  school       School                    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  participants ConversationParticipant[]
  messages     ConversationMessage[]

  @@index([schoolId, lastMessageAt])
}

model ConversationParticipant {
  id             String    @id @default(cuid())
  conversationId String
  schoolId       String
  userId         String
  /// The moment this person last opened the room. Unread = a message after it
  /// that they did not write.
  lastReadAt     DateTime?

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  school       School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([schoolId, userId])
  // A foreign key to User needs its own index, or deleting a person scans this table once per row (found by the fleet load test).
  @@index([userId])
}

model ConversationMessage {
  id             String   @id @default(cuid())
  conversationId String
  schoolId       String
  authorUserId   String
  body           String
  createdAt      DateTime @default(now())
  // Idempotency key minted on the device before the message is queued, so a
  // replay from the offline outbox lands once. Null for messages sent online
  // before the key existed.
  clientId       String?

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  school       School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  author       User         @relation(fields: [authorUserId], references: [id], onDelete: Cascade)

  @@unique([conversationId, clientId])
  @@index([conversationId, createdAt])
  @@index([schoolId])
  // A foreign key to User needs its own index, or deleting a person scans this table once per row (found by the fleet load test).
  @@index([authorUserId])
}

// ---------------------------------------------------------------------------
// Fees
//
// THE MONEY NEVER PASSES THROUGH THIS PLATFORM. A parent pays the school —
// into the school's own gateway account or straight to the school's UPI id —
// and these tables are the school's ledger of what was asked for and what
// arrived. There is no platform account, no fee, share or markup column, and
// no table that could hold funds in transit; docs/decisions/0003 says why and
// tests/fees-invariants.test.ts keeps it so.
//
// Every amount is INTEGER PAISE. Never a float, never rupees: ₹1,250.50 is
// 125050. Sums happen in the database.
//
// The ledger is APPEND-ONLY. A posted payment is never edited: a mistake is
// reversed (status REVERSED, with who and why), and its receipt stays on file
// marked as such. A demand's `paidPaise` is derived from its PAID allocations.
// ---------------------------------------------------------------------------

/// A line a school prints on its receipt: Tuition, Transport, Exam, Library.
model FeeHead {
  id        String    @id @default(cuid())
  schoolId  String
  name      String
  /// Short, stable, unique per school — "TUI", "TRN". Referenced by exports.
  code      String
  /// TUITION | TRANSPORT | EXAM | ACTIVITY | OTHER — a grouping for reports, not behaviour.
  kind      String    @default("OTHER")
  sortOrder Int       @default(0)
  retiredAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school      School          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  lines       FeeLine[]
  concessions FeeConcession[]

  @@unique([schoolId, code])
  @@index([schoolId, retiredAt])
}

/// What a grade pays in a year, in instalments. Published structures are
/// frozen: a change after publishing is a new structure, so a demand already
/// generated can always be traced to the lines that produced it.
model FeeStructure {
  id               String    @id @default(cuid())
  schoolId         String
  academicYearId   String
  name             String
  /// Null means every grade; otherwise the grade level it applies to, as the
  /// school names grades ("5", "K").
  gradeLevel       String?
  publishedAt      DateTime?
  archivedAt       DateTime?
  /// Open to families: a guardian may put their child on this structure
  /// themselves (while it is published, not archived, and the child is on no
  /// plan this year with nothing paid). The office turns it on per structure.
  selfEnrol        Boolean   @default(false)
  /// A COLLEGE'S STRUCTURE (4 Oct 2026): for one programme (the academics
  /// module's Programme.id), one year of study and one category, as the fee
  /// regulating authority approved it, with its approval reference and the
  /// late-fee slabs (JSON [{ afterDays, paise }]). Null on a school's.
  programmeId      String?
  yearOfStudy      Int?
  /// One of COLLEGE_CATEGORIES.
  category         String?
  approvalRef      String?
  lateFeeSlabsJson String    @default("[]")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school          School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  year            AcademicYear     @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  instalments     FeeInstalment[]
  plans           StudentFeePlan[]
  admissionCycles AdmissionCycle[]
  applications    Application[]

  @@index([schoolId, academicYearId])
  @@index([academicYearId])
}

/// "Term 1, due 15 June" — one due date within a structure.
model FeeInstalment {
  id          String   @id @default(cuid())
  schoolId    String
  structureId String
  label       String
  sortOrder   Int      @default(0)
  /// A calendar day in the school's zone, stored at UTC midnight of that day.
  dueDate     DateTime

  school    School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  structure FeeStructure @relation(fields: [structureId], references: [id], onDelete: Cascade)
  lines     FeeLine[]
  demands   FeeDemand[]

  @@index([structureId, sortOrder])
  @@index([schoolId])
}

/// One head's amount within one instalment.
model FeeLine {
  id           String @id @default(cuid())
  schoolId     String
  instalmentId String
  headId       String
  amountPaise  Int

  school     School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  instalment FeeInstalment @relation(fields: [instalmentId], references: [id], onDelete: Cascade)
  head       FeeHead       @relation(fields: [headId], references: [id], onDelete: NoAction)

  @@unique([instalmentId, headId])
  @@index([headId])
  @@index([schoolId])
}

/// Which structure a pupil is on for a year. One per pupil per year.
model StudentFeePlan {
  id                  String @id @default(cuid())
  schoolId            String
  studentMembershipId String
  structureId         String
  academicYearId      String

  createdAt DateTime @default(now())

  school    School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student   Membership   @relation("FeePlanStudent", fields: [studentMembershipId], references: [id], onDelete: Cascade)
  structure FeeStructure @relation(fields: [structureId], references: [id], onDelete: Cascade)
  year      AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)

  @@unique([studentMembershipId, academicYearId])
  @@index([structureId])
  @@index([schoolId, academicYearId])
  @@index([academicYearId])
}

/// A reduction for one pupil in one year: a percentage or a fixed amount,
/// on one head or on everything. Applied per line, rounded half up to the
/// paisa, when the pupil's demands are generated or regenerated.
model FeeConcession {
  id                  String    @id @default(cuid())
  schoolId            String
  studentMembershipId String
  academicYearId      String
  /// Null means every head.
  headId              String?
  /// PERCENT | AMOUNT
  kind                String
  /// Basis points for PERCENT (10000 = 100 %), paise for AMOUNT — per instalment line.
  value               Int
  reason              String
  grantedByUserId     String
  revokedAt           DateTime?
  /// A college's concession (4 Oct 2026): who sanctioned it (the authority
  /// named on the order), and — above the office's limit — the principal's
  /// approval, without which it is not applied. A school's is APPROVED.
  authority           String?
  /// APPROVED | PENDING | REFUSED
  approvalStatus      String    @default("APPROVED")
  approvedByUserId    String?
  approvedAt          DateTime?

  createdAt DateTime @default(now())

  school    School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student   Membership   @relation("FeeConcessionStudent", fields: [studentMembershipId], references: [id], onDelete: Cascade)
  year      AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  head      FeeHead?     @relation(fields: [headId], references: [id], onDelete: NoAction)
  grantedBy User         @relation("FeeConcessionGranter", fields: [grantedByUserId], references: [id], onDelete: Cascade)

  @@index([schoolId, studentMembershipId])
  @@index([studentMembershipId])
  @@index([academicYearId])
  @@index([headId])
  @@index([grantedByUserId])
}

/// What one pupil owes for one instalment — the materialised due. Generated
/// when a plan is assigned; regenerated only while nothing has been paid
/// against it. `linesJson` freezes the head-by-head breakdown so the receipt
/// can print it after the structure moves on.
model FeeDemand {
  id                  String   @id @default(cuid())
  schoolId            String
  studentMembershipId String
  academicYearId      String
  /// Null for an opening balance carried in from the previous year.
  instalmentId        String?
  label               String
  dueDate             DateTime
  grossPaise          Int
  concessionPaise     Int      @default(0)
  netPaise            Int
  paidPaise           Int      @default(0)
  /// OPEN | PART | PAID | WAIVED | CANCELLED | CARRIED
  status              String   @default("OPEN")
  /// JSON: [{ headId, code, name, grossPaise, concessionPaise }]
  linesJson           String   @default("[]")
  /// The last reminder bucket sent for this demand ("D-7:2026-06-08"), so a
  /// daily job sends each once.
  lastReminderKey     String?
  /// When CARRIED: the opening-balance demand in the next year.
  carriedToDemandId   String?
  /// THE IDENTITY OF A CHARGE RAISED ONCE (QA-07, QA campaign of 24 October 2026): language-free,
  /// "MESS:2026-10" or "ROUTE:<academicYearId>:<routeId>:<term>". The label is a sentence in the
  /// institution's language and was once the key, so a month billed in Hindi after English was billed
  /// twice. Unique per student, so two presses at once raise one; a CANCELLED charge gives its key up
  /// when the same charge is raised again. Null for everything else. One writer: college-fees.ts raiseOnce.
  raisedKey           String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school      School          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student     Membership      @relation("FeeDemandStudent", fields: [studentMembershipId], references: [id], onDelete: Cascade)
  year        AcademicYear    @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  instalment  FeeInstalment?  @relation(fields: [instalmentId], references: [id], onDelete: Cascade)
  allocations FeeAllocation[]

  @@unique([studentMembershipId, instalmentId])
  @@unique([studentMembershipId, raisedKey])
  @@index([schoolId, status, dueDate])
  @@index([schoolId, studentMembershipId])
  @@index([instalmentId])
  @@index([academicYearId])
}

/// Money that arrived (or was claimed to have, or was asked for).
///
/// ONLINE: an order at the school's gateway, settled by its webhook.
/// UPI: paid to the school's UPI id by the parent, who enters the UTR; the
///      office confirms it against the bank statement before a receipt exists.
/// CASH | CHEQUE | BANK: taken at the counter and recorded by the office.
///
/// INITIATED → (CLAIMED →) PAID | FAILED; PAID → REVERSED | REFUNDED.
model FeePayment {
  id                  String    @id @default(cuid())
  schoolId            String
  studentMembershipId String
  amountPaise         Int
  /// ONLINE | UPI | CASH | CHEQUE | BANK
  method              String
  /// INITIATED | CLAIMED | PAID | FAILED | REVERSED | REFUNDED
  status              String    @default("INITIATED")
  /// The caller's idempotency key: the office's form replayed twice records once.
  clientId            String?
  /// A UTR, a cheque number, a bank reference — whatever proves it.
  reference           String?
  gatewayOrderId      String?   @unique
  gatewayPaymentId    String?   @unique
  /// How the gateway says it was paid (upi, card, netbanking), for the receipt.
  gatewayMethod       String?
  note                String?
  /// The demands this payment was started for, in order; allocated on settlement.
  intentJson          String    @default("[]")
  /// The guardian who paid online or claimed a UPI transfer.
  payerUserId         String?
  /// The office person who took it at the counter.
  collectedByUserId   String?
  /// The office person who confirmed a UPI claim.
  confirmedByUserId   String?
  claimedAt           DateTime?
  paidAt              DateTime?
  failedReason        String?
  reversedAt          DateTime?
  reversedByUserId    String?
  reversalReason      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school      School          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student     Membership      @relation("FeePaymentStudent", fields: [studentMembershipId], references: [id], onDelete: Cascade)
  payer       User?           @relation("FeePayer", fields: [payerUserId], references: [id], onDelete: SetNull)
  collectedBy User?           @relation("FeeCollector", fields: [collectedByUserId], references: [id], onDelete: SetNull)
  confirmedBy User?           @relation("FeeConfirmer", fields: [confirmedByUserId], references: [id], onDelete: SetNull)
  reversedBy  User?           @relation("FeeReverser", fields: [reversedByUserId], references: [id], onDelete: SetNull)
  allocations FeeAllocation[]
  receipt     FeeReceipt?
  refunds     FeeRefund[]

  @@unique([schoolId, clientId])
  @@index([schoolId, status, createdAt])
  @@index([schoolId, studentMembershipId])
  @@index([studentMembershipId])
  @@index([payerUserId])
  @@index([collectedByUserId])
  @@index([confirmedByUserId])
  @@index([reversedByUserId])
}

/// Which demand a payment settled, and how much of it — so a part payment
/// and one payment across several dues are both plain rows.
model FeeAllocation {
  id          String @id @default(cuid())
  schoolId    String
  paymentId   String
  demandId    String
  amountPaise Int

  school  School     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  payment FeePayment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  demand  FeeDemand  @relation(fields: [demandId], references: [id], onDelete: Cascade)

  @@index([paymentId])
  @@index([demandId])
  @@index([schoolId])
}

/// The numbered receipt for a PAID payment. `snapshotJson` is the document —
/// school, pupil, class, lines, method, reference — frozen at issue, so a
/// later rename or a reversed structure never changes what was printed.
model FeeReceipt {
  id             String   @id @default(cuid())
  schoolId       String
  paymentId      String   @unique
  academicYearId String
  number         Int
  /// "RCPT/2026-27/000123"
  serial         String
  issuedAt       DateTime @default(now())
  snapshotJson   String

  school  School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  payment FeePayment   @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  year    AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)

  @@unique([schoolId, academicYearId, number])
  @@index([schoolId, issuedAt])
  @@index([academicYearId])
}

/// A refund against a PAID payment. ONLINE ones go back to the instrument
/// through the school's gateway; the rest are recorded here after the office
/// has paid the family back itself.
model FeeRefund {
  id                String    @id @default(cuid())
  schoolId          String
  paymentId         String
  amountPaise       Int
  reason            String
  /// REQUESTED | DONE | FAILED
  status            String    @default("REQUESTED")
  gatewayRefundId   String?
  /// What this refund took off each allocation, JSON [{ allocationId,
  /// amountPaise }]: the demand is reopened when the refund is asked for, so a
  /// refund the gateway then fails has to put back exactly what it took.
  cutsJson          String?
  /// The gateway's reason, when it failed.
  failedReason      String?
  requestedByUserId String
  settledAt         DateTime?

  createdAt DateTime @default(now())

  school      School     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  payment     FeePayment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  requestedBy User       @relation("FeeRefundRequester", fields: [requestedByUserId], references: [id], onDelete: Cascade)

  @@index([paymentId])
  @@index([schoolId])
  @@index([requestedByUserId])
}

/// The school's OWN gateway account — its key id and, encrypted at rest with
/// FEES_SECRET_KEY, its secret and webhook secret. One per school. There is
/// deliberately no platform-level row: the platform holds no account.
model FeeGatewayAccount {
  id               String @id @default(cuid())
  schoolId         String @unique
  /// RAZORPAY
  provider         String @default("RAZORPAY")
  keyId            String
  secretEnc        String
  webhookSecretEnc String
  /// TEST | LIVE
  mode             String @default("TEST")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
}

/// Every webhook the gateway delivered, by its event id — so a redelivery is
/// answered "already" and never settles a payment twice.
model GatewayEvent {
  id          String    @id @default(cuid())
  schoolId    String
  provider    String
  eventId     String
  kind        String
  receivedAt  DateTime  @default(now())
  processedAt DateTime?
  outcome     String?
  payloadJson String

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([schoolId, provider, eventId])
  @@index([schoolId, receivedAt])
}

// ---------------------------------------------------------------------------
// Texts to families: SMS and WhatsApp
//
// A row per message the platform tried to send a person, whatever happened
// to it — QUEUED, SENT, DELIVERED, FAILED, UNDELIVERED, or SKIPPED with the
// reason (no number, opted out, channel off, cap reached). The skipped rows
// are the point: a family that was not reached must be visible, not absent.
// ---------------------------------------------------------------------------

model OutboundMessage {
  id             String  @id @default(cuid())
  schoolId       String
  /// The recipient's account. Every number this release texts belongs to one.
  userId         String?
  /// E.164.
  to             String
  /// SMS | WHATSAPP
  channel        String
  /// A key in src/lib/message-templates.ts; the rendered text is `body`.
  templateKey    String
  locale         String  @default("en")
  varsJson       String  @default("{}")
  body           String
  /// QUEUED | SENT | DELIVERED | FAILED | UNDELIVERED | SKIPPED
  status         String  @default("QUEUED")
  /// For SKIPPED: no-phone | opted-out | channel-off | event-off | cap-monthly | cap-daily | no-transport
  skipReason     String?
  /// The provider's message id, once accepted; the status webhook finds the row by it.
  providerSid    String? @unique
  providerStatus String?
  error          String?
  /// SMS segments the provider billed, for the cap and the report. 1 until told otherwise.
  segments       Int     @default(1)
  broadcastId    String?
  /// What sent it: absence | fees:dueSoon | fees:overdue | fees:received | circular | broadcast | test
  purpose        String

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  sentAt      DateTime?
  deliveredAt DateTime?

  school    School     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user      User?      @relation("MessageRecipient", fields: [userId], references: [id], onDelete: SetNull)
  broadcast Broadcast? @relation(fields: [broadcastId], references: [id], onDelete: SetNull)

  @@index([schoolId, createdAt])
  @@index([schoolId, status])
  @@index([broadcastId])
  @@index([userId, createdAt])
}

/// One notice the office sent to many families at once, and how it went.
model Broadcast {
  id           String @id @default(cuid())
  schoolId     String
  authorUserId String
  /// The office's own label for the report page.
  title        String
  /// The notice as sent, at most 300 characters — one template, one variable.
  body         String
  /// JSON string[] of channels tried, in order: "WHATSAPP", "SMS", "PUSH".
  channelsJson String @default("[]")
  /// JSON { kind: ALL_PARENTS | CLASS | GRADE | OVERDUE_FEES | PEOPLE, classId?, gradeLevel?, userIds? }
  audienceJson String
  recipients   Int    @default(0)
  queued       Int    @default(0)
  sent         Int    @default(0)
  delivered    Int    @default(0)
  failed       Int    @default(0)
  skipped      Int    @default(0)
  /// SENDING | DONE
  status       String @default("SENDING")

  createdAt DateTime  @default(now())
  doneAt    DateTime?

  school   School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  author   User              @relation("BroadcastAuthor", fields: [authorUserId], references: [id], onDelete: Cascade)
  messages OutboundMessage[]

  @@index([schoolId, createdAt])
  @@index([authorUserId])
}

/// The pupil's health and emergency card: what a teacher must know before
/// the ambulance question is asked. One per pupil, written by the office or
/// a guardian, read by the child's teachers. Free text on purpose — an
/// allergy list is not an enum — and kept short by the contracts.
model HealthCard {
  id                  String   @id @default(cuid())
  schoolId            String
  studentMembershipId String   @unique
  /// A+ A- B+ B- AB+ AB- O+ O- or null for "not known".
  bloodGroup          String?
  allergies           String   @default("")
  conditions          String   @default("")
  medications         String   @default("")
  dietary             String   @default("")
  /// Anything else a teacher must know: "carries an inhaler", "no sport this term".
  notes               String   @default("")
  doctorName          String?
  doctorPhone         String?
  /// JSON [{ name, relation, phone }], at most three, in the order to call.
  contactsJson        String   @default("[]")
  updatedByUserId     String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  school  School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student Membership    @relation(fields: [studentMembershipId], references: [id], onDelete: Cascade)
  checks  HealthCheck[]

  @@index([schoolId])
}

/// One school health check-up: the nurse's or the camp's measurements on a
/// day. Append-only; the card shows the latest and the history.
model HealthCheck {
  id                  String   @id @default(cuid())
  schoolId            String
  cardId              String
  studentMembershipId String
  dateKey             String
  heightCm            Int?
  /// Grams, so 32.5 kg is an integer.
  weightGrams         Int?
  visionLeft          String?
  visionRight         String?
  notes               String   @default("")
  recordedByUserId    String?
  createdAt           DateTime @default(now())

  school  School     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  card    HealthCard @relation(fields: [cardId], references: [id], onDelete: Cascade)
  student Membership @relation(fields: [studentMembershipId], references: [id], onDelete: Cascade)

  @@index([schoolId, studentMembershipId, dateKey])
}

/// The sick-room and incident log: a fall in the playground, a fever at
/// eleven, a fight at the gate. Recorded by the teacher who was there,
/// told to the family at once, kept on the child's file. A record is never
/// edited after the fact — follow-ups are notes appended below it — so what
/// the office reads a year later is what was written on the day.
model Incident {
  id                     String    @id @default(cuid())
  schoolId               String
  studentMembershipId    String
  reportedByMembershipId String
  /// INJURY | ILLNESS | BEHAVIOUR | SAFEGUARDING | OTHER
  kind                   String
  /// MINOR | MODERATE | SERIOUS
  severity               String    @default("MINOR")
  occurredAt             DateTime
  place                  String?
  title                  String
  /// What happened, in the reporter's words.
  body                   String
  /// What was done: first aid, rest in the sick room, sent home, doctor called.
  actionTaken            String    @default("")
  /// Whether the family was told by this record (a push/text at once) and when.
  guardiansNotifiedAt    DateTime?
  /// OPEN | CLOSED — the office closes it once follow-up is done.
  status                 String    @default("OPEN")
  closedAt               DateTime?
  closedByUserId         String?
  createdAt              DateTime  @default(now())
  /// The hostel the incident happened in, when a warden recorded it (the hostel module's tag, 3 Oct 2026); null otherwise.
  hostelId               String?
  updatedAt              DateTime  @updatedAt

  school     School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student    Membership     @relation("IncidentStudent", fields: [studentMembershipId], references: [id], onDelete: Cascade)
  reportedBy Membership     @relation("IncidentReporter", fields: [reportedByMembershipId], references: [id], onDelete: Cascade)
  notes      IncidentNote[]

  @@index([schoolId, status, occurredAt])
  @@index([schoolId, studentMembershipId, occurredAt])
  @@index([reportedByMembershipId])
  @@index([schoolId, hostelId, occurredAt])
}

/// A follow-up on an incident: the nurse's note, the call to the family, the
/// head's decision. Append-only.
model IncidentNote {
  id           String   @id @default(cuid())
  schoolId     String
  incidentId   String
  authorUserId String
  body         String
  createdAt    DateTime @default(now())

  school   School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  incident Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  @@index([incidentId, createdAt])
  @@index([schoolId])
}

/// The staff register: one row per staff member per day. Marked by the
/// office for the whole staff room, or by the person themselves with a
/// check-in on the phone (present, or late after the school's grace); a
/// day inside an approved leave shows as ON_LEAVE without a row. Feeds the
/// monthly summary and, later, the substitution board.
model StaffAttendance {
  id             String    @id @default(cuid())
  schoolId       String
  membershipId   String
  dateKey        String
  /// PRESENT | LATE | HALF_DAY | ABSENT | ON_LEAVE
  status         String
  /// SELF (a check-in) | OFFICE (marked at the desk)
  source         String    @default("OFFICE")
  checkedInAt    DateTime?
  note           String?
  markedByUserId String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  school     School     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@unique([membershipId, dateKey])
  @@index([schoolId, dateKey])
}

/// A chapter of the syllabus for one grade and subject, in teaching order.
/// The office writes the list (or pastes it from the board's syllabus);
/// each class of that grade ticks its way through it.
model SyllabusUnit {
  id             String   @id @default(cuid())
  schoolId       String
  gradeLevel     String
  subject        String
  position       Int
  title          String
  /// Periods the plan allows; informational.
  periodsPlanned Int?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  school   School             @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  progress SyllabusProgress[]
  lessons  LessonPlan[]

  @@index([schoolId, gradeLevel, subject, position])
}

/// Where one class stands on one unit: not started, in progress, done, with
/// when and by whom. A class's coverage of a subject is done units over all.
model SyllabusProgress {
  id             String   @id @default(cuid())
  schoolId       String
  classId        String
  unitId         String
  /// NOT_STARTED | IN_PROGRESS | DONE
  status         String   @default("NOT_STARTED")
  doneOn         String?
  byMembershipId String?
  updatedAt      DateTime @updatedAt

  school School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  class  Class        @relation(fields: [classId], references: [id], onDelete: Cascade)
  unit   SyllabusUnit @relation(fields: [unitId], references: [id], onDelete: Cascade)
  by     Membership?  @relation("SyllabusProgressBy", fields: [byMembershipId], references: [id], onDelete: SetNull)

  @@unique([classId, unitId])
  @@index([schoolId, classId])
}

/// One lesson as planned and then as taught: a class, a subject, a day, the
/// topic, and optionally the unit it belongs to. Marking it taught moves the
/// unit to in progress if nothing has yet.
model LessonPlan {
  id                  String   @id @default(cuid())
  schoolId            String
  classId             String
  teacherMembershipId String
  subject             String
  unitId              String?
  dateKey             String
  topic               String
  notes               String   @default("")
  homework            String   @default("")
  /// PLANNED | TAUGHT | SKIPPED
  status              String   @default("PLANNED")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  school  School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  class   Class         @relation(fields: [classId], references: [id], onDelete: Cascade)
  teacher Membership    @relation("LessonPlanTeacher", fields: [teacherMembershipId], references: [id], onDelete: Cascade)
  unit    SyllabusUnit? @relation(fields: [unitId], references: [id], onDelete: SetNull)

  @@index([schoolId, classId, subject, dateKey])
  @@index([teacherMembershipId, dateKey])
}

/// One lesson covered on one day: the timetable's slot, who was away, who
/// took it. The board for a day is every lesson of an absent teacher and
/// the row here that says who is standing in; a row cleared is a lesson
/// uncovered again. The substitute is told when the row is written.
model Substitution {
  id                     String    @id @default(cuid())
  schoolId               String
  dateKey                String
  slotId                 String
  absentMembershipId     String
  substituteMembershipId String
  note                   String?
  createdByUserId        String?
  /// The covering teacher's answer: seen and taken, or declined with a reason
  /// so the office reassigns. Reassigning to someone else clears both; the
  /// same person again keeps their answer.
  acknowledgedAt         DateTime?
  declinedAt             DateTime?
  declineReason          String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  school     School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  slot       TimetableSlot @relation(fields: [slotId], references: [id], onDelete: Cascade)
  absent     Membership    @relation("SubstitutionAbsent", fields: [absentMembershipId], references: [id], onDelete: Cascade)
  substitute Membership    @relation("SubstitutionCovering", fields: [substituteMembershipId], references: [id], onDelete: Cascade)

  @@unique([slotId, dateKey])
  @@index([schoolId, dateKey])
  @@index([substituteMembershipId, dateKey])
}

/// THE PUPIL RECORD: the identity and admission details an Indian school
/// certificate names — parents' names, place of birth, nationality, religion,
/// caste and category, mother tongue, home address, the admission register
/// number and date, the last school, the UDISE+ PEN. Filled by the family
/// after joining or when the office asks, corrected by the office. No
/// Aadhaar: a school may not demand it and the app does not hold it.
/// Policy: docs/decisions/0002, row 28.
model PupilRecord {
  id                     String    @id @default(cuid())
  schoolId               String
  studentMembershipId    String    @unique
  fatherName             String?
  motherName             String?
  placeOfBirth           String?
  nationality            String?
  religion               String?
  caste                  String?
  category               String?
  motherTongue           String?
  addressLine            String?
  city                   String?
  postalCode             String?
  /// The school's own admission register (GR) number, distinct from the platform's student code.
  admissionNumber        String?
  admissionDate          DateTime?
  admittedToGrade        String?
  previousSchool         String?
  /// The transfer certificate the previous school issued — its number and date — which the
  /// admission register records and a board's pre-list asks for.
  previousSchoolTcNumber String?
  previousSchoolTcDate   DateTime?
  /// The household as the RTE and EWS verifications ask for it: each parent's occupation and the
  /// family's annual income in rupees. Read by no filing sheet yet; the office and the family fill them.
  fatherOccupation       String?
  motherOccupation       String?
  annualIncome           Int?
  /// Admitted under the Right to Education Act's quota: the office's answer,
  /// null until it has given one. It was read off the EWS answer, which is
  /// a different fact — a family may be one and not the other.
  rte                    Boolean?
  /// THE NUMBER THE SCHOOL RINGS, as the admission form gives it: written by
  /// the office or the family, unverified, E.164. It is the record's and NOT
  /// the account's — `User.phone` is proved by a code and is a way to sign
  /// in and to reset a password, so nobody but its owner may write it. This
  /// one signs nobody in. The filings print a linked guardian's own proved
  /// number first and this one when there is none.
  guardianPhone          String?
  /// UDISE+ Permanent Education Number.
  penNumber              String?
  /// THE SHEET'S PLAIN ANSWERS, added 2026-09-30: a second number to ring;
  /// whether the pupil was given a free uniform and free textbooks this
  /// year and takes part in extracurricular activity; and, for the higher
  /// secondary, the stream and the vocational course as the portal codes
  /// them. Nothing here is an identifier or a welfare, health or income
  /// fact; those the sheet still leaves for the office (decision 0002).
  alternatePhone         String?
  freeUniform            Boolean?
  freeTextbook           Boolean?
  extracurricular        Boolean?
  stream                 String?
  vocationalCourse       Boolean?
  vocationalTradeId      String?
  vocationalJobRoleId    String?
  vocationalExamAppeared Boolean?
  /// FILINGS: what UDISE+ and the boards ask beyond the certificate fields.
  /// Gender as the portal codes it (M | F | T); the name and the parents'
  /// names in the school's own script for a state board that files in it;
  /// below-poverty-line and economically-weaker-section flags; the type of
  /// disability in the portal's list, or null; the second language and the
  /// board's subject codes the pupil sits. Never Aadhaar.
  gender                 String?
  nameLocal              String?
  fatherNameLocal        String?
  motherNameLocal        String?
  bpl                    Boolean?
  ews                    Boolean?
  cwsnType               String?
  bloodGroup             String?
  /// A COLLEGE STUDENT'S RECORD (4 Oct 2026): the university's permanent
  /// registration number, the APAAR id and the Academic Bank of Credits id,
  /// and the category, quota, round and year of entry of the admission.
  /// Never Aadhaar (decision 0002).
  prn                    String?
  apaarId                String?
  abcId                  String?
  admissionCategory      String?
  admissionQuota         String?
  admissionRoundId       String?
  yearOfEntry            Int?
  /// When the office last asked the family to fill it in, and when the family last did.
  requestedAt            DateTime?
  familyFilledAt         DateTime?
  updatedByUserId        String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  school  School     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student Membership @relation(fields: [studentMembershipId], references: [id], onDelete: Cascade)

  @@index([schoolId])
}

/// A certificate the office designs once and issues many times: a kind (TC,
/// Nirgam Utara, Bonafide, Character, Study, or the school's own), a
/// language, a heading, an opening paragraph, numbered rows of label and
/// placeholder, a closing paragraph, the layout and the serial prefix.
model CertificateTemplate {
  id              String   @id @default(cuid())
  schoolId        String
  /// TC | NIRGAM | BONAFIDE | CHARACTER | STUDY | CUSTOM
  kind            String
  name            String
  /// en | hi | mr — the language the document is written in, whoever reads it.
  locale          String   @default("en")
  title           String
  intro           String   @default("")
  /// JSON [{label, value}] where value is text with {{placeholders}}.
  rowsJson        String   @default("[]")
  outro           String   @default("")
  /// JSON: showLogo, showAddress, signatureLeft, signatureRight, footerNote, paper, useBrandColour.
  layoutJson      String   @default("{}")
  serialPrefix    String
  active          Boolean  @default(true)
  createdByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  school       School              @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  certificates IssuedCertificate[]

  @@unique([schoolId, name])
  @@index([schoolId, kind])
}

/// One certificate issued to one pupil: a DOCUMENT, frozen at issue — the
/// resolved rows and paragraphs, the layout, the data they were filled from
/// — with a serial per year and prefix and a code anyone can verify it by.
model IssuedCertificate {
  id                  String    @id @default(cuid())
  schoolId            String
  templateId          String?
  studentMembershipId String
  academicYearId      String?
  kind                String
  locale              String
  serial              String
  number              Int
  title               String
  intro               String    @default("")
  rowsJson            String    @default("[]")
  outro               String    @default("")
  layoutJson          String    @default("{}")
  /// The values the placeholders were filled from, SNAPSHOT.
  dataJson            String    @default("{}")
  /// Typed at issue: what a bonafide is for, a remark on a TC.
  purpose             String?
  remark              String?
  /// The pupil's legal name AS PRINTED, frozen at issue like the rows and the
  /// serial. The office may correct a legal name afterwards
  /// (lib/legal-name.ts); the paper in the family's drawer does not change,
  /// and the public check by code must go on matching it.
  studentName         String?
  /// The verification code printed on the document.
  code                String    @unique
  issuedByUserId      String?
  issuedAt            DateTime  @default(now())
  revokedAt           DateTime?
  revokedReason       String?

  school       School               @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  template     CertificateTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  student      Membership           @relation("IssuedCertificateStudent", fields: [studentMembershipId], references: [id], onDelete: Cascade)
  academicYear AcademicYear?        @relation(fields: [academicYearId], references: [id], onDelete: SetNull)
  request      CertificateRequest?

  @@unique([schoolId, serial])
  @@index([studentMembershipId])
  @@index([schoolId, issuedAt])
}

/// ADMISSIONS: a cycle is the school's open door for one academic year — the
/// grades it takes and how many seats each has, the documents it asks for,
/// whether there is an entrance test, when it opens and closes, and the fee
/// structure an admitted pupil is put on. Opened and closed by the office.
model AdmissionCycle {
  id              String    @id @default(cuid())
  schoolId        String
  academicYearId  String
  name            String
  /// JSON [{grade, seats}] in the order the school lists its grades.
  gradesJson      String    @default("[]")
  /// JSON [{key, name, required}] — the documents an application should carry.
  documentsJson   String    @default("[]")
  testRequired    Boolean   @default(false)
  /// Shown to families on the school's page and on the form.
  notice          String    @default("")
  feeStructureId  String?
  opensAt         DateTime?
  closesAt        DateTime?
  /// DRAFT | OPEN | CLOSED
  status          String    @default("DRAFT")
  createdByUserId String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  school       School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academicYear AcademicYear   @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  feeStructure FeeStructure?  @relation(fields: [feeStructureId], references: [id], onDelete: SetNull)
  applications Application[]
  slots        EntranceSlot[]

  @@unique([schoolId, academicYearId, name])
  @@index([schoolId, status])
}

/// One family's application for one child to one cycle, from the form to the
/// seat: SUBMITTED → (documents, an entrance test) → OFFERED → ACCEPTED →
/// ADMITTED, or DECLINED, WAITLISTED, WITHDRAWN. The applicant is a signed-in
/// guardian account when the family applied themselves, or nobody when the
/// office entered a walk-in; the child's details live here, under the
/// applicant, until admission moves them onto a membership and its record.
/// Policy: docs/decisions/0002, row 29.
model Application {
  id                   String    @id @default(cuid())
  schoolId             String
  cycleId              String
  number               Int
  serial               String
  applicantUserId      String?
  applicantName        String
  applicantPhone       String?
  applicantEmail       String?
  /// PARENT | GUARDIAN | OTHER
  relation             String    @default("PARENT")
  childName            String
  childBirthdate       DateTime?
  gradeApplied         String
  previousSchool       String?
  /// The child's UDISE+ PEN when the family gave it; admission links the account it names.
  penNumber            String?
  addressLine          String?
  city                 String?
  note                 String?
  /// SUBMITTED | OFFERED | ACCEPTED | ADMITTED | DECLINED | WAITLISTED | WITHDRAWN
  status               String    @default("SUBMITTED")
  /// JSON [{key, fileId, name, mime, size, uploadedAt}] — the documents attached.
  documentsJson        String    @default("[]")
  documentsVerifiedAt  DateTime?
  testSlotId           String?
  testScore            String?
  testNote             String?
  testedAt             DateTime?
  offeredAt            DateTime?
  offerExpiresAt       DateTime?
  offerNote            String?
  respondedAt          DateTime?
  decisionNote         String?
  decidedAt            DateTime?
  admittedMembershipId String?   @unique
  admittedAt           DateTime?
  feeStructureId       String?
  createdByUserId      String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  school       School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  cycle        AdmissionCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  applicant    User?          @relation("ApplicationApplicant", fields: [applicantUserId], references: [id], onDelete: SetNull)
  testSlot     EntranceSlot?  @relation(fields: [testSlotId], references: [id], onDelete: SetNull)
  admitted     Membership?    @relation("ApplicationAdmitted", fields: [admittedMembershipId], references: [id], onDelete: SetNull)
  feeStructure FeeStructure?  @relation(fields: [feeStructureId], references: [id], onDelete: SetNull)

  @@unique([cycleId, number])
  @@index([schoolId, cycleId, status])
  @@index([applicantUserId])
  @@index([testSlotId])
}

/// An entrance test sitting the office publishes: a time, a place, how many
/// children it takes. A family books one for its application; the count is
/// checked under a lock on the slot's row.
model EntranceSlot {
  id          String    @id @default(cuid())
  schoolId    String
  cycleId     String
  startsAt    DateTime
  endsAt      DateTime
  location    String?
  note        String?
  capacity    Int       @default(1)
  cancelledAt DateTime?
  createdAt   DateTime  @default(now())

  school       School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  cycle        AdmissionCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  applications Application[]

  @@index([schoolId, cycleId, startsAt])
}

/// A family asks the office for a certificate: which kind, and what it is
/// for. The office issues from it (the request then points at the paper)
/// or declines with a reason; the family may take a pending one back. One
/// pending request per pupil and kind: asking again is the same ask.
model CertificateRequest {
  id                  String    @id @default(cuid())
  schoolId            String
  studentMembershipId String
  requestedByUserId   String
  /// TC | NIRGAM | BONAFIDE | CHARACTER | STUDY | CUSTOM
  kind                String
  purpose             String
  /// PENDING | ISSUED | DECLINED | CANCELLED
  status              String    @default("PENDING")
  certificateId       String?   @unique
  declineReason       String?
  decidedByUserId     String?
  decidedAt           DateTime?
  /// G-6: a former student's paper may carry a fee the office sets; it is a
  /// demand on the ledger of the student membership, paid outside the platform.
  feePaise            Int?
  feeDemandId         String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  school      School             @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student     Membership         @relation("CertificateRequestStudent", fields: [studentMembershipId], references: [id], onDelete: Cascade)
  certificate IssuedCertificate? @relation(fields: [certificateId], references: [id], onDelete: SetNull)

  @@index([schoolId, status, createdAt])
  @@index([studentMembershipId, status])
}

/// A change to a pupil's PEN once one is on the account: the office proposes
/// the new number with a reason, the head and a guardian each approve or
/// reject, and the number changes only when both have approved. The first
/// entry needs no approval; a correction does, because a wrong PEN on a
/// transfer certificate follows the child.
/// A SIGNATURE OR THE SCHOOL'S SEAL, AS A PICTURE. One per person who signs
/// the school's papers (an admin, the head) and one seal per school. The
/// picture is kept in the row and not in the file store: it is small, it is
/// never served by a link of its own, and it is read only to be drawn on a
/// paper its reader may already see.
model SignatureImage {
  id           String   @id @default(cuid())
  schoolId     String
  /// PERSON | SEAL
  kind         String   @default("PERSON")
  /// Whose signature it is; null for the seal.
  membershipId String?  @unique
  png          Bytes
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId, kind])
}

/// A SIGNATURE ON ONE ISSUED PAPER. The paper's own copy of the picture, so
/// that a signature changed or removed afterwards does not change a paper
/// already out. A person's signature is put on a paper they issue
/// themselves; on a paper somebody else issued it WAITS for them, and is
/// drawn only once they have approved that paper.
model PaperSignature {
  id                String    @id @default(cuid())
  schoolId          String
  /// CERTIFICATE | REPORT_CARD
  paperKind         String
  paperId           String
  /// LEFT | RIGHT | SEAL
  slot              String
  /// ADMIN | PRINCIPAL; null for the seal.
  role              String?
  /// PENDING | SIGNED | DECLINED
  status            String    @default("PENDING")
  signerUserId      String?
  /// The signer's name as it stood when they signed.
  signerName        String?
  png               Bytes?
  requestedByUserId String?
  decidedAt         DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([paperKind, paperId, slot])
  @@index([schoolId, status, role])
}

/// A FAMILY'S ASK TO CHANGE THE PUPIL RECORD. The record is the office's to
/// write; a guardian or the pupil reads it and proposes new values with a
/// reason, and the office applies them or declines. One waits per pupil:
/// asking again while one waits replaces it.
model RecordChangeRequest {
  id                  String    @id @default(cuid())
  schoolId            String
  studentMembershipId String
  requestedByUserId   String
  /// True when the pupil asked for themselves, false for a guardian.
  byPupil             Boolean   @default(false)
  /// [{ field, from, to }] as the form's strings; null is a blank.
  changesJson         String
  reason              String
  /// PENDING | APPLIED | DECLINED | WITHDRAWN
  status              String    @default("PENDING")
  decidedAt           DateTime?
  decidedByUserId     String?
  /// What the office chose to tell the family with a decline.
  declineReason       String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  school  School     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student Membership @relation(fields: [studentMembershipId], references: [id], onDelete: Cascade)

  @@index([schoolId, status, createdAt])
  @@index([studentMembershipId, status])
}

model PenChangeRequest {
  id                  String    @id @default(cuid())
  schoolId            String
  studentMembershipId String
  fromPen             String?
  /// Null = remove the number.
  toPen               String?
  reason              String
  requestedByUserId   String
  /// PENDING | APPLIED | REJECTED | WITHDRAWN
  status              String    @default("PENDING")
  principalDecidedAt  DateTime?
  principalUserId     String?
  principalApproved   Boolean?
  guardianDecidedAt   DateTime?
  guardianUserId      String?
  guardianApproved    Boolean?
  /// True when the pupil had no active guardian at the time, so the head's word settles it.
  guardianWaived      Boolean   @default(false)
  decisionReason      String?
  appliedAt           DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  school  School     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student Membership @relation(fields: [studentMembershipId], references: [id], onDelete: Cascade)

  @@index([schoolId, status, createdAt])
  @@index([studentMembershipId, status])
}

// ---------------------------------------------------------------------------
// Gigs: work a person does for the platform itself, outside any school
// (decision 0004). The first is a teacher writing questions for the shared
// practice bank. These tables carry no school: the bank is every school's,
// the reviewer is the content team, and the payer is the company. What
// guards them is the person — every read and write in src/lib/gig-questions.ts
// is bound to the signed-in user or to the content team's flag.
//
// THE PLATFORM STILL MOVES NO MONEY. A teacher is paid by the operator from
// the company's own bank, by UPI, outside the app; GigPayment is the record
// of that transfer (its UTR), not the transfer.
// ---------------------------------------------------------------------------

/// One row, id "gigs": the dials the operator holds.
model GigSettings {
  id                         String   @id @default("gigs")
  /// What one question added to the bank earns, in paise.
  questionRatePaise          Int      @default(1000)
  /// A teacher's first questions added to the bank earn nothing.
  questionFreeCount          Int      @default(20)
  /// The most questions one teacher is paid for in a calendar month.
  questionMonthlyCap         Int      @default(200)
  /// The most the company pays for questions in a calendar month, all teachers together.
  questionMonthlyBudgetPaise Int      @default(500000)
  /// How many a teacher may send in a day, and hold unreviewed at once.
  questionDailyLimit         Int      @default(20)
  questionPendingLimit       Int      @default(50)
  /// A pupil's free allowance in a school year: one-to-one sessions, and seats at workshops.
  pupilFreeOneToOnes         Int      @default(2)
  pupilFreeWorkshops         Int      @default(2)
  /// What an expert owes free: a starting block, then a standing quota.
  expertStartOneToOnes       Int      @default(10)
  expertStartWorkshops       Int      @default(2)
  expertMonthlyOneToOnes     Int      @default(2)
  expertQuarterlyWorkshops   Int      @default(1)
  /// The half-hours of guidance asked of a teacher in a month; asked, not enforced.
  teacherMonthlyGuidance     Int      @default(2)
  /// A seat given up at least this many hours before the start is not counted against the pupil's allowance.
  freeCancelHours            Int      @default(12)
  workshopMaxSeats           Int      @default(30)
  /// THE FREE-ACCOUNT LENGTH CAP PER MEETING SERVICE, in minutes (decision 0008, 7 November 2026): a session on a
  /// provider's free account may not be longer than the service's own free limit — Zoom 40, Meet 60, Teams 60,
  /// Jitsi none (0 is no cap). A provider who has said their account is premium (User.premiumMeeting) is not held
  /// to it. Applied when a slot or a series is offered (src/lib/gig-sessions.ts); the operator's dials on /root/gigs.
  freeLimitZoomMinutes       Int      @default(40)
  freeLimitMeetMinutes       Int      @default(60)
  freeLimitTeamsMinutes      Int      @default(60)
  freeLimitJitsiMinutes      Int      @default(0)
  /// THE KILL SWITCH for paid sessions (decision 0004, amended 2026-10-02): off, and no price is
  /// stored, no order is made and no transfer is released, whatever the gateway is set to. Read by
  /// every paid path through src/lib/gig-payments.ts; turned by the operator alone.
  paymentsEnabled            Boolean  @default(false)
  /// A workshop seat's price must lie between these, in paise (₹50–300 to begin).
  seatPriceMinPaise          Int      @default(5000)
  seatPriceMaxPaise          Int      @default(30000)
  /// The company's share of a paid seat, in whole percent; the gateway's fee comes out of it. 20 since
  /// decision 0008 (7 November 2026; 15 before), a teacher's seat and an expert's alike; the migration of that
  /// day moved the row, and every SessionPayment freezes the figure it was made under.
  commissionPercent          Int      @default(20)
  /// GST on the company's commission, in whole percent (18 to begin). The seat fee itself carries
  /// no GST here: the company collects it on the expert's behalf and invoices only its own share
  /// (decision 0004, second amendment of 2 October 2026).
  gstPercent                 Int      @default(18)
  /// THE COMPANY AS THE SELLER ON ITS TAX INVOICES — the merchant of record for its commission.
  /// A payout cannot be recorded paid until the legal name, the GSTIN and the state code are set;
  /// src/lib/gig-payments.ts refuses by name. Frozen into every GigInvoice's sellerJson at issue.
  companyLegalName           String?
  companyGstin               String?
  companyAddress             String?
  /// Two-digit GST state code (27 Maharashtra). The expert's state against this one decides
  /// CGST+SGST (the same state) or IGST (another).
  companyStateCode           String?
  /// The SAC the commission is invoiced under. 998599 ("other support services n.e.c.") is the
  /// placeholder the owner chose on 2 October 2026; THE ACCOUNTANT MUST CONFIRM IT, as they must
  /// the point of taxation and TCS under section 52 — see decision 0004's second amendment.
  invoiceSacCode             String   @default("998599")
  /// The series an invoice number begins with: SG/2026-27/0001; receipts SG-R/2026-27/0001.
  invoicePrefix              String   @default("SG")
  updatedByUserId            String?
  updatedAt                  DateTime @updatedAt
}

/// A question a teacher wrote for the bank, in English, Hindi and Marathi, and what the content team said to it.
model QuestionContribution {
  id               String    @id @default(cuid())
  authorUserId     String
  /// The school the teacher wrote from: its name for the reviewer to read, and its id so that the
  /// notice of a decision can be written under that school's binding. Not a tenant key: no policy
  /// reads it, and a teacher who moves school keeps their contributions.
  authorSchoolId   String
  authorSchoolName String
  topicId          String
  difficulty       Int
  stem             String
  /// JSON arrays of option strings, the same order and length in each language.
  choices          String
  answerIndex      Int
  solution         String
  stemHi           String
  choicesHi        String
  solutionHi       String
  stemMr           String
  choicesMr        String
  solutionMr       String
  /// SUBMITTED | RETURNED | ACCEPTED | REJECTED | WITHDRAWN
  status           String    @default("SUBMITTED")
  reviewNote       String?
  reviewedByUserId String?
  reviewedAt       DateTime?
  /// The bank's row, once added. Accepted means exactly this: the question is in the bank.
  questionId       String?   @unique
  /// The author said the work is their own and the platform may use it.
  termsAcceptedAt  DateTime
  submittedAt      DateTime  @default(now())
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  author  User        @relation("ContributionAuthor", fields: [authorUserId], references: [id], onDelete: Cascade)
  topic   QuizTopic   @relation(fields: [topicId], references: [id], onDelete: Cascade)
  earning GigEarning?

  @@index([authorUserId, status])
  @@index([status, submittedAt])
}

/// What one accepted piece of work earned. Written once, when the work is accepted, and never changed but to say it was paid.
model GigEarning {
  id             String   @id @default(cuid())
  userId         String
  /// QUESTION
  kind           String
  contributionId String   @unique
  amountPaise    Int
  /// PAID (the rate of the day) or FREE_BLOCK (one of the first unpaid ones).
  basis          String
  /// The calendar month the work was accepted in, "2026-09", by the server's clock: the month the cap and the budget count.
  month          String
  paymentId      String?
  createdAt      DateTime @default(now())

  user         User                 @relation("GigEarner", fields: [userId], references: [id], onDelete: Cascade)
  contribution QuestionContribution @relation(fields: [contributionId], references: [id], onDelete: Cascade)
  payment      GigPayment?          @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@index([userId, month])
  @@index([month])
  @@index([paymentId])
}

/// The operator's record of one UPI transfer made to a contributor from the company's bank, outside the app.
model GigPayment {
  id           String   @id @default(cuid())
  userId       String
  /// The sum of the earnings it settles, kept as what was sent.
  amountPaise  Int
  /// Where it was sent, as it stood that day.
  upiId        String
  utr          String   @unique
  note         String?
  paidByUserId String
  paidAt       DateTime @default(now())

  user     User         @relation("GigPaymentPayee", fields: [userId], references: [id], onDelete: Cascade)
  earnings GigEarning[]

  @@index([userId, paidAt])
}

/// Where a contributor is paid: their own UPI id, typed by them.
model GigPayee {
  userId    String   @id
  upiId     String
  payeeName String
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// A time a provider offers: one pupil for a one-to-one, up to `seats` for a workshop. It carries no
/// school: an expert's is open to every school's pupils, and a teacher's names the one school it is for.
/// The meeting link is the provider's own room and is shown to a pupil and their guardians only while
/// their seat is confirmed.
model GigSlot {
  id              String    @id @default(cuid())
  providerUserId  String
  /// EXPERT | TEACHER
  providerKind    String
  /// A teacher's guidance is for pupils of this school alone. Null for an expert's slot.
  teacherSchoolId String?
  /// ONE_TO_ONE | WORKSHOP
  kind            String
  title           String
  startsAt        DateTime
  endsAt          DateTime
  meetingUrl      String
  seats           Int       @default(1)
  /// Seats not cancelled: waiting for a guardian, confirmed, or already held, missed or not held. One
  /// writer (src/lib/gig-sessions.ts), which claims a seat with the booking and releases it when the
  /// booking is cancelled; checked by data:audit.
  seatsTaken      Int       @default(0)
  /// What a seat costs a family past their allowance, in paise. 0 is a free time, which the free
  /// allowances count; a one-to-one and a teacher's guidance may carry a price within the operator's
  /// band since decision 0006 (17 October 2026, amending 0004's "never priced"), a workshop as before,
  /// only while the provider passes the paid gate in src/lib/gig-sessions.ts (KYC, a payout account or a
  /// UPI id for a teacher, an open free offer, the period's free duties given).
  pricePaise      Int       @default(0)
  /// The series this session belongs to (decision 0008, 7 November 2026): a fixed set of dated sessions or a weekly
  /// pattern, written together by src/lib/gig-sessions.ts offerSeries. Null for a single session. The slot stays the
  /// unit of everything — its own seats, its own price, its own cancellation and refund.
  seriesId        String?
  cancelledAt     DateTime?
  cancelReason    String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  provider User             @relation("GigSlotProvider", fields: [providerUserId], references: [id], onDelete: Cascade)
  series   GigSeries?       @relation(fields: [seriesId], references: [id], onDelete: SetNull)
  bookings GigBooking[]
  payments SessionPayment[] @relation("SessionPaymentSlot")

  @@index([providerUserId, startsAt])
  @@index([startsAt])
  @@index([teacherSchoolId, startsAt])
  @@index([seriesId])
}

/// A pupil's seat in a slot. It is the pupil's school's row: the school is told, reads it and may cancel it.
/// A SERIES OF SESSIONS (decision 0008, the owner's decision of 7 November 2026): a provider offers a fixed set of
/// dated sessions, or a weekly pattern until a date, in one go; each session is a GigSlot as before — its own seats,
/// its own price within the band, its own cancellation refunding the seat — joined here by GigSlot.seriesId. There is
/// no pass and no standing access: a guardian books each session (or every remaining one in one order of individual
/// seats), and the meeting link shows per seat after payment and consent, as for a single session. No school's row:
/// an expert's series is open to every school, a teacher's names its school in teacherSchoolId and is held to it in
/// the library, exactly as GigSlot is (NO_SCHOOL_POLICY in scripts/gen-rls.ts).
model GigSeries {
  id              String    @id @default(cuid())
  providerUserId  String
  /// EXPERT | TEACHER
  providerKind    String
  teacherSchoolId String?
  /// ONE_TO_ONE | WORKSHOP
  kind            String
  title           String
  meetingUrl      String
  minutes         Int
  seats           Int       @default(1)
  pricePaise      Int       @default(0)
  /// DATES (a fixed list) or WEEKLY (days of the week at a time, from a day until a day); the rule itself is ruleJson.
  rule            String
  ruleJson        String    @default("{}")
  cancelledAt     DateTime?
  cancelReason    String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  provider User      @relation("GigSeriesProvider", fields: [providerUserId], references: [id], onDelete: Cascade)
  slots    GigSlot[]

  @@index([providerUserId, createdAt])
}

model GigBooking {
  id                  String    @id @default(cuid())
  schoolId            String
  slotId              String
  studentMembershipId String
  /// Denormalised from the slot: an expert has no school, and reads their own bookings by this column.
  providerUserId      String
  /// Denormalised from the slot: ONE_TO_ONE | WORKSHOP, the allowance it draws on.
  kind                String
  bookedByUserId      String
  /// What the pupil wants from it, in their own or their guardian's words.
  purpose             String
  /// PENDING_CONSENT | PENDING_PAYMENT (a paid seat waiting for the guardian's payment) | CONFIRMED |
  /// CANCELLED | DELIVERED | MISSED (the pupil did not come) | UNHELD (the provider did not)
  status              String
  /// The school year whose allowance it counts against.
  academicYearId      String?
  consentAt           DateTime?
  consentUserId       String?
  cancelledAt         DateTime?
  cancelledByUserId   String?
  cancelReason        String?
  /// Given up by the family inside the free-cancel window: still counted against the allowance.
  lateCancel          Boolean   @default(false)
  /// When the provider said how it went, or the family said it was not held.
  closedAt            DateTime?
  rating              Int?
  feedback            String?
  ratedAt             DateTime?
  remindedAt          DateTime?
  // seats (17 Oct 2026)
  /// When the family and the provider were told, about thirty minutes before the start, that the session is about to
  /// begin and where to join it (sessions:remind, src/lib/gig-sessions.ts). Claimed before anybody is told, so two runs
  /// at once tell a family once.
  joinRemindedAt      DateTime?
  // end seats
  /// A seat past the pupil's free allowance, bought by a guardian: it draws on no allowance, and its
  /// money is the SessionPayment row. Set once, at booking.
  paid                Boolean   @default(false)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  school  School          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  slot    GigSlot         @relation(fields: [slotId], references: [id], onDelete: Cascade)
  student Membership      @relation("GigBookingStudent", fields: [studentMembershipId], references: [id], onDelete: Cascade)
  payment SessionPayment?

  @@unique([slotId, studentMembershipId])
  @@index([schoolId, studentMembershipId, kind])
  @@index([providerUserId, status])
  @@index([studentMembershipId])
}

/// Where an expert is paid for a seat: THE EXPERT'S RAZORPAY ROUTE LINKED ACCOUNT, and the details
/// it was made from, typed by the expert on the "Get paid" card (decision 0004, third amendment of
/// 2 October 2026: the guardian pays the company's gateway account, the gateway holds the expert's
/// share as a transfer on hold to this linked account and settles it to the expert's bank when
/// gigs:release lets it go). A bank account sealed by src/lib/secret-box.ts under the binding
/// `gig:payee:<expertUserId>` with its IFSC, and the PAN sealed under `gig:payee:<expertUserId>:pan`;
/// the last four of each kept in the clear for the eye, the sealed values NEVER returned by any API
/// and opened only to be sent to the gateway. The address, the phone and the GST state go to the
/// gateway too; the GST state code is also the place of supply on the invoice, a GSTIN makes it
/// B2B. Onboarding is four gateway calls (account, stakeholder, Route product, its bank details),
/// each id stored as it is made so a failed step resumes where it stopped. `routeStatus` is the
/// gateway's activation status: NONE | REQUESTED | NEEDS_CLARIFICATION | UNDER_REVIEW | ACTIVATED
/// | SUSPENDED. ACTIVE (the view's word) exactly when KYC is VERIFIED, the Route product ACTIVATED
/// and the bank details the gateway holds are the ones saved here (`routeSubmittedKey`); SUSPENDED
/// by the operator with a note. `upiId` is kept from the company-collects days and not used for a
/// seat. No school: bound to the person.
model ExpertPayoutAccount {
  expertUserId      String    @id
  payeeName         String?
  upiId             String?
  bankAccountEnc    String?
  bankLast4         String?
  ifsc              String?
  /// Two-digit GST state code of the expert: the place of supply.
  gstStateCode      String?
  gstin             String?
  /// NONE | ACTIVE | SUSPENDED
  status            String    @default("NONE")
  /// The operator's reason for a suspension.
  note              String?
  /// The PAN, sealed; sent to the gateway as the stakeholder's KYC.
  panEnc            String?
  panLast4          String?
  /// The registered address the gateway asks of a linked account, and a phone it can reach.
  addressLine       String?
  city              String?
  postalCode        String?
  phone             String?
  /// The gateway's ids, each stored as the step that made it succeeds.
  linkedAccountId   String?   @unique
  stakeholderId     String?
  routeProductId    String?
  /// NONE | REQUESTED | NEEDS_CLARIFICATION | UNDER_REVIEW | ACTIVATED | SUSPENDED
  routeStatus       String    @default("NONE")
  /// JSON [{ field, reason }] — what the gateway still asks for, as it last said.
  routeRequirements String    @default("[]")
  /// A digest of the bank details last sent to the gateway; a later edit makes them differ until resent.
  routeSubmittedKey String?
  routeCheckedAt    DateTime?
  /// The gateway's last refusal of a step, for the expert and the operator to read.
  routeError        String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  expert User @relation("ExpertPayoutAccountOwner", fields: [expertUserId], references: [id], onDelete: Cascade)
}

/// A guardian's payment for one paid workshop seat. TWO PATHS, frozen on the row as `path`:
/// ROUTE (decision 0004, third amendment of 2 October 2026; every new seat) — the order carries a
/// transfer of the net to the expert's linked account ON HOLD, so the gateway, not the company,
/// holds the expert's share: INITIATED → PAID (captured; the gross, the commission, the GST on the
/// commission and the net frozen, the family's receipt number taken) → HELD (the transfer is known,
/// `transferId`) → RELEASED (the hold was taken off once the session was delivered plus 48 hours;
/// the gateway settles the expert; `payoutId` names the run's payout and its invoice) or REFUNDED
/// (the gross back with the transfer reversed). COMPANY (the second amendment's rows, kept
/// readable; none is made now) — HELD → DUE → PAID_OUT by the operator's recorded transfer.
/// FAILED is an order that failed or expired unpaid. One writer: src/lib/gig-payments.ts, and every
/// change is audited. `netPaise` is a stored copy of amount − commission − gst, frozen with them at
/// capture and checked by data:audit. The family's and the expert's row, read by their own user
/// ids; no school.
model SessionPayment {
  id              String    @id @default(cuid())
  bookingId       String    @unique
  slotId          String
  payerUserId     String
  expertUserId    String
  amountPaise     Int
  commissionPaise Int
  /// GST on the commission (GigSettings.gstPercent of commissionPaise), frozen at capture.
  gstPaise        Int       @default(0)
  /// amountPaise − commissionPaise − gstPaise, frozen at capture: what the expert is paid.
  netPaise        Int       @default(0)
  /// The family's receipt number, SG-R/2026-27/0001, taken under the settings-row lock at capture.
  receiptNumber   String?   @unique
  receiptSerial   Int?
  orderId         String    @unique
  paymentId       String?
  refundId        String?
  /// INITIATED | PAID | HELD | RELEASED | DUE | PAID_OUT | REFUNDED | FAILED
  status          String    @default("INITIATED")
  /// ROUTE — the gateway holds the expert's share as a transfer on hold; COMPANY — the second amendment's rows.
  path            String    @default("ROUTE")
  /// The gateway's transfer of the net to the expert's linked account (ROUTE).
  transferId      String?   @unique
  /// When the transfer's hold was taken off (ROUTE).
  releasedAt      DateTime?
  /// When the gateway's capture was recorded: the date on the family's receipt.
  paidAt          DateTime?
  /// When the hold ends: delivered or missed plus 48 hours; a late cancellation, the end plus 48 hours.
  holdUntil       DateTime?
  /// When the hold ran and the row joined a payout.
  dueAt           DateTime?
  /// When the company's transfer to the expert was recorded (the payout's paidAt).
  paidOutAt       DateTime?
  refundedAt      DateTime?
  /// REFUND | RELEASE | TRANSFER — the gateway call still owed, when it failed and is to be tried again.
  pendingAction   String?
  attempts        Int       @default(0)
  lastError       String?
  payoutId        String?
  /// Why it was refunded, failed or expired.
  reason          String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  booking GigBooking    @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  slot    GigSlot       @relation("SessionPaymentSlot", fields: [slotId], references: [id], onDelete: Cascade)
  payer   User          @relation("SessionPaymentPayer", fields: [payerUserId], references: [id], onDelete: Cascade)
  expert  User          @relation("SessionPaymentExpert", fields: [expertUserId], references: [id], onDelete: Cascade)
  payout  ExpertPayout? @relation(fields: [payoutId], references: [id], onDelete: SetNull)

  @@index([expertUserId, status])
  @@index([payerUserId, createdAt])
  @@index([status, holdUntil])
  @@index([pendingAction])
}

/// One expert's seats settled together, with the GST tax invoice for the commission on them. ROUTE
/// (decision 0004, third amendment of 2 October 2026): one RELEASED payout per expert per run of
/// gigs:release, made after the transfers' holds were taken off — the gateway pays the expert, so
/// there is no reference to record, and `paidAt` is the release. COMPANY (the second amendment,
/// kept readable): the seats whose hold had run gathered into the expert's one OPEN payout and
/// recorded PAID by the operator with the UTR of the company's own transfer. Either way the invoice
/// is issued in the transaction that settles the payout. The expert reads their own; the operator
/// every one. No school.
model ExpertPayout {
  id            String    @id @default(cuid())
  expertUserId  String
  /// The sum of the net of its payments, kept as what is owed and then what was sent.
  netPaise      Int
  paymentsCount Int
  /// OPEN | PAID (COMPANY) | RELEASED (ROUTE)
  status        String    @default("OPEN")
  /// The UTR of the company's transfer, recorded once (COMPANY); null for a ROUTE payout.
  reference     String?   @unique
  paidAt        DateTime?
  paidByUserId  String?
  note          String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  expert   User             @relation("ExpertPayoutOwner", fields: [expertUserId], references: [id], onDelete: Cascade)
  payments SessionPayment[]
  invoice  GigInvoice?

  @@index([expertUserId, createdAt])
  @@index([status])
}

/// THE COMPANY'S GST TAX INVOICE TO AN EXPERT for the commission on the seats of one payout: issued
/// once, when the payout is recorded paid, numbered in a financial-year series (SG/2026-27/0001)
/// under the GigSettings row lock inside the transaction that writes it — never reused, never a gap
/// on a failed write. Every figure and both parties are frozen here, so a later change of the
/// company's details or the expert's state does not rewrite history. CGST+SGST when the expert's
/// state is the company's, IGST otherwise. Rendered as a PDF on read in the expert's language. The
/// expert reads their own; the operator every one. No school.
model GigInvoice {
  id                String   @id @default(cuid())
  number            String   @unique
  /// The series (prefix/FY) and the serial within it, for the next number.
  series            String
  serial            Int
  payoutId          String   @unique
  expertUserId      String
  issuedAt          DateTime @default(now())
  /// en | hi | mr — the expert's language when it was issued.
  locale            String   @default("en")
  /// The commission total: the value the tax is on.
  taxableValuePaise Int
  cgstPaise         Int
  sgstPaise         Int
  igstPaise         Int
  totalPaise        Int
  sacCode           String
  /// { legalName, gstin, address, stateCode } of the company, as it stood.
  sellerJson        String
  /// { name, gstin, stateCode } of the expert, as it stood.
  buyerJson         String
  /// One line per seat: { paymentId, title, date, grossPaise, commissionPaise, gstPaise }.
  linesJson         String

  payout ExpertPayout @relation(fields: [payoutId], references: [id], onDelete: Cascade)
  expert User         @relation("GigInvoiceBuyer", fields: [expertUserId], references: [id], onDelete: Cascade)

  @@unique([series, serial])
  @@index([expertUserId, issuedAt])
}

/// A delivery from the company's gateway about a session payment, stored once by the id the signed
/// body states so a redelivery settles nothing twice (the same rule as GatewayEvent for school fees,
/// which carries a school this one has not).
model GigGatewayEvent {
  id          String    @id @default(cuid())
  provider    String
  eventId     String
  kind        String
  receivedAt  DateTime  @default(now())
  processedAt DateTime?
  outcome     String?
  payloadJson String

  @@unique([provider, eventId])
  @@index([receivedAt])
}

/// THE FAMILY SAYS THE CHILD WILL BE AWAY, before the register is taken.
///
/// A guardian (or the pupil, for themselves) files one note per day with a
/// coded reason and an optional line. The register shows it beside the
/// pupil's row for that day, and the absence notice the register would have
/// sent the family for a pupil who has a note is not sent — the family told
/// the school, not the other way round. `dateKey` is the school's day. A
/// note can be taken back by its author until the day's register has marked
/// the pupil; a past day's note stays as part of the record.
model AbsenceNote {
  id                  String   @id @default(cuid())
  schoolId            String
  studentMembershipId String
  dateKey             String
  /// ILLNESS | FAMILY | RELIGIOUS | TRAVEL | OTHER (ABSENCE_REASONS in @edulink/contracts).
  reason              String
  text                String?
  authorUserId        String
  /// PARENT when a guardian filed it, STUDENT when the pupil did.
  authorRole          String
  createdAt           DateTime @default(now())

  school  School     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student Membership @relation("AbsenceNoteStudent", fields: [studentMembershipId], references: [id], onDelete: Cascade)

  @@unique([studentMembershipId, dateKey])
  @@index([schoolId, dateKey])
}

/// WHO READ A PUPIL'S HEALTH CARD. One row per read by a member of staff
/// (the office, the head, a teacher of the class); the family's own reads
/// and the pupil's are not rows, because the family is who this list is
/// for. `healthCardId` is null when the card had not been written yet — the
/// page was still opened. The guardian's "who has read this" shows the
/// last ninety days; the retention sweep may trim older rows.
model HealthCardRead {
  id                  String   @id @default(cuid())
  schoolId            String
  studentMembershipId String
  healthCardId        String?
  readerUserId        String
  /// ADMIN | PRINCIPAL | TEACHER, as the reader was at the moment of reading.
  readerRole          String
  readAt              DateTime @default(now())

  school  School     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student Membership @relation("HealthCardReadStudent", fields: [studentMembershipId], references: [id], onDelete: Cascade)

  @@index([schoolId, studentMembershipId, readAt])
}

/// The second step of a sign-in whose first step passed. Minted when a
/// person with two-step sign-in gives the right password, follows a sign-in
/// link or comes back from SSO; the raw token goes to the browser (a
/// five-minute cookie) or the phone (the TWO_FACTOR answer) and only its hash
/// is kept. Spent by one right code, dead after five wrong ones or five
/// minutes. Belongs to a user before any school is chosen, like AuthToken.
model TwoFactorChallenge {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  /// How the first step was passed: password | magic-link | sso:<provider>.
  via       String
  /// Wrong codes charged so far, by one conditional UPDATE (attempts < cap).
  attempts  Int       @default(0)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  /// The retention sweep finds dead rows by this alone.
  @@index([expiresAt])
}

/// A plan the operator offers a school: what it allows per month, and a
/// price the operator RECORDS, never collects — money never touches the
/// platform (decision 0003). A null cap is "no cap". Platform-wide, so no
/// school policy: the office reads its own school's plan through the School
/// row, and the operator reads and writes every one.
model Plan {
  id                String   @id @default(cuid())
  /// Short, unique, typed by the operator: starter, standard, …
  code              String   @unique
  name              String
  pupilCap          Int?
  messageCap        Int?
  storageCapMb      Int?
  priceMonthlyPaise Int?
  createdAt         DateTime @default(now())

  schools School[]
}

/// One school's usage for one calendar month, written by the nightly
/// usage:sample job (its one writer) and recomputed by the data audit:
/// pupils on the roll, texts sent, storage held and people active that month.
/// The school's row — its office reads its own — and the operator reads every
/// school's against its plan.
model UsageSample {
  id          String   @id @default(cuid())
  schoolId    String
  /// YYYY-MM in the school's own calendar.
  month       String
  pupils      Int
  messages    Int
  storageMb   Int
  activeUsers Int
  computedAt  DateTime @default(now())

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([schoolId, month])
  @@index([month])
}

/// WHAT THE HEAD WROTE ABOUT A MEMBER OF STAFF: a lesson observed, a target
/// set, the year's appraisal. The head's rows (the office reads them); the
/// member of staff reads an entry only once the head has marked it visible
/// to them. The rating is 1–5 or nothing; the words are the head's own.
model StaffAppraisal {
  id                String   @id @default(cuid())
  schoolId          String
  staffMembershipId String
  appraiserUserId   String
  /// The academic year as the school writes it ("2026–27"), copied from the current year when written.
  year              String
  /// OBSERVATION | TARGET | APPRAISAL (APPRAISAL_KINDS in @edulink/contracts).
  kind              String
  date              DateTime
  summary           String
  strengths         String?
  targets           String?
  rating            Int?
  visibleToStaff    Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  school School     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  staff  Membership @relation("StaffAppraisalSubject", fields: [staffMembershipId], references: [id], onDelete: Cascade)

  @@index([schoolId, staffMembershipId, date])
}

/// A LESSON PLAN KEPT TO USE AGAIN: the topic, notes and homework of a plan a
/// teacher saved, for the school's teachers to copy into another class's
/// chapter. Applying one COPIES the words into a new LessonPlan; nothing
/// links back, so editing the template later changes no class's plan.
model LessonPlanTemplate {
  id           String   @id @default(cuid())
  schoolId     String
  authorUserId String
  subject      String
  grade        String?
  title        String
  /// JSON: { topic, notes, homework }. String, like every JSON column here.
  body         String   @default("{}")
  createdAt    DateTime @default(now())

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId, subject])
  @@index([schoolId, authorUserId])
}

/// HOW A QUESTION IS DOING, PER GRADE OF THE CHILDREN WHO MET IT.
///
/// A STORED COPY WITH ONE WRITER. The content team reads the bank from outside
/// every school, and a child's answers (QuizResponse) are their school's rows,
/// behind its policy — so "how often is this question got right" cannot be
/// computed on read by the person who needs it. These rows belong to the bank
/// (no school, no policy, like QuizQuestion) and are written by exactly one
/// function, `submitAnswer` in src/lib/quiz.ts, the moment an answer is
/// recorded: asked +1, correct +1 when right, the seconds the answer took.
/// `npm run data:audit` recomputes every row from the responses and fails on
/// a contradiction. `grade` 0 is "no grade recorded" (an answer by a pupil
/// with no form group, or one that predates QuizResponse.gradeLevel).
// ---- review-queue (the generated bank's review queue, 10 October 2026) ----
/// One act on one generated bank question: the ONE record of who edited it, took it down or put it back
/// (and, before 11 October 2026, who accepted, discarded or stamped a language, kept as history),
/// written only by src/lib/quiz-review.ts's writer, which changes the question in the same transaction.
/// The native-review page's language stamp (translation-review.ts) is recorded here too. Reviewers are the
/// app admins and the operator (the owner, 10 October 2026); neither has a school, and the bank has
/// none, so no schoolId (NO_SCHOOL_POLICY in scripts/gen-rls.ts). The reviewer's id is kept without a
/// foreign key, as QuizQuestion.reviewedBy is: a stamp outlives an account taken off the content team.
model QuizReviewStamp {
  id             String   @id @default(cuid())
  questionId     String
  reviewerUserId String
  /// APP_ADMIN | OPERATOR, as the reviewer stood when they stamped.
  role           String
  /// null for the English item; "hi" or "mr" for a language stamp.
  language       String?
  /// EDIT | TAKE_DOWN | PUT_BACK, and the history's ACCEPT | EDIT_ACCEPT | DISCARD | STAMP_TRANSLATION |
  /// UNSTAMP_TRANSLATION (packages/contracts QUIZ_REVIEW_ACTIONS)
  action         String
  /// A TAKE_DOWN's (or an old DISCARD's) coded reason (QUIZ_TAKEDOWN_REASONS).
  reason         String?
  /// An EDIT's (or an old EDIT_ACCEPT's) words as they stood before, JSON: the edit's audit.
  before         String?
  at             DateTime @default(now())

  question QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId, at])
  @@index([reviewerUserId, at])
}

// ---- end review-queue ----

// ---- quiz-publish-jobs (generation started and stopped from the bank desk, 11 October 2026) ----
/// ONE RUN of the quiz bank generator started from /appadmin/quiz-review or /root/quiz-review: who
/// started it, what was asked, where it stands, and the pid of the detached runner (the generator's CLI
/// with --job, scripts/quiz-gen/job.ts) that writes its progress here after every item. One running at a
/// time: `active` is true while QUEUED, RUNNING or STOPPING and null after, and the unique index makes a
/// second active row impossible. Written only by src/lib/quiz-jobs.ts. Neither the bank nor its operators
/// have a school, so no schoolId (NO_SCHOOL_POLICY in scripts/gen-rls.ts).
model QuizGenJob {
  id              String    @id @default(cuid())
  /// QUEUED | RUNNING | STOPPING | STOPPED | FINISHED | FAILED (packages/contracts QUIZ_GEN_JOB_STATES)
  state           String    @default("QUEUED")
  /// true while the run is QUEUED, RUNNING or STOPPING; null once it ends. Unique: one at a time.
  active          Boolean?  @unique
  /// The request as the desk sent it (quizGenRequestSchema), JSON.
  request         Json
  /// The live line (quizGenProgressSchema), JSON, rewritten after every item.
  progress        Json?
  /// The detached runner's process id on this machine, while it runs.
  pid             Int?
  /// The model servers this run brought up ("chat", "embed"): the run takes exactly these down with it.
  startedServers  String[]  @default([])
  startedByUserId String
  /// APP_ADMIN | OPERATOR, as the person stood when they pressed Start.
  startedByRole   String
  stopRequestedBy String?
  /// Why a run FAILED (a dead runner, a model that never came up, an error), in words.
  error           String?
  createdAt       DateTime  @default(now())
  startedAt       DateTime?
  finishedAt      DateTime?
  /// The runner's heartbeat: written every half minute and with every progress line.
  heartbeatAt     DateTime?

  @@index([createdAt])
}
// ---- end quiz-publish-jobs ----

model QuestionStat {
  id         String   @id @default(cuid())
  questionId String
  /// 1–12, or 0 when the answering pupil's grade was not known.
  grade      Int      @default(0)
  /// Answers recorded (a reveal without an answer is not one).
  asked      Int      @default(0)
  correct    Int      @default(0)
  /// The sum of QuizResponse.seconds over the answers that carry one, and how many do.
  seconds    Int      @default(0)
  timed      Int      @default(0)
  updatedAt  DateTime @updatedAt

  question QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([questionId, grade])
}

/// THE ACTOR ABOVE A SCHOOL, AT LAST, AND ONLY FOR THE GLOBAL FEED.
///
/// global-feed.ts explains why no school can take another's post down: the
/// global clause is read-only and `schoolId` stays on the row. What was
/// missing on purpose — a take-down for everyone — is this row. The content
/// team or the operator takes a GLOBAL post down (src/lib/bulletin.ts,
/// platformTakedown): the post's status becomes TAKEN_DOWN, which drops it
/// out of the global clause in the database and out of every feed in the
/// application, and this row keeps what the platform needs in order to list
/// it and restore it, because a TAKEN_DOWN post is no longer readable from
/// outside its school. No school owns this row — it is the platform's record
/// of its own act — so it carries no `schoolId` and no policy; `postSchoolId`
/// is the publishing school, named so a restore can write under forSchool.
/// The school is told, and the act is in that school's audit log.
model PlatformTakedown {
  id                String    @id @default(cuid())
  postId            String    @unique
  /// The publishing school, copied from the post when it was taken down.
  postSchoolId      String
  /// Its name and the post's title, copied: readable here after the row is not.
  schoolName        String
  title             String
  reason            String
  takenDownByUserId String
  takenDownAt       DateTime  @default(now())
  restoredAt        DateTime?
  restoredByUserId  String?

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([takenDownAt])
}

/// A module of the school version this school has switched on: TRANSPORT,
/// LIBRARY, HOSTEL, INVENTORY, PAYROLL or ALUMNI (SCHOOL_MODULES in
/// packages/contracts). ONE ROW PER MODULE THAT IS ON; switching off deletes
/// the row, so absence is "off" and there is no third state to read wrong.
/// ALUMNI is written for every school at creation (and for the schools that
/// existed by the migration of 3 October 2026). A table rather than a JSON
/// column on School so that who switched it on and when are columns the
/// audit can be checked against, and a module's own settings have a home
/// that is the school's row under its own policy. The admin switches; every
/// switch is an audit row (school.module.on / school.module.off).
model SchoolModule {
  id              String   @id @default(cuid())
  schoolId        String
  /// One of SCHOOL_MODULES.
  module          String
  enabledAt       DateTime @default(now())
  /// Null for the rows the platform writes (a new school's ALUMNI, the migration's backfill).
  enabledByUserId String?
  /// The module's own settings, as JSON, for its builder to define; null until it has any.
  settingsJson    String?

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([schoolId, module])
}

/// A FORMER PUPIL'S PLACE IN THE ALUMNI MODULE (3 Oct 2026), one per ALUMNUS
/// membership, made the first time there is something to keep: the alumnus
/// opting in to the directory, or the office muting them or marking them a
/// mentor. No row is the default — not listed, not muted, not a mentor.
///
/// The batch (the year they left) and their last class are NOT stored here:
/// they are read from the ALUMNUS membership's joinedAt (the leaving date) and
/// the SchoolRecord of the closed STUDENT membership, so there is no second
/// copy to drift.
///
/// THE DIRECTORY IS CONSENT. `listed` is the alumnus's own act and nothing is
/// shown to anyone while it is false; a minor cannot set it (decision 0002's
/// minors' policy); leaving the directory clears what they wrote. Mute and
/// mentor are the office's (audited alumni.mute / alumni.mentor).
model AlumniProfile {
  id             String    @id @default(cuid())
  schoolId       String
  membershipId   String    @unique
  userId         String
  listed         Boolean   @default(false)
  listedAt       DateTime?
  /// What the alumnus wrote for the directory, each short and optional.
  city           String?
  occupation     String?
  /// One of ALUMNI_CONTACT_PREFS in packages/contracts.
  contactPref    String    @default("OFFICE")
  /// A mentor appears marked in the directory; the office's flag.
  mentor         Boolean   @default(false)
  mentorAt       DateTime?
  mentorByUserId String?
  /// Muted by the office: the alumnus may not open or write in a room, comment or post.
  mutedAt        DateTime?
  mutedByUserId  String?
  muteReason     String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  school     School     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@index([schoolId, listed])
}

/// A NOTE FROM THE SCHOOL TO ITS ALUMNI (3 Oct 2026): the office writes to one
/// batch (the year they left) or to every alumnus; each is told by a
/// notification, and the note stays on their alumni home. `recipientCount`
/// is what the send reached, frozen with it (written once, by the send).
model AlumniNote {
  id             String   @id @default(cuid())
  schoolId       String
  /// The year of leaving the note is for; null for every alumnus.
  batchYear      Int?
  title          String
  body           String
  sentByUserId   String
  recipientCount Int      @default(0)
  createdAt      DateTime @default(now())

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId, createdAt])
}

// ---------------------------------------------------------------------------
// Transport (the owner's decision of 3 October 2026): an optional module
// (SchoolModule TRANSPORT). The office defines routes and stops, buses, who
// drives which bus on which route, and which pupil rides from which stop;
// the DRIVER's phone is the bus's GPS between Start and End of a trip, and a
// family sees the bus — never the child — on a map. No GPS hardware is sold
// or required; a state that mandates a certified tracking device is not
// satisfied by this. Every location row here is the BUS's (TripPosition) or a
// stop's; no allotment or boarding row carries a location (decision 0002).
// ---------------------------------------------------------------------------

/// A bus route: the stops it calls at, in order. MORNING runs the stops in
/// order to the school, EVENING in reverse from it, BOTH makes two trips a
/// day. Archived (active false) rather than deleted, since its trips stay.
model TransportRoute {
  id              String   @id @default(cuid())
  schoolId        String
  name            String
  /// MORNING | EVENING | BOTH
  direction       String   @default("BOTH")
  active          Boolean  @default(true)
  note            String   @default("")
  /// FIXED (a roster of riders) | LOOP (a campus shuttle: no roster, trips without boardings).
  kind            String   @default("FIXED")
  /// The route's fee per term, raised on each rider's ledger under a TRANSPORT head; 0: none.
  feePerTermPaise Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  school      School               @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  stops       TransportStop[]
  assignments BusAssignment[]
  allotments  TransportAllotment[]

  @@index([schoolId, active])
}

/// One stop on a route: where it is (a public place, never a home address
/// by design of the form), when the bus is due there, and how near counts as
/// "at the stop" for the start offer and the family's alert.
model TransportStop {
  id            String   @id @default(cuid())
  schoolId      String
  routeId       String
  /// 1, 2, 3 … in the morning's order; the evening runs them backwards.
  order         Int
  name          String
  lat           Float
  lng           Float
  /// Minutes after midnight, school time, on the morning and the evening trip; null on a route that does not run that way.
  morningMinute Int?
  eveningMinute Int?
  /// The geofence, in metres.
  radiusM       Int      @default(150)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  school     School               @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  route      TransportRoute       @relation(fields: [routeId], references: [id], onDelete: Cascade)
  allotments TransportAllotment[]

  @@index([schoolId])
  @@index([routeId, order])
}

/// A bus the school runs or hires: its registration plate is the one thing a family is shown about it.
model Bus {
  id           String   @id @default(cuid())
  schoolId     String
  registration String
  capacity     Int
  note         String   @default("")
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  school      School          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  assignments BusAssignment[]

  @@unique([schoolId, registration])
}

/// Which bus runs which route, driven by whom (a DRIVER membership) and
/// with which attendant (also a DRIVER membership, optional), from one
/// school day to another (toDateKey null: until changed). Ending one sets
/// toDateKey; nothing is deleted, so a past trip still names its bus.
model BusAssignment {
  id                    String   @id @default(cuid())
  schoolId              String
  busId                 String
  routeId               String
  driverMembershipId    String
  attendantMembershipId String?
  fromDateKey           String
  toDateKey             String?
  createdByUserId       String?
  createdAt             DateTime @default(now())

  school    School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  bus       Bus            @relation(fields: [busId], references: [id], onDelete: Cascade)
  route     TransportRoute @relation(fields: [routeId], references: [id], onDelete: Cascade)
  driver    Membership     @relation("BusAssignmentDriver", fields: [driverMembershipId], references: [id], onDelete: Cascade)
  attendant Membership?    @relation("BusAssignmentAttendant", fields: [attendantMembershipId], references: [id], onDelete: Cascade)
  trips     Trip[]

  @@index([schoolId, fromDateKey])
  @@index([driverMembershipId])
  @@index([attendantMembershipId])
  @@index([routeId])
  @@index([busId])
}

/// A pupil's seat: the route and the stop, whether they are picked up there
/// in the morning (boards) and set down there in the evening (alights), from
/// one day to another. No location of the child's: the stop is the route's.
/// `feeHeadId` names the fees module's transport head when the school keeps
/// one; nothing here charges anything (decision 0003).
model TransportAllotment {
  id                  String   @id @default(cuid())
  schoolId            String
  studentMembershipId String
  routeId             String
  stopId              String
  boards              Boolean  @default(true)
  alights             Boolean  @default(true)
  fromDateKey         String
  toDateKey           String?
  feeHeadId           String?
  createdByUserId     String?
  createdAt           DateTime @default(now())

  school    School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student   Membership     @relation("TransportAllotmentStudent", fields: [studentMembershipId], references: [id], onDelete: Cascade)
  route     TransportRoute @relation(fields: [routeId], references: [id], onDelete: Cascade)
  stop      TransportStop  @relation(fields: [stopId], references: [id], onDelete: Restrict)
  boardings TripBoarding[]

  @@index([schoolId, routeId])
  @@index([studentMembershipId])
  @@index([stopId])
}

/// One run of one assignment on one day in one direction. SCHEDULED until
/// the driver starts it, LIVE until they end it, then ENDED. MISSED is never
/// stored: a SCHEDULED trip ten minutes past its first stop's time is read as
/// missed (lib/transport.ts), and `missedNotifiedAt` is when the office was
/// told, once. `lowBatteryAt` is the driver's phone saying its battery ran low.
model Trip {
  id                    String    @id @default(cuid())
  schoolId              String
  assignmentId          String
  dateKey               String
  /// MORNING | EVENING
  direction             String
  /// SCHEDULED | LIVE | ENDED
  status                String    @default("SCHEDULED")
  startedAt             DateTime?
  startedByMembershipId String?
  /// Started away from the first stop: the driver's reason, kept.
  startReason           String?
  endedAt               DateTime?
  endedByMembershipId   String?
  lowBatteryAt          DateTime?
  missedNotifiedAt      DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  school     School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  assignment BusAssignment  @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  positions  TripPosition[]
  boardings  TripBoarding[]

  @@unique([assignmentId, dateKey, direction])
  @@index([schoolId, dateKey])
}

/// Where the BUS was, from the driver's phone, every 10–15 seconds of a
/// LIVE trip. Kept RETENTION_TRIP_POSITIONS_DAYS (30 by default) by the
/// retention sweep. Unique on the instant, so a batch replayed from the
/// phone's outbox lands once.
model TripPosition {
  id        String   @id @default(cuid())
  schoolId  String
  tripId    String
  at        DateTime
  lat       Float
  lng       Float
  /// Metres per second and metres, as the phone reported them.
  speed     Float?
  accuracy  Float?
  createdAt DateTime @default(now())

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  trip   Trip   @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@unique([tripId, at])
  @@index([at])
  @@index([schoolId, at])
}

/// A pupil on one trip: when the driver ticked them on and off, and when
/// the family was told the bus was near. No location.
model TripBoarding {
  id                   String    @id @default(cuid())
  schoolId             String
  tripId               String
  allotmentId          String
  boardedAt            DateTime?
  alightedAt           DateTime?
  markedByMembershipId String?
  nearNotifiedAt       DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  school    School             @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  trip      Trip               @relation(fields: [tripId], references: [id], onDelete: Cascade)
  allotment TransportAllotment @relation(fields: [allotmentId], references: [id], onDelete: Cascade)

  @@unique([tripId, allotmentId])
  @@index([schoolId])
  @@index([allotmentId])
}

/// A guardian's "tell me when the bus is near" for one child: on unless a row says off.
model TransportAlertPref {
  id                  String   @id @default(cuid())
  schoolId            String
  studentMembershipId String
  userId              String
  nearAlerts          Boolean  @default(true)
  updatedAt           DateTime @updatedAt

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([studentMembershipId, userId])
  @@index([schoolId])
}

/// A driver's yes to the location sentence, shown once before the first
/// trip: their phone's location is collected between Start and End only.
/// `textKey` is the sentence they were shown, so a changed sentence asks again.
model TransportConsent {
  id           String   @id @default(cuid())
  schoolId     String
  membershipId String   @unique
  textKey      String
  consentedAt  DateTime @default(now())

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId])
}

/// THE LIBRARY MODULE (module LIBRARY, role LIBRARIAN; the owner's decision of
/// 3 October 2026). The school's rules for lending: one row per school, made
/// the first time anyone reads them, written by the office. A fine is never
/// money the platform takes (decision 0003): with `fineHeadId` set it becomes a
/// demand on the pupil's fee ledger under that head; without it, it is a due
/// the office settles at its own counter and records here.
model LibrarySettings {
  id                     String    @id @default(cuid())
  schoolId               String    @unique
  /// How many books a pupil may hold at once, and for how many days.
  pupilLimit             Int       @default(2)
  pupilLoanDays          Int       @default(14)
  /// The same for staff.
  staffLimit             Int       @default(5)
  staffLoanDays          Int       @default(30)
  /// At a college (4 Oct 2026): faculty and college students borrow on their own terms;
  /// a student holding a scholarship may take `bookBankExtra` more from the book bank.
  facultyLimit           Int       @default(10)
  facultyLoanDays        Int       @default(90)
  collegeStudentLimit    Int       @default(4)
  collegeStudentLoanDays Int       @default(15)
  bookBankExtra          Int       @default(2)
  /// How many times one loan may be renewed at the desk.
  maxRenewals            Int       @default(2)
  /// The overdue fine for each day past the due date, in paise; 0 charges none.
  finePerDayPaise        Int       @default(100)
  /// The fee head a pupil's fine is charged under; null: fines are counter dues.
  fineHeadId             String?
  /// When the running stock-take began; null while none is running.
  stockTakeStartedAt     DateTime?
  updatedByUserId        String?
  updatedAt              DateTime  @updatedAt

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
}

/// A book the library holds, once per title; its copies are the physical books.
model LibraryTitle {
  id        String   @id @default(cuid())
  schoolId  String
  /// ISBN-10 or ISBN-13, digits (and a final X) only; null when the book has none.
  isbn      String?
  title     String
  author    String   @default("")
  publisher String   @default("")
  year      Int?
  subject   String   @default("")
  /// One of LIBRARY_LANGUAGES in packages/contracts.
  language  String   @default("OTHER")
  /// One of LIBRARY_CATEGORIES in packages/contracts.
  category  String   @default("GENERAL")
  /// A PERIODICAL's subscription (G4-21, risks batch 5 Oct 2026): how often it comes (PERIODICAL_FREQUENCIES in
  /// packages/contracts) and the days the subscription runs, YYYY-MM-DD; null on a book, refused on one.
  frequency         String?
  subscriptionFrom  String?
  subscriptionUntil String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school       School               @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  copies       LibraryCopy[]
  reservations LibraryReservation[]
  volumes      LibraryVolume[]

  @@unique([schoolId, isbn])
  @@index([schoolId, title])
}

/// A VOLUME OR ISSUE OF A PERIODICAL (G4-21, risks batch 5 Oct 2026): what the library received of a subscription,
/// "Vol. 12, No. 3" with the day it came. Only a title of category PERIODICAL has them (college-campus.ts refuses a
/// book's); removing one is the librarian's correction, audited. The copies a library lends stay LibraryCopy rows.
model LibraryVolume {
  id         String   @id @default(cuid())
  schoolId   String
  titleId    String
  /// The volume as printed ("12"), and the issue within it ("3"; "" when the periodical numbers volumes only).
  volume     String
  issue      String   @default("")
  /// The day the issue reached the library, YYYY-MM-DD.
  receivedOn String
  createdByUserId String?
  createdAt  DateTime @default(now())

  school School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  title  LibraryTitle @relation(fields: [titleId], references: [id], onDelete: Cascade)

  @@unique([titleId, volume, issue])
  @@index([schoolId, titleId])
}

/// One physical book, known by the accession number written in it.
model LibraryCopy {
  id        String    @id @default(cuid())
  schoolId  String
  titleId   String
  accession String
  rack      String    @default("")
  /// AVAILABLE | ISSUED | LOST | WITHDRAWN | REPAIR. ISSUED is set and cleared
  /// only by an issue and its return, under a conditional update, so two desks
  /// cannot lend one book twice.
  status    String    @default("AVAILABLE")
  /// Seen during the running stock-take (seenAt ≥ LibrarySettings.stockTakeStartedAt).
  seenAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  school School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  title  LibraryTitle   @relation(fields: [titleId], references: [id], onDelete: Cascade)
  issues LibraryIssue[]

  @@unique([schoolId, accession])
  @@index([titleId, status])
}

/// A person who borrows: one per school membership (a pupil's, or a member of
/// staff's), made at their first loan or reservation. The card number is what
/// the desk scans; the limits come from the school's settings by kind.
model LibraryMember {
  id           String   @id @default(cuid())
  schoolId     String
  membershipId String   @unique
  /// PUPIL | STAFF, from the membership's role when the row was made.
  kind         String
  cardNumber   String
  createdAt    DateTime @default(now())

  school       School               @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  membership   Membership           @relation("LibraryMemberOf", fields: [membershipId], references: [id], onDelete: Cascade)
  issues       LibraryIssue[]
  reservations LibraryReservation[]
  fines        LibraryFine[]

  @@unique([schoolId, cardNumber])
}

/// A loan: a copy lent to a member until `dueOn` (a day in the school's zone).
model LibraryIssue {
  id               String    @id @default(cuid())
  schoolId         String
  copyId           String
  memberId         String
  issuedAt         DateTime  @default(now())
  dueOn            String
  returnedAt       DateTime?
  renewedCount     Int       @default(0)
  issuedByUserId   String
  returnedByUserId String?
  /// The day the last "due tomorrow" reminder and overdue notice went, so each goes once.
  remindedOn       String?
  noticedOn        String?

  school School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  copy   LibraryCopy   @relation(fields: [copyId], references: [id], onDelete: Cascade)
  member LibraryMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  fines  LibraryFine[]

  @@index([schoolId, returnedAt, dueOn])
  @@index([memberId, returnedAt])
  @@index([copyId, returnedAt])
}

/// A member's place in the queue for a title. `readyAt` and `readyCopyId`: a
/// returned copy is held for the first in the queue, and lent to nobody else
/// while it waits. Fulfilled by the loan, or cancelled.
model LibraryReservation {
  id             String    @id @default(cuid())
  schoolId       String
  titleId        String
  memberId       String
  placedAt       DateTime  @default(now())
  placedByUserId String
  readyAt        DateTime?
  readyCopyId    String?
  fulfilledAt    DateTime?
  cancelledAt    DateTime?

  school School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  title  LibraryTitle  @relation(fields: [titleId], references: [id], onDelete: Cascade)
  member LibraryMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([titleId, placedAt])
  @@index([memberId])
}

/// A fine on one loan: OVERDUE (written by the return), DAMAGE or LOST (raised
/// at the desk). One of each reason per loan. Whether it is paid is read from
/// the fee demand it raised (`demandId`), or from `settledAt` when the school
/// keeps library dues at its own counter — never stored twice.
model LibraryFine {
  id              String    @id @default(cuid())
  schoolId        String
  issueId         String
  memberId        String
  paise           Int
  /// OVERDUE | DAMAGE | LOST
  reason          String
  raisedByUserId  String
  createdAt       DateTime  @default(now())
  waivedAt        DateTime?
  waivedByUserId  String?
  waivedReason    String?
  /// The FeeDemand this fine raised on the pupil's ledger; null for a counter due.
  demandId        String?
  settledAt       DateTime?
  settledByUserId String?

  school School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  issue  LibraryIssue  @relation(fields: [issueId], references: [id], onDelete: Cascade)
  member LibraryMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([issueId, reason])
  @@index([schoolId, createdAt])
}

/// THE HOSTEL MODULE (module HOSTEL, role WARDEN; 3 October 2026). One
/// boarding house of the school, with the warden who runs it.
model Hostel {
  id                 String   @id @default(cuid())
  schoolId           String
  name               String
  /// BOYS | GIRLS | MIXED
  kind               String
  /// The WARDEN membership in charge; any warden of the school may take its roll call.
  wardenMembershipId String?
  capacity           Int      @default(0)
  /// Whether the warden marks who ate at each meal (off by default).
  messAttendance     Boolean  @default(false)
  /// A college's rules (4 Oct 2026): the curfew (minutes after midnight) after which a
  /// return needs late permission, whether night-outs are allowed, and the mess's monthly
  /// charge billed to each boarder's ledger under a MESS head (0: no mess bill).
  curfewMinute       Int      @default(1290)
  nightOutAllowed    Boolean  @default(true)
  messMonthlyPaise   Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  school      School             @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  rooms       HostelRoom[]
  rollCalls   HostelRollCall[]
  menu        MessMenu[]
  squadRounds HostelSquadRound[]

  @@unique([schoolId, name])
}

/// A HOSTEL EXPULSION (5 Oct 2026, a principal's approval): the warden or the
/// office proposes ending a boarder's place for a reason, with the incident it
/// rests on and the day it would take effect; only the principal decides. An
/// approval ends the allotment on that day (as the office's own "end the
/// allotment" does); a refusal or a withdrawal leaves the boarder where they
/// are. One open proposal per allotment. lib/head-approvals.ts is the writer,
/// and every decision is an audit row the head's decision log reads back.
model HostelExpulsion {
  id               String    @id @default(cuid())
  schoolId         String
  allotmentId      String
  membershipId     String
  reason           String
  incidentId       String?
  effectiveOn      String
  /// ASKED | APPROVED | REFUSED | WITHDRAWN
  status           String    @default("ASKED")
  proposedByUserId String
  proposedAt       DateTime  @default(now())
  decidedByUserId  String?
  decidedAt        DateTime?
  decisionNote     String?
  /// Set while ASKED, so one allotment carries one open proposal at a time.
  openKey          String?   @unique

  school    School          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  allotment HostelAllotment @relation(fields: [allotmentId], references: [id], onDelete: Cascade)

  @@index([schoolId, status])
  @@index([allotmentId])
}

model HostelRoom {
  id       String @id @default(cuid())
  schoolId String
  hostelId String
  number   String
  floor    String @default("")
  beds     Int
  /// DORMITORY | SHARED | SINGLE | SICK_BAY
  kind     String @default("SHARED")

  school     School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  hostel     Hostel            @relation(fields: [hostelId], references: [id], onDelete: Cascade)
  allotments HostelAllotment[]

  @@unique([hostelId, number])
}

/// A pupil's bed, from a day to a day. The two keys are set only while ACTIVE
/// and are unique, so one pupil holds one bed and one bed one pupil, whoever
/// presses at once.
model HostelAllotment {
  id               String   @id @default(cuid())
  schoolId         String
  membershipId     String
  roomId           String
  bed              Int
  fromDate         String
  toDate           String?
  /// ACTIVE | ENDED
  status           String   @default("ACTIVE")
  activePupilKey   String?  @unique
  activeBedKey     String?  @unique
  /// The hostel fee's demand on the pupil's ledger, which the fees module owns; this only links it.
  feeDemandId      String?
  allottedByUserId String
  endedByUserId    String?
  createdAt        DateTime @default(now())

  school     School                @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student    Membership            @relation("HostelAllotmentStudent", fields: [membershipId], references: [id], onDelete: Cascade)
  room       HostelRoom            @relation(fields: [roomId], references: [id], onDelete: Cascade)
  leaves     HostelLeave[]
  entries    HostelRollCallEntry[]
  visitors   HostelVisitor[]
  meals      MessAttendance[]
  // A proposal to end this place, decided by the principal (5 Oct 2026).
  expulsions HostelExpulsion[]

  @@index([schoolId, status])
  @@index([membershipId, status])
  @@index([roomId, status])
}

/// Leave from the hostel. A minor pupil's ask waits for a guardian's consent
/// (AWAITING_CONSENT) before the warden sees it to decide; a guardian's own
/// ask is their consent. The gate writes outAt and inAt; `late` is set when
/// the pupil came back after `toAt`.
model HostelLeave {
  id                String    @id @default(cuid())
  schoolId          String
  allotmentId       String
  membershipId      String
  /// HOME | LOCAL | MEDICAL
  kind              String
  fromAt            DateTime
  toAt              DateTime
  destination       String
  reason            String    @default("")
  /// AWAITING_CONSENT | PENDING | APPROVED | DECLINED | CANCELLED
  status            String
  requestedByUserId String
  consentAt         DateTime?
  consentUserId     String?
  decidedAt         DateTime?
  decidedByUserId   String?
  decisionNote      String?
  outAt             DateTime?
  outByUserId       String?
  inAt              DateTime?
  inByUserId        String?
  late              Boolean   @default(false)
  createdAt         DateTime  @default(now())

  school    School          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  allotment HostelAllotment @relation(fields: [allotmentId], references: [id], onDelete: Cascade)

  @@index([schoolId, status, fromAt])
  @@index([allotmentId])
}

/// One roll call: a hostel, a day, MORNING or NIGHT — once. `clientId` is the
/// phone's, so a replay of the same sheet from the outbox is the same call.
model HostelRollCall {
  id            String   @id @default(cuid())
  schoolId      String
  hostelId      String
  dateKey       String
  /// MORNING | NIGHT
  slot          String
  takenByUserId String
  takenAt       DateTime @default(now())
  clientId      String?

  school  School                @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  hostel  Hostel                @relation(fields: [hostelId], references: [id], onDelete: Cascade)
  entries HostelRollCallEntry[]

  @@unique([hostelId, dateKey, slot])
}

model HostelRollCallEntry {
  id           String @id @default(cuid())
  schoolId     String
  rollCallId   String
  allotmentId  String
  membershipId String
  /// PRESENT | ON_LEAVE | ABSENT
  status       String

  school    School          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  rollCall  HostelRollCall  @relation(fields: [rollCallId], references: [id], onDelete: Cascade)
  allotment HostelAllotment @relation(fields: [allotmentId], references: [id], onDelete: Cascade)

  @@unique([rollCallId, allotmentId])
  @@index([membershipId])
}

/// What the mess serves: one row per hostel, weekday (1 = Monday … 7 = Sunday) and meal.
model MessMenu {
  id       String @id @default(cuid())
  schoolId String
  hostelId String
  weekday  Int
  /// BREAKFAST | LUNCH | SNACKS | DINNER
  meal     String
  items    String

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  hostel Hostel @relation(fields: [hostelId], references: [id], onDelete: Cascade)

  @@unique([hostelId, weekday, meal])
}

/// Who ate at a meal, where the hostel has mess attendance switched on.
model MessAttendance {
  id             String  @id @default(cuid())
  schoolId       String
  allotmentId    String
  dateKey        String
  meal           String
  present        Boolean
  markedByUserId String

  school    School          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  allotment HostelAllotment @relation(fields: [allotmentId], references: [id], onDelete: Cascade)

  @@unique([allotmentId, dateKey, meal])
  @@index([schoolId, dateKey])
}

/// The visitor book: who came to see a boarder, when they came and went, and who let them in.
model HostelVisitor {
  id              String    @id @default(cuid())
  schoolId        String
  allotmentId     String
  name            String
  relation        String
  note            String    @default("")
  inAt            DateTime  @default(now())
  outAt           DateTime?
  allowedByUserId String

  school    School          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  allotment HostelAllotment @relation(fields: [allotmentId], references: [id], onDelete: Cascade)

  @@index([schoolId, inAt])
}

/// INVENTORY AND ASSETS (module INVENTORY, 3 October 2026; src/lib/inventory.ts).
/// A category groups items and assets and carries the depreciation rate its
/// assets take unless they carry their own, in basis points a year.
model InventoryCategory {
  id                 String   @id @default(cuid())
  schoolId           String
  name               String
  depreciationRateBp Int?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  school School          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  items  InventoryItem[]
  assets Asset[]

  @@unique([schoolId, name])
}

/// Who the school buys from. Free details; the bill's own name is kept on the purchase record.
model Vendor {
  id        String   @id @default(cuid())
  schoolId  String
  name      String
  phone     String?
  gstin     String?
  address   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school    School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  purchases PurchaseRecord[]
  assets    Asset[]

  @@unique([schoolId, name])
}

/// Something the stores keep, by a code unique in the school. kind CONSUMABLE | ASSET.
model InventoryItem {
  id           String    @id @default(cuid())
  schoolId     String
  categoryId   String?
  code         String
  name         String
  unit         String
  reorderLevel Int       @default(0)
  kind         String    @default("CONSUMABLE")
  archivedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  school    School             @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  category  InventoryCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  stock     InventoryStock[]
  movements StockMovement[]
  assets    Asset[]
  requests  InventoryRequest[]

  @@unique([schoolId, code])
}

/// How many of an item are at one place. A STORED COPY of the sum of the
/// item's movements there, written only by inventory.ts in the same
/// transaction as the movement, and never below zero (data:audit
/// "inventory-stock" recomputes it).
model InventoryStock {
  id        String   @id @default(cuid())
  schoolId  String
  itemId    String
  location  String
  quantity  Int      @default(0)
  updatedAt DateTime @updatedAt

  school School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  item   InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([itemId, location])
  @@index([schoolId])
}

/// One change to the stock at a location: PURCHASE | ISSUE | RETURN | ADJUST |
/// WRITE_OFF, `delta` signed (an issue is negative). An issue names who or
/// where it went: a member of staff, a room, a department.
model StockMovement {
  id               String   @id @default(cuid())
  schoolId         String
  itemId           String
  kind             String
  delta            Int
  location         String
  toMembershipId   String?
  toRoom           String?
  toDepartment     String?
  reference        String?
  note             String   @default("")
  purchaseRecordId String?
  requestId        String?
  byUserId         String?
  at               DateTime @default(now())

  school   School          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  item     InventoryItem   @relation(fields: [itemId], references: [id], onDelete: Cascade)
  to       Membership?     @relation("StockMovementTo", fields: [toMembershipId], references: [id], onDelete: SetNull)
  purchase PurchaseRecord? @relation(fields: [purchaseRecordId], references: [id], onDelete: SetNull)

  @@index([schoolId, at])
  @@index([itemId, location])
  @@index([toMembershipId])
}

/// Something the school owns that lasts, under a tag number unique in the
/// school, with ONE custodian at most. status IN_USE | IN_STORE | REPAIR |
/// DISPOSED; depreciation is worked out on read from the cost, the date, the
/// method and the rate (never stored).
model Asset {
  id                    String    @id @default(cuid())
  schoolId              String
  itemId                String?
  categoryId            String?
  vendorId              String?
  tagNumber             String
  name                  String
  purchaseDate          DateTime?
  costPaise             Int       @default(0)
  warrantyUntil         DateTime?
  location              String
  custodianMembershipId String?
  status                String    @default("IN_STORE")
  condition             String    @default("GOOD")
  /// STRAIGHT_LINE | WDV | NONE
  depreciationMethod    String    @default("STRAIGHT_LINE")
  /// Null takes the category's rate, else the default.
  depreciationRateBp    Int?
  lastAuditedAt         DateTime?
  disposedAt            DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  school    School             @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  item      InventoryItem?     @relation(fields: [itemId], references: [id], onDelete: SetNull)
  category  InventoryCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  vendor    Vendor?            @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  custodian Membership?        @relation("AssetCustodian", fields: [custodianMembershipId], references: [id], onDelete: SetNull)
  events    AssetEvent[]

  @@unique([schoolId, tagNumber])
  @@index([custodianMembershipId])
}

/// What happened to an asset: CREATED | ASSIGNED | MOVED | REPAIR | REPAIRED | AUDITED | DISPOSED.
model AssetEvent {
  id       String   @id @default(cuid())
  schoolId String
  assetId  String
  kind     String
  note     String   @default("")
  byUserId String?
  at       DateTime @default(now())

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  asset  Asset  @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([assetId, at])
  @@index([schoolId])
}

/// A bill the school paid OUTSIDE THE APP (decision 0003): who, when, the
/// invoice's reference, its lines as JSON, and the total — a STORED COPY of
/// the sum of the lines (data:audit "inventory-purchase"). The scanned bill
/// is an upload the office and the head read (files.ts).
model PurchaseRecord {
  id              String   @id @default(cuid())
  schoolId        String
  vendorId        String?
  vendorName      String
  dateKey         String
  invoiceRef      String
  location        String
  linesJson       String   @default("[]")
  totalPaise      Int
  billFileId      String?
  note            String   @default("")
  createdByUserId String?
  createdAt       DateTime @default(now())

  school    School          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  vendor    Vendor?         @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  movements StockMovement[]

  @@index([schoolId, dateKey])
}

/// A member of staff's ask for something from the stores: PENDING |
/// FULFILLED | DECLINED | CANCELLED. Fulfilling an ask that names an item
/// issues it to them.
model InventoryRequest {
  id                    String    @id @default(cuid())
  schoolId              String
  requesterMembershipId String
  itemId                String?
  itemText              String    @default("")
  quantity              Int
  note                  String    @default("")
  status                String    @default("PENDING")
  decidedByUserId       String?
  decidedAt             DateTime?
  decisionNote          String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  school    School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  requester Membership     @relation("InventoryRequester", fields: [requesterMembershipId], references: [id], onDelete: Cascade)
  item      InventoryItem? @relation(fields: [itemId], references: [id], onDelete: SetNull)

  @@index([schoolId, status])
  @@index([requesterMembershipId])
}

/// HR AND PAYROLL (module PAYROLL, 3 October 2026; src/lib/payroll.ts). The
/// school's statutory switches and the codes the portals know it by; the
/// rates themselves are the coded table in packages/contracts (payroll.ts).
model PayrollSettings {
  id                  String   @id @default(cuid())
  schoolId            String   @unique
  pfEnabled           Boolean  @default(true)
  pfOnFullBasic       Boolean  @default(false)
  esiEnabled          Boolean  @default(true)
  /// MH | NONE
  ptState             String   @default("MH")
  employerName        String   @default("")
  pfEstablishmentCode String   @default("")
  esiEmployerCode     String   @default("")
  updatedByUserId     String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
}

/// A named set of salary components ("Teaching staff", "Support staff").
model SalaryStructure {
  id         String    @id @default(cuid())
  schoolId   String
  name       String
  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  school     School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  components SalaryComponent[]
  salaries   StaffSalary[]

  @@unique([schoolId, name])
}

/// One line of a structure: a code from SALARY_COMPONENT_CODES, its kind
/// (fixed by the code), a formula FIXED | PERCENT_OF_BASIC | PERCENT_OF_GROSS
/// and its value (paise, or basis points). Statutory lines are worked out by
/// the coded rules, whatever the value says.
model SalaryComponent {
  id          String  @id @default(cuid())
  schoolId    String
  structureId String
  code        String
  label       String  @default("")
  kind        String
  formula     String  @default("FIXED")
  value       Int     @default(0)
  statutory   Boolean @default(false)
  position    Int     @default(0)

  school    School          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  structure SalaryStructure @relation(fields: [structureId], references: [id], onDelete: Cascade)

  @@unique([structureId, code])
  @@index([schoolId])
}

/// A member of staff's salary from a date; a revision is a new row from its
/// own date, so a past month is paid as it was. The PAN and the bank account
/// are SEALED (secret-box, bound to the school and membership) with their
/// last four beside them; only the bank advice and the TDS summary open them,
/// into the file, audited.
model StaffSalary {
  id                String   @id @default(cuid())
  schoolId          String
  membershipId      String
  structureId       String
  effectiveFromKey  String
  basicPaise        Int
  overridesJson     String   @default("{}")
  pfUan             String?
  esiNumber         String?
  panSealed         String?
  panLast4          String?
  bankAccountSealed String?
  bankLast4         String?
  bankIfsc          String?
  bankName          String?
  /// owner-batch-item2b: the member of staff's own UPI id (VPA), SEALED like the bank account (bound to the school
  /// and membership), opened only into the UPI advice and the pay-from-your-app link; the masked form beside it.
  upiSealed         String?
  upiMasked         String?
  /// BANK | CASH | CHEQUE | UPI
  paymentMode       String   @default("BANK")
  updatedByUserId   String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  school     School          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  membership Membership      @relation("StaffSalaryOf", fields: [membershipId], references: [id], onDelete: Cascade)
  structure  SalaryStructure @relation(fields: [structureId], references: [id], onDelete: Restrict)

  @@unique([membershipId, effectiveFromKey])
  @@index([schoolId])
}

/// A month's payroll: DRAFT while the office reviews, LOCKED after — and
/// then nothing in it changes. The totals are a STORED COPY of the sum of its
/// slips, and lockDigest the SHA-256 of the slips as locked (data:audit
/// "payroll-run" recomputes both).
model PayrollRun {
  id                  String    @id @default(cuid())
  schoolId            String
  month               String
  status              String    @default("DRAFT")
  headcount           Int       @default(0)
  grossPaise          Int       @default(0)
  deductionsPaise     Int       @default(0)
  employerPaise       Int       @default(0)
  netPaise            Int       @default(0)
  lockDigest          String?
  sharedWithPrincipal Boolean   @default(false)
  createdByUserId     String?
  lockedByUserId      String?
  lockedAt            DateTime?
  /// owner-batch-item2b: when the run became PAID (the last slip recorded paid); cleared when a void takes it back to LOCKED.
  paidAt              DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  school   School          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  slips    Payslip[]
  exports  PayrollExport[]
  payments SalaryPayment[]

  @@unique([schoolId, month])
}

/// One person's month. Each component's paise in linesJson; gross,
/// deductions, employer and net are STORED COPIES of the lines (net = gross −
/// deductions, data:audit "payroll-slip"), frozen with the run at lock.
model Payslip {
  id                  String   @id @default(cuid())
  schoolId            String
  runId               String
  membershipId        String
  staffName           String
  department          String
  designation         String?
  daysInMonth         Int
  /// Loss of pay drawn from the staff register and approved unpaid leave, in half days.
  lopHalfDays         Int      @default(0)
  /// The office's own figure in half days, which wins over the register's when set.
  lopOverrideHalfDays Int?
  linesJson           String   @default("[]")
  grossPaise          Int      @default(0)
  deductionsPaise     Int      @default(0)
  employerPaise       Int      @default(0)
  netPaise            Int      @default(0)
  arrearsPaise        Int      @default(0)
  tdsOverridePaise    Int?
  notes               String   @default("")
  paymentMode         String   @default("BANK")
  bankLast4           String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  school     School     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  run        PayrollRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  membership Membership @relation("PayslipOf", fields: [membershipId], references: [id], onDelete: Cascade)
  payments   SalaryPayment[]

  @@unique([runId, membershipId])
  @@index([schoolId])
  @@index([membershipId])
}

/// A file cut from a LOCKED run: PF_ECR | ESI | BANK_ADVICE | PT | TDS_SUMMARY.
/// The file itself is not kept — a bank advice holds account numbers in the
/// clear — it is cut again, the same bytes, from the frozen slips; this row
/// is its reference: the name, the SHA-256 of the bytes, rows and total.
model PayrollExport {
  id              String   @id @default(cuid())
  schoolId        String
  runId           String
  kind            String
  fileName        String
  sha256          String
  rows            Int
  totalPaise      Int
  createdByUserId String?
  createdAt       DateTime @default(now())

  school School     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  run    PayrollRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId])
  @@index([schoolId])
}

/// An advance against salary: asked by the member of staff (REQUESTED) or
/// recorded by the office; RECORDED is recovered in instalments as ADVANCE
/// lines of the runs that follow (what is recovered is read from the locked
/// slips, never stored). The money itself is handed over outside the app.
model StaffAdvance {
  id                   String    @id @default(cuid())
  schoolId             String
  membershipId         String
  amountPaise          Int
  reason               String
  status               String    @default("REQUESTED")
  monthlyRecoveryPaise Int?
  decidedByUserId      String?
  decidedAt            DateTime?
  decisionNote         String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  school     School     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  membership Membership @relation("StaffAdvanceOf", fields: [membershipId], references: [id], onDelete: Cascade)

  @@index([schoolId, status])
  @@index([membershipId])
}

/// WHAT AN ADULT STUDENT LETS A GUARDIAN SEE (4 October 2026). At a college a
/// student who is not a minor decides, one grant at a time — ATTENDANCE,
/// RESULTS, MONEY, HOSTEL_TRANSPORT, PLACEMENT, MESSAGES
/// (STUDENT_CONSENT_GRANTS in packages/contracts) — and may revoke any of them
/// whenever they like; a minor's guardian, and every guardian at a school or a
/// junior college, sees everything without asking. ONE ROW PER GRANT EVER
/// GIVEN: on while `revokedAt` is null; granting again clears it. Written only
/// by the student (src/lib/student-consent.ts), read by `parentMaySee`, which
/// the family's doors call; the audit log keeps every change.
model StudentConsent {
  id                  String    @id @default(cuid())
  schoolId            String
  studentMembershipId String
  /// One of STUDENT_CONSENT_GRANTS.
  grant               String
  grantedAt           DateTime  @default(now())
  revokedAt           DateTime?

  school  School     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student Membership @relation(fields: [studentMembershipId], references: [id], onDelete: Cascade)

  @@unique([studentMembershipId, grant])
  @@index([schoolId])
}

/// A RECRUITER'S OWN ACCOUNT (4 October 2026): an outside account like the
/// expert's, registered by the recruiter themself (never invited, never a
/// Membership), which belongs to no college and reaches one only through a
/// placement drive the college's TPO opens (the placement module's binding).
/// No school owns this row, exactly as no school owns an ExpertProfile, so it
/// carries no schoolId and no policy; the person is the fence
/// (src/lib/recruiters.ts). The company record, its verification and the
/// drives are the placement module's tables.
model RecruiterProfile {
  id          String    @id @default(cuid())
  userId      String    @unique
  companyName String
  createdAt   DateTime  @default(now())
  /// Set by the operator to shut the account out of every college at once.
  disabledAt  DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------------------------
// THE COLLEGE OFFICE (4 October 2026; the office builder): admissions from the
// CET Cell's rounds, a student's seat in a programme, scholarships against the
// fee ledger, no-dues, and the office's settings. Money never touches the
// platform (decision 0003): every amount here is a record of what the
// college's own bank and the state's portal did, never a movement.
// ---------------------------------------------------------------------------

/// A STUDENT'S SEAT IN A PROGRAMME: which programme, the year they entered,
/// the category and quota they were admitted under and the round. Written by
/// the office's admission (college-admissions.ts, the one writer) and read by
/// the academics builder's registration, the fee structures (year of study =
/// the academic year's start − yearOfEntry + 1, on read) and the scholarship
/// schemes (category). `programmeId` is the academics module's Programme.id.
model ProgrammeEnrolment {
  id                  String   @id @default(cuid())
  schoolId            String
  studentMembershipId String
  programmeId         String
  yearOfEntry         Int
  /// One of COLLEGE_CATEGORIES (packages/contracts v1/college-office.ts).
  category            String
  /// One of ADMISSION_QUOTAS.
  quota               String
  roundId             String?
  /// ACTIVE | LEFT | COMPLETED | CANCELLED
  status              String   @default("ACTIVE")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  school  School          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student Membership      @relation("ProgrammeEnrolmentStudent", fields: [studentMembershipId], references: [id], onDelete: Cascade)
  round   AdmissionRound? @relation(fields: [roundId], references: [id], onDelete: SetNull)

  @@unique([studentMembershipId, programmeId])
  @@index([schoolId, programmeId, yearOfEntry])
  @@index([roundId])
}

/// One admission round of a college's intake year: a CET Cell CAP round
/// (CAP_1..CAP_3), the institute-level round, or merit-list admission for a
/// non-professional programme. `seatsJson` is the seat matrix by category
/// ({ OPEN: 30, SC: 8, … }); the vacancy report is computed on read.
model AdmissionRound {
  id              String   @id @default(cuid())
  schoolId        String
  /// Null: the round covers every programme the college runs.
  programmeId     String?
  /// The intake year: 2026 for the 2026-27 first year.
  intakeYear      Int
  /// CAP_1 | CAP_2 | CAP_3 | INSTITUTE | MERIT
  kind            String
  name            String
  opensAt         DateTime
  closesAt        DateTime
  seatsJson       String   @default("{}")
  /// OPEN | CLOSED
  status          String   @default("OPEN")
  createdByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  school       School               @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  allotments   CapAllotment[]
  applications CollegeApplication[]
  enrolments   ProgrammeEnrolment[]

  @@unique([schoolId, intakeYear, kind, name])
  @@index([schoolId, status])
}

/// One row of the CET Cell's allotment list for a round, imported from the
/// pasted sheet in the Maharashtra State CET Cell's column order. The CET
/// application id is unique per round, so an import repeated adds nothing.
model CapAllotment {
  id               String   @id @default(cuid())
  schoolId         String
  roundId          String
  cetApplicationId String
  applicantName    String
  /// The allotted programme as the sheet names it (the college's choice code or the programme code).
  programmeCode    String
  /// The programme the code was matched to; null when the code matched none (listed on the import).
  programmeId      String?
  category         String
  quota            String
  meritNumber      Int?
  importedAt       DateTime @default(now())
  importedByUserId String?

  school       School               @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  round        AdmissionRound       @relation(fields: [roundId], references: [id], onDelete: Cascade)
  applications CollegeApplication[]

  @@unique([roundId, cetApplicationId])
  @@index([schoolId])
}

/// One applicant's admission to a college programme: from the allotment or
/// the merit list through scrutiny of the category's documents, the offer,
/// the admission fee and the seat. APPLIED → SCRUTINY → OFFERED → FEE_DUE →
/// ADMITTED, or CANCELLED (with the refund the authority's slab allows
/// RECORDED, never paid by the platform) → REFUNDED.
model CollegeApplication {
  id                    String    @id @default(cuid())
  schoolId              String
  roundId               String
  programmeId           String
  number                Int
  applicantName         String
  birthdate             DateTime?
  /// One of COLLEGE_CATEGORIES.
  category              String
  /// One of ADMISSION_QUOTAS.
  quota                 String
  /// M | F | T, as the portals code it.
  gender                String?
  phone                 String?
  email                 String?
  capAllotmentId        String?
  meritRank             Int?
  /// JSON { caste: {fileId, status, note}, income: …, domicile: …, gap: …, migration: …, marksheets: … }; status PENDING | VERIFIED | REJECTED.
  documentsJson         String    @default("{}")
  /// The anti-ragging undertaking (UGC 2009), recorded here as given by the student and by a parent; the antiragging.in portal remains the legal record.
  antiRaggingStudentAt  DateTime?
  antiRaggingParentAt   DateTime?
  /// APPLIED | SCRUTINY | OFFERED | FEE_DUE | ADMITTED | CANCELLED | REFUNDED
  status                String    @default("APPLIED")
  /// The admission fee demand, raised on the offer (fees module).
  feeDemandId           String?
  feeStructureId        String?
  /// The admission fee: what the offer asked (the structure's first term) and, once the
  /// college's own counter or bank has it, how and with what reference — the platform
  /// records it on the ledger at admission (fees-payments.ts), never collects it.
  admissionFeePaise     Int?
  admissionFeeMethod    String?
  admissionFeeRef       String?
  admissionFeePaidAt    DateTime?
  admittedMembershipId  String?   @unique
  admittedAt            DateTime?
  cancelledAt           DateTime?
  cancelReason          String?
  /// The refund the slab allowed, in paise, and the slab's code; recorded, never paid here.
  refundPaise           Int?
  refundSlab            String?
  refundRecordedAt      DateTime?
  refundReference       String?
  /// A REFUND OUTSIDE THE SLAB (5 Oct 2026, a principal's approval): the office asks for an amount the slab does not
  /// give, with its reason; the principal approves (it becomes `refundPaise`, the slab's figure kept in
  /// `refundSlabPaise`) or refuses (the slab stands). ASKED | APPROVED | REFUSED; lib/head-approvals.ts is the writer.
  refundAskPaise        Int?
  refundAskReason       String?
  refundAskStatus       String?
  refundAskedByUserId   String?
  refundAskedAt         DateTime?
  refundDecidedByUserId String?
  refundDecidedAt       DateTime?
  refundDecisionNote    String?
  refundSlabPaise       Int?
  /// LIFECYCLE-4: a seat over the round's category seats or the programme's
  /// intake, which the principal approved as supernumerary, with why. An
  /// application without it is refused once the seats are taken.
  supernumeraryAt       DateTime?
  supernumeraryByUserId String?
  supernumeraryReason   String?
  createdByUserId       String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  school       School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  round        AdmissionRound @relation(fields: [roundId], references: [id], onDelete: Cascade)
  capAllotment CapAllotment?  @relation(fields: [capAllotmentId], references: [id], onDelete: SetNull)
  admitted     Membership?    @relation("CollegeApplicationAdmitted", fields: [admittedMembershipId], references: [id], onDelete: SetNull)

  @@unique([roundId, number])
  @@unique([roundId, capAllotmentId])
  @@index([schoolId, status])
}

/// A student's claim under one scholarship scheme for one academic year: the
/// state portal's (MahaDBT) application id, what was sanctioned and when,
/// what the state disbursed to the college's bank and its reference. While
/// APPLIED or SANCTIONED the amount is a RECEIVABLE on the student's ledger,
/// so the family sees what it owes net of the state's share
/// (scholarships.ts `ledgerFor`); a lapse reverts it to the family.
model ScholarshipClaim {
  id                  String    @id @default(cuid())
  schoolId            String
  studentMembershipId String
  /// One of SCHOLARSHIP_SCHEMES.
  scheme              String
  /// The academic year's name, "2026-27".
  academicYear        String
  portalApplicationId String?
  appliedAt           DateTime?
  /// What the office expects the scheme to cover before sanction, in paise.
  expectedPaise       Int       @default(0)
  sanctionedPaise     Int?
  sanctionedAt        DateTime?
  disbursedPaise      Int?
  disbursedAt         DateTime?
  disbursementRef     String?
  /// APPLIED | SANCTIONED | DISBURSED | LAPSED | REJECTED
  status              String    @default("APPLIED")
  /// JSON [{ key, fileId, name, uploadedAt }].
  documentsJson       String    @default("[]")
  /// An alumni-funded scholarship: the placement builder's AlumniGift id (kind SCHOLARSHIP).
  alumniGiftId        String?
  note                String    @default("")
  lapsedAt            DateTime?
  createdByUserId     String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  school  School     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student Membership @relation("ScholarshipClaimStudent", fields: [studentMembershipId], references: [id], onDelete: Cascade)

  @@unique([studentMembershipId, scheme, academicYear])
  @@index([schoolId, academicYear, status])
}

/// A no-dues clearance for one student and one event (an exam form, leaving
/// the hostel, leaving the college). The lines are worked out on read from
/// the ledger, the library, the hostel and the lab (no-dues.ts); this row
/// keeps only what a desk did by hand — a line cleared with what was owed at
/// that moment, so a new due afterwards reopens it — and when every line
/// first stood cleared. `cycleKey` is the academic year for an exam form.
model NoDuesClearance {
  id                  String    @id @default(cuid())
  schoolId            String
  studentMembershipId String
  /// EXAM_FORM | HOSTEL_EXIT | LEAVING
  event               String
  cycleKey            String    @default("")
  /// JSON { [desk]: { clearedByUserId, clearedAt, owedAtClearPaise, itemsAtClear, note } }.
  clearsJson          String    @default("{}")
  completedAt         DateTime?
  /// At LEAVING: the caution deposit the college returns, net of dues; recorded, never paid here.
  cautionReturnPaise  Int?
  cautionReturnRef    String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  school  School     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student Membership @relation("NoDuesClearanceStudent", fields: [studentMembershipId], references: [id], onDelete: Cascade)

  @@unique([studentMembershipId, event, cycleKey])
  @@index([schoolId, event])
}

/// The college office's own dials: how large a fee concession the office
/// may grant before the principal must approve it.
model CollegeOfficeSettings {
  id                   String   @id @default(cuid())
  schoolId             String   @unique
  concessionLimitPaise Int      @default(500000)
  updatedByUserId      String?
  updatedAt            DateTime @updatedAt

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
}

/// An e-resource the library subscribes to (N-LIST, DELNET, an e-journal):
/// its link and how many times members opened it through the app — the
/// usage count NAAC criterion 4 asks for.
/// THE READING-ROOM REGISTER (risks batch 5A, 5 Oct 2026; reading-room.ts, module LIBRARY): one row per
/// visit — a reader (a student or a member of staff) signed in at the desk and, later, out. One open visit per
/// person at a time, held by the one writer under a lock; `dayKey` is the school-zone day the visit began, which
/// the librarian's day report reads. A visit never signed out stays open and the day report says so.
model ReadingRoomVisit {
  id           String    @id @default(cuid())
  schoolId     String
  membershipId String
  dayKey       String
  inAt         DateTime  @default(now())
  outAt        DateTime?
  inByUserId   String?
  outByUserId  String?

  school School     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  reader Membership @relation("ReadingRoomVisitOf", fields: [membershipId], references: [id], onDelete: Cascade)

  @@index([schoolId, dayKey])
  @@index([membershipId, outAt])
}

model LibraryEResource {
  id        String   @id @default(cuid())
  schoolId  String
  name      String
  url       String
  /// NLIST | DELNET | EJOURNAL | EBOOK | DATABASE | OTHER
  kind      String   @default("OTHER")
  clicks    Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  /// qb-C (31 Oct 2026, QB-12): the name as the desk compares it — trimmed, spaces collapsed, lower case
  /// (eResourceNameKey in packages/contracts v1/library.ts, its only writer; data:audit "eresource-name-key").
  /// "ZZ DIKSHA", "zz diksha" and "ZZ  DIKSHA" are one resource, corrected rather than added again.
  nameKey   String

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([schoolId, nameKey])
}

/// A round of the hostel's anti-ragging squad (UGC 2009): when, who walked
/// it, and what they saw. Logged by the warden or the office.
model HostelSquadRound {
  id             String   @id @default(cuid())
  schoolId       String
  hostelId       String
  at             DateTime
  members        String
  note           String   @default("")
  /// Something was found that the committee must take up.
  flagged        Boolean  @default(false)
  loggedByUserId String
  createdAt      DateTime @default(now())

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  hostel Hostel @relation(fields: [hostelId], references: [id], onDelete: Cascade)

  @@index([schoolId, at])
  @@index([hostelId])
}

// ---------------------------------------------------------------------------
// THE COLLEGE'S ACADEMICS (module ACADEMICS, roles FACULTY and HOD; the
// owner's plan of 4 October 2026). src/lib/academics*.ts.
//
// A DIVISION IS A CLASS. "FY BSc Physics A" is a Class row (the school's
// class, its enrolments and roll numbers, its notices and register) with a
// Division row beside it naming the programme and year of study, so the
// feed, notices by division, the roll and the identity card read it as they
// read a school's class. What a class cannot hold is per-lecture attendance
// (AttendanceSession is one per class per day) or an elective shared across
// divisions (TimetableSlot is one lesson per class per period), so those are
// the offering's: CourseOffering, OfferingSlot (on the school's own bells,
// TimetablePeriod), Lecture and LectureAttendance.
//
// Percentages and attainment are computed on read and never stored. The one
// stored derived value is InternalLock.totalsJson, written once at the lock
// by lockInternal and checked by data:audit "academics-internal-lock".
// ---------------------------------------------------------------------------

/// The college's academic dials: the faculty load band a week, the AICTE ratio shown per department, mentees per mentor.
model AcademicsSettings {
  id                 String   @id @default(cuid())
  schoolId           String   @unique
  loadMinHours       Int      @default(14)
  loadMaxHours       Int      @default(18)
  studentsPerFaculty Int      @default(20)
  menteesPerMentor   Int      @default(20)
  updatedByUserId    String?
  updatedAt          DateTime @updatedAt

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
}

/// A department: its code, its head (a FACULTY or HOD membership), and the lowest attendance its head may condone alone.
model Department {
  id                  String   @id @default(cuid())
  schoolId            String
  code                String
  name                String
  hodMembershipId     String?
  /// Below this percentage a condonation goes to the principal.
  condoneFloorPercent Int      @default(65)
  createdAt           DateTime @default(now())

  school     School              @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  programmes Programme[]
  faculty    DepartmentFaculty[]

  @@unique([schoolId, code])
}

/// Which department a faculty member belongs to: one each.
model DepartmentFaculty {
  id           String @id @default(cuid())
  schoolId     String
  departmentId String
  membershipId String @unique

  school     School     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  membership Membership @relation("DepartmentFacultyOf", fields: [membershipId], references: [id], onDelete: Cascade)

  @@index([schoolId, departmentId])
}

/// A programme of study: level, years, intake, regulator, the attendance rule (75; pharmacy 80; law 70) and NEP's exit points.
model Programme {
  id                  String    @id @default(cuid())
  schoolId            String
  departmentId        String
  code                String
  name                String
  /// UG | PG | DIPLOMA (PROGRAMME_LEVELS)
  level               String
  durationYears       Int
  intake              Int       @default(0)
  /// AICTE | UGC | PCI | BCI | NCTE | COA | NMC | ICAR | DCI | INC | OTHER (REGULATORS)
  regulator           String
  /// The college stream this programme belongs to (STREAMS, 5 Oct 2026); its
  /// default regulator and threshold follow it. Null until chosen; backfilled
  /// from a single-stream college's stream where the regulator agrees.
  stream              String?
  attendanceThreshold Int       @default(75)
  /// JSON [{ afterYear, award, credits }]
  exitPoints          String    @default("[]")
  archivedAt          DateTime?
  createdAt           DateTime  @default(now())

  school     School             @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  department Department         @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  schemes    Scheme[]
  outcomes   ProgrammeOutcome[]
  divisions  Division[]
  seats      StudentProgramme[]

  @@unique([schoolId, code])
}

/// A programme outcome (PO1, PSO2): what a graduate can do.
model ProgrammeOutcome {
  id          String @id @default(cuid())
  schoolId    String
  programmeId String
  code        String
  text        String

  school    School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  programme Programme @relation(fields: [programmeId], references: [id], onDelete: Cascade)

  @@unique([programmeId, code])
}

/// The university's scheme for a programme from a year: the grading table and the passing rules (coded JSON, checked by zod).
model Scheme {
  id            String   @id @default(cuid())
  schoolId      String
  programmeId   String
  name          String
  effectiveYear Int
  /// JSON [{ grade, points, minPercent }]
  gradingTable  String   @default("[]")
  /// JSON { minPercentPerCourse, atktLimit, totalCredits, internalMax, externalMax, minTermCredits, maxTermCredits }
  passingRules  String   @default("{}")
  createdAt     DateTime @default(now())

  school    School             @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  programme Programme          @relation(fields: [programmeId], references: [id], onDelete: Cascade)
  courses   Course[]
  seats     StudentProgramme[]

  @@unique([programmeId, name])
}

/// A course of a scheme in a semester, its credits by lecture, tutorial and practical, its kind and its outcomes.
model Course {
  id       String @id @default(cuid())
  schoolId String
  schemeId String
  code     String
  name     String
  semester Int
  creditsL Int    @default(0)
  creditsT Int    @default(0)
  creditsP Int    @default(0)
  /// CORE | ELECTIVE | MINOR | HONOURS | OPEN (COURSE_KINDS)
  kind     String @default("CORE")
  /// JSON [{ code: "CO1", text }]
  outcomes String @default("[]")

  school    School             @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  scheme    Scheme             @relation(fields: [schemeId], references: [id], onDelete: Cascade)
  mapping   CourseOutcomeMap[]
  offerings CourseOffering[]

  @@unique([schemeId, code])
  @@index([schoolId, semester])
}

/// The articulation matrix: a course outcome against a programme outcome, graded 1–3.
model CourseOutcomeMap {
  id       String @id @default(cuid())
  schoolId String
  courseId String
  coCode   String
  poCode   String
  level    Int

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([courseId, coCode, poCode])
}

/// A college term (a semester's teaching), with the window in which students register. Date keys in School.timezone.
model AcademicTerm {
  id                   String   @id @default(cuid())
  schoolId             String
  name                 String
  academicYear         String
  startsOn             String
  endsOn               String
  registrationOpensOn  String
  registrationClosesOn String
  createdAt            DateTime @default(now())

  school           School                  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  offerings        CourseOffering[]
  registrations    CourseRegistration[]
  lateRegistration LateRegistration[]
  condonations     AttendanceCondonation[]
  mentoringGroups  MentoringGroup[]
  /// The studio desk (R-56, the studio half, 10 Oct 2026).
  studios          Studio[]

  @@unique([schoolId, name])
  @@index([schoolId, startsOn])
}

/// A classroom, lab or seminar hall, with how many it seats.
model Room {
  id       String @id @default(cuid())
  schoolId String
  name     String
  capacity Int
  /// CLASSROOM | LAB | SEMINAR | OTHER (ROOM_KINDS)
  kind     String @default("CLASSROOM")

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([schoolId, name])
}

/// A division: a Class row of the school's, named to a programme and a year of study.
model Division {
  id           String @id @default(cuid())
  schoolId     String
  classId      String @unique
  programmeId  String
  yearOfStudy  Int
  academicYear String

  school     School     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  class      Class      @relation("DivisionOf", fields: [classId], references: [id], onDelete: Cascade)
  programme  Programme  @relation(fields: [programmeId], references: [id], onDelete: Cascade)
  /// Stream records (5 Oct 2026): the division's lab batches.
  labBatches LabBatch[]
  /// The clinical desk (10 Oct 2026): the division's clinical postings.
  clinicalPostings ClinicalPosting[]

  @@index([schoolId, programmeId])
}

/// A student's seat in a programme: the scheme they study under, where they are in it, their division and the university's PRN. The roll number is the division's Enrollment.rollNumber.
model StudentProgramme {
  id                  String   @id @default(cuid())
  schoolId            String
  studentMembershipId String   @unique
  programmeId         String
  schemeId            String
  entryYear           Int
  yearOfStudy         Int      @default(1)
  semester            Int      @default(1)
  divisionId          String?
  prn                 String?
  /// ACTIVE | EXITED | COMPLETED (SEAT_STATUSES)
  status              String   @default("ACTIVE")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  school    School     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student   Membership @relation("AcademicSeatOf", fields: [studentMembershipId], references: [id], onDelete: Cascade)
  programme Programme  @relation(fields: [programmeId], references: [id], onDelete: Cascade)
  scheme    Scheme     @relation(fields: [schemeId], references: [id], onDelete: Cascade)

  @@index([schoolId, programmeId])
}

/// A course taught in a term: to one division (divisionId) or shared across divisions (null: an elective), by one faculty member, with its weekly hours.
model CourseOffering {
  id                  String  @id @default(cuid())
  schoolId            String
  termId              String
  courseId            String
  divisionId          String?
  facultyMembershipId String?
  lectureHours        Int     @default(0)
  tutorialHours       Int     @default(0)
  practicalHours      Int     @default(0)
  roomId              String?
  capacity            Int?

  school           School               @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  term             AcademicTerm         @relation(fields: [termId], references: [id], onDelete: Cascade)
  course           Course               @relation(fields: [courseId], references: [id], onDelete: Cascade)
  slots            OfferingSlot[]
  registrations    CourseRegistration[]
  lectures         Lecture[]
  components       InternalComponent[]
  lock             InternalLock?
  courseFile       CourseFile?
  /// Stream records (5 Oct 2026): the practical record kept on it.
  practicalRecords PracticalRecord[]
  /// Homework set to the offering (R-48, 5 Oct 2026).
  assignments      Assignment[]
  /// The studio desk (R-56, the studio half, 10 Oct 2026): the design studios kept on the offering.
  studios          Studio[]

  @@unique([termId, courseId, divisionId])
  @@index([schoolId, termId])
  @@index([facultyMembershipId])
}

/// One weekly hour of an offering on the school's bells (TimetablePeriod), 0 = Sunday like TimetableSlot.
model OfferingSlot {
  id         String  @id @default(cuid())
  schoolId   String
  offeringId String
  weekday    Int
  periodId   String
  /// LECTURE | LAB | TUTORIAL (LECTURE_KINDS)
  kind       String  @default("LECTURE")
  roomId     String?

  school     School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  offering   CourseOffering @relation(fields: [offeringId], references: [id], onDelete: Cascade)
  /// Stream records (5 Oct 2026): a LAB hour may be one batch's rather than the whole division's; its lectures follow.
  labBatchId String?
  labBatch   LabBatch?      @relation(fields: [labBatchId], references: [id], onDelete: SetNull)

  @@unique([offeringId, weekday, periodId])
  @@index([schoolId, weekday, periodId])
}

/// A student on an offering for a term. Dropping keeps the row (status DROPPED), so attendance already marked keeps its owner.
model CourseRegistration {
  id                  String   @id @default(cuid())
  schoolId            String
  studentMembershipId String
  offeringId          String
  termId              String
  /// The course's kind when registered (COURSE_KINDS).
  kind                String
  /// REGISTERED | DROPPED
  status              String   @default("REGISTERED")
  registeredAt        DateTime @default(now())
  byUserId            String?
  late                Boolean  @default(false)

  school   School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student  Membership     @relation("CourseRegistrationOf", fields: [studentMembershipId], references: [id], onDelete: Cascade)
  offering CourseOffering @relation(fields: [offeringId], references: [id], onDelete: Cascade)
  term     AcademicTerm   @relation(fields: [termId], references: [id], onDelete: Cascade)

  @@unique([offeringId, studentMembershipId])
  @@index([schoolId, termId, studentMembershipId])
}

/// A registration opened after the window: asked by the office, decided by the principal.
model LateRegistration {
  id                  String    @id @default(cuid())
  schoolId            String
  studentMembershipId String
  termId              String
  reason              String
  openUntil           String
  /// ASKED | APPROVED | REFUSED
  status              String    @default("ASKED")
  askedByUserId       String
  askedAt             DateTime  @default(now())
  decidedByUserId     String?
  decidedAt           DateTime?

  school  School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student Membership   @relation("LateRegistrationOf", fields: [studentMembershipId], references: [id], onDelete: Cascade)
  term    AcademicTerm @relation(fields: [termId], references: [id], onDelete: Cascade)

  @@index([schoolId, termId, studentMembershipId])
}

/// One lecture, lab or tutorial on a day: made from the timetable when the day is first read (one per offering, day and slot), or by hand with no slot.
model Lecture {
  id                     String    @id @default(cuid())
  schoolId               String
  offeringId             String
  slotId                 String?
  dateKey                String
  startMinute            Int
  endMinute              Int
  /// LECTURE | LAB | TUTORIAL
  kind                   String    @default("LECTURE")
  roomId                 String?
  substituteMembershipId String?
  cancelledAt            DateTime?
  createdAt              DateTime  @default(now())

  school     School              @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  offering   CourseOffering      @relation(fields: [offeringId], references: [id], onDelete: Cascade)
  attendance LectureAttendance[]
  /// Stream records (5 Oct 2026): a LAB lecture for one batch — its roster and marks are the batch's members only.
  labBatchId String?
  labBatch   LabBatch?           @relation(fields: [labBatchId], references: [id], onDelete: SetNull)

  @@unique([offeringId, dateKey, slotId])
  @@index([schoolId, dateKey])
}

/// A student's mark at one lecture. clientId is the batch the phone minted: a second delivery of it writes nothing.
model LectureAttendance {
  id                   String   @id @default(cuid())
  schoolId             String
  lectureId            String
  studentMembershipId  String
  /// PRESENT | ABSENT | LATE (LECTURE_MARKS)
  status               String
  markedByMembershipId String
  markedAt             DateTime @default(now())
  clientId             String?

  school  School     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  lecture Lecture    @relation(fields: [lectureId], references: [id], onDelete: Cascade)
  student Membership @relation("LectureAttendanceOf", fields: [studentMembershipId], references: [id], onDelete: Cascade)

  @@unique([lectureId, studentMembershipId])
  @@index([schoolId, studentMembershipId])
  @@index([lectureId, clientId])
}

/// A student's ask to have a shortfall condoned: the HOD approves above the department's floor or forwards; the principal decides what is forwarded.
model AttendanceCondonation {
  id                  String    @id @default(cuid())
  schoolId            String
  studentMembershipId String
  termId              String
  offeringId          String?
  /// CONDONATION_GROUNDS
  ground              String
  note                String
  documentFileId      String?
  /// ASKED | HOD_APPROVED | FORWARDED | PRINCIPAL_APPROVED | REFUSED
  status              String    @default("ASKED")
  hodDecidedByUserId  String?
  hodDecidedAt        DateTime?
  decidedByUserId     String?
  decidedAt           DateTime?
  decisionNote        String?
  createdAt           DateTime  @default(now())

  school  School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student Membership   @relation("CondonationOf", fields: [studentMembershipId], references: [id], onDelete: Cascade)
  term    AcademicTerm @relation(fields: [termId], references: [id], onDelete: Cascade)

  @@index([schoolId, status])
  @@index([studentMembershipId])
}

/// A defaulter notice sent: at most one a week per student and offering.
model DefaulterNotice {
  id                  String   @id @default(cuid())
  schoolId            String
  studentMembershipId String
  offeringId          String
  percentTenths       Int
  sentAt              DateTime @default(now())

  school  School     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student Membership @relation("DefaulterNoticeOf", fields: [studentMembershipId], references: [id], onDelete: Cascade)

  @@index([offeringId, studentMembershipId, sentAt])
}

/// A part of an offering's internal assessment: its maximum, its weight in the scheme's internal marks, the outcomes it tests, the countersign and the HOD's release.
model InternalComponent {
  id                String    @id @default(cuid())
  schoolId          String
  offeringId        String
  name              String
  /// INTERNAL_KINDS
  kind              String
  maxMarks          Int
  weight            Int
  /// JSON ["CO1", …]
  coCodes           String    @default("[]")
  position          Int       @default(0)
  moderatedByUserId String?
  moderatedAt       DateTime?
  releasedByUserId  String?
  releasedAt        DateTime?
  createdAt         DateTime  @default(now())

  school   School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  offering CourseOffering @relation(fields: [offeringId], references: [id], onDelete: Cascade)
  marks    InternalMark[]

  @@unique([offeringId, name])
}

/// One student's marks on one component, in tenths of a mark; null marks is absent.
model InternalMark {
  id                  String    @id @default(cuid())
  schoolId            String
  componentId         String
  studentMembershipId String
  marksTenths         Int?
  enteredByUserId     String
  enteredAt           DateTime  @default(now())
  moderatedByUserId   String?
  moderatedAt         DateTime?

  school    School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  component InternalComponent @relation(fields: [componentId], references: [id], onDelete: Cascade)
  student   Membership        @relation("InternalMarkOf", fields: [studentMembershipId], references: [id], onDelete: Cascade)

  @@unique([componentId, studentMembershipId])
  @@index([schoolId, studentMembershipId])
}

/// THE ONE TABLE THE EXAMS MODULE READS for internal marks: an offering's internal totals, frozen by the HOD's lock. totalsJson is [{ studentMembershipId, totalHundredths }] out of outOf (the scheme's internalMax); one writer (lockInternal), checked by data:audit.
model InternalLock {
  id             String   @id @default(cuid())
  schoolId       String
  offeringId     String   @unique
  termId         String
  outOf          Int
  totalsJson     String   @default("[]")
  lockedByUserId String
  lockedAt       DateTime @default(now())

  school   School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  offering CourseOffering @relation(fields: [offeringId], references: [id], onDelete: Cascade)

  @@index([schoolId, termId])
}

/// An offering's course file: the plan by week with the outcomes each covers and the day it was taught, and the HOD's review.
model CourseFile {
  id               String    @id @default(cuid())
  schoolId         String
  offeringId       String    @unique
  /// JSON [{ week, topic, coCodes, taughtOn }]
  planJson         String    @default("[]")
  reviewedByUserId String?
  reviewedAt       DateTime?
  reviewNote       String?
  updatedAt        DateTime  @updatedAt

  school   School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  offering CourseOffering   @relation(fields: [offeringId], references: [id], onDelete: Cascade)
  items    CourseFileItem[]

  @@index([schoolId])
}

/// A resource, lecture notes, a question paper or model answer (a stored file or a link), tagged by the outcomes it serves.
model CourseFileItem {
  id              String   @id @default(cuid())
  schoolId        String
  courseFileId    String
  /// COURSE_FILE_ITEM_KINDS
  kind            String
  title           String
  fileId          String?
  url             String?
  coCodes         String   @default("[]")
  createdByUserId String
  createdAt       DateTime @default(now())

  school     School     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  courseFile CourseFile @relation(fields: [courseFileId], references: [id], onDelete: Cascade)

  @@index([schoolId, fileId])
}

/// A faculty mentor's group for a term (NAAC asks one mentor to twenty).
model MentoringGroup {
  id                  String   @id @default(cuid())
  schoolId            String
  facultyMembershipId String
  termId              String
  name                String
  createdAt           DateTime @default(now())

  school  School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  term    AcademicTerm      @relation(fields: [termId], references: [id], onDelete: Cascade)
  members MentoringMember[]
  notes   MentoringNote[]

  @@index([schoolId, termId])
  @@index([facultyMembershipId])
}

model MentoringMember {
  id                  String @id @default(cuid())
  schoolId            String
  groupId             String
  studentMembershipId String

  school  School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  group   MentoringGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  student Membership     @relation("MenteeOf", fields: [studentMembershipId], references: [id], onDelete: Cascade)

  @@unique([groupId, studentMembershipId])
  @@index([studentMembershipId])
}

/// A mentor's note on a mentee, with the flag NAAC counts (slow or advanced learner, referred to counselling).
model MentoringNote {
  id                  String   @id @default(cuid())
  schoolId            String
  groupId             String
  studentMembershipId String
  note                String
  /// MENTOR_FLAGS
  flag                String   @default("NONE")
  authorUserId        String
  at                  DateTime @default(now())

  school  School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  group   MentoringGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  student Membership     @relation("MentoringNoteOn", fields: [studentMembershipId], references: [id], onDelete: Cascade)

  @@index([schoolId, studentMembershipId])
}

// ---------------------------------------------------------------------------
// THE COLLEGE EXAM CELL (module EXAMS, role EXAM_CONTROLLER; 4 October 2026)
//
// One session per term (and supplementary ones), its forms, the logistics of
// the sittings, external marks entered twice or imported from the
// university, grace with the principal's approval, result runs under the
// scheme, and what follows a result. Courses, terms and registrations are
// the academics module's (Course, the term, CourseRegistration,
// InternalLock): referenced here by plain ids, read through
// lib/exam-cell-academics.ts, so the two modules migrate independently.
// Marks are thousandths; money is paise and never moves (decision 0003).
// A marks change after publication is a NEW ExamMark row (version + 1) with
// its reason, and a NEW ResultRun; nothing published is edited.
// ---------------------------------------------------------------------------

/// One exam session: a term's regular sitting or a supplementary one.
model ExamSession {
  id                 String    @id @default(cuid())
  schoolId           String
  name               String
  /// REGULAR | SUPPLEMENTARY
  kind               String    @default("REGULAR")
  /// The academics module's term this session examines.
  termId             String
  formOpensAt        DateTime?
  formClosesAt       DateTime?
  feePerCoursePaise  Int       @default(0)
  feePerBacklogPaise Int       @default(0)
  photocopyFeePaise  Int       @default(0)
  revalFeePaise      Int       @default(0)
  /// JSON [{ fromDateKey, paise }]: from that day the late fee is that slab's.
  lateFeeSlabsJson   String    @default("[]")
  /// The fee head (kind EXAM) the form's and revaluation's demands are raised under; none raises nothing.
  feeHeadId          String?
  /// DRAFT | FORMS | CONDUCT | ASSESSMENT | PUBLISHED | CLOSED
  status             String    @default("DRAFT")
  createdByUserId    String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  school       School                 @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  forms        ExamForm[]
  tickets      HallTicket[]
  schedules    ExamSchedule[]
  rooms        ExamRoom[]
  invigilation Invigilation[]
  malpractice  Malpractice[]
  remuneration Remuneration[]
  marks        ExamMark[]
  graces       ExamGrace[]
  notes        ExamModerationNote[]
  runs         ResultRun[]
  revaluations Revaluation[]
  papers       QuestionPaper[]
  printing     PrintingList[]
  allocations  AssessmentAllocation[]

  @@unique([schoolId, name])
  @@index([schoolId, termId])
}

/// A student's exam form: the courses they sit (registered and backlog), the
/// eligibility and no-dues it was checked against when submitted, the fee
/// demand it raised. Locked when the session moves to its sittings.
model ExamForm {
  id                  String    @id @default(cuid())
  schoolId            String
  sessionId           String
  studentMembershipId String
  /// JSON [{ courseId, kind: REGULAR | BACKLOG }]
  coursesJson         String    @default("[]")
  /// JSON snapshot at the last check: { eligible, note, courses: [{ courseId, percent, condoned }] }
  eligibilityJson     String    @default("{}")
  eligible            Boolean   @default(false)
  noDues              Boolean   @default(false)
  feePaise            Int       @default(0)
  lateFeePaise        Int       @default(0)
  feeDemandId         String?
  /// DRAFT | SUBMITTED | APPROVED | REFUSED
  status              String    @default("DRAFT")
  submittedAt         DateTime?
  decidedAt           DateTime?
  decidedByUserId     String?
  waiverReason        String?
  refusalReason       String?
  lockedAt            DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  session ExamSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  student Membership  @relation("ExamFormStudent", fields: [studentMembershipId], references: [id], onDelete: Cascade)
  ticket  HallTicket?
  seats   Seating[]

  @@unique([sessionId, studentMembershipId])
  @@index([schoolId, studentMembershipId])
}

/// A hall ticket: its number in the session and the code the public check reads. The PDF is drawn on read.
model HallTicket {
  id                  String   @id @default(cuid())
  schoolId            String
  sessionId           String
  formId              String   @unique
  studentMembershipId String
  number              String
  code                String   @unique
  issuedByUserId      String
  issuedAt            DateTime @default(now())

  session ExamSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  form    ExamForm    @relation(fields: [formId], references: [id], onDelete: Cascade)
  student Membership  @relation("HallTicketStudent", fields: [studentMembershipId], references: [id], onDelete: Cascade)

  @@unique([sessionId, number])
  @@index([schoolId, studentMembershipId])
}

/// One course's paper on the session's date sheet. The course's code and
/// name are copied as the date sheet prints them (provenance, like a
/// certificate's snapshot).
model ExamSchedule {
  id          String   @id @default(cuid())
  schoolId    String
  sessionId   String
  courseId    String
  courseCode  String
  courseName  String
  at          DateTime
  durationMin Int      @default(180)
  createdAt   DateTime @default(now())

  session     ExamSession            @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  rooms       ExamRoom[]
  seats       Seating[]
  malpractice Malpractice[]
  papers      QuestionPaper[]
  allocations AssessmentAllocation[]
  /// The exam flying squad's visits to this paper's halls (5 Oct 2026).
  squadVisits ExamSquadVisit[]

  @@unique([sessionId, courseId])
  @@index([schoolId, at])
}

/// A hall used for one paper. Two papers at the same hour may share a hall's name: the first takes the odd seats, the second the even.
model ExamRoom {
  id         String  @id @default(cuid())
  schoolId   String
  sessionId  String
  scheduleId String
  /// The academics module's room, when the hall is one.
  roomId     String?
  name       String
  capacity   Int

  session      ExamSession    @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  schedule     ExamSchedule   @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  seats        Seating[]
  invigilation Invigilation[]
  printing     PrintingList[]

  @@unique([scheduleId, name])
  @@index([schoolId, sessionId])
}

/// Who sits where for one paper. Alternate seats, so no two students of one course sit side by side.
model Seating {
  id                  String @id @default(cuid())
  schoolId            String
  scheduleId          String
  examRoomId          String
  seatNo              Int
  formId              String
  studentMembershipId String

  schedule ExamSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  room     ExamRoom     @relation(fields: [examRoomId], references: [id], onDelete: Cascade)
  form     ExamForm     @relation(fields: [formId], references: [id], onDelete: Cascade)
  student  Membership   @relation("SeatingStudent", fields: [studentMembershipId], references: [id], onDelete: Cascade)

  @@unique([scheduleId, formId])
  @@unique([examRoomId, seatNo])
  @@index([schoolId, studentMembershipId])
}

/// An invigilator on duty in a hall for a paper; a swap names who was replaced.
model Invigilation {
  id                      String   @id @default(cuid())
  schoolId                String
  sessionId               String
  examRoomId              String
  staffMembershipId       String
  /// ASSIGNED | SWAPPED | DONE
  status                  String   @default("ASSIGNED")
  swappedFromMembershipId String?
  note                    String?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  session ExamSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  room    ExamRoom    @relation(fields: [examRoomId], references: [id], onDelete: Cascade)
  staff   Membership  @relation("InvigilationStaff", fields: [staffMembershipId], references: [id], onDelete: Cascade)

  @@unique([examRoomId, staffMembershipId])
  @@index([schoolId, staffMembershipId])
}

/// A case of unfair means at a paper, and the committee's decision.
model Malpractice {
  id                  String    @id @default(cuid())
  schoolId            String
  sessionId           String
  scheduleId          String
  studentMembershipId String
  note                String
  reportedByUserId    String
  /// NO_ACTION | WARNING | CANCEL_PAPER | CANCEL_SESSION | DEBAR_NEXT
  decision            String?
  decisionNote        String?
  decidedByUserId     String?
  decidedAt           DateTime?
  createdAt           DateTime  @default(now())

  session  ExamSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  schedule ExamSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  student  Membership   @relation("MalpracticeStudent", fields: [studentMembershipId], references: [id], onDelete: Cascade)

  @@index([schoolId, sessionId])
}

/// What a paper setter, moderator, invigilator or assessor is owed for a session: a record, never a payment (decision 0003).
model Remuneration {
  id                String   @id @default(cuid())
  schoolId          String
  sessionId         String
  staffMembershipId String
  /// SETTER | MODERATOR | INVIGILATOR | ASSESSOR
  kind              String
  count             Int
  ratePaise         Int
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  session ExamSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  staff   Membership  @relation("RemunerationStaff", fields: [staffMembershipId], references: [id], onDelete: Cascade)

  @@unique([sessionId, staffMembershipId, kind])
  @@index([schoolId, staffMembershipId])
}

/// External marks of one student in one course of a session. Version 1 is
/// entered twice by two people (or imported); every later version — grace,
/// revaluation, a correction after publication — is a new row with its
/// reason, and the run reads the highest version. `internalMilli` is set only
/// by an import (the university's own figure); entered marks take the
/// internal from the academics module's InternalLock at the run.
model ExamMark {
  id                  String    @id @default(cuid())
  schoolId            String
  sessionId           String
  courseId            String
  studentMembershipId String
  internalMilli       Int?
  externalMilli       Int?
  absent              Boolean   @default(false)
  entry1Milli         Int?
  entry1Absent        Boolean   @default(false)
  entry1ByUserId      String?
  entry1At            DateTime?
  entry2Milli         Int?
  entry2Absent        Boolean   @default(false)
  entry2ByUserId      String?
  entry2At            DateTime?
  matched             Boolean   @default(false)
  graceMilli          Int       @default(0)
  /// IMPORT | DOUBLE_ENTRY | GRACE | REVALUATION | CORRECTION
  source              String
  version             Int       @default(1)
  reason              String?
  enteredByUserId     String
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  session ExamSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  student Membership  @relation("ExamMarkStudent", fields: [studentMembershipId], references: [id], onDelete: Cascade)

  @@unique([sessionId, courseId, studentMembershipId, version])
  @@index([schoolId, sessionId, courseId])
  @@index([studentMembershipId])
}

/// A grace proposal under the scheme's rule: the controller proposes, the principal decides.
model ExamGrace {
  id                  String    @id @default(cuid())
  schoolId            String
  sessionId           String
  courseId            String
  studentMembershipId String
  graceMilli          Int
  /// TO_PASS | TO_CLASS
  rule                String
  reason              String
  proposedByUserId    String
  /// PROPOSED | APPROVED | REFUSED
  status              String    @default("PROPOSED")
  decidedByUserId     String?
  decidedAt           DateTime?
  decisionNote        String?
  createdAt           DateTime  @default(now())

  session ExamSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  student Membership  @relation("ExamGraceStudent", fields: [studentMembershipId], references: [id], onDelete: Cascade)

  @@unique([sessionId, courseId, studentMembershipId])
  @@index([schoolId, status])
}

/// The moderation committee's note on a session or one course of it.
model ExamModerationNote {
  id              String   @id @default(cuid())
  schoolId        String
  sessionId       String
  courseId        String?
  note            String
  writtenByUserId String
  createdAt       DateTime @default(now())

  session ExamSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([schoolId, sessionId])
}

/// One computation of a session's results. Publishing one supersedes the
/// one published before, which is kept; a change after publication is a
/// new run.
model ResultRun {
  id                String    @id @default(cuid())
  schoolId          String
  sessionId         String
  number            Int
  /// DRAFT | PUBLISHED | SUPERSEDED
  status            String    @default("DRAFT")
  reason            String?
  computedAt        DateTime  @default(now())
  computedByUserId  String
  publishedAt       DateTime?
  publishedByUserId String?
  /// JSON { students, passed, atkt, failed }
  summaryJson       String    @default("{}")

  session ExamSession    @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  courses CourseResult[]
  terms   TermResult[]

  @@unique([sessionId, number])
  @@index([schoolId, status])
}

/// A run's result for one student in one course: the marks it read, the grade and points the scheme gave.
model CourseResult {
  id                  String @id @default(cuid())
  schoolId            String
  runId               String
  studentMembershipId String
  courseId            String
  creditsTenths       Int
  internalMilli       Int?
  externalMilli       Int?
  graceMilli          Int    @default(0)
  totalMilli          Int
  maxMilli            Int
  grade               String
  pointsTenths        Int
  /// PASS | FAIL | ATKT | ABSENT
  status              String
  /// REGULAR | BACKLOG, as the form carried it: the term\'s SGPA is over the regular courses (all of them in a supplementary session).
  kind                String @default("REGULAR")

  run     ResultRun  @relation(fields: [runId], references: [id], onDelete: Cascade)
  student Membership @relation("CourseResultStudent", fields: [studentMembershipId], references: [id], onDelete: Cascade)

  @@unique([runId, studentMembershipId, courseId])
  @@index([schoolId, courseId])
  @@index([studentMembershipId])
}

/// A run's term result for one student. `sgpaHundredths` is a stored copy
/// with ONE writer (the run, lib/exam-cell-results.ts) and a data:audit check
/// that it equals Σ credits × points ÷ Σ credits of the run's course rows.
model TermResult {
  id                     String  @id @default(cuid())
  schoolId               String
  runId                  String
  termId                 String
  studentMembershipId    String
  sgpaHundredths         Int?
  creditsAttemptedTenths Int
  creditsEarnedTenths    Int
  /// PASS | ATKT | FAIL
  status                 String
  /// DISTINCTION | FIRST | HIGHER_SECOND | SECOND | PASS, or null when not passed
  cls                    String?

  run     ResultRun  @relation(fields: [runId], references: [id], onDelete: Cascade)
  student Membership @relation("TermResultStudent", fields: [studentMembershipId], references: [id], onDelete: Cascade)

  @@unique([runId, studentMembershipId])
  @@index([schoolId, termId])
  @@index([studentMembershipId])
}

/// A photocopy or revaluation asked of a course's answer book, its fee demand and outcome.
model Revaluation {
  id                  String    @id @default(cuid())
  schoolId            String
  sessionId           String
  courseId            String
  studentMembershipId String
  /// PHOTOCOPY | REVAL
  kind                String
  feePaise            Int       @default(0)
  feeDemandId         String?
  /// ASKED | DECIDED | WITHDRAWN
  status              String    @default("ASKED")
  /// PROVIDED | UNCHANGED | CHANGED
  outcome             String?
  oldExternalMilli    Int?
  newExternalMilli    Int?
  note                String?
  decidedByUserId     String?
  decidedAt           DateTime?
  createdAt           DateTime  @default(now())

  session ExamSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  student Membership  @relation("RevaluationStudent", fields: [studentMembershipId], references: [id], onDelete: Cascade)

  @@unique([sessionId, courseId, studentMembershipId, kind])
  @@index([schoolId, status])
}

/// A course a student failed and carries, until passed or past the limit. Written only when a run is published.
model Backlog {
  id                   String    @id @default(cuid())
  schoolId             String
  studentMembershipId  String
  courseId             String
  firstFailedSessionId String
  firstFailedAt        DateTime
  clearedSessionId     String?
  clearedAt            DateTime?
  attempts             Int       @default(1)
  /// The last session whose published result counted an attempt, so a rerun of one session counts it once.
  lastSessionId        String?
  /// OPEN | CLEARED | LAPSED
  status               String    @default("OPEN")
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  school  School     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student Membership @relation("BacklogStudent", fields: [studentMembershipId], references: [id], onDelete: Cascade)

  @@unique([studentMembershipId, courseId])
  @@index([schoolId, status])
}

/// Credits earned in a term, to be sent to the Academic Bank of Credits
/// against the student's APAAR id. The transport is a stub: SENT only with
/// ABC_STUB_SEND set, with a made-up reference; the real ABC is untested.
model CreditPush {
  id                  String    @id @default(cuid())
  schoolId            String
  studentMembershipId String
  termId              String
  runId               String
  creditsTenths       Int
  apaarId             String?
  abcRef              String?
  /// PENDING | SENT | FAILED
  status              String    @default("PENDING")
  pushedAt            DateTime?
  error               String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  school  School     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student Membership @relation("CreditPushStudent", fields: [studentMembershipId], references: [id], onDelete: Cascade)

  @@unique([studentMembershipId, termId])
  @@index([schoolId, status])
}

/// An autonomous college's question paper: set by a faculty member with its
/// outcome map, moderated, and kept SEALED (secret-box, bound to the row) —
/// opened only into the stream that sends it, every opening appended to
/// `accessLogJson` and audited.
model QuestionPaper {
  id                 String    @id @default(cuid())
  schoolId           String
  sessionId          String
  scheduleId         String
  setterMembershipId String
  /// ASSIGNED | SUBMITTED | MODERATED
  status             String    @default("ASSIGNED")
  /// JSON [{ question, co, marks }]
  coMapJson          String    @default("[]")
  sealedBody         String?   @db.Text
  fileName           String?
  mime               String?
  sizeBytes          Int?
  sha256             String?
  submittedAt        DateTime?
  moderatedByUserId  String?
  moderatedAt        DateTime?
  moderationNote     String?
  /// JSON [{ userId, at }] — every opening, appended.
  accessLogJson      String    @default("[]")
  assignedByUserId   String
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  session  ExamSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  schedule ExamSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  setter   Membership   @relation("QuestionPaperSetter", fields: [setterMembershipId], references: [id], onDelete: Cascade)

  @@unique([scheduleId, setterMembershipId])
  @@index([schoolId, setterMembershipId])
}

/// How many papers to print for a hall: seated + spare. `seated` and
/// `count` have one writer (buildPrintingLists) and a data:audit check.
model PrintingList {
  id         String @id @default(cuid())
  schoolId   String
  sessionId  String
  scheduleId String
  examRoomId String
  seated     Int
  spare      Int
  count      Int

  session ExamSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  room    ExamRoom    @relation(fields: [examRoomId], references: [id], onDelete: Cascade)

  @@unique([scheduleId, examRoomId])
  @@index([schoolId, sessionId])
}

/// A bundle of answer books given to an assessor at central assessment.
model AssessmentAllocation {
  id                   String    @id @default(cuid())
  schoolId             String
  sessionId            String
  scheduleId           String
  assessorMembershipId String
  bundle               String
  count                Int
  /// ALLOTTED | RETURNED
  status               String    @default("ALLOTTED")
  returnedAt           DateTime?
  createdAt            DateTime  @default(now())

  session  ExamSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  schedule ExamSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  assessor Membership   @relation("AssessmentAssessor", fields: [assessorMembershipId], references: [id], onDelete: Cascade)

  @@unique([scheduleId, bundle])
  @@index([schoolId, assessorMembershipId])
}

/// An autonomous college's convocation list for a year: the graduates as the list was drawn.
model Convocation {
  id              String    @id @default(cuid())
  schoolId        String
  year            Int
  /// JSON [{ studentMembershipId, name, programme, cgpa, cls }]
  listJson        String    @default("[]")
  /// DRAFT | FINAL
  status          String    @default("DRAFT")
  finalizedAt     DateTime?
  createdByUserId String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([schoolId, year])
}

/// A grade card, transcript or degree certificate the exam cell issued:
/// numbered under a lock, frozen as printed (`dataJson`), with the
/// controller's signature and the seal copied in as they were, and a code
/// for the public check.
model ExamDocument {
  id                  String    @id @default(cuid())
  schoolId            String
  studentMembershipId String
  /// GRADE_CARD | TRANSCRIPT | DEGREE
  kind                String
  sessionId           String?
  runId               String?
  yearLabel           String
  number              Int
  serial              String
  code                String    @unique
  studentName         String
  dataJson            String
  signaturePng        Bytes?
  sealPng             Bytes?
  issuedByUserId      String
  issuedAt            DateTime  @default(now())
  revokedAt           DateTime?
  revokedReason       String?

  school  School     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student Membership @relation("ExamDocumentStudent", fields: [studentMembershipId], references: [id], onDelete: Cascade)

  @@unique([schoolId, kind, yearLabel, number])
  @@index([schoolId, studentMembershipId])
}

// ---------------------------------------------------------------------------
// Placement (the owner's college plan of 4 October 2026): module PLACEMENT,
// roles TPO and RECRUITER. Eligibility is computed from the exam cell's and
// the office's rows, never typed; a recruiter is an outside account bound to
// a company and reaches a college's rows only through a drive of that
// company, and a student's name only after that student consents to that
// drive (RECRUITER_READABLE in scripts/gen-rls.ts); a pooled drive is the
// host college's row that its guest colleges read (POOLED_READABLE). Money
// never touches the platform (decision 0003): a package is a figure the
// company states, a gift a record of what the college received elsewhere.
// ---------------------------------------------------------------------------

/// A COMPANY THAT RECRUITS — the same row for every college on the platform,
/// NOT tenant-scoped (like ExpertProfile): its name, its registration number
/// (a GSTIN or a CIN, format-checked and never looked up), its sectors and
/// its point of contact. Made by a recruiter's own registration or by a
/// college's placement cell. `verifiedAt` is a placement officer's word that
/// they checked it (any college's cell, or the operator): a requirement from
/// an unverified company is shown as such and cannot become a drive until it
/// is. No college's rows are reachable through this row alone.
model Company {
  id                String    @id @default(cuid())
  name              String
  /// GSTIN or CIN, upper case.
  identifier        String    @unique
  /// JSON array of PLACEMENT_SECTORS.
  sectors           String    @default("[]")
  pointOfContact    String
  createdByUserId   String?
  /// The college whose cell made it, when a cell did: provenance only, no access follows from it.
  createdBySchoolId String?
  verifiedAt        DateTime?
  verifiedByUserId  String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  recruiters   CompanyRecruiter[]
  requirements Requirement[]
  tenantLinks  CompanyTenantLink[]
  drives       Drive[]
  alumniLinks  AlumniCompanyLink[]
}

/// A RECRUITER BOUND TO A COMPANY (NOT tenant-scoped): the binding a drive's
/// company passes on to the recruiter. Made when a recruiter registers a
/// company, or when a bound colleague adds another recruiter account by its
/// address; `removedAt` ends it, and with it every drive's rows at once.
model CompanyRecruiter {
  id            String    @id @default(cuid())
  companyId     String
  userId        String
  addedAt       DateTime  @default(now())
  removedAt     DateTime?
  /// Campaign S-16 (4 Oct 2026): a colleague's binding counts only once that
  /// recruiter accepts it; until then it is an invitation and reads nothing.
  /// The registering recruiter's own binding is accepted when made.
  acceptedAt    DateTime?
  /// Who added this recruiter (null for the one who registered the company).
  addedByUserId String?

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User    @relation("CompanyRecruiterOf", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([companyId, userId])
  @@index([userId])
}

/// A RECRUITER'S ASK, to one college or several (NOT tenant-scoped: it is the
/// company's, and names its target colleges in `targetSchoolIds`): the role,
/// the package (CTC a year, rupees), the bond, the locations, the
/// eligibility asked for, the rounds planned and the dates proposed. A
/// college's cell reads those naming it and may turn one into a drive.
model Requirement {
  id               String    @id @default(cuid())
  companyId        String
  byUserId         String
  role             String
  packageRupees    Int
  bond             String    @default("")
  locations        String    @default("")
  /// JSON eligibilityRule (packages/contracts v1/placement.ts).
  eligibilityAsked String    @default("{}")
  /// JSON array of { kind, note }.
  rounds           String    @default("[]")
  datesProposed    String    @default("")
  /// JSON array of School ids: colleges with PLACEMENT on, chosen from the recruiter's list.
  targetSchoolIds  String    @default("[]")
  withdrawnAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  drives  Drive[]

  @@index([companyId])
}

/// A COMPANY'S STANDING AT ONE COLLEGE: the year it first came, the cell's note.
model CompanyTenantLink {
  id             String   @id @default(cuid())
  schoolId       String
  companyId      String
  firstVisitYear Int?
  note           String   @default("")
  createdAt      DateTime @default(now())

  school  School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([schoolId, companyId])
}

/// A STUDENT'S PLACEMENT PROFILE: what they add to the record (skills,
/// certifications, projects), their season choices (opted out, going for
/// higher studies, starting up) and the dream flag the cell grants. The
/// CGPA, backlogs, attendance and programme are NOT here: they are read from
/// the exam cell's and the office's rows each time (src/lib/placement-record.ts).
/// The resume is rendered from both on read; no file is kept.
model PlacementProfile {
  id                  String    @id @default(cuid())
  schoolId            String
  studentMembershipId String    @unique
  /// JSON string arrays, and [{ title, note }] for projects.
  skills              String    @default("[]")
  certifications      String    @default("[]")
  projects            String    @default("[]")
  /// The student's own consent to the cell processing their record for the season, set when they first save.
  consentAt           DateTime?
  optedOut            Boolean   @default(false)
  dreamFlag           Boolean   @default(false)
  dreamByUserId       String?
  higherStudies       Boolean   @default(false)
  entrepreneur        Boolean   @default(false)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  school  School     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student Membership @relation("PlacementProfileOf", fields: [studentMembershipId], references: [id], onDelete: Cascade)
}

/// A PLACEMENT DRIVE, the host college's row. ON_CAMPUS and OFF_CAMPUS are the
/// college's own; a POOLED drive is hosted here with the colleges in
/// `poolSchoolIds` invited, whose cells and students READ this row
/// (POOLED_READABLE) and whose students' applications stay their own
/// college's rows. `eligibilityRule` is the JSON rule; who qualifies is
/// computed on read. A recruiter of the company reads it while it is
/// OPEN, SHORTLISTING, ROUNDS or OFFERS, and nothing once it is CLOSED.
model Drive {
  id                String    @id @default(cuid())
  schoolId          String
  companyId         String
  requirementId     String?
  /// ON_CAMPUS | OFF_CAMPUS | POOLED
  kind              String
  title             String
  jd                String    @default("")
  packageMinRupees  Int
  packageMaxRupees  Int
  bond              String    @default("")
  /// JSON array of { n, kind, note, at }.
  rounds            String    @default("[]")
  /// JSON array of { label, at }.
  schedule          String    @default("[]")
  venues            String    @default("")
  eligibilityRule   String    @default("{}")
  /// JSON array of guest School ids, for a POOLED drive.
  poolSchoolIds     String    @default("[]")
  /// DRAFT | OPEN | SHORTLISTING | ROUNDS | OFFERS | CLOSED
  status            String    @default("DRAFT")
  invitedAt         DateTime?
  closedAt          DateTime?
  /// The recruiter's word on the college's preparation.
  recruiterRating   Int?
  recruiterFeedback String?
  createdByUserId   String
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  school       School             @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  company      Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  requirement  Requirement?       @relation(fields: [requirementId], references: [id], onDelete: SetNull)
  applications DriveApplication[]
  results      RoundResult[]
  offers       Offer[]
  referrals    AlumniReferral[]
  /// Its pre-placement talk (R-2, 5 Oct 2026; lib/placement-talks.ts).
  talk         PlacementTalk?

  /// One drive per recruiter requirement at a college (QA-30, 24 Oct 2026); drives with no requirement are not held by it (nulls are distinct).
  @@unique([schoolId, requirementId])
  @@index([schoolId, status])
  @@index([companyId, status])
}

/// A STUDENT'S APPLICATION TO A DRIVE, their own college's row (for a pooled
/// drive's guest, the guest college's). Applying IS the consent to share the
/// profile and the record with the drive's company for the drive's
/// duration: `consentAt`, and `recordJson`, the record as it stood at that
/// moment, frozen as what was consented to (provenance, not a copy to keep
/// in step — the eligibility of the next drive reads the live rows).
/// `studentUserId` is copied from the membership so a bound recruiter reads
/// the name without reading a Membership. Where it stands (shortlisted, in a
/// round, selected, rejected) is computed on read from RoundResult and Offer.
model DriveApplication {
  id                  String    @id @default(cuid())
  schoolId            String
  driveId             String
  studentMembershipId String
  studentUserId       String
  /// The applicant's college's name, frozen with the record, for a pooled drive's host and recruiter.
  schoolName          String
  appliedAt           DateTime  @default(now())
  consentAt           DateTime?
  withdrawnAt         DateTime?
  recordJson          String    @default("{}")

  school  School     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  drive   Drive      @relation(fields: [driveId], references: [id], onDelete: Cascade)
  student Membership @relation("DriveApplicationOf", fields: [studentMembershipId], references: [id], onDelete: Cascade)

  @@unique([driveId, studentMembershipId])
  @@index([schoolId, studentMembershipId])
}

/// ONE CANDIDATE'S OUTCOME IN ONE ROUND, the drive's host college's row,
/// written by its cell or the drive's bound recruiter. Round 0 is the
/// shortlist. `feedback` is the recruiter's or the cell's; the student reads
/// it only when `feedbackShared`.
model RoundResult {
  id                  String   @id @default(cuid())
  schoolId            String
  driveId             String
  round               Int
  studentMembershipId String
  /// PASSED | REJECTED | ABSENT | ON_HOLD
  outcome             String
  feedback            String?
  feedbackShared      Boolean  @default(false)
  byUserId            String
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  school  School     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  drive   Drive      @relation(fields: [driveId], references: [id], onDelete: Cascade)
  student Membership @relation("RoundResultOf", fields: [studentMembershipId], references: [id], onDelete: Cascade)

  @@unique([driveId, round, studentMembershipId])
  @@index([schoolId, studentMembershipId])
}

/// AN OFFER, the drive's host college's row: the package (CTC a year, rupees,
/// as the letter states it), the letter (an upload), the student's answer
/// and the joining. `dreamException` marks an offer made to a student who
/// already held one, under the dream rule.
model Offer {
  id                  String    @id @default(cuid())
  schoolId            String
  driveId             String
  studentMembershipId String
  packageRupees       Int
  letterFileId        String?
  acceptedAt          DateTime?
  declinedAt          DateTime?
  joinedAt            DateTime?
  dreamException      Boolean   @default(false)
  byUserId            String
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  school  School     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  drive   Drive      @relation(fields: [driveId], references: [id], onDelete: Cascade)
  student Membership @relation("OfferOf", fields: [studentMembershipId], references: [id], onDelete: Cascade)

  @@unique([driveId, studentMembershipId])
  @@index([schoolId, studentMembershipId])
}

/// AN INTERNSHIP under the AICTE policy (AICTE_INTERNSHIP_BTECH in
/// packages/contracts): the student proposes it in a window (after semester
/// 2, 4 or 6), the cell or the HOD approves it naming the supervising
/// faculty, the student keeps the diary and hands in the report, the
/// industry supervisor's grade, the faculty visit and the viva are recorded,
/// and the credits are decided last (status CREDITED). `credits` has one
/// writer (src/lib/placement-internships.ts); the exam cell reads it through
/// `internshipCreditsForTerm`. A family business needs a parent's declaration.
model Internship {
  id                      String    @id @default(cuid())
  schoolId                String
  studentMembershipId     String
  companyId               String?
  companyName             String
  /// INDUSTRY | RESEARCH | FAMILY_BUSINESS
  kind                    String
  fromKey                 String
  toKey                   String
  hours                   Int
  credits                 Int?
  /// 2 | 4 | 6
  windowSemester          Int
  supervisorName          String
  facultyMembershipId     String?
  /// JSON array of { on, hours, text }.
  diary                   String    @default("[]")
  reportFileId            String?
  industryGrade           String?
  facultyVisitAt          DateTime?
  vivaMarks               Int?
  /// PROPOSED | APPROVED | SUBMITTED | EVALUATED | CREDITED | REFUSED
  status                  String    @default("PROPOSED")
  parentDeclarationFileId String?
  decidedByUserId         String?
  decidedAt               DateTime?
  refusedReason           String?
  creditedAt              DateTime?
  creditedByUserId        String?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  school  School     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student Membership @relation("InternshipOf", fields: [studentMembershipId], references: [id], onDelete: Cascade)

  @@index([schoolId, status])
  @@index([studentMembershipId])
  @@index([facultyMembershipId])
}

/// A STUDENTS' PROJECT with its guide: the reviews (JSON [{ on, byUserId, byName, note, marks }]) and the final marks.
model Project {
  id                   String   @id @default(cuid())
  schoolId             String
  /// JSON array of the students' membership ids.
  studentMembershipIds String   @default("[]")
  guideMembershipId    String
  title                String
  reviews              String   @default("[]")
  marks                Float?
  createdByUserId      String
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  school School     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  guide  Membership @relation("ProjectGuide", fields: [guideMembershipId], references: [id], onDelete: Cascade)

  @@index([schoolId])
  @@index([guideMembershipId])
}

/// A SEASON'S TABLE AS THE CELL PUBLISHED IT (one row per batch, the year of
/// passing): placed, higher studies, entrepreneurs, the median salary. A
/// STORED COPY with one writer (`publishSeason` in
/// src/lib/placement-analytics.ts) and a data:audit check that recomputes
/// it from the offers and the profiles; the live table is always computed
/// on read, and this row is what was filed.
model PlacementSeason {
  id                 String   @id @default(cuid())
  schoolId           String
  batchYear          Int
  finalYear          Int
  placed             Int
  higherStudies      Int
  entrepreneurs      Int
  offers             Int
  medianSalaryRupees Int?
  computedAt         DateTime @default(now())
  computedByUserId   String

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([schoolId, batchYear])
}

/// A GIFT FROM AN ALUMNUS, RECORDED ONLY: the college issued its receipt
/// outside the app (decision 0003); this is the governing body's line.
model AlumniGift {
  id                  String   @id @default(cuid())
  schoolId            String
  alumnusMembershipId String
  /// DONATION | ENDOWMENT | SCHOLARSHIP | IN_KIND
  kind                String
  amountRupees        Int?
  receiptRef          String
  note                String   @default("")
  onKey               String
  recordedByUserId    String
  createdAt           DateTime @default(now())

  school  School     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  alumnus Membership @relation("AlumniGiftOf", fields: [alumnusMembershipId], references: [id], onDelete: Cascade)

  @@index([schoolId, onKey])
}

/// AN ALUMNUS'S REFERRAL of an opening: into a drive the college has, or a
/// company the cell may approach.
model AlumniReferral {
  id                  String   @id @default(cuid())
  schoolId            String
  alumnusMembershipId String
  driveId             String?
  companyName         String   @default("")
  note                String
  createdAt           DateTime @default(now())

  school  School     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  alumnus Membership @relation("AlumniReferralOf", fields: [alumnusMembershipId], references: [id], onDelete: Cascade)
  drive   Drive?     @relation(fields: [driveId], references: [id], onDelete: SetNull)

  @@index([schoolId, createdAt])
}

/// AN ALUMNUS WHO RECRUITS, linked to their company's row: the cell sees the
/// alumni at a company it is talking to.
model AlumniCompanyLink {
  id                  String   @id @default(cuid())
  schoolId            String
  alumnusMembershipId String   @unique
  companyId           String
  role                String   @default("")
  createdAt           DateTime @default(now())

  school  School     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  alumnus Membership @relation("AlumniCompanyLinkOf", fields: [alumnusMembershipId], references: [id], onDelete: Cascade)
  company Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([schoolId, companyId])
}

/// AN ALUMNI MEET OR REUNION, on the calendar (an EVENT Holiday row made with
/// it, `holidayId`) with registration; for one batch or for all.
model AlumniMeet {
  id              String   @id @default(cuid())
  schoolId        String
  title           String
  onKey           String
  venue           String   @default("")
  note            String   @default("")
  batchYear       Int?
  holidayId       String?
  createdByUserId String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  school        School                   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  registrations AlumniMeetRegistration[]

  @@index([schoolId, onKey])
}

model AlumniMeetRegistration {
  id                  String    @id @default(cuid())
  schoolId            String
  meetId              String
  alumnusMembershipId String
  registeredAt        DateTime  @default(now())
  cancelledAt         DateTime?

  school  School     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  meet    AlumniMeet @relation(fields: [meetId], references: [id], onDelete: Cascade)
  alumnus Membership @relation("AlumniMeetRegistrationOf", fields: [alumnusMembershipId], references: [id], onDelete: Cascade)

  @@unique([meetId, alumnusMembershipId])
}

/**
 * --------------------------------------------------------------------------
 */
/**
 * IQAC (module IQAC, role IQAC; 4 October 2026): the NAAC predictor and its
 */
/**
 * evidence, the registers NAAC reads, surveys, grievances, faculty records,
 */
/**
 * the filings and the public disclosure. lib/iqac*.ts.
 */
/**
 * --------------------------------------------------------------------------
 */

/// One NAAC assessment a college is preparing for: the framework it is graded
/// under (packages/contracts v1/naac.ts), the five-year window its metrics
/// read, and the CGPA — a STORED COPY with one writer (`recomputeCycle` in
/// lib/iqac.ts) and a data:audit check that it equals the CGPA of the latest
/// MetricScore of every metric. `enteredJson` holds the figures the platform
/// does not keep (sanctioned posts, bandwidth…), each with who entered it and
/// the files behind it.
model AccreditationCycle {
  id              String    @id @default(cuid())
  schoolId        String
  framework       String
  institutionType String
  windowFrom      String
  windowTo        String
  /// OPEN | SUBMITTED | CLOSED
  status          String    @default("OPEN")
  cgpa            Float?
  cgpaComputedAt  DateTime?
  enteredJson     String    @default("{}")
  createdByUserId String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  school    School          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  scores    MetricScore[]
  filings   CollegeFiling[]
  scenarios IqacScenario[]

  @@index([schoolId, status])
}

/// A metric's value and 0–4 score at one computation. APPEND-ONLY: a
/// recomputation writes a new row per quantitative metric under one `runId`,
/// a qualitative score is a new row too, so the trend by term is read from
/// the rows and nothing is overwritten. The current score of a metric is its
/// latest row. `evidenceJson`: { rows: [{type,id,label}], files: [fileId],
/// inputs: [{key,value,source,reason}] }.
model MetricScore {
  id             String   @id @default(cuid())
  schoolId       String
  cycleId        String
  metricCode     String
  /// QN | QL
  kind           String
  runId          String
  value          Float?
  score          Float?
  provisional    Boolean  @default(true)
  evidenceJson   String   @default("{}")
  note           String   @default("")
  scoredByUserId String?
  computedAt     DateTime @default(now())

  school School             @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  cycle  AccreditationCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)

  @@index([cycleId, metricCode, computedAt])
  @@index([schoolId])
}

/// The research register: a publication, patent, funded project, consultancy,
/// book, conference paper, PhD scholar guided, award, MoU or seed grant. A
/// faculty member enters their own; the HOD reads the department's, the IQAC
/// the college's. `amountLakhs` is a grant's or a consultancy's figure as
/// recorded — no money passes through the platform (decision 0003).
model ResearchItem {
  id                  String   @id @default(cuid())
  schoolId            String
  kind                String
  title               String
  indexing            String   @default("NONE")
  year                Int
  amountLakhs         Float?
  facultyMembershipId String?
  departmentId        String?
  fileId              String?
  createdByUserId     String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  school  School      @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  faculty Membership? @relation("ResearchItemFaculty", fields: [facultyMembershipId], references: [id], onDelete: SetNull)

  @@index([schoolId, kind, year])
  @@index([facultyMembershipId])
}

/// The activity register: FDPs, workshops, extension, NSS and NCC, cultural
/// and sports events, guest lectures, visits, audits and the rest of
/// ACTIVITY_KINDS, with a head count and (for staff programmes) who took part.
model Activity {
  id                 String   @id @default(cuid())
  schoolId           String
  kind               String
  title              String
  at                 String
  participants       Int      @default(0)
  participantIdsJson String   @default("[]")
  theme              String?
  departmentId       String?
  fileId             String?
  createdByUserId    String?
  createdAt          DateTime @default(now())

  school School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  /// NSS and NCC (5 Oct 2026, the NSS/NCC officer's desk): the hours each participant earned, and whether it was a camp.
  hours  Float?
  camp   Boolean @default(false)

  @@index([schoolId, kind, at])
}

/// A statutory or institutional committee (grievance, anti-ragging, ICC,
/// CDC, governing body, IQAC, advisory) with its members as the office
/// recorded them.
model Committee {
  id          String   @id @default(cuid())
  schoolId    String
  kind        String
  name        String
  membersJson String   @default("[]")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  school   School             @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  meetings CommitteeMeeting[]
  /// A STUDENT_COUNCIL's notices on the bulletin (risks batch 5A, 5 Oct 2026).
  councilNotices Post[] @relation("CouncilNotices")

  @@index([schoolId, kind])
}

model CommitteeMeeting {
  id              String   @id @default(cuid())
  schoolId        String
  committeeId     String
  at              String
  minutesFileId   String?
  actionTaken     String   @default("")
  createdByUserId String?
  createdAt       DateTime @default(now())

  school    School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  committee Committee @relation(fields: [committeeId], references: [id], onDelete: Cascade)

  @@index([committeeId, at])
  @@index([schoolId])
}

/// A survey the IQAC runs (SURVEY_KINDS). `salt` makes the respondent hash of
/// an anonymous survey; it is wiped when the survey closes.
model Survey {
  id              String    @id @default(cuid())
  schoolId        String
  kind            String
  title           String
  termId          String?
  offeringId      String?
  opensOn         String
  closesOn        String
  questionsJson   String    @default("[]")
  salt            String    @default("")
  closedAt        DateTime?
  createdByUserId String?
  createdAt       DateTime  @default(now())

  school    School             @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  responses SurveyResponse[]
  atr       ActionTakenReport?

  @@index([schoolId, kind, closesOn])
}

/// One respondent's answers. `respondentHash` lets a person answer once; an
/// anonymous survey (every kind but COURSE_FEEDBACK) stores NO membership id —
/// a test holds that. Course feedback names its respondent, as the school's
/// teacher reviews do, and every read is an aggregate.
model SurveyResponse {
  id                     String   @id @default(cuid())
  schoolId               String
  surveyId               String
  respondentHash         String
  respondentMembershipId String?
  answersJson            String
  /// A transcribed paper form (an employer's), what it came from.
  source                 String?
  createdAt              DateTime @default(now())

  school     School      @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  survey     Survey      @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  respondent Membership? @relation("SurveyResponseBy", fields: [respondentMembershipId], references: [id], onDelete: Cascade)

  @@unique([surveyId, respondentHash])
  @@index([schoolId])
  @@index([respondentMembershipId])
}

/// What the college did about a survey's findings, published to its feed.
model ActionTakenReport {
  id              String    @id @default(cuid())
  schoolId        String
  surveyId        String    @unique
  text            String
  fileId          String?
  publishedAt     DateTime?
  postId          String?
  createdByUserId String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  survey Survey @relation(fields: [surveyId], references: [id], onDelete: Cascade)

  @@index([schoolId])
}

/// A student's grievance to the committee, with the UGC 2023 time limit:
/// `dueOn` is fifteen working days from filing, written once at filing (one
/// writer; a data:audit check recomputes it). A RAGGING grievance goes to the
/// anti-ragging committee and the page names the UGC portal as the legal
/// route; HARASSMENT goes to the internal complaints committee.
model Grievance {
  id               String    @id @default(cuid())
  schoolId         String
  byMembershipId   String
  kind             String
  /// GRIEVANCE | ANTI_RAGGING | ICC — the committee it went to.
  committeeKind    String    @default("GRIEVANCE")
  text             String
  fileId           String?
  anonymousToStaff Boolean   @default(false)
  /// OPEN | ACKNOWLEDGED | RESOLVED | ESCALATED
  status           String    @default("OPEN")
  filedAt          DateTime  @default(now())
  dueOn            String
  response         String    @default("")
  ombudspersonNote String    @default("")
  acknowledgedAt   DateTime?
  resolvedAt       DateTime?
  escalatedAt      DateTime?
  decidedByUserId  String?
  updatedAt        DateTime  @updatedAt

  school School     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  by     Membership @relation("GrievanceBy", fields: [byMembershipId], references: [id], onDelete: Cascade)

  @@index([schoolId, status])
  @@index([byMembershipId])
}

/// A college teacher's record beside the school's StaffRecord (which keeps
/// the staff number, designation text and DCF fields): the coded designation,
/// appointment and highest qualification NAAC and AICTE count, experience
/// before joining, the APAAR faculty id, the PAN sealed (secret-box) with its
/// last four shown, and the API-score inputs for promotion.
model FacultyRecord {
  id                    String    @id @default(cuid())
  schoolId              String
  membershipId          String    @unique
  designation           String
  appointment           String
  highestQualification  String
  netSetQualified       Boolean   @default(false)
  experienceBeforeYears Float     @default(0)
  joinedOn              String?
  departmentId          String?
  apaarFacultyId        String?
  panSealed             String?
  panLast4              String?
  apiScoreJson          String    @default("{}")
  updatedByUserId       String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  /// The faculty member's own opt-in to a public profile page (5 Oct 2026): when they published it; null while they
  /// have not, or after they (or the office) took it down. Written only by lib/faculty-profile.ts.
  publicProfileAt       DateTime?
  // website-three (17 Oct 2026)
  /// The faculty member's own public photo (a stored file, uploaded on /faculty/profile with their own consent tick),
  /// shown on the college website's Faculty page and the public faculty page while the site is live. Written only by
  /// lib/faculty-profile.ts; the consent stamp is when they ticked it. Removing the photo clears both.
  publicPhotoFileId     String?
  publicPhotoConsentAt  DateTime?
  // end website-three

  school        School                @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  membership    Membership            @relation("FacultyRecordOf", fields: [membershipId], references: [id], onDelete: Cascade)
  publicProfile FacultyPublicProfile?

  @@index([schoolId])
  // website-three (17 Oct 2026)
  @@index([publicPhotoFileId])
  // end website-three
}

/// A FACULTY MEMBER'S PUBLIC PROFILE (5 Oct 2026; integration decision 10): the
/// page a teacher chooses to publish for the college's website, linked from
/// the published AICTE disclosure. A frozen snapshot — name, designation,
/// department, qualification, experience and the research register's titles —
/// written by the faculty member's own "publish" (lib/faculty-profile.ts, the
/// one writer) and readable by anyone while `publishedAt` is set
/// (GLOBAL_READABLE in scripts/gen-rls.ts), like DisclosurePage beside it: no
/// contact detail, no PAN, no student. Taking it down deletes the row.
model FacultyPublicProfile {
  id              String   @id @default(cuid())
  schoolId        String
  schoolSlug      String
  facultyRecordId String   @unique
  snapshotJson    String   @default("{}")
  publishedAt     DateTime @default(now())
  updatedAt       DateTime @updatedAt
  // website-three (17 Oct 2026)
  /// The photo the published page shows: the record's own public photo, copied here when the page is published or
  /// refreshed and at once when the member changes or removes it. Public (the file route) only while the college's
  /// website is live.
  publicPhotoFileId String?
  // end website-three

  school School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  record FacultyRecord @relation(fields: [facultyRecordId], references: [id], onDelete: Cascade)

  @@index([schoolId])
  @@index([schoolSlug])
  // website-three (17 Oct 2026)
  @@index([publicPhotoFileId])
  // end website-three
}

/// A return the college files (SSR, AQAR, IIQA, NIRF, AISHE, the AICTE
/// disclosure, the affiliation return), cut from live rows at `generatedAt`.
/// `body` is what the file is made from (CSV text, or the JSON the PDF is
/// drawn from) and `hash` the SHA-256 of the file's bytes; `figuresJson` the
/// headline numbers it printed, which data:audit regenerates and compares.
/// The NAAC documents wait for the principal's sign-off (status
/// AWAITING_SIGNOFF → SIGNED_OFF | RETURNED); `checked` is the IQAC's mark
/// that it went in on the portal, `fileId` the portal's acknowledgement.
model CollegeFiling {
  id                String    @id @default(cuid())
  schoolId          String
  kind              String
  cycleId           String?
  year              Int
  format            String
  body              String
  hash              String
  figuresJson       String    @default("{}")
  /// THE FIELDS WITH NO HISTORY, AS THEY STOOD AT GENERATION (R-21, risks batch 5 Oct 2026): each teacher's department,
  /// designation, qualification and appointment, each programme's intake, the students' higher-studies and
  /// entrepreneur flags. Written once by generateFilingAs with the body; council-filings.ts reads it for any later
  /// build of the year (the view, the data audit), so a filed year does not drift when those rows change.
  snapshotJson      String    @default("{}")
  status            String    @default("DRAFT")
  checked           Boolean   @default(false)
  fileId            String?
  principalNote     String    @default("")
  submittedAt       DateTime?
  signedOffAt       DateTime?
  signedOffByUserId String?
  generatedByUserId String?
  generatedAt       DateTime  @default(now())
  /// An NBA SAR's engineering department (5 Oct 2026): one SAR per department per year; null for the college's own filings.
  departmentId      String?

  school School              @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  cycle  AccreditationCycle? @relation(fields: [cycleId], references: [id], onDelete: SetNull)

  @@index([schoolId, kind, year])
}

/// What a council's return asks that no row of the platform holds (5 Oct
/// 2026): the BCI's compliance items and NCTE's infrastructure items, which the
/// office answers as a checklist, and NBA's qualitative criteria, which the
/// HOD writes and self-assesses against the SAR's marks. One per college, kind,
/// academic year and department ("" for a college-wide return). `itemsJson`
/// is { [code]: { answer, score, note } } with codes from
/// packages/contracts v1/council-filings.ts. Input, not a derived value: a
/// filing prints the worksheet as it stood when generated.
model FilingWorksheet {
  id              String   @id @default(cuid())
  schoolId        String
  kind            String
  year            Int
  departmentId    String   @default("")
  itemsJson       String   @default("{}")
  updatedByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([schoolId, kind, year, departmentId])
}

/// An uploaded document the IQAC cites: evidence for a metric, minutes, a
/// research item's paper, a grievance's attachment. Registered when an upload
/// ticket is spent, so lib/files.ts can say who may read it: the IQAC desk
/// (IQAC, ADMIN, PRINCIPAL) of the college, and the person who uploaded it.
model IqacFile {
  id                     String   @id @default(cuid())
  schoolId               String
  fileId                 String   @unique
  title                  String
  purpose                String
  uploadedByUserId       String
  uploadedByMembershipId String?
  createdAt              DateTime @default(now())

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId, purpose])
}

/// The AICTE mandatory disclosure a college publishes at
/// /public/disclosure/<slug>: a frozen snapshot cut from the live rows when
/// the IQAC publishes, readable by anyone while `publishedAt` is set
/// (GLOBALLY_READABLE in scripts/gen-rls.ts). `schoolSlug` is copied at
/// publish (one writer) so a signed-out reader finds it without reading School.
model DisclosurePage {
  id           String    @id @default(cuid())
  schoolId     String    @unique
  schoolSlug   String    @unique
  publishedAt  DateTime?
  snapshotJson String    @default("{}")
  hash         String    @default("")
  updatedAt    DateTime  @updatedAt

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
}

/// A LAB BATCH (stream records, 5 Oct 2026): part of a division that does its
/// practicals together, made by the office by splitting the division evenly
/// (lib/stream-records.ts). A student is in at most one batch of a division
/// (LabBatchMember's unique key). A LAB hour on the timetable and its lectures
/// may name a batch; then the roster, the marks and the practical record are
/// the batch's members only.
model LabBatch {
  id         String   @id @default(cuid())
  schoolId   String
  divisionId String
  name       String
  capacity   Int      @default(20)
  createdAt  DateTime @default(now())

  school   School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  division Division         @relation(fields: [divisionId], references: [id], onDelete: Cascade)
  members  LabBatchMember[]
  slots    OfferingSlot[]
  lectures Lecture[]
  /// The clinical desk (10 Oct 2026): a batch posted on its own.
  clinicalPostings ClinicalPosting[]

  @@unique([divisionId, name])
  @@index([schoolId])
}

/// A student in a lab batch; `divisionId` repeats the batch's so a student is in one batch of a division at most.
model LabBatchMember {
  id                  String  @id @default(cuid())
  schoolId            String
  batchId             String
  divisionId          String
  studentMembershipId String
  /// S4B-0 (5 Oct 2026): the days this row holds, as the college's date keys — "" is since the batch began, null
  /// untilKey is still. A re-split or a move ends a changed row the day before it takes effect and opens a new one, so
  /// a past LAB lecture's roster is the batch on its own day (stream-records.ts `memberOn`). One open row per student
  /// and division, kept by the two writers (splitLabBatches, moveToLabBatch).
  fromKey             String  @default("")
  untilKey            String?

  school  School     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  batch   LabBatch   @relation(fields: [batchId], references: [id], onDelete: Cascade)
  student Membership @relation("LabBatchMemberOf", fields: [studentMembershipId], references: [id], onDelete: Cascade)

  @@unique([divisionId, studentMembershipId, fromKey])
  @@index([batchId])
  @@index([schoolId])
}

/// THE PRACTICAL RECORD (stream records, 5 Oct 2026; the PCI asks for it
/// first, any lab offering may keep it): one experiment a student performed
/// on an offering, its marks, and the signature of the offering's faculty
/// member or a LAB_INCHARGE. Signed rows are not edited.
model PracticalRecord {
  id                   String    @id @default(cuid())
  schoolId             String
  offeringId           String
  studentMembershipId  String
  experimentNo         Int
  title                String
  /// The day it was performed (YYYY-MM-DD).
  performedOn          String
  marks                Int?
  signedByMembershipId String?
  signedAt             DateTime?
  createdByUserId      String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  school   School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  offering CourseOffering @relation(fields: [offeringId], references: [id], onDelete: Cascade)
  student  Membership     @relation("PracticalRecordOf", fields: [studentMembershipId], references: [id], onDelete: Cascade)

  @@unique([offeringId, studentMembershipId, experimentNo])
  @@index([schoolId, performedOn])
  @@index([studentMembershipId])
}

/// A MOOT COURT (stream records, LAW, 5 Oct 2026): an intra-college,
/// inter-college or national moot, its teams (JSON [{ name, membershipIds,
/// outcome }], MOOT_OUTCOMES), the result and the judges' notes.
model MootCourt {
  id              String   @id @default(cuid())
  schoolId        String
  name            String
  /// The day it was held (YYYY-MM-DD).
  at              String
  /// INTRA | INTER | NATIONAL (MOOT_COURT_KINDS)
  kind            String
  teamsJson       String   @default("[]")
  result          String   @default("")
  judgeNotes      String   @default("")
  createdByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId, at])
}

/// A SCHOOL WHERE STUDENT TEACHERS PRACTISE (stream records, EDUCATION, 5 Oct 2026), with its UDISE code when known.
model PracticeSchool {
  id         String    @id @default(cuid())
  schoolId   String
  name       String
  udise      String?
  contact    String    @default("")
  archivedAt DateTime?
  createdAt  DateTime  @default(now())

  school   School                    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  postings TeachingPracticePosting[]

  @@unique([schoolId, name])
}

/// A student teacher's posting to a practice school for a span of days, with the lessons planned; the lessons observed are counted from LessonObservation on read.
model TeachingPracticePosting {
  id                  String   @id @default(cuid())
  schoolId            String
  studentMembershipId String
  practiceSchoolId    String
  fromKey             String
  toKey               String
  lessonsPlanned      Int      @default(0)
  createdByUserId     String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  school         School              @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student        Membership          @relation("PracticePostingOf", fields: [studentMembershipId], references: [id], onDelete: Cascade)
  practiceSchool PracticeSchool      @relation(fields: [practiceSchoolId], references: [id], onDelete: Cascade)
  observations   LessonObservation[]

  @@index([schoolId, fromKey])
  @@index([studentMembershipId])
}

/// One lesson of a posting watched by a teacher educator, with the grade (LESSON_GRADES) and a note.
model LessonObservation {
  id                   String   @id @default(cuid())
  schoolId             String
  postingId            String
  /// The day of the lesson (YYYY-MM-DD).
  at                   String
  observerMembershipId String
  grade                String
  note                 String   @default("")
  createdAt            DateTime @default(now())

  school  School                  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  posting TeachingPracticePosting @relation(fields: [postingId], references: [id], onDelete: Cascade)

  @@index([postingId])
  @@index([schoolId])
}

/// A student in the college's NSS or NCC unit (5 Oct 2026, the officer's desk): when they joined and, once they leave, when.
model CorpsEnrolment {
  id                  String   @id @default(cuid())
  schoolId            String
  /// NSS | NCC (CORPS)
  corps               String
  studentMembershipId String
  unit                String   @default("")
  enrolledOn          String
  leftOn              String?
  createdByUserId     String?
  createdAt           DateTime @default(now())

  school  School     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student Membership @relation("CorpsEnrolmentOf", fields: [studentMembershipId], references: [id], onDelete: Cascade)

  @@unique([corps, studentMembershipId])
  @@index([schoolId, corps])
}

/// THE EXAM FLYING SQUAD'S VISIT to a paper's halls (5 Oct 2026, the EXAM_SQUAD duty): when, which hall, who went, whether anything was found and a note. A case of unfair means stays the exam cell's to enter (Malpractice).
model ExamSquadVisit {
  id             String   @id @default(cuid())
  schoolId       String
  scheduleId     String
  examRoomId     String?
  at             DateTime
  byMembershipId String
  members        String   @default("")
  flagged        Boolean  @default(false)
  note           String   @default("")
  createdAt      DateTime @default(now())

  school   School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  schedule ExamSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  @@index([schoolId, at])
  @@index([scheduleId])
}

/// A what-if the IQAC, the principal or an engineering HOD saved from the
/// simulator (5 Oct 2026; lib/iqac-insights.ts, the arithmetic in
/// lib/accreditation-insights.ts): the inputs as typed and what they gave.
/// kind NAAC: a cycle's facts and qualitative scores (`cycleId`), `cgpa` the
/// CGPA; kind NBA: an engineering department's SAR figures for a year
/// (`year`, `departmentId`), `marks` the SAR's total of 1,000. `cgpa` and
/// `marks` are stored copies with ONE WRITER (saveScenario) and a data:audit
/// check that recomputes them from `inputsJson`; every read recomputes them.
model IqacScenario {
  id              String   @id @default(cuid())
  schoolId        String
  /// NAAC | NBA
  kind            String   @default("NAAC")
  cycleId         String?
  year            Int?
  departmentId    String?
  name            String
  inputsJson      String   @default("{}")
  cgpa            Float?
  marks           Float?
  createdByUserId String?
  createdAt       DateTime @default(now())

  school School              @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  cycle  AccreditationCycle? @relation(fields: [cycleId], references: [id], onDelete: Cascade)

  @@index([schoolId, kind, createdAt])
  @@index([cycleId])
}

// ---------------------------------------------------------------------------
// The risks batch's college builds (package 5B, R-2, 5 Oct 2026): a company's
// pre-placement talk, soft-skills training, the attendance devices and their
// punches, and the peer-team visit file. Every row carries `schoolId` under
// RLS; the people are membership ids (no relation, as Internship's faculty).
// ---------------------------------------------------------------------------

/// A PRE-PLACEMENT TALK (lib/placement-talks.ts): a company's talk to the
/// college's students, set by the TPO, with each student's RSVP and the
/// attendance the TPO marks once it is held. `driveId` is the drive it belongs
/// to (one talk a drive; the drive's page links to it). Who may answer is any
/// student of the college while it is SCHEDULED and ahead; the counts (going,
/// present) are computed on read and stored nowhere.
model PlacementTalk {
  id              String    @id @default(cuid())
  schoolId        String
  driveId         String?   @unique
  companyName     String
  title           String
  startsAt        DateTime
  durationMinutes Int       @default(60)
  venue           String    @default("")
  note            String    @default("")
  /// The seats: GOING answers stop here; null is no limit.
  capacity        Int?
  /// SCHEDULED | CANCELLED
  status          String    @default("SCHEDULED")
  /// When the TPO first marked attendance: the talk was held.
  heldAt          DateTime?
  createdByUserId String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  school School              @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  drive  Drive?              @relation(fields: [driveId], references: [id], onDelete: SetNull)
  rsvps  PlacementTalkRsvp[]

  @@index([schoolId, startsAt])
}

/// ONE STUDENT AT ONE TALK: the answer (GOING or NOT_GOING; null for a walk-in
/// the TPO marked) and the attendance (PRESENT or ABSENT, the TPO's; null
/// until marked).
model PlacementTalkRsvp {
  id                  String    @id @default(cuid())
  schoolId            String
  talkId              String
  studentMembershipId String
  answer              String?
  answeredAt          DateTime?
  attendance          String?
  markedByUserId      String?
  markedAt            DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  school School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  talk   PlacementTalk @relation(fields: [talkId], references: [id], onDelete: Cascade)

  @@unique([talkId, studentMembershipId])
  @@index([schoolId, studentMembershipId])
}

/// A SOFT-SKILLS TRAINING (lib/soft-skills.ts): the TPO's course in a skill
/// (SOFT_SKILLS in packages/contracts) with its sessions; students enrol
/// while it is OPEN, the TPO marks each session's attendance, and a student
/// has COMPLETED it once present at `minAttendancePercent` of its sessions
/// that were not cancelled — computed on read, never stored.
model SoftSkillsTraining {
  id                   String   @id @default(cuid())
  schoolId             String
  title                String
  skill                String
  trainer              String   @default("")
  description          String   @default("")
  capacity             Int?
  minAttendancePercent Int      @default(75)
  /// OPEN (students may enrol) | CLOSED (no new enrolment; sessions and attendance go on)
  status               String   @default("OPEN")
  createdByUserId      String
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  school     School                @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  sessions   SoftSkillsSession[]
  enrolments SoftSkillsEnrolment[]

  @@index([schoolId, status])
}

/// One session of a training; `heldAt` is set when its attendance is first marked.
model SoftSkillsSession {
  id              String    @id @default(cuid())
  schoolId        String
  trainingId      String
  startsAt        DateTime
  durationMinutes Int       @default(60)
  topic           String    @default("")
  venue           String    @default("")
  cancelledAt     DateTime?
  heldAt          DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  school     School                 @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  training   SoftSkillsTraining     @relation(fields: [trainingId], references: [id], onDelete: Cascade)
  attendance SoftSkillsAttendance[]

  @@index([trainingId, startsAt])
  @@index([schoolId])
}

/// A student on a training's roll; `withdrawnAt` takes them off it (their marks stay).
model SoftSkillsEnrolment {
  id                  String    @id @default(cuid())
  schoolId            String
  trainingId          String
  studentMembershipId String
  enrolledAt          DateTime  @default(now())
  withdrawnAt         DateTime?
  byUserId            String

  school   School             @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  training SoftSkillsTraining @relation(fields: [trainingId], references: [id], onDelete: Cascade)

  @@unique([trainingId, studentMembershipId])
  @@index([schoolId, studentMembershipId])
}

/// One student's presence at one session, the TPO's mark (a re-mark replaces it).
model SoftSkillsAttendance {
  id                  String   @id @default(cuid())
  schoolId            String
  sessionId           String
  studentMembershipId String
  present             Boolean
  markedByUserId      String
  markedAt            DateTime @default(now())
  updatedAt           DateTime @updatedAt

  school  School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  session SoftSkillsSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, studentMembershipId])
  @@index([schoolId, studentMembershipId])
}

/// A BIOMETRIC OR RFID READER the office registered (lib/attendance-devices.ts).
/// It posts signed punches to POST /api/v1/punch/{schoolId}: an HMAC-SHA256 over
/// the timestamp and the body with the device's own key. The key is shown once
/// when made or rotated and kept SEALED (secret-box, bound to the school and the
/// device) with ONE WRITER, `issueDeviceKey`; `keyLast4` is what the page shows.
/// `scope` says whom it may mark: STAFF, STUDENTS or BOTH.
model AttendanceDevice {
  id              String    @id @default(cuid())
  schoolId        String
  name            String
  /// BIOMETRIC | RFID | FACE | OTHER
  kind            String    @default("BIOMETRIC")
  location        String    @default("")
  scope           String    @default("BOTH")
  keySealed       String
  keyLast4        String
  keyVersion      Int       @default(1)
  keyRotatedAt    DateTime  @default(now())
  disabledAt      DateTime?
  lastPunchAt     DateTime?
  createdByUserId String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  school  School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  punches AttendancePunch[]

  @@index([schoolId])
}

/// THE CODE A DEVICE SENDS FOR A PERSON: a card's number or the enrolment
/// number a fingerprint reader keeps (never a template, never Aadhaar), mapped
/// by the office to a membership. One code is one person at a school.
model AttendanceBadge {
  id              String   @id @default(cuid())
  schoolId        String
  code            String
  membershipId    String
  createdByUserId String
  createdAt       DateTime @default(now())

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([schoolId, code])
  @@index([membershipId])
}

/// A PUNCH AS RECEIVED, kept once per device and the device's own punch id
/// (a replay is answered with the stored outcome and writes nothing). The
/// register and the staff check-in are written only through their own
/// writers (`saveAttendanceBatch`, `recordStaffCheckIn`); this row is the log
/// of what came in and what became of it: APPLIED | ALREADY_MARKED |
/// UNKNOWN_BADGE | NO_REGISTER | CLOSED_DAY | OUT_OF_SCOPE | NOT_RECENT.
model AttendancePunch {
  id           String   @id @default(cuid())
  schoolId     String
  deviceId     String
  externalId   String
  code         String
  membershipId String?
  punchedAt    DateTime
  dateKey      String
  /// IN | OUT, when the device says
  direction    String?
  outcome      String
  receivedAt   DateTime @default(now())

  school School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  device AttendanceDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@unique([deviceId, externalId])
  @@index([schoolId, dateKey])
  @@index([membershipId])
}

/// THE PEER-TEAM VISIT FILE (lib/peer-visits.ts): one NAAC peer team's or NBA
/// expert team's visit with its schedule and its evidence index in one place,
/// beside the SAR pack the page reads from the filings (computed on read). A
/// NAAC visit names its cycle; an NBA visit its engineering department and
/// year. The IQAC writes any; an HOD writes their own department's NBA visit;
/// the principal and the office read.
model PeerTeamVisit {
  id              String   @id @default(cuid())
  schoolId        String
  /// NAAC | NBA
  framework       String
  cycleId         String?
  departmentId    String?
  /// The academic year's first calendar year (2026 for 2026–27): the SAR's year for NBA.
  year            Int
  title           String
  fromDate        String
  toDate          String
  /// JSON array of { name, role } — the visiting team as they were announced.
  teamJson        String   @default("[]")
  /// PLANNED | DONE
  status          String   @default("PLANNED")
  createdByUserId String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  school School          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  items  PeerVisitItem[]

  @@index([schoolId, framework])
}

/// A LINE OF A VISIT'S FILE. SCHEDULE: a slot of a day (`dayKey`, minutes from
/// midnight, the activity, the venue, who takes it). EVIDENCE: a criterion or
/// metric code and what answers it — a filing (CollegeFiling), an IQAC file, a
/// metric's latest score, a council worksheet, a link, or a note.
model PeerVisitItem {
  id              String   @id @default(cuid())
  schoolId        String
  visitId         String
  /// SCHEDULE | EVIDENCE
  kind            String
  dayKey          String?
  startMinute     Int?
  endMinute       Int?
  activity        String   @default("")
  venue           String   @default("")
  ownerName       String   @default("")
  criterion       String   @default("")
  title           String   @default("")
  /// FILING | FILE | METRIC | WORKSHEET | LINK | NOTE
  linkKind        String?
  linkId          String?
  url             String?
  note            String   @default("")
  position        Int      @default(0)
  createdByUserId String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  school School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  visit  PeerTeamVisit @relation(fields: [visitId], references: [id], onDelete: Cascade)

  @@index([visitId, kind, position])
  @@index([schoolId])
}

// ---------------------------------------------------------------------------
// The assistant (docs/plans/assistant.md Phase B, decision 0005, 9 Oct 2026)
//
// A conversation is the unit: nothing is remembered across them, and each is deleted
// RETENTION_ASSISTANT_DAYS (30) after its last message by the retention sweep. Never in the
// audit log: the use is counted in AssistantUsage, by number, never by word.
// ---------------------------------------------------------------------------

/// One conversation of one person at one school. A guardian has no membership: theirs is filed
/// under the school of the child they chose (membershipId null, userId the guardian).
model AssistantConversation {
  id           String   @id @default(cuid())
  schoolId     String
  /// The asker's membership at this school; null for a guardian.
  membershipId String?
  userId       String
  /// The role the conversation was opened in (the policy table reads it on every question).
  role         String
  /// en | hi | mr: the language it was opened in; a question typed in another of the three is answered in that one.
  language     String   @default("en")
  /// The first question, shortened, as the person typed it: the list's title.
  title        String?
  createdAt    DateTime @default(now())
  lastAt       DateTime @default(now())
  /// Prompt and completion tokens spent on this conversation (the school's month is AssistantUsage's).
  tokens       Int      @default(0)

  school   School             @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  messages AssistantMessage[]

  @@index([schoolId, userId, lastAt])
  @@index([lastAt])
}

/// One message. `text` is what the person typed (kept for them to re-read) or the answer as shown;
/// `textForModel` is the question as the model saw it, names, ids, codes, e-mails and phone numbers
/// replaced by placeholders (src/lib/assistant/strip.ts). `verdict` is the gate's coded reason
/// (ASSISTANT_VERDICTS in packages/contracts); `matchedAssignmentId` the hand-in assignment a
/// question matched, which the second-ask rule reads.
model AssistantMessage {
  id                  String   @id @default(cuid())
  conversationId      String
  schoolId            String
  /// USER | ASSISTANT
  role                String
  text                String
  textForModel        String?
  /// JSON AssistantCitation[]: only passages the search returned.
  citationsJson       String   @default("[]")
  verdict             String?
  /// HELP | TUTOR, or null for a fixed sentence.
  mode                String?
  hint                Boolean  @default(false)
  matchedAssignmentId String?
  helpful             Boolean?
  promptTokens        Int      @default(0)
  completionTokens    Int      @default(0)
  /// Vidura pass 3 (18 Oct 2026): the mode the gate had reached (USING | RECORDS | LEARNING) on every answer row, a
  /// fixed sentence's too where the gate got that far; null before it. Read by the unanswered report (vidura:gaps).
  scope               String?
  /// Vidura pass 3: the gate's reason codes, never a word: NOTHING_FOUND (below both thresholds, or no passage and no
  /// data) or CLASSIFIER for OUT_OF_SCOPE; the answer gate's codes (CITATION, FOREIGN_PAGE, …) for ANSWER_DISCARDED.
  gateReasons         String?
  /// Vidura pass 3: the operator's standard answer this row served (CachedAnswer), when it was one.
  cachedAnswerId      String?
  createdAt           DateTime @default(now())

  conversation AssistantConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  school       School                @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([schoolId])
}

/// THE COUNT, NEVER THE TEXT: one row per person per school day. The daily cap reads a person's
/// row, the school's monthly token budget and the office's card sum the month's rows. It outlives
/// the conversations (a deleted conversation must not give back its tokens) and is swept after
/// ASSISTANT_USAGE_KEEP_DAYS by the retention job.
model AssistantUsage {
  id               String   @id @default(cuid())
  schoolId         String
  userId           String
  /// YYYY-MM-DD in the school's time zone.
  dayKey           String
  questions        Int      @default(0)
  answered         Int      @default(0)
  hints            Int      @default(0)
  refused          Int      @default(0)
  counsellorRoutes Int      @default(0)
  modelCalls       Int      @default(0)
  promptTokens     Int      @default(0)
  completionTokens Int      @default(0)
  helpful          Int      @default(0)
  notHelpful       Int      @default(0)
  /// Vidura pass 3 (18 Oct 2026): answers served from an operator's standard answer (CachedAnswer), counted on the office's card.
  standardAnswers  Int      @default(0)
  updatedAt        DateTime @updatedAt

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([schoolId, userId, dayKey])
  @@index([schoolId, dayKey])
}

/// A pupil's assistant settings their guardian holds: the opt-out (any one active guardian may
/// turn it off or back on), and when the one-time notice went to the guardians.
model AssistantChildSetting {
  id                  String    @id @default(cuid())
  schoolId            String
  studentMembershipId String    @unique
  optedOut            Boolean   @default(false)
  changedByUserId     String?
  changedAt           DateTime?
  noticeSentAt        DateTime?
  createdAt           DateTime  @default(now())

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId])
}

/// THE CLINICAL COORDINATOR'S DESK (R-56, the clinical half; 10 Oct 2026; lib/clinical.ts).
/// A site students are posted to: the teaching hospital or an attached one, a PHC, a clinic, a hospital pharmacy
/// (CLINICAL_SITE_KINDS); the agreement's dates; the contact as a role word (CLINICAL_CONTACT_ROLES), never a person.
model ClinicalSite {
  id               String    @id @default(cuid())
  schoolId         String
  name             String
  /// HOSPITAL | PRIMARY_HEALTH_CENTRE | CLINIC | PHARMACY
  kind             String
  address          String    @default("")
  agreementFromKey String?
  agreementToKey   String?
  contactRole      String
  archivedAt       DateTime?
  createdAt        DateTime  @default(now())

  school      School               @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  departments ClinicalDepartment[]
  postings    ClinicalPosting[]

  @@unique([schoolId, name])
}

/// A ward or department of a clinical site, with its beds (or a pharmacy's counters) when counted.
model ClinicalDepartment {
  id        String   @id @default(cuid())
  schoolId  String
  siteId    String
  name      String
  beds      Int?
  createdAt DateTime @default(now())

  school   School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  site     ClinicalSite      @relation(fields: [siteId], references: [id], onDelete: Cascade)
  postings ClinicalPosting[]

  @@unique([siteId, name])
  @@index([schoolId])
}

/// A division (or one of its lab batches) posted to a site's department for a span of days under a supervising
/// faculty member, in a rotation's order. The students are the division's enrolment (the batch's members) on read.
model ClinicalPosting {
  id                     String   @id @default(cuid())
  schoolId               String
  siteId                 String
  departmentId           String
  divisionId             String
  labBatchId             String?
  supervisorMembershipId String
  fromKey                String
  toKey                  String
  rotationOrder          Int      @default(1)
  createdByUserId        String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  school     School             @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  site       ClinicalSite       @relation(fields: [siteId], references: [id], onDelete: Cascade)
  department ClinicalDepartment @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  division   Division           @relation(fields: [divisionId], references: [id], onDelete: Cascade)
  labBatch   LabBatch?          @relation(fields: [labBatchId], references: [id], onDelete: Cascade)
  supervisor Membership         @relation("ClinicalSupervisorOf", fields: [supervisorMembershipId], references: [id], onDelete: Cascade)
  entries    LogbookEntry[]

  @@index([schoolId, fromKey])
  @@index([divisionId])
  @@index([supervisorMembershipId])
}

/// One student's logbook entry of a posting: a case, a procedure, a skill or dispensing (LOGBOOK_KINDS) on a day,
/// a count, a short note THAT CARRIES NO PATIENT NAME OR NUMBER (refused on save), the supervisor's sign-off with
/// the time and a remark, and the state DRAFT | SUBMITTED | SIGNED | RETURNED. `clientId` makes a phone's replay
/// write one row (unique per student).
model LogbookEntry {
  id                   String    @id @default(cuid())
  schoolId             String
  postingId            String
  studentMembershipId  String
  clientId             String
  onKey                String
  /// CASE | PROCEDURE | SKILL | DISPENSING
  kind                 String
  count                Int       @default(1)
  note                 String    @default("")
  /// DRAFT | SUBMITTED | SIGNED | RETURNED
  state                String    @default("DRAFT")
  submittedAt          DateTime?
  signedAt             DateTime?
  signedByMembershipId String?
  remark               String    @default("")
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  school  School          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  posting ClinicalPosting @relation(fields: [postingId], references: [id], onDelete: Cascade)
  student Membership      @relation("LogbookEntryOf", fields: [studentMembershipId], references: [id], onDelete: Cascade)

  @@unique([studentMembershipId, clientId])
  @@index([schoolId, state])
  @@index([postingId])
}

/// A DESIGN STUDIO (the studio desk, R-56's studio half, ARCHITECTURE, 10 Oct
/// 2026; lib/studio.ts): a course offering's studio for its term — the brief,
/// the coordinator (a FACULTY or HOD holding STUDIO_COORDINATOR), the marks a
/// jury gives out of, and the four stage dates (date keys; the brief's day is
/// always set, the rest once the coordinator fixes them).
model Studio {
  id                      String   @id @default(cuid())
  schoolId                String
  offeringId              String
  termId                  String
  title                   String
  brief                   String   @default("")
  maxMarks                Int      @default(100)
  coordinatorMembershipId String
  briefIssuedOn           String
  interimOn               String?
  finalOn                 String?
  juryOn                  String?
  createdByUserId         String?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  school      School             @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  offering    CourseOffering     @relation(fields: [offeringId], references: [id], onDelete: Cascade)
  term        AcademicTerm       @relation(fields: [termId], references: [id], onDelete: Cascade)
  coordinator Membership         @relation("StudioCoordinatorOf", fields: [coordinatorMembershipId], references: [id], onDelete: Cascade)
  submissions StudioSubmission[]
  juries      StudioJury[]

  @@index([schoolId, termId])
  @@index([offeringId])
  @@index([coordinatorMembershipId])
}

/// One student's work for a studio stage (INTERIM_PINUP or FINAL_SUBMISSION): a
/// note and, where they have one, a file stored through an upload ticket of
/// theirs (files.ts lets the student, the studio's teachers and the office read
/// it); state DRAFT until sent, SUBMITTED by the stage's day, LATE after it.
model StudioSubmission {
  id                  String    @id @default(cuid())
  schoolId            String
  studioId            String
  studentMembershipId String
  /// STUDIO_SUBMISSION_STAGES
  stage               String
  /// STUDIO_SUBMISSION_STATES
  state               String    @default("DRAFT")
  note                String    @default("")
  fileId              String?
  fileName            String?
  fileMime            String?
  fileSize            Int?
  submittedAt         DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  school  School     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  studio  Studio     @relation(fields: [studioId], references: [id], onDelete: Cascade)
  student Membership @relation("StudioSubmissionOf", fields: [studentMembershipId], references: [id], onDelete: Cascade)

  @@unique([studioId, studentMembershipId, stage])
  @@index([schoolId])
  @@index([studentMembershipId])
}

/// A JURY: a sitting on a day for a studio, with its panel — the college's own
/// FACULTY and HOD members (panelJson: a JSON list of membership ids), one of
/// them the chair, and up to two external jurors kept as a role word and an
/// institution only (externalJson: [{ role, institution }], EXTERNAL_JUROR_ROLES;
/// never a name or a contact). The chair's signature closes the sheet: no mark
/// changes after it, and only then do the marks reach the students.
model StudioJury {
  id                   String    @id @default(cuid())
  schoolId             String
  studioId             String
  /// The day of the sitting (YYYY-MM-DD).
  on                   String
  title                String    @default("")
  panelJson            String    @default("[]")
  chairMembershipId    String
  externalJson         String    @default("[]")
  signedByMembershipId String?
  signedAt             DateTime?
  createdByUserId      String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  school School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  studio Studio           @relation(fields: [studioId], references: [id], onDelete: Cascade)
  marks  StudioJuryMark[]

  @@index([schoolId, on])
  @@index([studioId])
}

/// One student's mark from one jury, in tenths of a mark out of the studio's
/// maximum (null marks is absent), with the panel's remark; written by a juror
/// on the panel through lib/studio.ts `saveJuryMarks` alone (one writer,
/// audited studio.marks). The grade band is read from the marks, never stored.
model StudioJuryMark {
  id                   String   @id @default(cuid())
  schoolId             String
  juryId               String
  studentMembershipId  String
  marksTenths          Int?
  remark               String   @default("")
  markedByMembershipId String
  markedAt             DateTime @default(now())

  school  School     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  jury    StudioJury @relation(fields: [juryId], references: [id], onDelete: Cascade)
  student Membership @relation("StudioJuryMarkOf", fields: [studentMembershipId], references: [id], onDelete: Cascade)

  @@unique([juryId, studentMembershipId])
  @@index([schoolId])
  @@index([studentMembershipId])
}

/// THE OFFICE'S SETTLEMENT ON LEAVING (R-61 Q2, the owner's decision of 10 Oct
/// 2026). When a pupil (or a college student) is recorded as leaving, the
/// departure itself CANCELS the later instalments nothing was paid against
/// (school-record.ts). What is left — a part-paid later instalment, an unpaid
/// earlier one, library books and lab issues still out — is listed to the
/// office in one step, and the office decides each money line once: cancel the
/// balance (the demand goes WAIVED, the paid amount kept) or keep it owed (the
/// demand stays as it is). One row per leaver, written once by lib
/// leaving-settlement.ts `settleOnLeaving` (one writer, audited
/// fees.leavingSettled); the family's fees page reads it. The lines are kept
/// as decided (labels and balances at the moment), items out read-only.
model LeavingSettlement {
  id                  String   @id @default(cuid())
  schoolId            String
  studentMembershipId String   @unique
  decidedByUserId     String
  decidedAt           DateTime @default(now())
  /// JSON: [{ demandId, label, dueDateKey, balancePaise, choice: "CANCEL" | "KEEP" }]
  linesJson           String   @default("[]")
  /// JSON: [{ desk, itemsOut }] — what was still out when the office settled, for the record; nothing here returns a book.
  itemsJson           String   @default("[]")
  /// JSON: the ids of the demands the departure itself cancelled, as the step listed them.
  cancelledJson       String   @default("[]")

  school  School     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student Membership @relation("LeavingSettlementOf", fields: [studentMembershipId], references: [id], onDelete: Cascade)

  @@index([schoolId])
}

// ---- competitions-crawler (competitions suggested from the organisers' own sites, 12 October 2026) ----
/// AN ORGANISER'S OWN SITE the competitions crawler reads (scripts/competitions-crawl/): its root page and
/// the pages it links to one level down on the same host. Edited on the operator's and the content team's
/// competitions desks (add, disable, enable, remove; audited). Removing is a stamp, never a delete, so the
/// fixture that seeds the official organisers does not bring a removed one back. A platform list like
/// Competition: no school owns it (NO_SCHOOL_POLICY in scripts/gen-rls.ts).
model CompetitionSource {
  id              String    @id @default(cuid())
  name            String
  /// The site's root page, http(s); unique, so the seed is idempotent.
  rootUrl         String    @unique
  /// The organiser as it names itself ("Homi Bhabha Centre for Science Education").
  organiser       String
  /// OLYMPIAD | TALENT_SEARCH | SCIENCE_FAIR | QUIZ | OTHER, and for college organisers (college-content, 12 Oct
  /// 2026) MOOT_COURT | HACKATHON | COLLEGE_EVENT (packages/contracts COMPETITION_SOURCE_KINDS); the kind gives a
  /// crawled entry its audience when the page does not say (sourceKindAudience).
  kind            String
  /// college-content (12 Oct 2026): the streams a college organiser's competitions are for (the Bar Council's: LAW),
  /// given to a crawled COLLEGE entry when the page names none; empty for a school organiser.
  streams         String[]  @default([])
  enabled         Boolean   @default(true)
  /// The organiser's own site (not a coaching site or an aggregator): Publish marks its competitions verified.
  official        Boolean   @default(true)
  addedByUserId   String?
  /// APP_ADMIN | OPERATOR | FIXTURE
  addedByRole     String
  removedAt       DateTime?
  removedByUserId String?
  lastCrawledAt   DateTime?
  /// The last crawl's numbers for this source (competitionCrawlSourceResultSchema), or its refusal.
  lastResult      Json?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  pages  CompetitionCrawlPage[]
  crawls CompetitionCrawl[]

  @@index([enabled, removedAt])
}

/// THE CRAWLER'S CACHE, one row per page URL: the validators the server gave (ETag, Last-Modified), the
/// SHA-256 of the bytes, and the same-host links the page carried (so an unchanged root still leads to its
/// children). A page is read again only when the server says it changed or its hash differs.
model CompetitionCrawlPage {
  id           String    @id @default(cuid())
  sourceId     String
  url          String    @unique
  etag         String?
  lastModified String?
  sha256       String?
  /// The last HTTP status, or 0 when nothing answered.
  status       Int       @default(0)
  contentType  String?
  links        String[]  @default([])
  /// Why the page was not read (robots, a login, rendered by script, an error), in words.
  refused      String?
  fetchedAt    DateTime?
  checkedAt    DateTime  @default(now())

  source CompetitionSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@index([sourceId])
}

/// WHERE A SUGGESTED COMPETITION CAME FROM, one per Competition: the source, the page, its hash, when it
/// was crawled and last checked, the model's confidence and the extracted JSON as the model gave it. On a
/// re-crawl a DRAFT's fields are updated; a PUBLISHED one is never edited: `changedSinceReview` is set with
/// the field-by-field `diff` kept for the reviewer. A dismissed one stays dismissed (and never public)
/// unless its page changes. `matchedExisting` marks a hand-posted competition the crawler found again: it
/// gets the diff and the flag, never an edit. Written only by scripts/competitions-crawl/land.ts and
/// src/lib/competition-crawl-desk.ts. No school (NO_SCHOOL_POLICY).
model CompetitionCrawl {
  id                 String    @id @default(cuid())
  competitionId      String    @unique
  sourceId           String
  pageUrl            String
  pageHash           String
  crawledAt          DateTime
  lastCheckedAt      DateTime
  /// 0 to 1, the model's own.
  confidence         Float
  /// The entry as extracted (competitionExtractEntrySchema), JSON.
  extracted          Json
  /// The competition's year, from its dates: the dedupe key with the organiser and the title.
  year               Int?
  matchedExisting    Boolean   @default(false)
  changedSinceReview Boolean   @default(false)
  /// The fields that differ, { field: { before, after } }, kept until the reviewer marks it reviewed.
  diff               Json?
  changedAt          DateTime?
  reviewedAt         DateTime?
  reviewedByUserId   String?
  dismissedAt        DateTime?
  /// packages/contracts COMPETITION_DISMISS_REASONS
  dismissedReason    String?
  dismissedByUserId  String?
  /// The page's hash when it was dismissed: the entry comes back only when its page changes.
  dismissedPageHash  String?

  competition Competition       @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  source      CompetitionSource @relation(fields: [sourceId], references: [id])

  @@index([sourceId])
  @@index([changedSinceReview])
}

/// ONE CRAWL started from the competitions desk (/appadmin, /root/competitions) by the content team or the
/// operator: the same shape and the same rules as QuizGenJob (one active at a time by the unique `active`,
/// a detached runner's pid and heartbeat, the model servers it brought up and so takes down). A crawl may
/// run beside a quiz generation run: different jobs, one model. Written only by
/// src/lib/competition-crawl-jobs.ts. No school (NO_SCHOOL_POLICY).
model CompetitionCrawlJob {
  id              String    @id @default(cuid())
  /// QUEUED | RUNNING | STOPPING | STOPPED | FINISHED | FAILED
  state           String    @default("QUEUED")
  active          Boolean?  @unique
  /// competitionCrawlRequestSchema, JSON.
  request         Json
  /// The live line (competitionCrawlProgressSchema), JSON.
  progress        Json?
  pid             Int?
  startedServers  String[]  @default([])
  startedByUserId String
  startedByRole   String
  stopRequestedBy String?
  error           String?
  createdAt       DateTime  @default(now())
  startedAt       DateTime?
  finishedAt      DateTime?
  heartbeatAt     DateTime?

  @@index([createdAt])
}
// ---- end competitions-crawler ----

// ---- feature-switches (15 Oct 2026) ----
/// THE PLATFORM'S FEATURE SWITCHES (the owner's ask of 15 October 2026): one row per feature code
/// (packages/contracts v1/platform-features.ts — ASSISTANT, QUESTION_BANK, QUESTION_GIG, EXPERT_SESSIONS,
/// TEACHER_SESSIONS, JOB_BOARD, TEXT_MESSAGING), OFF until the operator switches it on at /root/features.
/// OUTSIDE THE SCHOOL FENCE ON PURPOSE (NO_SCHOOL_POLICY): a switch is the platform's, the same for every
/// school, read by every request of every tenant and written by the operator alone, who belongs to no
/// school. A row is created on first read when missing (enabled false). Read and written only by
/// src/lib/platform-features.ts; the switch is audited ("operator.feature.on" / "operator.feature.off").
model PlatformFeature {
  /// The feature's code: a checked string (the migration's CHECK holds it to the contracts' list, and the
  /// library reads only codes of that list), not a Prisma enum.
  code            String   @id
  enabled         Boolean   @default(false)
  /// When the operator last switched it, and who; both null while nobody has.
  changedAt       DateTime?
  changedByUserId String?
}
// ---- end feature-switches ----

// ---- expert-registration (15 Oct 2026) ----
/// AN EXPERT'S APPLICATION FROM THE LOGIN PAGE (the owner's ask of 15 October 2026). Somebody who wants to mentor
/// pupils fills /register/expert (or POST /api/v1/public/expert-applications); no account is made, and only the
/// operator turns an application into one (src/lib/expert-applications.ts, the one writer): Approve makes the User
/// and an unpublished ExpertProfile from these fields and sends an ExpertInvite's link, whose existing form sets
/// the password; Refuse records a coded reason and the applicant is told by email in `locale`.
/// OUTSIDE THE SCHOOL FENCE ON PURPOSE (NO_SCHOOL_POLICY in scripts/gen-rls.ts): an applicant belongs to no
/// school and has no session, the reader is the operator alone, who belongs to no school either, and no school's
/// row is in it. The person is the fence, held in the library: written only by the public form's call, read and
/// decided only under `isSuperuser`. One open application per address: the partial unique index
/// "ExpertApplication_one_pending" (migration expert_applications) holds `email` unique while PENDING.
model ExpertApplication {
  id               String    @id @default(cuid())
  name             String
  /// Lower-cased on the way in.
  email            String
  /// E.164, an Indian mobile (+91 and ten digits from 6 to 9), never proved by a code: it is for the operator to
  /// call, never a sign-in identifier, and is not copied to the account on approval.
  phone            String
  city             String
  organisation     String?
  /// What they do, 120 characters at most.
  headline         String
  /// JSON string[] of EXPERT_SPECIALISMS codes (packages/contracts v1/expert-applications.ts), one to five.
  specialisms      String    @default("[]")
  /// JSON string[] of the languages they can teach in: en, hi, mr.
  languages        String    @default("[]")
  yearsExperience  Int
  /// 1,000 characters at most.
  bio              String
  /// JSON string[] of up to three https URLs.
  links            String    @default("[]")
  /// SESSIONS | MENTORING | BOTH, the ExpertProfile's own list (EXPERT_OFFERINGS), copied onto the profile.
  offering         String
  /// A stored file id (storage.ts; never a URL): the qualification or identity document, opened by the operator
  /// alone through GET /api/v1/operator/expert-applications/{id}/document; claimed by the orphan sweep.
  documentFileId   String?
  /// When the applicant ticked the declaration (over 18, pupils only through the platform, consent to checks).
  declarationAt    DateTime
  /// PENDING | APPROVED | REFUSED | WITHDRAWN.
  status           String    @default("PENDING")
  /// NOT_QUALIFIED | DOCUMENT_UNCLEAR | DUPLICATE | OTHER, with a note for OTHER.
  refusalCode      String?
  refusalNote      String?
  decidedAt        DateTime?
  decidedByUserId  String?
  /// The account made on approval; null when the address already had one (the invitation attaches the profile).
  createdUserId    String?
  /// The ExpertInvite sent on approval: the invite's acceptance reads the application by it.
  inviteId         String?
  /// The applicant's language for every email about the application.
  locale           String    @default("en")
  createdAt        DateTime  @default(now())

  @@index([status, createdAt])
  @@index([email])
  @@index([inviteId])
}
// ---- end expert-registration ----

// website-builder B
/// A SCHOOL'S OWN DOMAIN FOR ITS PUBLIC WEBSITE (the WEBSITE module, 15 October 2026; src/lib/site-domains.ts is
/// the one writer). The office or the head types a domain at /admin/website/domain, adds the two DNS records the
/// page shows at their registrar, and presses Verify: the DNS is checked (PENDING_DNS -> VERIFYING), a certificate
/// is asked of the hosting platform (certStatus NONE -> REQUESTED -> ISSUED), and once it is issued the domain is
/// LIVE and the middleware serves the published site on it (src/lib/site-hosts.ts schoolIdForHost). The job
/// site:domains re-checks VERIFYING domains every ten minutes. `domain` is lowercase ASCII (punycode for an
/// internationalised name), unique across the platform: one domain is one school's. `dnsError` and `certError`
/// hold a code (with the value found after a colon where there is one), never a sentence; the page words them.
/// School-fenced like every school table; a LIVE row is also readable by anyone (GLOBALLY_READABLE in
/// scripts/gen-rls.ts), because the public site route must find the school for a host with no session, and a
/// domain the school has pointed at its own site is public by nature.
model SchoolSiteDomain {
  id              String    @id @default(cuid())
  schoolId        String
  domain          String    @unique
  /// PENDING_DNS | VERIFYING | LIVE | FAILED
  status          String    @default("PENDING_DNS")
  dnsCheckedAt    DateTime?
  dnsError        String?
  /// NONE | REQUESTED | ISSUED | FAILED
  certStatus      String    @default("NONE")
  certCheckedAt   DateTime?
  certError       String?
  createdByUserId String
  createdAt       DateTime  @default(now())
  verifiedAt      DateTime?

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId])
  @@index([status])
}
// end website-builder B

// website-builder A
/// A SCHOOL'S PUBLIC WEBSITE, THE DRAFT (the WEBSITE module, 15 October 2026; src/lib/site-admin.ts is the one
/// writer). The admin or the head builds it in the six-screen flow at /admin/website with no free layout: a
/// template, a colour, a face, a language, the school's own words, which sections are on and in what order, the
/// posts and pictures chosen. `configJson` is that draft (siteConfigSchema in packages/contracts v1/website.ts),
/// autosaved on each Continue; a gallery picture carries the admin's consent tick with who ticked it and when
/// (minors' policy 0002). Nothing here is public: what the world reads is a SchoolSiteVersion.
model SchoolSite {
  id                 String   @id @default(cuid())
  schoolId           String   @unique
  configJson         String   @default("{}")
  /// The version the public route serves; null while the site is not published (never, or unpublished).
  publishedVersionId String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  updatedByUserId    String?
  // website-three (17 Oct 2026)
  /// Counts the draft's saves: a save names the number it was read at and is refused when another save came between
  /// (site-admin.ts saveSite), so two editors never silently overwrite each other.
  draftVersion       Int      @default(0)
  // end website-three

  school   School              @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  versions SchoolSiteVersion[]
}

/// ONE RENDERED VERSION OF A SCHOOL'S WEBSITE (15 October 2026; src/lib/site-publish.ts is the one writer):
/// static HTML per language cut at Publish, and again by the nightly site:refresh job when the live numbers have
/// changed. `html` is JSON { en, hi, mr }; `snapshotJson` the config and the data it was cut from, the gallery's
/// consent ticks with who and when among them; `imageFileIds` the stored files the pages show, which the file
/// route then serves to anyone (files.ts) while the version is live. `liveAt` is set on the one version the site
/// serves and cleared when another replaces it or the site is unpublished (a partial unique index allows one per
/// school). A LIVE row is readable by anyone (GLOBALLY_READABLE in scripts/gen-rls.ts), as a published
/// disclosure is: the public route finds it by `schoolSlug` with no session. What crosses is the school's own
/// public words and aggregate numbers, never a pupil.
model SchoolSiteVersion {
  id                String    @id @default(cuid())
  schoolId          String
  siteId            String
  /// School.slug at the render: the office's own view at /sites/<slug>, and <slug>.localhost in development (16 Oct 2026: no platform subdomain).
  schoolSlug        String
  snapshotJson      String    @default("{}")
  html              String    @default("{}")
  imageFileIds      String[]  @default([])
  /// A hash of the numbers shown, so the nightly job stores a new version only when one changed.
  numbersHash       String    @default("")
  renderedAt        DateTime  @default(now())
  numbersAt         DateTime  @default(now())
  /// Null for a version the nightly job cut.
  publishedByUserId String?
  liveAt            DateTime?
  // website-two (16 Oct 2026)
  /// The pages besides the home page, JSON { <path>: { en, hi, mr } } (`html` stays the home page's), rendered with
  /// the version: about, academics, admissions, facilities, faculty, gallery, news, events, achievements, downloads,
  /// contact and the custom pages' own paths. A page with nothing to show is not rendered and answers 404.
  pagesHtml         String    @default("{}")
  // end website-two

  school School     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  site   SchoolSite @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([schoolId, renderedAt])
  @@index([schoolSlug])
}

/// AN ENQUIRY FROM A SCHOOL'S PUBLIC WEBSITE (15 October 2026; src/lib/site-enquiry.ts). The shared enquiries
/// (Enquiry) need a signed-in parent, and a visitor to a static site has no account, so the site's admission
/// form writes here, rate-limited per address: a name, a phone or an email, the class asked about and a
/// message. The admissions contact (or the admins) is told in the app; the office reads them on /admin/website.
model SchoolSiteEnquiry {
  id           String    @id @default(cuid())
  schoolId     String
  name         String
  contact      String
  grade        String    @default("")
  message      String
  locale       String    @default("en")
  createdAt    DateTime  @default(now())
  readAt       DateTime?
  readByUserId String?
  // website-two (16 Oct 2026): the inbox in the editor. NEW until the office replies by email (REPLIED, with what it
  // wrote) or closes it (CLOSED); `lastActivityAt` moves with every act. The weekly site:enquiries job deletes an
  // enquiry closed, or untouched, for 180 days (src/lib/site-inbox.ts), which the form says.
  /// An email the form asked for apart from the contact (the form's optional field), or "".
  email           String    @default("")
  /// The enquirer asked to visit the school (the form's optional tick).
  wantsVisit      Boolean   @default(false)
  /// NEW | REPLIED | CLOSED
  status          String    @default("NEW")
  replyText       String    @default("")
  repliedAt       DateTime?
  repliedByUserId String?
  closedAt        DateTime?
  lastActivityAt  DateTime  @default(now())
  // end website-two
  // website-three (17 Oct 2026)
  /// Every reply sent on the thread, oldest first: JSON [{ text, at, byUserId, messageId }]. `replyText`/`repliedAt` stay
  /// the latest one's. A reply's mail carries the earlier ones' Message-IDs, so the enquirer's mail keeps one thread.
  repliesJson     String    @default("[]")
  // end website-three

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId, createdAt])
  @@index([schoolId, status])
  @@index([lastActivityAt])
}
// end website-builder A

// website-two (16 Oct 2026)
/// A LINK TO REVIEW A SCHOOL WEBSITE'S DRAFT, SIGNED OUT (src/lib/site-share.ts is the one writer). The office or the
/// head makes one from the editor's header for a principal or a colleague to read the draft before it is published:
/// /sites/review/<token>, read-only, never indexed, valid seven days, revocable; making a new one revokes the old.
/// Only the token's SHA-256 is kept, so the link is shown once, when it is made. A row neither revoked nor expired is
/// readable with no session (GLOBALLY_READABLE in scripts/gen-rls.ts), because the review route has none and must find
/// the school by the token; what crosses is the hash and its school, never the draft (read under the school's binding).
model SchoolSiteShare {
  id              String    @id @default(cuid())
  schoolId        String
  tokenHash       String    @unique
  createdByUserId String
  createdAt       DateTime  @default(now())
  expiresAt       DateTime
  revokedAt       DateTime?

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId, createdAt])
}

/// A SCHOOL WEBSITE'S PAGE VIEWS, COUNTED ON THE SERVER (src/lib/site-visits.ts): one row per page per day in the
/// school's zone, a number and nothing else — no cookie is set, no address or browser is stored, so nothing here can
/// tell one visitor from another. Written by the public route on the school's own domain under the school's binding;
/// read as a thirty-day line and totals on the editor's Publish section; rows older than 400 days go with the weekly
/// site:enquiries job. A row per (school, day, page) so a count is an increment, never a read-modify-write of JSON.
model SchoolSiteVisit {
  id       String @id @default(cuid())
  schoolId String
  /// YYYY-MM-DD in the school's zone.
  dateKey  String
  /// The page's path key: "home", "about", … or a custom page's own.
  page     String
  count    Int    @default(0)

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([schoolId, dateKey, page])
}

/// A FILE UPLOADED FOR A SCHOOL'S WEBSITE (src/lib/site-files.ts): a picture (the hero, a facility, an album, an
/// achievement) or a PDF (the prospectus, the downloads). The row names the file so the file route can let the office
/// and the head read it while it is only in the draft (files.ts) and the orphan sweep keeps it (orphans.ts); the
/// published version's `imageFileIds` makes it public while a live page shows it. A picture of people still needs the
/// consent tick where the draft uses it (minors' policy 0002); the row only says who uploaded it.
model SchoolSiteFile {
  id               String   @id @default(cuid())
  schoolId         String
  fileId           String   @unique
  /// IMAGE | PDF
  kind             String
  mime             String
  size             Int
  name             String   @default("")
  uploadedByUserId String?
  createdAt        DateTime @default(now())

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId, createdAt])
}
// end website-two

// meta-posting (16 Oct 2026)
/// A SCHOOL'S FACEBOOK PAGE, CONNECTED FOR POSTING (src/lib/social.ts is the one writer; the owner's ask of 15
/// October 2026). The school's admin connects once at /admin/settings/social through Facebook Login and picks one
/// Page; the Instagram professional account linked to that Page, if any, comes with it. `pageTokenSealed` is the
/// Page's access token sealed under FEES_SECRET_KEY (src/lib/secret-box.ts) and bound to the school's id, so a copy
/// of the database alone posts nothing. One connection per school; Disconnect deletes the row. `error` is a code
/// ("RECONNECT"), never a sentence: the page and the composer word it. School-fenced like every school table.
model SocialConnection {
  id                String    @id @default(cuid())
  schoolId          String    @unique
  /// META (the only provider)
  provider          String    @default("META")
  pageId            String
  pageName          String
  igUserId          String?
  igUsername        String?
  pageTokenSealed   String
  tokenExpiresAt    DateTime?
  connectedByUserId String
  connectedAt       DateTime  @default(now())
  lastCheckedAt     DateTime?
  error             String?

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
}

/// ONE COPY OF A SCHOOL POST SENT TO ONE NETWORK (FACEBOOK | INSTAGRAM). Queued when the admin publishes a
/// school-wide post with "Also post to …" ticked, sent by the social:send job (every minute), three attempts an hour
/// apart and then FAILED; Retry queues it again. `postId` is deliberately NOT a foreign key: the copy on Meta outlives
/// the post here (deleting or taking down a post does not delete it on Meta), so the record of what left the platform
/// is kept with it. `fileId` is the picture sent (the post's first picture), and `pictureToken` the random token in
/// the short-lived public link Instagram fetches it by (src/lib/files.ts, kind "social": open while QUEUED and for 24
/// hours after SENT). `error` is a code with Meta's own words after a colon where there are any; the page words it.
model SocialPost {
  id             String    @id @default(cuid())
  schoolId       String
  postId         String
  /// FACEBOOK | INSTAGRAM
  network        String
  /// QUEUED | SENT | FAILED
  status         String    @default("QUEUED")
  fileId         String?
  pictureToken   String?
  remoteId       String?
  remoteUrl      String?
  error          String?
  attempts       Int       @default(0)
  nextAttemptAt  DateTime  @default(now())
  queuedByUserId String
  createdAt      DateTime  @default(now())
  sentAt         DateTime?

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([postId, network])
  @@index([schoolId, postId])
  @@index([status, nextAttemptAt])
  @@index([fileId])
}

// end meta-posting

// plans (16 Oct 2026)
/// A PLAN SOLD PER PERSON (the owner's decisions of 15–16 October 2026; decision 0006): STUDENT, TEACHER or
/// EXPERT, one row each, created on first read with prices 0 and the contracts' feature lists, inactive. Not
/// the `Plan` a school is put on (caps and a recorded price, src/lib/plans.ts): this one is bought by a person.
/// OUTSIDE THE SCHOOL FENCE ON PURPOSE (NO_SCHOOL_POLICY): the platform's price list, the same for every school,
/// read by every tenant's requests (the gate asks whether a plan is active) and written by the operator alone,
/// who belongs to no school. Read and written only by src/lib/person-plans.ts; every change is audited
/// ("operator.plan.update").
model PersonPlan {
  id               String   @id @default(cuid())
  /// STUDENT | TEACHER | EXPERT: a checked string (the migration's CHECK holds it to the contracts' list).
  code             String   @unique
  /// The monthly price and the yearly price, in paise; 0 until the operator sets them.
  pricePaise       Int      @default(0)
  yearlyPricePaise Int      @default(0)
  /// The FeatureCode list the plan opens (a JSON array), from the contracts' PLAN_FEATURES; a grant makes one
  /// Entitlement row per entry.
  features         Json     @default("[]")
  /// Active: the plan is asked for. An inactive plan asks nothing, and its features follow the platform switch alone.
  active           Boolean  @default(false)
  updatedAt        DateTime @default(now()) @updatedAt
  /// Null until the operator changes the row.
  updatedByUserId  String?
}

/// ONE FEATURE OPEN TO ONE PERSON FOR A WINDOW (16 October 2026; decision 0006): a person is entitled to a
/// feature while an unrevoked row covers now (validFrom ≤ now < validTo). Written by the operator's grant (GRANT)
/// in this half, and by a paid pass (ORDER) or a paid seat (SEAT) in the second half, which fills orderId.
/// OUTSIDE THE SCHOOL FENCE ON PURPOSE (NO_SCHOOL_POLICY): a plan is the PERSON's, bought for themselves or by a
/// guardian for a pupil, and follows them across every school they belong to (a teacher at two schools, a pupil
/// who moves); no school's row is in it. The person is the fence, held in src/lib/person-plans.ts: a person reads
/// their own, the operator reads and writes every one. No foreign key to User, so the zz teardown and an account
/// merge name it themselves.
model Entitlement {
  id              String    @id @default(cuid())
  userId          String
  /// A FeatureCode (checked in the migration).
  feature         String
  /// ORDER | GRANT | SEAT (checked in the migration).
  source          String
  /// The plan it came from; null for a SEAT.
  planCode        String?
  validFrom       DateTime
  validTo         DateTime
  /// The second half's payment order behind an ORDER or a SEAT.
  orderId         String?
  grantedByUserId String?
  note            String?
  revokedAt       DateTime?
  revokedByUserId String?
  /// Set by the plans:expire job once it has told the person the window ended, so a second run tells nobody twice.
  endNotedAt      DateTime?
  createdAt       DateTime  @default(now())

  @@index([userId, feature, validTo])
  @@index([validTo])
}

// end plans

// plans-pay (17 Oct 2026)
/// ONE PASS BOUGHT THROUGH THE COMPANY'S GATEWAY (17 October 2026; decision 0006, src/lib/pass-orders.ts): a month
/// or a year of one plan sold per person, for `userId` (the person entitled), paid by `payerUserId` (the guardian
/// for a pupil under eighteen, else the same person). The money is the company's own revenue and the company
/// collects it directly: no Route, no transfer, no split (decision 0006's collection rule; decision 0003 untouched,
/// a school's fees never come here). The plan's price is frozen on the row when the order is made, with the GST on
/// it at the company's rate (GigSettings.gstPercent); the gateway charges `totalPaise`. CREATED → PAID (a signed
/// capture: the checkout's own confirm or the platform webhook, whichever is first; the ORDER entitlements written
/// by person-plans.ts grantPassFromOrder and the tax invoice issued) | FAILED (the gateway said so; a later signed
/// capture on the same order still settles) ; PAID → REFUNDED by the operator alone, in full, within seven days of
/// payment, revoking the entitlements it granted. No card detail ever touches the platform (policy 0002): the
/// gateway's own page takes them.
/// OUTSIDE THE SCHOOL FENCE ON PURPOSE (NO_SCHOOL_POLICY): a pass is the PERSON's and follows them across schools,
/// like the Entitlement rows it opens; a guardian belongs to no school. The person is the fence, held in the
/// library: the payer and the holder read their own, the operator every one. No foreign key to User (the
/// Entitlement precedent), so the zz teardown names the rows itself.
model PassOrder {
  id               String    @id @default(cuid())
  /// The person the pass is for.
  userId           String
  /// Who paid: the guardian for a pupil under eighteen, else userId.
  payerUserId      String
  /// STUDENT | TEACHER | EXPERT (checked in the migration).
  planCode         String
  /// MONTH | YEAR (checked in the migration).
  period           String
  /// The plan's price when the order was made: the taxable value.
  amountPaise      Int
  /// The GST on it at gstPercent, and what the gateway charges (amountPaise + gstPaise).
  gstPaise         Int
  totalPaise       Int
  gstPercent       Int
  /// The gateway's order (a placeholder "pending_<id>" for the instant before it answers).
  gatewayOrderId   String    @unique
  /// The captured payment: one payment settles one order, once.
  gatewayPaymentId String?   @unique
  /// CREATED | PAID | FAILED | REFUNDED (checked in the migration).
  status           String    @default("CREATED")
  paidAt           DateTime?
  failedReason     String?
  refundedAt       DateTime?
  refundedByUserId String?
  gatewayRefundId  String?
  /// The tax invoice issued for it (PassInvoice), once paid.
  invoiceId        String?   @unique
  createdAt        DateTime  @default(now())

  @@index([userId, createdAt])
  @@index([payerUserId, createdAt])
  @@index([status, paidAt])
}

/// THE COMPANY'S GST TAX INVOICE FOR ONE PAID PASS (17 October 2026): the GigInvoice shape, the company as the
/// seller (the same seller block, GigSettings frozen into sellerJson) and the payer as the buyer, numbered in its own
/// financial-year series "<prefix>-PASS/2026-27/0001" under the GigSettings row lock inside the transaction that
/// writes it, as every company series is — never reused, never a gap on a failed write. Every figure is frozen.
/// The place of supply is the company's state while the buyer's address is not on record (CGST+SGST); the
/// accountant confirms it (docs/decisions/0006). Rendered as a PDF on read in the payer's language. The payer reads
/// their own; the operator every one. No school.
model PassInvoice {
  id                String   @id @default(cuid())
  number            String   @unique
  series            String
  serial            Int
  passOrderId       String   @unique
  payerUserId       String
  issuedAt          DateTime @default(now())
  /// en | hi | mr — the payer's language when it was issued.
  locale            String   @default("en")
  taxableValuePaise Int
  cgstPaise         Int
  sgstPaise         Int
  igstPaise         Int
  totalPaise        Int
  sacCode           String
  /// { name, gstin, address, stateCode } of the company, as it stood.
  sellerJson        String
  /// { name, gstin, address, stateCode } of the payer, as it stood (no GSTIN: a person).
  buyerJson         String
  /// One line: { passOrderId, plan, period, holderName, validFrom, validTo, amountPaise, gstPaise }.
  linesJson         String

  @@unique([series, serial])
  @@index([payerUserId, issuedAt])
}
// end plans-pay

// owner-batch-item2b (27 Oct 2026): how each salary slip was paid, recorded by the school.
/// THE SCHOOL'S RECORD OF ONE SALARY PAYMENT (src/lib/salary-payments.ts). The platform pays nobody (decisions 0003
/// and 0004): the school pays from its own bank, its own UPI app, a cheque or cash, and records it here afterwards.
/// One LIVE payment per slip: `liveSlipId` is the slip's id while the row stands and NULL once voided, unique, so two
/// presses of "Record" can never leave two (Postgres keeps NULLs distinct). A partial payment is refused; a mistake
/// is voided with a reason and recorded again. `liveUtr` is the UTR of a live BANK or UPI payment, unique per school:
/// one transfer pays one slip. The run is PAID while every slip with money due has a live payment (data:audit
/// "payroll-paid"), moved by a conditional update under the run's row lock.
model SalaryPayment {
  id                     String    @id @default(cuid())
  schoolId               String
  runId                  String
  payslipId              String
  liveSlipId             String?   @unique
  /// BANK | CASH | CHEQUE | UPI
  mode                   String
  amountPaise            Int
  /// YYYY-MM-DD, the school's day the money left.
  paidOnKey              String
  /// The UTR (BANK, UPI), the cheque's number (CHEQUE); null for cash.
  reference              String?
  liveUtr                String?
  note                   String    @default("")
  recordedByMembershipId String
  createdAt              DateTime  @default(now())
  voidedAt               DateTime?
  voidedByMembershipId   String?
  voidReason             String?

  run  PayrollRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  slip Payslip    @relation(fields: [payslipId], references: [id], onDelete: Cascade)

  @@unique([schoolId, liveUtr])
  @@index([schoolId])
  @@index([runId])
  @@index([payslipId])
}
// end owner-batch-item2b

// ---- bank-duplicates-incremental (27 Oct 2026) ----
/// The bank duplicates report, kept between calls and across restarts so the finder
/// never walks the whole bank twice: one row per rule ("t" trigram, "e" exact). The
/// bank belongs to no school and so does its report. Written by findDuplicates alone
/// (src/lib/bank-tools.ts); the next call probes only the questions added or edited
/// since `seenUpdatedAt` and drops pairs whose question is gone.
model BankDuplicateReport {
  /// "t" (trigram similarity) or "e" (exact normalised stem).
  mode             String    @id
  /// The bank as this report saw it: the count of questions and the newest updatedAt.
  bankCount        Int
  bankMaxUpdatedAt DateTime?
  /// The newest updatedAt among the questions the report has looked at.
  seenUpdatedAt    DateTime?
  computedAt       DateTime
  /// Every pair at or above the rule's threshold, JSON [{ aId, bId, similarity }], aId < bId; the answer takes the top 200.
  pairs            String
  updatedAt        DateTime  @updatedAt
}
// ---- end bank-duplicates-incremental ----
