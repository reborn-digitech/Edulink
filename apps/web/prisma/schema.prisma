// EduLink data model.
//
// PORTABILITY CONTRACT — this schema is written to run unchanged on SQLite (dev)
// and PostgreSQL (prod). That costs us two things, both deliberate:
//   * no native `enum`  -> status/role columns are String, with the allowed
//     values defined once in src/lib/constants.ts and validated by zod at every
//     write. Postgres CHECK constraints are added by the prod migration.
//   * no `Json` columns -> JSON payloads are String, read/written through the
//     typed helpers in src/lib/json.ts.
//
// TENANCY — every school-owned row carries `schoolId` directly, even where it
// could be derived through a relation. Denormalised on purpose: it lets the
// scoped data layer (src/lib/tenancy.ts) put `schoolId` in the WHERE clause of
// every single query, and lets every Postgres RLS policy be the same one-line
// `USING (school_id = current_setting('app.school_id'))` predicate in prod.
//
// This said "every" for a while before it was true — ClassTeacher, Enrollment,
// Comment, Reaction and RemarkMessage reached their school through a join, which
// would have meant five bespoke `EXISTS` policies, the kind most easily written
// wrong and the kind that costs per row. They carry the column now.
// `tests/tenancy-shape.test.ts` checks this against the schema instead of
// asserting it here, and fails when a model is added without saying how it is
// scoped. Where the column is denormalised it is ALWAYS taken from the parent
// row, never from the session: it is only worth having if it provably agrees.

generator client {
  provider      = "prisma-client-js"
  // The container runs on Debian bookworm (OpenSSL 3). Pinned rather than detected: the
  // build stage once guessed 1.1.x and the served image could not find its query engine.
  binaryTargets = ["native", "debian-openssl-3.0.x"]
  // The assistant's vectors need pgvector before a table can be created; declaring the extension
  // lets `prisma db push` (db:reset, rls:verify's scratch database) create it too (8 Oct 2026).
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  // pgvector for ContentChunk and HelpEntry (the assistant). pg_trgm stays optional and out of
  // this list on purpose: its migration tolerates a Postgres without it (bank duplicates).
  extensions = [vector]
}

