{
  "name": "@edulink/mobile",
  "main": "expo-router/entry",
  "version": "0.1.0",
  "dependencies": {
    "@expo/ui": "~57.0.16",
    "expo": "~57.0.20",
    "expo-constants": "~57.0.17",
    "expo-device": "~57.0.1",
    "expo-font": "~57.0.3",
    "expo-glass-effect": "~57.0.1",
    "expo-image": "~57.0.4",
    "expo-linking": "~57.0.9",
    "expo-router": "~57.0.19",
    "expo-splash-screen": "~57.0.8",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.2",
    "expo-system-ui": "~57.0.3",
    "expo-web-browser": "~57.0.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1",
    "@edulink/api-client": "workspace:*",
    "@edulink/contracts": "workspace:*",
    "@edulink/i18n": "workspace:*",
    "@edulink/tokens": "workspace:*",
    "@tanstack/react-query": "^5.90.2",
    "expo-secure-store": "~57.0.3",
    "expo-sqlite": "~57.0.2",
    "expo-notifications": "~57.0.17",
    "expo-image-picker": "~57.0.16",
    "expo-local-authentication": "~57.0.2",
    "expo-localization": "~57.0.1",
    "expo-haptics": "~57.0.2",
    "phosphor-react-native": "^3.0.6",
    "react-native-svg": "15.15.5",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3",
    "@testing-library/react-native": "^14.0.1",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.5",
    "@types/jest": "^29.5.14",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.2",
    "eslint-plugin-react-native-a11y": "^3.5.1",
    "react-test-renderer": "19.2.3"
  },
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "jest --ci",
    "test:contract": "jest --ci --testPathIgnorePatterns=/node_modules/ --testPathPattern=contract",
    "battery": "tsc --noEmit && eslint . && jest --ci"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "transformIgnorePatterns": [
      "node_modules/(?!\\.pnpm/)(?!((jest-)?react-native|@react-native(-community)?|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@sentry/react-native|native-base|react-native-svg|phosphor-react-native|@edulink/.*))",
      "node_modules/\\.pnpm/[^/]+/node_modules/(?!((jest-)?react-native|@react-native(-community)?|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@sentry/react-native|native-base|react-native-svg|phosphor-react-native|@edulink/.*))"
    ],
    "setupFilesAfterEnv": [
      "./test/setup.ts"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/.expo/",
      "/contract/"
    ]
  }
}
