{
  "name": "@edulink/mobile",
  "main": "expo-router/entry",
  "version": "0.1.0",
  "dependencies": {
    "@edulink/api-client": "workspace:*",
    "@edulink/contracts": "workspace:*",
    "@edulink/i18n": "workspace:*",
    "@edulink/tokens": "workspace:*",
    "@expo/ui": "~57.0.16",
    "@tanstack/react-query": "^5.90.2",
    "expo": "~57.0.20",
    "expo-application": "~57.0.2",
    "expo-constants": "~57.0.17",
    "expo-device": "~57.0.1",
    "expo-document-picker": "~57.0.1",
    "expo-font": "~57.0.3",
    "expo-glass-effect": "~57.0.1",
    "expo-haptics": "~57.0.2",
    "expo-image": "~57.0.4",
    "expo-image-picker": "~57.0.18",
    "expo-linking": "~57.0.9",
    "expo-localization": "~57.0.1",
    "expo-network": "~57.0.1",
    "expo-notifications": "~57.0.17",
    "expo-router": "~57.0.19",
    "expo-screen-capture": "~57.0.2",
    "expo-secure-store": "~57.0.3",
    "expo-splash-screen": "~57.0.8",
    "expo-sqlite": "~57.0.2",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.2",
    "expo-system-ui": "~57.0.3",
    "expo-updates": "~57.0.21",
    "expo-web-browser": "~57.0.2",
    "phosphor-react-native": "^3.0.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.5",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.1",
    "@playwright/test": "1.58.2",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.19.9",
    "@types/react": "~19.2.2",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.2",
    "eslint-plugin-react-native": "^5.0.0",
    "eslint-plugin-react-native-a11y": "^3.5.1",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.5",
    "react-test-renderer": "19.2.3",
    "typescript": "~6.0.3",
    "yaml": "^2"
  },
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "jest --ci",
    "test:contract": "jest --ci --config test/contract/jest.config.cjs",
    "battery": "tsc --noEmit && eslint . && jest --ci --coverage && node scripts/maestro-check.mjs",
    "test:coverage": "jest --ci --coverage",
    "bundle:check": "node scripts/bundle-size.mjs --json",
    "e2e": "playwright test",
    "maestro:check": "node scripts/maestro-check.mjs",
    "ota:guard": "node scripts/ota-guard.mjs"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "transformIgnorePatterns": [
      "node_modules/(?!\\.pnpm/)(?!((jest-)?react-native|@react-native(-community)?|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@sentry/react-native|native-base|react-native-svg|phosphor-react-native|@edulink/.*))",
      "node_modules/\\.pnpm/[^/]+/node_modules/(?!((jest-)?react-native|@react-native(-community)?|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@sentry/react-native|native-base|react-native-svg|phosphor-react-native|@edulink/.*))"
    ],
    "setupFilesAfterEnv": [
      "./test/setup.ts"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/.expo/",
      "/contract/",
      "/e2e/"
    ],
    "testTimeout": 15000,
    "collectCoverageFrom": [
      "src/lib/**/*.{ts,tsx}",
      "!src/lib/*-platform*.ts"
    ],
    "coverageThreshold": {
      "global": {
        "lines": 90
      }
    },
    "coverageReporters": [
      "text-summary",
      "json-summary"
    ],
    "moduleNameMapper": {
      "^phosphor\\-react\\-native/src/icons/(.*)$": "<rootDir>/node_modules/phosphor-react-native/src/icons/$1"
    }
  }
}
