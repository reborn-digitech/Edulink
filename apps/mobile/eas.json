{
  "cli": { "version": ">= 16.0.0", "appVersionSource": "remote" },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "env": { "EXPO_PUBLIC_API_URL": "http://localhost:3000" }
    },
    "staging": {
      "distribution": "internal",
      "channel": "staging",
      "ios": { "simulator": false },
      "android": { "buildType": "apk" },
      "env": { "EXPO_PUBLIC_API_URL": "https://staging.edulink.example" }
    },
    "production": {
      "autoIncrement": true,
      "channel": "production",
      "android": { "buildType": "app-bundle" }
    }
  },
  "submit": {
    "production": {
      "ios": { "ascAppId": "ASC_APP_ID", "appleTeamId": "APPLE_TEAM_ID" },
      "android": { "track": "internal", "serviceAccountKeyPath": "./play-service-account.json", "releaseStatus": "draft" }
    }
  }
}
